                                        <td>1255</td>
                                    </tr>*@
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header p-2 border-0 bg-dark">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="text-white">Order Types</label>
                    <button type="button" class="btn btn-primary hourwisesalesbreakdown">
