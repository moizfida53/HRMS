                    </button>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-center inner-table">
                    <div class="table-responsive grid-table">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order Type</th>
                                    <th>Count of Order</th>
                                    <th>Total Payment (<span class="currancy">KD</span>)</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyOrderTypes">
