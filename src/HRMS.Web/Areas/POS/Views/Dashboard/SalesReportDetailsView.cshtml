@model IEnumerable<HRMS.Web.Areas.POS.Models.PivotTotalSalesData>
<!-- 1 Boxs ============================================-->
<div class="row">
    <div class="col-lg-12 mb-3">
        <div class="card h-100">
            <div class="card-header p-2 border-0 bg-dark">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="text-white">Sales Data</label>
                    <div class="d-flex align-items-center">
                        @* Chart-only toggle: Dashboard.js's GetReportDashboardData()
                           already reads this element's value as ShowDefaultValueFlag
                           and re-fetches on change (see the #SalesShowDefaultValue
                           handler) - it just had nowhere to read from until now. The
                           grid below always shows Sales, Orders and Avg Per cheque
                           together regardless of this toggle. *@
                        <select class="form-control mr-2" id="SalesShowDefaultValue" style="width:150px;" title="Chart shows Amount or Order Count">
                            <option value="1">Amount</option>
                            <option value="2">Count</option>
                        </select>
                        <input type="button" value="Back" class="btn btn-primary" onclick="BackToMainTab();">
                    </div>
                </div>
            </div>
            <div class="card-body p-3">

                <div class="row">
                    <div class="col-lg-12">
                        <div class="card p-3 mb-3">
                            <div id="totalsalelinechart" style="height: 300px;"></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card p-3 mb-3">
                            <div class="row justify-content-between">
                                <div class="col-md">
                                    <div class="row">
                                        <div class="form-group col-xl-3 col-lg-3 col-md-4">
                                            <input id="btnExportToExcel" type="button" value="Export To Excel" class="btn btn-primary exportToExcel" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card p-3 mb-3">
                            @* Model.ReportWithPivot(...) called an extension method
                               that does not exist anywhere in this codebase - see
                               SalesPivotBuilder in DashboardModels.cs for why and
                               what replaces it. Its InvoiceDate x Branch(Sales /
                               Orders / Avg Per cheque) grid, with a Total column
                               and a Total row, is built there instead. *@
                            <div class="table-responsive grid-table">
                                @Html.Raw(HRMS.Web.Areas.POS.Models.SalesPivotBuilder.Build(Model))
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>







