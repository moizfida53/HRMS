@* =============================================================================
   SCRIPTS - and why every one of them is down here in a section

   _LayoutPOS.cshtml loads jQuery AFTER @@RenderBody(). Anything this view loaded
   inline in the body therefore registered its plugins against a jQuery that the
   layout then replaced wholesale a moment later: window.$ became a brand-new
   instance with no .selectpicker and no .daterangepicker on $.fn. Dashboard.js's
   ready handler then threw on the first $('#reportrange').daterangepicker(...)
   and never reached BindFilters() - which is why the date range did nothing AND
   every dropdown came up empty. One fault, two symptoms.

   @@section scripts renders after the layout's own <script> tags, so the plugins
   attach to the jQuery that survives. The view no longer loads jQuery,
   Bootstrap's JS or DataTables core at all - the layout already has all three.

   Paths corrected while here: ~/assets/js/pages/custom/reportdashboard/,
   ~/Content/datatables/ and ~/Scripts/chartkick.js do not exist in this project.
============================================================================= *@
@section scripts {
    @* Popper is deliberately NOT loaded here any more. It used to be, and it
       did not work: this section renders AFTER the layout's bootstrap.min.js,
       and Bootstrap captures Popper as a UMD closure argument when IT runs,
       not when a dropdown opens. Loading Popper afterwards left that argument
       undefined for good, so every filter below threw "Bootstrap's dropdowns
       require Popper.js" on first click and never opened. It now loads ahead
       of Bootstrap in _LayoutPOS.cshtml - see the note there. *@
    <script src="~/js/bootstrap-select.min.js"></script>

    <script src="~/DashboardContent/DateRangePicker/moment.min.js"></script>
    <script src="~/DashboardContent/DateRangePicker/daterangepicker.min.js"></script>

    @* DataTables core comes from the layout; these are the export buttons the
       drill-down grids ask for with dom: 'Bfrtip'. *@
    <link href="https://cdn.datatables.net/buttons/1.6.5/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/buttons/1.6.5/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.6.5/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.6.5/js/buttons.print.min.js"></script>

    @* Charts. Chart.js drives the Branch Sales bar; Chartkick over Highcharts
       draws the hourly and total-sales lines. Only ONE Chart.js version now -
       3.6.0 and 3.0.2 were both being pulled in, and the second overwrote the
       first after the datalabels plugin had registered against it. *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.6.0/dist/chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0-rc"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@3.2.1/dist/chartkick.min.js"></script>

    @* The endpoints, written by the router rather than by hand.

       Inside an Area the routes are /POS/Dashboard/..., not /Dashboard/... -
       the hard-coded paths in Dashboard.js pointed at the root and returned 404,
       which shows up as a page stuck on its loading spinner rather than as an
       error. Emitting them here means a future route change cannot break the JS.

       Same pattern as POS.urls in _LayoutPOS.cshtml. *@
    <script>
        window.DASH = {
            filter: '@Url.Action("GetFilter",              "Dashboard", new { area = "POS" })',
            data:   '@Url.Action("GetReportDashboardData", "Dashboard", new { area = "POS" })'
        };
    </script>

    <script src="~/MainJs/KMLoader.js"></script>
    <script src="~/Areas/POS/Scripts/Dashboard.js"></script>

    @* BI Reports tab. These were inline in BIReports.cshtml, which is rendered
       into the middle of the body - i.e. before the layout's jQuery and before
       Chartkick existed - so the whole block threw on its first line and left
       exportPivotToExcel() and saveAs() undefined. Moved here, after both. *@
    <script src="~/vendor/pivot/c3.min.js"></script>
    <script src="~/vendor/pivot/d3.min.js"></script>
    <script src="~/MainJs/PivotJS.js"></script>

    <script>
        // $(document)
        //    .ajaxStart(function () {
        //        debugger;
        //        showLoading();
        //    });
        //$(document).ajaxStop(function () {
        //    hideLoading();
        //});
        //$(document).ajaxError(function () {
        //    hideLoading();
        //});

        Chartkick.CustomChart = function (element, dataSource, options) { };


        ///////////////////// Start code for BI Reports Tab //////////////////////////////////
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--><meta http-equiv="content-type" content="text/plain; charset=UTF-8"/></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) };


        function saveAs(uri, filename) {
            var link = document.createElement('a');
            if (typeof link.download === 'string') {
                link.href = uri;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } else {
                window.open(uri);
            }
        }

        function exportPivotToExcel(pivotBlockId, name) {
            if ($('#outputInvoicewise').css('display') != 'none') {
                pivotBlockId = "outputInvoicewise";
            }
            if ($('#outputItemwise').css('display') != 'none') {
                pivotBlockId = "outputItemwise";
            }

            var tbl = $('#' + pivotBlockId).find('.pvtTable');
            var ctx = { worksheet: name || 'Worksheet', table: tbl.html() };
            var uriFile = uri + base64(format(template, ctx));
            saveAs(uriFile, name + '.xls');
        }
        ///////////////////// End code for BI Reports Tab //////////////////////////////////
        $("#chkSelectAllDays").click(function () {
            if ($("#chkSelectAllDays").is(':checked')) {
                $("#daysdropdowns > option").prop("selected", "selected");
                $("#daysdropdowns").trigger("change");
            } else {
                $("#daysdropdowns > option").removeAttr("selected");
                $("#daysdropdowns").trigger("change");
            }
        });
    </script>
}