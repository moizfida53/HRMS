
@{
    ViewBag.Title = "Dashboard";

    // Stated explicitly, as every other POS view does. There is no _ViewStart
    // in this Area, so without this line the view renders with no layout at
    // all - no nav, no sign-out, no way back to the Order List.
    Layout = "~/Areas/POS/Views/Shared/_LayoutPOS.cshtml";
}

@* -----------------------------------------------------------------------------
   STYLESHEETS

   The originals pointed at ~/assets/css/pages/reportdashboard/ and
   ~/Content/datatables/. NEITHER FOLDER EXISTS in this project, so every one of
   those links 404'd - which is why the filter bar rendered as bare, unstyled
   <select> boxes. They are replaced with the copies that are actually here.

   bootstrap.min.css and jquery.dataTables.min.css are already loaded by
   _LayoutPOS.cshtml's <head>; pulling them in a second time only invites a
   cascade fight, so they are not repeated.
----------------------------------------------------------------------------- *@
<link href="~/Content/bootstrap-select.min.css" rel="stylesheet" />
<link href="~/DashboardContent/DateRangePicker/daterangepicker.css" rel="stylesheet" />
<link href="~/css/KMLoader.css" rel="stylesheet" />
<link href="~/css/loader-Montserrat.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css?family=Poppins:300,300i,400,400i,500,600,700,900&display=swap" rel="stylesheet" />

<style>
    .nav-tabs .nav-item.show .nav-link, .nav-tabs .nav-link.active {
        background-color: #f2f3f7 !important;
        color: #000 !important;
    }

    .dropdown-menu.show {
        transform: none !important;
    }

    /* The filter bar sits inside a Bootstrap card; bootstrap-select renders a
       button the same height as .form-control so the row lines up. */
    .filter-bar .bootstrap-select > .dropdown-toggle {
        height: calc(1.5em + .75rem + 2px);
        padding: .375rem .75rem;
    }

    .filter-bar .form-group {
        margin-bottom: .75rem;
    }

    #reportrange {
        background: #fff;
        cursor: pointer;
        padding: .375rem .75rem;
        border: 1px solid #ced4da;
        border-radius: .25rem;
        color: #212529;
        height: calc(1.5em + .75rem + 2px);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ---------------- KPI cards (Sales.cshtml's 4 boxes) ----------------
       .info-name and .name-id came from ~/assets/css/pages/reportdashboard/
       style.css, which 404's - see the STYLESHEETS note above. With no CSS to
       stack them, the amount and its count sat side by side as two inline
       elements. Amount now leads, its count follows underneath as a smaller,
       muted line - the count is context for the amount, not a second figure
       of equal weight. */
    .info-name {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .info-name .name-id {
        font-size: 22px;
        font-weight: 700;
        color: var(--tmm-ink);
    }
    .info-name .name-id .currancy {
        font-size: 12px;
        font-weight: 600;
        margin-right: 4px;
        color: var(--pos-muted);
    }
    .info-name .kpi-count {
        margin-top: 2px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--pos-muted);
    }

    /* ---------------- Sales Data pivot grid ----------------
       Built server-side by SalesPivotBuilder dot Build in DashboardModels.cs.
       col-total / row-total are added by the builder to the Total group's
       cells so the grand totals stay visually distinct from the per-branch
       figures they sum. */
    .totalSalesPivotTable thead tr:last-child th {
        background: #F2F4F4;
        font-weight: 600;
        font-size: 12.5px;
    }
    .totalSalesPivotTable th.col-total,
    .totalSalesPivotTable td.col-total {
        background: #FBF8EF;
    }
    .totalSalesPivotTable tr.row-total td {
        font-weight: 700;
        background: #FAFBFB;
        border-top: 2px solid #DCE1E0;
    }
</style>
<input type="hidden" id="hdnCurrancyCode" value="KD" />
<!-- Tab START -->
<div class="tab-section">
    <ul class="tab-sec nav nav-tabs md-tabs mb-3 bg-white align-items-center" id="myTabMD" role="tablist">
        @* Sales / BI Reports / Finance / Business Summary / Saved Reports - hidden
           until those pages exist, same as the Customers/Reports/Settings links
           in the POS main menu (_LayoutPOS.cshtml). Kept, not deleted: restoring
           one is a matter of uncommenting its <li>.

           The Sales tab-pane (#home-md, below) already carries "show active" of
           its own, independent of these nav links, so Sales content keeps
           showing by default with the tab strip gone - there just stops being a
           way to switch to BI Reports/Finance/Business Summary/Saved Reports.

           "Location & Date" is left alone - it is not one of the named tabs,
           and is what opens the filter bar (Country/Location/Brand/date range)
           that the Sales tab still uses. Hiding the row that contains it would
           have taken it out too. *@
        @*
        <li class="nav-item waves-effect waves-light">
            <a class="nav-link active p-md-3 p-sm-2 border-0 dash_tab" id="sales-tab-md" data-toggle="tab" href="#home-md" role="tab" aria-controls="home-md" aria-selected="true">Sales</a>
        </li>
        <li class="nav-item waves-effect waves-light">
            <a class="nav-link p-md-3 p-sm-2 border-0 dash_tab" id="BIReports-tab-md" data-toggle="tab" href="#profile-md" role="tab" aria-controls="profile-md" aria-selected="false">BI Reports</a>
        </li>
        <li class="nav-item waves-effect waves-light">
            <a class="nav-link p-md-3 p-sm-2 border-0 dash_tab" id="Finance-tab-md" data-toggle="tab" href="#contact-md" role="tab" aria-controls="contact-md" aria-selected="false">Finance</a>
        </li>
        <li class="nav-item waves-effect waves-light">
            <a class="nav-link p-md-3 p-sm-2 border-0 dash_tab" id="summary-tab-md" data-toggle="tab" href="#summary-md" role="tab" aria-controls="summary-md" aria-selected="false">Business Summary</a>
        </li>
        <li class="nav-item waves-effect waves-light">
            <a class="nav-link p-md-3 p-sm-2 border-0 dash_tab" id="reports-tab-md" data-toggle="tab" href="#reports-md" role="tab" aria-controls="reports-md" aria-selected="false">Saved Reports</a>
        </li>
        *@
        @* "Location & Date" used to open/close the filter bar below via
           Bootstrap's collapse plugin. The filter bar is now always visible
           (see #collapseExample below - the "collapse" class that hid it by
           default is gone), so there is nothing left for this button to
           toggle. Kept, not deleted: bringing it - and the click-to-open
           behaviour - back just means restoring the "collapse" class down
           there and uncommenting this. *@
        @*
        <li class="collapse-btn ml-md-auto bd-md-highlight pr-3">
            <a class="btn btn-primary" data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                Location & Date
            </a>
        </li>
        *@
    </ul>
</div>
<!-- Tab END -->
