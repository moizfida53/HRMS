@{
    Layout = "~/Areas/Items/Views/Shared/_LayoutNew.cshtml";
}

<!-- Main Content -->
<main class="main-content item-management">
    <div class="container-fluid h-100">
        <div id="posX" style="display:none"></div>
        <div id="posY" style="display:none"></div>
        <div id="divTableBookingTablesView" class="table-management-list">
            <div class="d-flex justify-content-between">
                <input id="hdnSelectedDiningArea" type="hidden" value="Inner Area" />
                <ul class="nav nav-pills nav-fill" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link flex-fill active" id="inner-areas" data-toggle="tab" href="#inner" role="tab" aria-controls="inner" aria-selected="true" onclick="onDiningAreaTabChange('Inner Area');">Inner Areas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link flex-fill" id="outer-areas" data-toggle="tab" href="#outer" role="tab" aria-controls="outer" aria-selected="false" onclick="onDiningAreaTabChange('Out Area');">Outer Areas</a>
                    </li>
                </ul>
                <div>
                    <div class="d-flex">
                        <a href="#" class="btn btn-icon btn-secondary pr-0 mb-2" data-toggle="modal" data-target="#warning"><img class="icon" src="../images/clear.svg" alt=""></a>

                        <a href="#" class="btn btn-icon btn-primary pr-0 mb-2 ml-3" onclick="btnViewChange();">
                            <img class="icon" src="../images/list-view.svg" alt="">
                        </a>

                        @*<a href="#" class="btn btn-icon btn-primary pr-0 mb-2 ml-3" data-toggle="modal" data-target="#add-table">
                                <img class="icon" src="../images/add-w.svg" alt="">
                            </a>*@
                    </div>
                </div>
            </div>

            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="inner" role="tabpanel" aria-labelledby="inner-areas">

                </div>
                <div class="tab-pane fade" id="outer" role="tabpanel" aria-labelledby="profile-tab">

                </div>
            </div>
        </div>
    </div>
    <!-- Item Management Right Navigation -->

    <div class="right-navigation p-3">
        <div class="form-group">
            <input id="datepickerdt" class="btn btn-primary datepicker w-100 text-left" type="text" name="" value="Select Date">
        </div>

        @*<div class="cart events-cart mb-3">
                <div id="divSelectDatepicker" class="input-group date">
                    <input id="datepickerdt" type="text" class="form-control" readonly><span class="input-group-addon"><i class="glyphicon glyphicon-th"></i></span>
                </div>
            </div>*@
        @*<div class="accordion" id="accordionExample">
                <div class="card">
                    <div class="card-header" id="Branch-heading">
                        <a class="card-title" role="button" data-toggle="collapse" data-target="#Branch" aria-expanded="true" aria-controls="Branch">
                            Time Slots
                        </a>
                    </div>

                    <div id="Branch" class="collapse show" aria-labelledby="Branch-heading" data-parent="#accordionExample">
                        <div class="card-body">
                            <ul id="ulTimeSlotList"></ul>
                        </div>
                    </div>
                </div>
            </div>*@
        <div id="ulTimeSlotList" class="time-slot w-100">

        </div>
    </div>
</main>
<!-- End Main Content -->
@*//-------------------------------------------Start EditTableWindow Popup----------------------------------------*@
<div class="modal fade" id="EditTableWindow" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="AddTableTitle">Change Table</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <input id="hdnSelectedTableid" type="hidden" value="0" />
                        <input id="hdnReservationid" type="hidden" value="0" />
                        <label>Current Table</label>
                        <input id="txtCurrentTableName" type="text" class="form-control" readonly />
                        <div class="invalid-feedback">
                            Please insert a valid Table name.
                        </div>
                    </div>
                    <div class="form-group">
                        <label>New Table</label>
                        <select id="ddavailableTables" class="form-control" name="ddavailableTables" required>
                            @*<option value="">Select Area</option>
                                <option value="Inner Area">Inner Area</option>
                                <option value="Out Area">Out Areaa</option>*@
                        </select>
                        <div class="invalid-feedback">
                            Please select New Table.
                        </div>
                    </div>

                    @*<div class="form-group">
                            <label>Seating Count</label>
                            <input type="radio" id="one" name="seatingCount" value="2" checked>
                            <label for="male">1-2</label><br>
                            <input type="radio" id="two" name="seatingCount" value="4">
                            <label for="female">2-4</label><br>
                            <input type="radio" id="fivePlus" name="seatingCount" value="6">
                            <label for="other">5+</label>
                            <div class="invalid-feedback">
                                Please insert a valid Seating Count.
                            </div>
                        </div>*@
                </div>
                <div class="modal-footer">
                    @*<button id="TimeSlotDeleteButton" type="button" class="btn btn-danger" onclick="InActiveTable();">Delete</button>*@
                    <button id="TableAddButton" type="button" class="btn btn-primary" onclick="ChangesSaveTable();">Change</button>
                    <button id="btnEditTableWindowClose" type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*//-------------------------------------------End EditTableWindow Popup----------------------------------------*@
@*//-------------------------------------------Start Reservation Popup----------------------------------------*@
<div class="modal fade" id="ReservationStatus" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="AddTableTitle">Reservation Status</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Select Reservation Status :</label>
                        <select id="ddReservationStatus" class="form-control" name="ddReservationStatus">
                        </select>
                    </div>


                </div>
                <div class="modal-footer">
                    @*<button id="TimeSlotDeleteButton" type="button" class="btn btn-danger" onclick="InActiveTable();">Delete</button>*@
                    <button id="ChangeStatusButton" type="button" class="btn btn-primary" onclick="ReservationStatusChange();">Change</button>
                    <button id="btnReservationStatusClose" type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*//-------------------------------------------End Reservation Popup----------------------------------------*@


