                var strTimeSlotLi = ""
                //strTimeSlotLi = '<li class="p-0 mb-2" onclick="OnchangeTimeSlot(' + value.id + ');" >\
                //            <table class="table">\
                //                <tr>\
                //                    <td class="branch_td1">' + 3 + '</td>\
