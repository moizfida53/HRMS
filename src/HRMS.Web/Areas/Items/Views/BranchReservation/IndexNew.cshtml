        //$('#divSelectDatepicker').datepicker({
        //    format: "dd/mm/yyyy",
        //    todayHighlight: true,
        //    "autoclose": true,
        //    startDate: today
        //}).change(dateChanged);
        FillReservation();
        $('#datepickerdt').datepicker({
            format: "dd/mm/yyyy",
            todayHighlight: true,
            "autoclose": true,
            startDate: today
        }).change(dateChanged);
        $('#datepickerdt').datepicker('setDate', today);
    });

    function onDiningAreaTabChange(selectedval) {
        $('#hdnSelectedDiningArea').val(selectedval);
        BindTimeSlotList();
        if (timeslotIntVar != null) {
            clearInterval(timeslotIntVar);
        }
        timeslotIntVar = setInterval(function () {
            BindTimeSlotList();
        }, 5000);

        if (selectedslotId > 0) {
            if (myintVar != null) {
                clearInterval(myintVar);
            }
            BindTableData(selectedslotId);
            myintVar = setInterval(function () {
                BindTableData(selectedslotId);
            }, 5000);
        }
    }
    function dateChanged(ev) {
        BindTimeSlotList();
        if (timeslotIntVar != null) {
            clearInterval(timeslotIntVar);
        }
        timeslotIntVar = setInterval(function () {
            BindTimeSlotList();
        }, 5000);
    }
    function BindTimeSlotList() {
        //$("#inner").html("");
        //$("#outer").html("");
        //$("#ulTimeSlotList").html("");

        var dt = $("#datepickerdt").val().split("/")
        //var dt1 = new Date(dt[2], dt[1] - 1, dt[0])
        var dt1 = dt[2] + '-' + dt[1] + '-' + dt[0];

        var objdata = {
            selectedDate: dt1,
            //selectedDate: $('#divSelectDatepicker').data('date'),
            DiningArea: $('#hdnSelectedDiningArea').val(),
        }
        $.ajax({
            type: "POST",
            data: JSON.stringify(objdata),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            cache: false,
            url: "/BranchReservation/GetTimeSlotData",
            success: function (result) {
                if (result.dtresult != "") {
                    var TimeSlotdata = JSON.parse(result.dtTimeSlotresult);
                    BindTimeSlotViewHtml(TimeSlotdata);
                }
            }
        });
    }
