<!-- Reservation Content ===========================================================-->
<div id="divReservation" class="main-content active cart-page" style="display:none; height:100%;">
    <div class="item-list-title mb-2">
        <div class="row justify-content-between align-items-center">
            <div class="col-auto">
                <a href="#" title="back" class="btn btn-sm back-btn" onclick="BackToSectionList();">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
            <div class="col-auto">
                <h2 id="lblReservationHeader">Reservation</h2>
            </div>
        </div>
    </div>
    <div class="container-fluid">
            <div class="form-group guests-select">
                <label id="lblNameOfGuests">Number of Guests</label>
                <div class="d-flex item-select-block justify-content-between align-content-center">
                    <a href="#" class="btn btn-primary icon-btn" onclick="MinusReservationGuest();">
                        <i class="fa fa-minus" aria-hidden="true"></i>
                    </a>
                    <input id="txtReservationGuestCount" class="form-control onlyNumeric" type="text" name="" value="1">
                    <a href="#" class="btn btn-primary icon-btn" onclick="AddReservationGuest();">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
            <div class="form-group">
                <label id="lblScheduleDataAndTime">Schedule Data & Time</label>
                <div class="date-pick">
                    <div id="dtReservation" class="datepicker"></div>
                </div>
