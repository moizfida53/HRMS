                            <div class="card-body p-4">
                                <h5 class="card-title font-weight-bold pb-2">Lorem ipsum tempor nulla est eiusmod ?</h5>
                                <div class="smiley-outer d-flex">
                                    <img id="imgSmile_1" class="mr-3 clsmile clsSmilechecked" src="~/Images/smiley-03.svg" alt="smiley" onclick="smaileRatingClick(this,1)">
                                    <img id="imgSmile_2" class="mr-3 clsmile" src="~/Images/smiley-02.svg" alt="smiley" onclick="smaileRatingClick(this,2)">
                                    <img id="imgSmile_3" class="clsmile" src="~/Images/smiley-01.svg" alt="smiley" onclick="smaileRatingClick(this,3)">
