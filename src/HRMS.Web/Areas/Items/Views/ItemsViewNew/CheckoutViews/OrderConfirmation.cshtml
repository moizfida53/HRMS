<!-- Main Content ===========================================================-->
<div id="divOrderConfirmView" class="main-content active cart-page order-mode-page order-information-page" style="display:none;">
    <div class="item-list-title mb-2">
        <div class="row justify-content-between align-items-center">
            <div class="col-auto">
                @*<a title="back" class="btn btn-sm back-btn" onclick="OrderConfirmBackClick();">
                        <i class="fa fa-arrow-left" aria-hidden="true"></i>
                    </a>*@
            </div>
            <div class="col-auto">
                <h2 id="lblOCOrderInformation">Order Information</h2>
            </div>
        </div>
    </div>
    <div class="animation">
        <div class="container-fluid pt-3 payment-methods">
            <div class="d-flex justify-content-between order-information-invoice-btn mb-3">
                <a href="#" title="" class="btn btn-light mr-2" style="display:none">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-printer" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" />
                            <path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" />
                            <rect x="7" y="13" width="10" height="8" rx="2" />
                        </svg>
                        <label id="lblOCPrint">Print</label>
                    </span>
                </a>
                <a onclick="OrderConfirmHomeClick();" title="" class="btn btn-light mr-2">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-notes" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <rect x="5" y="3" width="14" height="18" rx="2" />
                            <line x1="9" y1="7" x2="15" y2="7" />
                            <line x1="9" y1="11" x2="15" y2="11" />
                            <line x1="9" y1="15" x2="13" y2="15" />
                        </svg>
                        @*PDF Invoice*@

                        <label id="lblOCHome">Home</label>
                    </span>
                </a>
                <a onclick="OrderConfirmTrackOrderClick();" title="" class="btn btn-light" style="display:none">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-live-view" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M4 8v-2a2 2 0 0 1 2 -2h2" />
                            <path d="M4 16v2a2 2 0 0 0 2 2h2" />
                            <path d="M16 4h2a2 2 0 0 1 2 2v2" />
                            <path d="M16 20h2a2 2 0 0 0 2 -2v-2" />
                            <line x1="12" y1="11" x2="12" y2="11.01" />
                            <path d="M12 18l-3.5 -5a4 4 0 1 1 7 0l-3.5 5" />
                        </svg>
                        <label id="lblOCTrackorder">Track order</label>
                    </span>
                </a>
            </div>
            @if (ViewBag.IsFromWaiterLogin=="true")
            {
                <div class="card p-3 mb-3">
                    <h3 class="sub-title"><label id="lblWaiter">Waiter Name: </label>  <label id="txtWaiterName">@ViewBag.WaiterName</label></h3>
                </div>
            }
            <div class="card p-3 mb-3">
                <h3 class="sub-title"><label id="lblOCOrder">Order</label>  <label id="CustomerOrderNo"></label></h3>
                <ul class="card-order-info">
                    <li class="d-flex justify-content-between">
                        <span id="lblOrderConfirmOrderDateLabel">Order Date</span>
                        <strong id="lblOrderConfirmOrderDate">08:30 PM 8, March  2021</strong>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span id="lblOCOrderStatus">Order Status</span>
                        <strong class="text-warning" id="lblOCPending">Pending</strong>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span id="lblOCOrderTotal">Order Total</span>
                        <strong id="lblOrderConfirmOrderTotal">0.000</strong>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span id="lblOCPaymentMehtod">Payment Mehtod</span>
                        <strong id="lblOrderConfirmOrderPaymentType">Cash on delivery</strong>
                    </li>
                </ul>
            </div>
            <div class="card pt-3 pb-3 mb-3">
                <h3 class="sub-title pl-3 pr-3" id="lblOCDeliveryInfo">Delivery Info</h3>
                <ul class="delivery-info">
                    <li class="d-flex align-items-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-user mr-3 ml-3" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                            <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                        </svg>
                        <label id="lblOrderConfirmOrderCustomerName">Info@gmail.com</label>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mail mr-3 ml-3" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <polyline points="3 7 12 13 21 7" />
                        </svg>
                        <label id="lblOrderConfirmOrderEmail">Info@gmail.com</label>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-phone-call mr-3 ml-3" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
                            <path d="M15 7a2 2 0 0 1 2 2" />
                            <path d="M15 3a6 6 0 0 1 6 6" />
                        </svg>
                        <label id="lblOrderConfirmOrderMobile"> +685 122346</label>
                    </li>
                    <li class="d-flex align-items-top mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-map-pin mr-3 ml-3" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="12" cy="11" r="3" />
                            <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
                        </svg>
                        <div>
                            <h3 class="pb-1" id="lblOrderConfirmOrderAddre1">Building No.</h3>
                            <p class="pb-0" id="lblOrderConfirmOrderAddre2">11 Street 1 lane, Salmiya</p>
                        </div>
                    </li>
                </ul>
            </div>
            @*<div class="d-flex justify-content-center mt-4">
            <a class="btn btn-primary w-100" onclick="BackToSectionList();"><span>Go to Menu</span></a>
        </div>*@
        </div>
    </div>
</div><!-- End Main Content ===========================================================-->


