@using HRMS.Web.Areas.Items.Legacy
@*<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/jquery.validate.min.js"></script>*@
<script src="@Asset.V("~/js/jquery.validate.min.js")"></script>
<!-- Main Content ===========================================================-->
<div id="divCustomerInfo" class="main-content active cart-page order-mode-page" style="display:none;">
    <div class="animation">
        <form id="formCustomerInfo" class="container-fluid pt-3">
            @*was-validated*@
            <div class="card p-3 user-information">
                <div class="heading mb-3">
                    <span class="icon-outer">
                        <svg height="640pt" viewBox="-20 -99 640 640" width="640pt" xmlns="http://www.w3.org/2000/svg">
                            <path d="m179.25 211c35.691406 0 64.625-28.9375 64.625-64.625 0-35.691406-28.933594-64.625-64.625-64.625s-64.625 28.933594-64.625 64.625c.046875 35.671875 28.953125 64.578125 64.625 64.625zm0-104.125c21.882812 0 39.625 17.738281 39.625 39.625 0 21.882812-17.742188 39.625-39.625 39.625-21.886719 0-39.625-17.742188-39.625-39.625.007812-21.882812 17.742188-39.617188 39.625-39.625zm0 0" />
                            <path d="m179.25 234.875c-26.441406-.195312-51.820312 10.417969-70.25 29.375-18.75 19.125-29 45.125-29 73.375.019531 6.894531 5.605469 12.480469 12.5 12.5h173.5c6.894531-.019531 12.480469-5.605469 12.5-12.5 0-28.25-10.25-54.25-29-73.375-18.429688-18.957031-43.804688-29.570312-70.25-29.375zm-73.375 90.25c2.140625-16.34375 9.507812-31.554688 21-43.375 13.832031-13.996094 32.695312-21.875 52.375-21.875s38.542969 7.878906 52.375 21.875c11.46875 11.832031 18.835938 27.039062 21 43.375zm0 0" />
                            <path d="m537.5-5.25h-475c-34.511719.015625-62.484375 27.988281-62.5 62.5v317.5c.015625 34.511719 27.988281 62.484375 62.5 62.5h475c34.511719-.015625 62.484375-27.988281 62.5-62.5v-317.5c-.015625-34.511719-27.988281-62.484375-62.5-62.5zm37.5 380c-.058594 20.683594-16.816406 37.441406-37.5 37.5h-475c-20.683594-.058594-37.441406-16.816406-37.5-37.5v-317.5c.058594-20.683594 16.816406-37.441406 37.5-37.5h475c20.683594.058594 37.441406 16.816406 37.5 37.5zm0 0" />
                            <path d="m506.75 203.5h-145.625c-6.902344 0-12.5 5.59375-12.5 12.5s5.597656 12.5 12.5 12.5h145.625c6.902344 0 12.5-5.59375 12.5-12.5s-5.597656-12.5-12.5-12.5zm0 0" />
                            <path d="m506.75 283.5h-145.625c-6.902344 0-12.5 5.59375-12.5 12.5s5.597656 12.5 12.5 12.5h145.625c6.902344 0 12.5-5.59375 12.5-12.5s-5.597656-12.5-12.5-12.5zm0 0" />
                            <path d="m506.75 123.5h-145.625c-6.902344 0-12.5 5.59375-12.5 12.5s5.597656 12.5 12.5 12.5h145.625c6.902344 0 12.5-5.59375 12.5-12.5s-5.597656-12.5-12.5-12.5zm0 0" />
                        </svg>
                    </span>
                    <h3 id="divUserInformation" class="pb-2">User Information</h3>
                    <p id="lblUserInformationTag">We’ll ues it to get back to you for order updates</p>
                </div>
                <div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-user" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <circle cx="12" cy="7" r="4" />
                                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                                    </svg>
                                </div>
                            </div>
                            <input id="txtCustomerFullname" type="text" class="form-control" placeholder="Full name" required />
                        </div>

                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    965
                                </div>
                            </div>
                            <input id="txtCustomerPhoneNumber" type="text" class="form-control PhoneNumber" placeholder="Phone number" required />
                            @*<label id="txtCustomerPhoneNumber-error" class="error" for="txtCustomerPhoneNumber">
                    Phone Number is required.
                </label>*@
                        </div>
                    </div>
                    <div class="form-group" style="display:none">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mail" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <rect x="3" y="5" width="18" height="14" rx="2" />
                                        <polyline points="3 7 12 13 21 7" />
                                    </svg>
                                </div>
                            </div>
                            @*<input id="txtCustomerEmailnew" type="text" class="form-control" placeholder="Email" tabindex="100" required>*@
                            <input id="txtCustomerEmailnew" type="text" class="form-control" placeholder="Email" tabindex="100">
                        </div>
                    </div>
                    <div class="form-group" style="display:none">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mail" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <rect x="3" y="5" width="18" height="14" rx="2" />
                                        <polyline points="3 7 12 13 21 7" />
                                    </svg>
                                </div>
                            </div>
                            <input id="txtCustomerCivilID" type="text" class="form-control" placeholder="CivilID" tabindex="100">
                        </div>
                    </div>

                    <div class="form-group isHideDineInfo">
                        <div class="input-group">
                            <input id="txtTableNumber" type="number" class="form-control" placeholder="Table Number" required />
                        </div>
                    </div>
                    <div class="form-group isHideDineInfo">
                        <div class="input-group">
                            <input id="txtNumberofGuests" type="number" class="form-control" placeholder="Number of Guests" required />
                        </div>
                    </div>
                    <div class="form-group isHideDineInfo align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkReOrder">
                            <label class="form-check-label" for="chkReOrder">
                                Re-Order
                            </label>
                        </div>
                    </div>
                    <div class="form-group isHideDineInfo align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkTakeAway">
                            <label class="form-check-label" for="chkTakeAway">
                                Take-Away
                            </label>
                        </div>
                    </div>                  
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-secondary" onclick="clickBackFromCustomerInfo();" tabindex="0">
                    <span id="CustInfobtnPrevious">Previous</span>
                </button>
                @if (ViewBag.IsFromWaiterLogin == "true")
                {
                    <button id="btnInfobtnDineIn" class="btn btn-secondary" tabindex="1">
                        <span id="CustInfobtnDineIn">Dine-In</span>
                    </button>
                }
                <button class="btn btn-primary" type="button" onclick="customerInfoNext();" tabindex="101">
                    <span id="CustInfobtnNext">Next</span>
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    $("#txtCustomerPhoneNumber").on('input', function (e) {
        $(this).val($(this).val().replace(/[^0-9]/g, ''));
    });
    $(".isHideDineInfo").hide();
    function clickBackFromCustomerInfo() {
        $('#divCategoryList').hide();
        $('#divMainItemDetails').hide();
        $('#divCartView').show();
        $('#divQRCodeMain').hide();
        $('#TrackingOrder').hide();
        $('#divReservation').hide();
        $('#divReservationConfirm').hide();

        //checkout views list
        $('#divCustomerInfo').hide();
        $('#divDeliveryService').hide();
        $('#divDeliveryAddress').hide();
        $('#divPaymentView').hide();
        $('#divOrderConfirmView').hide();

        //set customer info cookies
        if (CustomerDetails != null) {
            CustomerDetails["CustomerFullName"] = $('#txtCustomerFullname').val();
            CustomerDetails["PhoneNumber"] = $('#txtCustomerPhoneNumber').val();
            CustomerDetails["EmailId"] = $('#txtCustomerEmailnew').val();
            CustomerDetails["CivilID"] = $('#txtCustomerCivilID').val();
            CustomerDetails["TableNumber"] = $('#txtTableNumber').val();
            CustomerDetails["NumberofGuests"] = $('#txtNumberofGuests').val();
            CustomerDetails["ReOrder"] = $('#chkReOrder').is(':checked');
            CustomerDetails["TakeAway"] = $('#chkTakeAway').is(':checked');
            var val = JSON.stringify(CustomerDetails);
            createCookie("CustomerDetailsCookie", val, 365);
        }
    }

    $('#btnInfobtnDineIn').click(function (e) {
        e.preventDefault();
        $(".isHideDineInfo").show();
    });

</script>
<!-- End Main Content ===========================================================-->