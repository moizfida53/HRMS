        $('#divDeliveryService').hide();
        $('#divDeliveryAddress').hide();
        $('#divPaymentView').hide();
        $('#divOrderConfirmView').show();
    }

    function SubmitOrderAjaxcall(objdata) {
        debugger;
        $.ajax({
            type: "Post",
            data: JSON.stringify(objdata),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            cache: false,
            url: "/ItemsView/SubmitOrder",
            success: function (result) {
                debugger;
                if (result.Message == "Success") {

                    // An online method must be paid before the customer sees a
                    // confirmation screen. Showing "order placed" first and
                    // redirecting after teaches people to close the tab, and the
                    // order is then sitting unpaid.
                    if (result.IsOnlinePayment && result.PayToken) {
                        $('#lblPaymentConfirmation').html('Redirecting to payment...');
                        $.ajax({
                            type: "Post",
                            url: "/ItemsView/StartOnlinePayment",
                            data: { invoiceNo: result.InvoiceNo, payToken: result.PayToken },
                            cache: false
                        }).done(function (pr) {
                            if (pr && pr.Message === "Success" && pr.PaymentUrl) {
                                ClearcartData();
                                ClearCheckoutData();
                                // Same tab, not a popup: mobile browsers block
                                // popups opened from an ajax callback, and the
                                // customer must not lose the gateway page.
                                window.location = pr.PaymentUrl;
                            } else {
                                alert('Your order ' + result.InvoiceNo + ' was created, but the payment page could not be opened.\n\n'
                                    + ((pr && pr.Detail) || '') + '\n\nPlease contact the branch to pay.');
                                showOrderConfirmation();
                            }
                        }).fail(function () {
                            alert('Your order ' + result.InvoiceNo + ' was created, but the payment page could not be opened. Please contact the branch to pay.');
                            showOrderConfirmation();
                        });
                        return;
                    }

                    $('#advisement').modal('hide');
                    $('#divlandingpage').hide();
                    $('#divCategoryList').hide();
                    $('#divMainItemDetails').hide();
                    $('#divCartView').hide();
                    $('#divQRCodeMain').hide();
                    $('#TrackingOrder').hide();
                    $('#divReservation').hide();
                    $('#divReservationConfirm').hide();

                    //checkout views list
                    $('#divCustomerInfo').hide();
                    $('#divDeliveryService').hide();
                    $('#divDeliveryAddress').hide();
                    $('#divPaymentView').hide();
                    $('#divOrderConfirmView').show();

                    var resData = JSON.parse(result.dtresult);
                    // The printed invoice number when the server sent one,
                    // otherwise the invoice number itself - an install that has
                    // not run POS_32 must still show the customer something.
                    $('#CustomerOrderNo').html(resData[0].InvoiceNumShow || resData[0].InvoiceNo);
                    if (resData[0].DeliveryDate != null) {
                        var d = new Date(resData[0].DeliveryDate);
                        var month = d.getMonth() + 1;
                        var day = d.getDate();

                        var output = (day < 10 ? '0' : '') + day + ' ' +
                            (month < 10 ? '' : '') + months[month - 1] + ' ' +
                            d.getFullYear() + ' ' + formatAMPM(d);

                        $('#lblOrderConfirmOrderDate').html(output);
                    }

                    $('#lblOrderConfirmOrderTotal').html(round(resData[0].FinalAmount, decimalPlace).toFixed(decimalPlace));
                    // Name the method the customer actually picked. The old test
                    // was `selectedPayementType == "0"` from the 0/1 Cash/KNET
                    // days, so every order now labelled itself KNET.
                    var $chosen = $('.paymenttype.activePayment').first();
                    var chosenName = $chosen.find('label').text();
                    if (chosenName) {
                        $('#lblOrderConfirmOrderPaymentType').html($('<div>').text(chosenName).html());
                    }
                    else if ($chosen.data('iscod') == 1) {
                        $('#lblOrderConfirmOrderPaymentType').html($('#lblPaymentCash').html());
                    }
                    else {
                        $('#lblOrderConfirmOrderPaymentType').html($('#lblPaymentKNET').html());
                    }

                    // The order is placed and the confirmation is already on
                    // screen, so nothing about this customer should survive into
                    // the next order on the same device: name, mobile, address,
                    // basket and the saved cookie all go.
                    //
                    // (`document.cookie = ""` below was a no-op - assigning an
                    // empty string to document.cookie deletes nothing.)
                    ClearcartData();
                    ClearCheckoutData();
                }
                else {
                    // ShowNotification(result.Message);
                }
            }
        });
    }

