        $('#divPaymentView').hide();
        $('#divOrderConfirmView').hide();
    }
    function OnApplyDiscountCodeClick() {
        if ($('#txtdiscountCoupon').val().trim() != "") {

            var objdata = {
                DiscountCode: $('#txtdiscountCoupon').val().trim(),
            }
            $.ajax({
                type: "Post",
                data: JSON.stringify(objdata),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                url: "/ItemsView/CheckDiscountCouponCode",
                success: function (result) {
                    debugger;
                    if (result.Message == "Success") {
                        var data = JSON.parse(result.dtresult);
                        var IsDiscountPercent = data[0].IsDiscountPercent;
                        var discountValue = data[0].DiscountValue;
                        var netamount = round($('#lblPaymentNetAmountVal').text(), decimalPlace).toFixed(decimalPlace);
                        $('#hdnDiscountTypeID').val(data[0].DiscountTypeId);
                        if (IsDiscountPercent == true) {
                            var disc = parseFloat((netamount * discountValue) / 100);
                            $('#lblDiscountAmount').text(round(disc, decimalPlace).toFixed(decimalPlace));
                            $('#lblfinalAmount').text(round(parseFloat(netamount - disc), decimalPlace).toFixed(decimalPlace));
                        }
                        else {
                            $('#lblDiscountAmount').text(round(discountValue, decimalPlace).toFixed(decimalPlace));
                            $('#lblfinalAmount').text(round(parseFloat(netamount - discountValue), decimalPlace).toFixed(decimalPlace));
                        }
                    }
                    else {
                        $('#txtdiscountCoupon').val("");
                        $("#alertTitle").html("Message");
                        $("#alertMessage").html("Please insert valid Coupon code");
                        $("#alertModal").modal();
                    }
                }
            });
        }
        else {
            $("#alertTitle").html(Message);
            $("#alertMessage").html("Please insert valid Coupon code");
            $("#alertModal").modal();
        }
        
    }
</script>
