    function createDeliveryDate(DateControl, Timecontrol) {
        var returndate = null;
        ////////////////start set date Time join///////////////
        var dt = null;
        if ($(DateControl).val() == "Today" || $(DateControl).val() == TodayLable) {
            dt = new Date();
        }
        else {
            //var from = $(DateControl).val().split(" ")
            //dt = new Date(from[2], from[1] - 1, from[0]);
            dt = new Date($(DateControl).val());
        }


        if ($(Timecontrol).val() == "0" || $(Timecontrol).val() == null) {
            var currenttime = new Date();
            var d = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate(), currenttime.getHours(), currenttime.getMinutes(), 0, 0);
            returndate = d;
        }
        else {
            var cntname = $(Timecontrol).attr("id");
            var tmptime = $('#' + cntname + " option:selected").attr("data-value").split(":");
            //new Date(year, month, day, hour, minute, second, and millisecond)
            var d = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate(), tmptime[0], tmptime[1], 0, 0);
            returndate = d;
        }
        return returndate;
        ////////////////End set date Time join///////////////

    }

    function formatAMPM(date) {
        var hours = date.getHours();
        var minutes = date.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var strTime = hours + ':' + minutes + '' + ampm;
        return strTime;
    }

    function paymentselectionClick(obj, type) {
        if (!obj) return;

        $('.paymenttype').each(function () { $(this).removeClass('activePayment'); });
        $(obj).addClass('activePayment');
        $('#selectedPayementType').html(type);

        // The button label follows whether money is taken now or on delivery,
        // which is a property of the method rather than of its name.
        var isCod = $(obj).data('iscod') == 1;
        $('#lblPaymentConfirmation').html(isCod ? btnPaymentProcessOrder : btnPaymentProceedtoPayment);
    }
    // =====================================================================
    //  Payment methods, loaded from tblInvoicePaymentType (IsOnline = 1).
    //
    //  #selectedPayementType now holds the REAL tblInvoicePaymentType.ID
    //  rather than the old 0/1 code. SubmitOrder validates it against the
    //  table, so an order is booked against the method the customer actually
    //  chose instead of a hard-coded guess.
    // =====================================================================
    function loadPaymentTypes() {
        $.ajax({
            type: "Post",
            url: "/ItemsView/GetPaymentTypes",
            // Cash on delivery (tblInvoicePaymentType ID 1) is offered next to
            // the online methods. With this false the list held only IsOnline
            // rows, so cash could only ever appear if the cash row itself was
            // flagged online - which is exactly the misconfiguration that sent
            // cash orders to MyFatoorah.
            data: { includeCOD: true },
            cache: false
        }).done(function (res) {
            var $wrap = $('#divPaymentOptions');
            if (!$wrap.length) return;

            var rows = [];
            if (res && res.Message === "Success" && res.dtresult) {
                try { rows = JSON.parse(res.dtresult); } catch (e) { rows = []; }
            }

            if (!rows.length) {
                // Better to say so than to show an empty row the customer
                // cannot get past without knowing why.
                $wrap.html('<div class="col-12"><div class="alert alert-warning mb-0" '
                         + 'style="font-size:13px;">No payment method is available right now. '
                         + 'Please contact the branch.</div></div>');
                $('#selectedPayementType').html('');
                $('#lblPaymentConfirmation').html(btnPaymentProcessOrder);
                return;
            }

            var isAr = ($('#selectedLang').val() === 'AR');
            var html = '';

            $.each(rows, function (i, p) {
                var name = isAr && p.PaymentTypeNameArb ? p.PaymentTypeNameArb : p.PaymentTypeName;
                var img  = p.ImageUrl
                         ? '<img src="' + p.ImageUrl + '" alt="" '
                           // A missing file must not leave a broken-image icon
                           // sitting in the middle of checkout.
                           + 'onerror="this.style.display=\'none\';" />'
                         : '';

                html += '<div class="col-4">'
                     +  '<a class="card paymenttype' + (i === 0 ? ' activePayment' : '') + '"'
                     +  ' data-paytype="' + p.PaymentTypeID + '"'
                     +  ' data-iscod="' + (p.IsCOD ? 1 : 0) + '"'
                     +  ' onclick="paymentselectionClick(this,\'' + p.PaymentTypeID + '\');">'
                     +  img
                     +  '<label>' + $('<div>').text(name).html() + '</label>'
                     +  '</a></div>';
            });

            $wrap.html(html);

            // Pre-select the first method so the customer is never left on a
            // page where Process Order does nothing and nothing looks wrong.
            paymentselectionClick($wrap.find('.paymenttype').first()[0], String(rows[0].PaymentTypeID));
        }).fail(function () {
            $('#divPaymentOptions').html('<div class="col-12"><div class="alert alert-danger mb-0" '
                + 'style="font-size:13px;">Could not load payment methods.</div></div>');
        });
    }

    function onViewDetailsItemsOnPaymentView() {
        loadPaymentTypes();
        debugger;
        var bindstr = "";
        if (CartDetails.length > 0) {
            debugger;
            var ObjDataCartDetails = [];
            var objCartDetails = CartDetails;
            $.each(objCartDetails, function (i, obj) {
                var item = {}
                item["UID"] = obj.UID;
                item["ItemId"] = obj.I;
                item["HID"] = obj.O;
                item["qty"] = obj.Q;
                item["Comments"] = obj.C;
                item["ChoiceId"] = obj.CH;
                ObjDataCartDetails.push(item);
            });
            $.ajax({
                type: "Post",
                data: JSON.stringify(ObjDataCartDetails),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                url: "/ItemsView/GetCartViewItems",
                success: function (result) {
                    debugger;
                    if (result.Message == "Success") {
                        var Items = result.dtItems;
                        $.each(Items, function (i, item) {
                            bindstr += '<li class="d-flex justify-content-between">' +
                                '<span>' + item.ITEM_NAME + '</span>' +
                                '<span>' + item.qty + '</span>' +
                                '<strong>' + round(parseFloat(item.qty) * parseFloat(item.PRICE), decimalPlace).toFixed(decimalPlace)+ '</strong>' +
                                '</li>';
                        });
                        $('#ulDivItemsListOnPaymentview').html(bindstr);
                    }
                }
            });
        }
    }
