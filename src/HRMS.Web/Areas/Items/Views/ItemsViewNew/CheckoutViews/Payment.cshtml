<script>
    function PaymentPreviousClick() {
        if ($('#hdnIsFromWaiterLogin').val() == "true") {
            DeliveryServicePrevious()
        }
        else {
            if (parseInt($('#hdnBranchId').val()) > 0 && $('#hdnIsDeliveryEnable').val() == "false") {
                DeliveryServicePrevious();
            }
            else {
                $('#divCategoryList').hide();
                $('#divMainItemDetails').hide();
                $('#divCartView').hide();
                $('#divQRCodeMain').hide();
                $('#TrackingOrder').hide();
                $('#divReservation').hide();
                $('#divReservationConfirm').hide();

                //checkout views list
                $('#divCustomerInfo').hide();
                $('#divDeliveryService').show();
                $('#divDeliveryAddress').hide();
                $('#divPaymentView').hide();
                $('#divOrderConfirmView').hide();
            }
        }
    }
    function PaymentNextClick() {
        if ($('#selectedPayementType').html() != "") {
            CustomerSubmitOrder();
        }
        else {
            alert("Please select Payment Type");
        }

        //$('#divCategoryList').hide();
        //$('#divMainItemDetails').hide();
        //$('#divCartView').hide();
        //$('#divQRCodeMain').hide();
        //$('#TrackingOrder').hide();
        //$('#divReservation').hide();
        //$('#divReservationConfirm').hide();

        ////checkout views list
        //$('#divCustomerInfo').hide();
        //$('#divDeliveryService').hide();
        //$('#divDeliveryAddress').hide();
        //$('#divPaymentView').hide();
        //$('#divOrderConfirmView').show();

    }
    var Custinfo = {};
    var AddrInfo = {};
    var selectedbranchid = 1;
    var deliveryDate = null;
    var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

    function CustomerSubmitOrder() {
        debugger;
        //isfromWaiterTemp = isfromWaiter;
        FillCustinfoAndAddressInfo();

        var objCartDetails = CartDetails;
        var ObjDataCartDetails = [];
        var tapPayAPIObject = [];

        //set default 0
        $('#lblPaymentDiscountCharge').text(round(0, decimalPlace).toFixed(decimalPlace));
        $('#lblDiscountAmount').text(round(0, decimalPlace).toFixed(decimalPlace));


        $.each(objCartDetails, function (i, obj) {
            var strComment = "";
            var item = {}
            item["ItemId"] = obj.I;
            item["HID"] = obj.O;
            item["qty"] = obj.Q;
            //item["UID"] = obj.UID;

            //New inserted on 8 Nov 2021, same extra and choices selected then it is considered only single
            item["UID"] = ObjDataCartDetails.length + 1;

            //New inserted on 17-Dec-22, For callcenter tblorder add ParentOrderId value
            item["CartItemUniqID"] = obj.UID;
            item["ParentItemId"] = 0;

            //start for comment
            //strComment = obj.C;
            strComment = $('#comments_' + obj.I + '_' + obj.UID).val();
            $.each(CartComments, function (i, extraComments) {
                if (extraComments.MainItemId == obj.I) {
                    strComment += strComment != "" ? ", " : "";
                    strComment += extraComments.Comment;
                }
            });
            item["Comments"] = strComment;
            //End for comment

