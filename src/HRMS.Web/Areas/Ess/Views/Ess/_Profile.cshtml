@model EssPageModel
@{
    var p = Model.Profile;
    var name = p is null ? null : L.IsArabic && !string.IsNullOrWhiteSpace(p.ArabicName) ? p.ArabicName : p.EmployeeName;
    string V(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
@* Read-only on purpose: no inputs at all, only a description list. Changes go through HR. *@
@if (p is null)
{
    <div class="ess-card"><div class="ess-empty">@Html.Icon("user", 32)<div>@L.Tr("Your account is not linked to an employee. Contact your HR administrator.")</div></div></div>
}
else
{
    <div class="ess-profile-head">
        <span class="ess-avatar">@Model.Initials</span>
        <div>
            <div class="ess-profile-head__name">@name</div>
            <div class="ess-profile-head__sub">@V(p.DesignationName ?? p.PositionName) · @V(p.DepartmentName)</div>
            <div class="ess-profile-head__sub">@L.Tr("Employee No.") @p.EmployeeNo</div>
        </div>
    </div>

    <p class="ess-lock">@Html.Icon("lock", 15) @L.Tr("This information is read-only. Contact HR to request a change.")</p>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="ess-card">
                <div class="ess-card__title">@L.Tr("Personal")</div>
                <dl class="ess-fields">
                    <div><dt>@L.Tr("Civil ID")</dt><dd dir="ltr">@EssFormat.Mask(p.CivilIdNumber)</dd></div>
                    <div><dt>@L.Tr("Civil ID expiry")</dt><dd>@L.Date(p.CivilIdExpiryDate)</dd></div>
                    <div><dt>@L.Tr("Nationality")</dt><dd>@V(p.NationalityName)</dd></div>
                    <div><dt>@L.Tr("Date of birth")</dt><dd>@L.Date(p.DateOfBirth)</dd></div>
                    <div><dt>@L.Tr("Gender")</dt><dd>@V(p.Gender is null ? null : L.Tr(p.Gender switch { "M" => "Male", "F" => "Female", _ => p.Gender }))</dd></div>
                    <div><dt>@L.Tr("Marital status")</dt><dd>@V(p.MaritalStatus is null ? null : L.Tr(p.MaritalStatus))</dd></div>
                    <div><dt>@L.Tr("Mobile")</dt><dd dir="ltr">@EssFormat.Mask(p.MobileNumber, 4, 3)</dd></div>
                    <div><dt>@L.Tr("Work email")</dt><dd>@V(p.WorkEmail)</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="ess-card">
                <div class="ess-card__title">@L.Tr("Employment")</div>
                <dl class="ess-fields">
                    <div><dt>@L.Tr("Company")</dt><dd>@V(p.CompanyName)</dd></div>
                    <div><dt>@L.Tr("Branch")</dt><dd>@V(p.BranchName)</dd></div>
                    <div><dt>@L.Tr("Department")</dt><dd>@V(p.DepartmentName)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(p.SectionName))
                    {
                        <div><dt>@L.Tr("Section")</dt><dd>@p.SectionName</dd></div>
                    }
                    <div><dt>@L.Tr("Designation")</dt><dd>@V(p.DesignationName ?? p.PositionName)</dd></div>
                    <div><dt>@L.Tr("Work location")</dt><dd>@V(p.LocationName)</dd></div>
                    <div><dt>@L.Tr("Reporting to")</dt><dd>@V(p.ReportingManagerName)</dd></div>
                    <div><dt>@L.Tr("Joining date")</dt><dd>@L.Date(p.HireDate)</dd></div>
                    @if (p.ProbationEndDate is { } pe && pe >= HRMS.Web.Services.LocalClock.Today)
                    {
                        <div><dt>@L.Tr("Probation ends")</dt><dd>@L.Date(pe)</dd></div>
                    }
                    <div><dt>@L.Tr("Employment type")</dt><dd>@V(p.EmploymentType is null ? null : L.Tr(p.EmploymentType))</dd></div>
                </dl>
            </div>
        </div>
    </div>
}
