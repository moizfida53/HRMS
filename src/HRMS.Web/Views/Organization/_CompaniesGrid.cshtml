@model GridViewModel<Company>

<div class="hrms-card">
    @await Html.PartialAsync("Partials/_GridToolbar", (IGridView)Model)

    @if (Model.Page.TotalCount == 0)
    {
        @await Html.PartialAsync("Partials/_EmptyState", (IGridView)Model)
    }
    else
    {
        <div class="hrms-table-wrap">
            <table class="hrms-table">
                <caption class="hrms-sr-only">@L["common.records_page_of", Model.PageNumber, Model.TotalPages]</caption>
                <thead>
                    <tr>
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "CompanyCode", "Code"))
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "CompanyName", "Company"))
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "LegalName", "Legal Name", "col-p2"))
                        <th scope="col" class="col-p3">@L["org.cr_no"]</th>
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "CountryName", "Country"))
                        <th scope="col" class="col-p3">@L["org.branches"]</th>
                        <th scope="col">@L["common.employees"]</th>
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "IsActive", "Status"))
                        <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Page.Items)
                    {
                        <tr data-id="@row.CompanyId" data-name="@row.CompanyName" data-active="@row.IsActive.ToString().ToLowerInvariant()">
                            <td data-label="@L.Tr("Code")"><span class="hrms-code-chip">@row.CompanyCode</span></td>
                            <td data-label="@L.Tr("Company")"><span class="hrms-table__primary">@row.CompanyName</span></td>
                            <td data-label="@L.Tr("Legal Name")" class="hrms-muted col-p2">@(string.IsNullOrWhiteSpace(row.LegalName) ? "—" : row.LegalName)</td>
                            <td data-label="@L.Tr("CR No.")" class="col-p3">@(string.IsNullOrWhiteSpace(row.CommercialRegistrationNo) ? "—" : row.CommercialRegistrationNo)</td>
                            <td data-label="@L.Tr("Country")">@(string.IsNullOrWhiteSpace(row.CountryName) ? "—" : row.CountryName)</td>
                            <td data-label="@L.Tr("Branches")" class="col-p3"><span class="hrms-count @(row.BranchCount == 0 ? "is-zero" : null)">@row.BranchCount</span></td>
                            <td data-label="@L.Tr("Employees")"><span class="hrms-count @(row.EmployeeCount == 0 ? "is-zero" : null)">@row.EmployeeCount</span></td>
                            <td data-label="@L.Tr("Status")">
                                @if (row.IsActive)
                                {
                                    <span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@L["org.active"]</span>
                                }
                                else
                                {
                                    <span class="hrms-badge hrms-badge--muted"><span class="hrms-badge__dot"></span>@L["org.inactive"]</span>
                                }
                            </td>
                            <td class="hrms-table__actions">
                                <button type="button" class="btn-icon" data-action="edit"
                                        title="@L["common.edit"]" aria-label="@L["common.edit_named", row.CompanyName]">@Html.Icon("edit", 15)</button>
                                <button type="button" class="btn-icon btn-icon--success" data-action="toggle"
                                        title="@(row.IsActive ? L["common.deactivate"] : L["common.activate"])"
                                        aria-label="@(row.IsActive ? L["common.deactivate_named", row.CompanyName] : L["common.activate_named", row.CompanyName])">@Html.Icon("power", 15)</button>
                                <button type="button" class="btn-icon btn-icon--danger" data-action="delete"
                                        title="@L["common.delete"]" aria-label="@L["common.delete_named", row.CompanyName]">@Html.Icon("trash", 15)</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("Partials/_Pagination", PaginationModel.From(Model))
    }
</div>
