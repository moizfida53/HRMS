@model GridViewModel<AssetType>
@{
    // Organization > Asset Types (db/84): the kinds of asset kept on Workforce > Assets.
    // db/100: every type on one page; rows are dragged into their sequence (organization.js) while
    // the list shows in that sequence - no search, no status filter, no other column sort.
    var request = Model.Request;
    var inOwnOrder = string.IsNullOrEmpty(request.SortColumn) || (Model.IsSortedBy("SortOrder") && !Model.IsDescending);
    var canDrag = inOwnOrder && !Model.IsFiltered && Model.TotalPages <= 1;
    var position = 0;
}
<div class="hrms-card">
    @await Html.PartialAsync("Partials/_GridToolbar", (IGridView)Model)

    @if (Model.Page.TotalCount == 0)
    {
        @await Html.PartialAsync("Partials/_EmptyState", (IGridView)Model)
    }
    else
    {
        <div class="hrms-table-wrap">
            <p class="org-doctypes__hint">
                @Html.Icon(canDrag ? "grip" : "info", 14)
                <span>@(canDrag ? L["as.type_drag_hint"] : L["as.type_drag_off_hint"])</span>
            </p>
            <table class="hrms-table od-types as-typetable org-doctypes@(canDrag ? " is-sortable" : "")" @(canDrag ? "data-docorder" : "")
                   data-docorder-url="@Url.Action("ReorderAssetTypes", "Organization")">
                <caption class="hrms-sr-only">@L["common.records_page_of", Model.PageNumber, Model.TotalPages]</caption>
                <thead>
                    <tr>
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "SortOrder", "Order", "org-doctypes__order-col"))
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "TypeName", "Asset Type"))
                        <th scope="col" class="col-p2">@L["as.expiry_date"]</th>
                        <th scope="col">@L["od.expiry_alerts"]</th>
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "UsageCount", "Assets", "col-p3"))
                        @await Html.PartialAsync("Partials/_SortHeader", SortHeaderModel.For(Model, "IsActive", "Status"))
                        <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Page.Items)
                    {
                        var name = AssetFormat.Name(L, row.TypeName, row.ArabicName);
                        var alerts = ExpiryAlert.Parse(row.AlertRules);
                        position++;
                        <tr data-id="@row.AssetTypeId" data-name="@row.TypeName" data-active="@row.IsActive.ToString().ToLowerInvariant()"
                            data-section="all">
                            <td data-label="@L["org.od_order"]" class="org-doctypes__order">
                                <span class="org-doctypes__order-in">
                                    @if (canDrag)
                                    {
                                        <button type="button" class="org-doctypes__handle" data-docorder-handle
                                                title="@L["org.od_drag_handle", name]" aria-label="@L["org.od_drag_handle", name]"
                                                aria-describedby="docorder-help">
                                            @Html.Icon("grip", 16)
                                        </button>
                                    }
                                    <span class="org-doctypes__pos" data-docorder-pos>@(canDrag ? position : row.SortOrder ?? position)</span>
                                </span>
                            </td>
                            <td data-label="@L.Tr("Asset Type")">
                                <span class="as-typecell">
                                    <span class="as-icon as-icon--@AssetFormat.Key(row.Icon) as-icon--tile" aria-hidden="true">@Html.Icon(AssetFormat.Icon(row.Icon), 16)</span>
                                    <span class="od-cell">
                                        <span class="hrms-table__primary">@name</span>
                                        @if (!string.IsNullOrWhiteSpace(row.ArabicName))
                                        {
                                            <span class="org-doctypes__alt" dir="@(L.IsArabic ? "ltr" : "rtl")" lang="@(L.IsArabic ? "en" : "ar")">@(L.IsArabic ? row.TypeName : row.ArabicName)</span>
                                        }
                                    </span>
                                </span>
                            </td>
                            <td data-label="@L["as.expiry_date"]" class="col-p2">
                                @if (!row.HasExpiryDate)
                                {
                                    <span class="hrms-muted hrms-text-sm">@L["od.no_expiry"]</span>
                                }
                                else
                                {
                                    <span class="hrms-text-sm">@(AssetFormat.Name(L, row.ExpiryLabel, row.ExpiryLabelAr) is { Length: > 0 } label ? label : L["as.expiry_date"])</span>
                                }
                            </td>
                            <td data-label="@L["od.expiry_alerts"]">
                                @if (!row.HasExpiryDate)
                                {
                                    <span class="hrms-muted hrms-text-sm">—</span>
                                }
                                else if (alerts.Count == 0)
                                {
                                    <span class="od-noalert">@Html.Icon("bell", 12)@L["od.no_alerts"]</span>
                                }
                                else
                                {
                                    <span class="od-alerts" title="@string.Join(L["common.list_separator"], alerts.Select(a => OrgDocumentFormat.AlertLabel(L, a)))">
                                        @Html.Icon("bell", 12)
                                        @foreach (var a in alerts) { <span class="od-alerts__chip">@OrgDocumentFormat.AlertShort(L, a)</span> }
                                    </span>
                                }
                            </td>
                            <td data-label="@L.Tr("Assets")" class="col-p3 hrms-numeric">@row.UsageCount</td>
                            <td data-label="@L.Tr("Status")">
                                @if (row.IsActive)
                                {
                                    <span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@L["org.active"]</span>
                                }
                                else
                                {
                                    <span class="hrms-badge hrms-badge--muted"><span class="hrms-badge__dot"></span>@L["org.inactive"]</span>
                                }
                            </td>
                            <td class="hrms-table__actions">
                                <button type="button" class="btn-icon" data-action="edit"
                                        title="@L["common.edit"]" aria-label="@L["common.edit_named", name]">@Html.Icon("edit", 15)</button>
                                <button type="button" class="btn-icon btn-icon--success" data-action="toggle"
                                        title="@(row.IsActive ? L["common.deactivate"] : L["common.activate"])"
                                        aria-label="@(row.IsActive ? L["common.deactivate_named", name] : L["common.activate_named", name])">@Html.Icon("power", 15)</button>
                                <button type="button" class="btn-icon btn-icon--danger" data-action="delete"
                                        title="@L["common.delete"]" aria-label="@L["common.delete_named", name]">@Html.Icon("trash", 15)</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (canDrag)
            {
                <span id="docorder-help" class="hrms-sr-only">@L["as.type_drag_hint"]</span>
                <span class="hrms-sr-only" role="status" aria-live="polite" data-docorder-live></span>
            }
        </div>

        @* db/100: no pages - the whole list shows, so it can be dragged into order *@
    }
</div>
