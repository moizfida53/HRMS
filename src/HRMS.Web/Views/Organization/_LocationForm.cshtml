@model FormViewModel<Location>

<form id="record-form" data-tab="@Model.Tab.Key" novalidate>
    <div class="modal-header">
        <h2 class="modal-title h5" id="record-modal-title">@(Model.IsNew ? L["common.add_named", L.Tr(Model.Tab.Singular)] : L["common.edit_named", L.Tr(Model.Tab.Singular)])</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" name="LocationId" value="@Model.Model.LocationId" />

        <fieldset class="hrms-fieldset">
            <legend>@L["common.identity"]</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="f-CompanyId">@L["common.company"] <span class="req" aria-hidden="true">*</span></label>
                    <select class="form-select" id="f-CompanyId" name="CompanyId" required>
                        <option value="">@L["common.select"]</option>
                        @foreach (var item in Model.Lookup(LookupType.Company))
                        {
                            <option value="@item.Id" selected="@(Model.Model.CompanyId == item.Id)">@item.Text</option>
                        }
                    </select>
                    <span class="field-validation-error" data-valmsg-for="CompanyId"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="f-BranchId">@L["common.branch"]</label>
                    <select class="form-select" id="f-BranchId" name="BranchId" data-cascade-from="CompanyId" data-lookup-type="Branch">
                        <option value="">@L["org.not_tied_to_a_branch"]</option>
                        @foreach (var item in Model.Lookup(LookupType.Branch))
                        {
                            <option value="@item.Id" selected="@(Model.Model.BranchId == item.Id)">@item.Text</option>
                        }
                    </select>
                    <span class="field-validation-error" data-valmsg-for="BranchId"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="f-LocationCode">@L["org.location_code"] <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="f-LocationCode" name="LocationCode" type="text"
                           value="@Model.Model.LocationCode" maxlength="50" required
                           autocomplete="off" spellcheck="false"
                           data-code-field data-scope-field="CompanyId" />
                    <span class="form-text">@L["org.letters_numbers_hyphen_or_underscore_must_be_uni"]</span>
                    <span class="field-validation-error" data-valmsg-for="LocationCode"></span>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="f-LocationName">@L["org.location_name"] <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="f-LocationName" name="LocationName" type="text"
                           value="@Model.Model.LocationName" maxlength="150" required />
                    <span class="field-validation-error" data-valmsg-for="LocationName"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="f-LocationType">@L["org.type"]</label>
                    <input class="form-control" id="f-LocationType" name="LocationType" type="text"
                           value="@Model.Model.LocationType" maxlength="50" placeholder="@L["org.office_warehouse"]" />
                    <span class="field-validation-error" data-valmsg-for="LocationType"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="hrms-fieldset">
            <legend>@L["common.address"]</legend>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="f-Governorate">@L["org.governorate"]</label>
                    <select class="form-select" id="f-Governorate" name="Governorate">
                        <option value="">@L["common.select"]</option>
                        @foreach (var item in Model.Lookup(LookupType.Governorate))
                        {
                            <option value="@item.Text" selected="@(Model.Model.Governorate == item.Text)">@item.Text</option>
                        }
                    </select>
                    <span class="field-validation-error" data-valmsg-for="Governorate"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="f-Area">@L["org.area"]</label>
                    <input class="form-control" id="f-Area" name="Area" type="text"
                           value="@Model.Model.Area" maxlength="100" />
                    <span class="field-validation-error" data-valmsg-for="Area"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="f-Block">@L["common.block"]</label>
                    <input class="form-control" id="f-Block" name="Block" type="text"
                           value="@Model.Model.Block" maxlength="30" />
                    <span class="field-validation-error" data-valmsg-for="Block"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="f-Street">@L["org.street"]</label>
                    <input class="form-control" id="f-Street" name="Street" type="text"
                           value="@Model.Model.Street" maxlength="150" />
                    <span class="field-validation-error" data-valmsg-for="Street"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="f-Building">@L["org.building"]</label>
                    <input class="form-control" id="f-Building" name="Building" type="text"
                           value="@Model.Model.Building" maxlength="50" />
                    <span class="field-validation-error" data-valmsg-for="Building"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="hrms-fieldset">
            <legend>@L["org.coordinates"]</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="f-Latitude">@L["org.latitude"]</label>
                    <input class="form-control" id="f-Latitude" name="Latitude" type="number" step="0.0000001"
                           value="@Model.Model.Latitude" placeholder="29.3759" />
                    <span class="field-validation-error" data-valmsg-for="Latitude"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="f-Longitude">@L["org.longitude"]</label>
                    <input class="form-control" id="f-Longitude" name="Longitude" type="number" step="0.0000001"
                           value="@Model.Model.Longitude" placeholder="47.9774" />
                    <span class="field-validation-error" data-valmsg-for="Longitude"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="hrms-fieldset">
            <legend>@L["common.status"]</legend>
            <div class="row g-3">
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="f-IsActive" name="IsActive" value="true" checked="@Model.Model.IsActive" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="f-IsActive">@L["org.active"]</label>
                    </div>
                    <span class="form-text">@L["org.inactive_records_stay_in_the_system_and_in_histo"]</span>
                </div>
            </div>
        </fieldset>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
        <button type="submit" class="btn btn-primary" data-submit>
            @Html.Icon("check", 15)
            <span>@(Model.IsNew ? L["common.create"] : L["common.save_changes"])</span>
        </button>
    </div>
</form>
