@model FormViewModel<Department>

<form id="record-form" data-tab="@Model.Tab.Key" novalidate>
    <div class="modal-header">
        <h2 class="modal-title h5" id="record-modal-title">@(Model.IsNew ? L["common.add_named", L.Tr(Model.Tab.Singular)] : L["common.edit_named", L.Tr(Model.Tab.Singular)])</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
    </div>

    <div class="modal-body">
        <input type="hidden" name="DepartmentId" value="@Model.Model.DepartmentId" />

        <fieldset class="hrms-fieldset">
            <legend>@L["common.identity"]</legend>
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label" for="f-CompanyId">@L["common.company"] <span class="req" aria-hidden="true">*</span></label>
                    <select class="form-select" id="f-CompanyId" name="CompanyId" required>
                        <option value="">@L["common.select"]</option>
                        @foreach (var item in Model.Lookup(LookupType.Company))
                        {
                            <option value="@item.Id" selected="@(Model.Model.CompanyId == item.Id)">@item.Text</option>
                        }
                    </select>
                    <span class="field-validation-error" data-valmsg-for="CompanyId"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="f-DepartmentCode">@L["org.department_code"] <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="f-DepartmentCode" name="DepartmentCode" type="text"
                           value="@Model.Model.DepartmentCode" maxlength="50" required
                           autocomplete="off" spellcheck="false"
                           data-code-field data-scope-field="CompanyId" />
                    <span class="form-text">@L["org.letters_numbers_hyphen_or_underscore_must_be_uni"]</span>
                    <span class="field-validation-error" data-valmsg-for="DepartmentCode"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="f-DepartmentName">@L["org.department_name"] <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="f-DepartmentName" name="DepartmentName" type="text"
                           value="@Model.Model.DepartmentName" maxlength="150" required />
                    <span class="field-validation-error" data-valmsg-for="DepartmentName"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="hrms-fieldset">
            <legend>@L["org.structure"]</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="f-ParentDepartmentId">@L["org.reports_to"]</label>
                    <select class="form-select" id="f-ParentDepartmentId" name="ParentDepartmentId">
                        <option value="">@L["org.top_level"]</option>
                        @foreach (var item in Model.Lookup(LookupType.Department))
                        {
                            <option value="@item.Id" selected="@(Model.Model.ParentDepartmentId == item.Id)">@item.Text</option>
                        }
                    </select>
                    <span class="form-text">@L["org.leave_blank_for_a_top_level_department"]</span>
                    <span class="field-validation-error" data-valmsg-for="ParentDepartmentId"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="f-CostCenterId">@L["common.cost_center"]</label>
                    <select class="form-select" id="f-CostCenterId" name="CostCenterId">
                        <option value="">@L["common.select"]</option>
                        @foreach (var item in Model.Lookup(LookupType.CostCenter))
                        {
                            <option value="@item.Id" selected="@(Model.Model.CostCenterId == item.Id)">@item.Text</option>
                        }
                    </select>
                    <span class="field-validation-error" data-valmsg-for="CostCenterId"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="hrms-fieldset">
            <legend>@L["common.status"]</legend>
            <div class="row g-3">
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="f-IsActive" name="IsActive" value="true" checked="@Model.Model.IsActive" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="f-IsActive">@L["org.active"]</label>
                    </div>
                    <span class="form-text">@L["org.inactive_records_stay_in_the_system_and_in_histo"]</span>
                </div>
            </div>
        </fieldset>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
        <button type="submit" class="btn btn-primary" data-submit>
            @Html.Icon("check", 15)
            <span>@(Model.IsNew ? L["common.create"] : L["common.save_changes"])</span>
        </button>
    </div>
</form>
