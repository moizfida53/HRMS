@model OrganizationIndexViewModel
@{
    ViewData["Title"] = "Organization Setup";   // translated by the layout (L.Tr)
    ViewData["ActiveArea"] = "organization";
    ViewData["ActiveTab"] = Model.ActiveTab.Key;
    ViewData["Subtitle"] = Model.ActiveTab.Description;   // organization.js updates it on tab change
}


<nav class="hrms-tabs" aria-label="@L["org.organization_masters"]">
    <div class="hrms-tabs__rail" role="tablist">
        @foreach (var tab in Model.Tabs)
        {
            var isActive = tab.Key == Model.ActiveTab.Key;
            <button type="button"
                    role="tab"
                    id="tab-@tab.Key"
                    class="hrms-tab @(isActive ? "is-active" : null)"
                    data-tab="@tab.Key"
                    data-singular="@L.Tr(tab.Singular)"
                    data-description="@L.Tr(tab.Description)"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-controls="grid-slot">
                @L.Tr(tab.Title)
                <span class="hrms-tab__count" data-tab-count hidden></span>
            </button>
        }
    </div>
</nav>

<div id="grid-slot"
     class="hrms-grid-slot"
     role="tabpanel"
     aria-labelledby="tab-@Model.ActiveTab.Key"
     aria-busy="true"
     data-tab="@Model.ActiveTab.Key"
     data-grid-url="@Url.Action("Grid", "Organization")"
     data-form-url="@Url.Action("Form", "Organization")"
     data-save-url="@Url.Action("Save", "Organization")"
     data-delete-url="@Url.Action("Delete", "Organization")"
     data-toggle-url="@Url.Action("Toggle", "Organization")"
     data-lookup-url="@Url.Action("Lookup", "Organization")"
     data-duplicate-url="@Url.Action("CheckDuplicate", "Organization")">

    <div class="hrms-spinner" aria-hidden="true"></div>

    @* First paint: skeleton rows, replaced by the real grid as soon as it arrives. *@
    <div class="hrms-card">
        <div class="hrms-card__toolbar">
            <div class="hrms-skeleton" style="width:220px;height:34px"></div>
            <div class="hrms-card__count"><span class="hrms-skeleton" style="width:70px;display:inline-block"></span></div>
        </div>
        <div style="padding:1.25rem">
            @for (var i = 0; i < 6; i++)
            {
                <div class="hrms-skeleton" style="margin-bottom:14px;width:@(90 - (i * 7))%"></div>
            }
        </div>
    </div>
</div>

@* Modal host for the add/edit forms. Content is injected by organization.js. *@
<div class="modal fade" id="record-modal" tabindex="-1" aria-hidden="true" aria-labelledby="record-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="record-modal-content">
            <!-- form partial injected here -->
        </div>
    </div>
</div>

@* Delete confirmation. Kept as a real dialog rather than window.confirm so it
   can name the record and explain when a delete will be refused. *@
<div class="modal fade" id="confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="confirm-modal-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="confirm-modal-title">@L["org.delete_record"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">@L["common.are_you_sure_you_want_to_delete"] <strong data-confirm-name></strong>@L["common.question_mark"]</p>
                <p class="hrms-muted hrms-text-sm mb-0">
                    @L["org.the_record_is_hidden_everywhere_in_the_app_but_k"]
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="button" class="btn btn-primary" data-confirm-accept
                        style="--bs-btn-bg:#b42318;--bs-btn-border-color:#b42318;--bs-btn-hover-bg:#912018;--bs-btn-hover-border-color:#912018">
                    @Html.Icon("trash", 15)
                    <span>@L["common.delete"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/organization.js" asp-append-version="true"></script>
}


@section PageActions {
    <button type="button" class="btn btn-outline-secondary" data-action="export">
        @Html.Icon("download", 15)
        <span>@L["common.export"]</span>
    </button>
    <button type="button" class="btn btn-primary" data-action="add">
        @Html.Icon("plus", 15)
        <span data-add-label>@L["common.add_named", L.Tr(Model.ActiveTab.Singular)]</span>
    </button>
}
