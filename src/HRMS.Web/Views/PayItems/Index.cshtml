@model PayItemsPageModel
@{
    // Payroll Components (db/111): one page per kind of exception to the contract salary
    var pg = Model.Page;
    ViewData["Title"] = pg.Title;
    ViewData["Heading"] = L[pg.TitleKey];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "components";
    ViewData["PayrollPage"] = pg.Slug;
    ViewData["Subtitle"] = L[pg.SubtitleKey];
    var r = Model.Rights;
    var isSalary = pg.ItemClass == ItemClass.Salary;
    var status = Model.SelectedStatus is "ACTIVE" or "PENDING" or "ENDED" or "ALL" ? Model.SelectedStatus : "OPEN";
}

<div class="pr-stack" data-pr-page="payitems" data-pi-page-class="@pg.ItemClass"
     data-urls-salary-history="@Url.Action("SalaryHistory", "PayItems", new { employeeId = 0 })"
     data-urls-grid="@Url.Action("Grid", "PayItems")"
     data-urls-kpis="@Url.Action("Kpis", "PayItems")"
     data-urls-employee="@Url.Action("Employee", "PayItems", new { id = 0 })"
     data-urls-figures="@Url.Action("EmployeeFigures", "PayItems", new { id = 0 })"
     data-urls-reference="@Url.Action("EmployeeItems", "PayItems", new { id = 0 })"
     data-text-ref-current="@L["pi.ref_focus_current"]"
     data-text-ref-before="@L["pi.ref_focus_before"]"
     data-text-ref-none="@L["pi.ref_focus_none"]"
     data-urls-form="@Url.Action("Form", "PayItems")"
     data-urls-save="@Url.Action("Save", "PayItems")"
     data-urls-approve="@Url.Action("Approve", "PayItems")"
     data-urls-end="@Url.Action("End", "PayItems")"
     data-urls-delete="@Url.Action("Delete", "PayItems")"
     data-urls-history="@Url.Action("History", "PayItems", new { id = 0 })"
     data-urls-export="@Url.Action("Export", "PayItems")"
     data-urls-import="@Url.Action("Import", "PayItems")"
     data-text-new="@L["pc.add_" + pg.Route]"
     data-text-edit="@L["pr.edit_pay_item"]"
     data-text-revise="@L["pr.change_salary_item"]"
     data-text-approve-title="@L["pr.approve"]"
     data-text-approve="@L["pr.approve_this_item_salary_and_loan_items_are_paid_only_af"]"
     data-text-delete-title="@L["common.delete"]"
     data-text-delete="@L["pr.delete_this_pay_item_it_has_not_been_paid_by_any_payroll"]">

    @* what this page is for - the contract salary is the default, these are the exceptions (approved) *@
    <div class="pr-banner pr-banner--info">
        @Html.Icon(pg.Icon, 18)
        <div>
            <strong>@L["pc.default_title"]</strong>
            @L["pc.intro_" + pg.Route]
        </div>
    </div>

    <div data-pi-kpis aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>

    <div data-pi-employee></div>

    <section class="hrms-card" data-pi-list>
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <label class="hrms-search" style="max-width:280px;flex:1 1 200px">
                    @Html.Icon("search", 16)
                    <input type="search" data-pi-search autocomplete="off" placeholder="@L["pr.search_item_or_comment"]" aria-label="@L["pr.search_item_or_comment"]" />
                </label>
                <select class="form-select pr-pi-emp" data-pi-emp aria-label="@L["pr.employee"]">
                    <option value="">@L["pr.all_employees"]</option>
                    @foreach (var e in Model.Employees)
                    {
                        <option value="@e.EmployeeId" selected="@(e.EmployeeId == Model.SelectedEmployeeId)">@PayItemFormat.EmployeeName(L, e.EmployeeName, e.EmployeeArabicName) · @e.EmployeeNo</option>
                    }
                </select>
                <select class="form-select pr-pi-status" data-pi-status aria-label="@L["common.status"]">
                    <option value="OPEN" selected="@(status == "OPEN")">@L["pr.active_and_pending"]</option>
                    <option value="ACTIVE" selected="@(status == "ACTIVE")">@L["org.active"]</option>
                    <option value="PENDING" selected="@(status == "PENDING")">@L["pr.pending_approval"]</option>
                    <option value="ENDED" selected="@(status == "ENDED")">@L["pr.ended"]</option>
                    <option value="ALL" selected="@(status == "ALL")">@L["common.all_statuses"]</option>
                </select>
            </div>
            <div class="hrms-card__count" data-pi-count></div>
        </div>
        <div data-pi-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>

@* ---- add / edit form: the body is loaded from the server ---- *@
<div class="modal fade" id="pi-modal" tabindex="-1" aria-hidden="true" aria-labelledby="pi-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-pi-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="pi-modal-title" data-pi-form-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-pi-form-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="submit" class="btn btn-primary" data-pi-save>@Html.Icon("check", 15)<span>@L["pr.save_item"]</span></button>
            </div>
        </form>
    </div>
</div>

@* ---- history ---- *@
<div class="modal fade" id="pi-history-modal" tabindex="-1" aria-hidden="true" aria-labelledby="pi-history-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="pi-history-title">@L["pr.history"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-pi-history-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
            </div>
        </div>
    </div>
</div>

@* ---- end an item ---- *@
<div class="modal fade" id="pi-end-modal" tabindex="-1" aria-hidden="true" aria-labelledby="pi-end-title">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-pi-end-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="pi-end-title">@L["pr.end_item"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p class="hrms-muted hrms-text-sm" data-pi-end-what></p>
                <div data-pi-end-monthly hidden>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="pi-end-when" id="pi-end-now" value="now" checked />
                        <label class="form-check-label" for="pi-end-now">@L["pr.stop_now_no_further_payroll_pays_it"]</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="pi-end-when" id="pi-end-month" value="month" />
                        <label class="form-check-label" for="pi-end-month">@L["pr.pay_it_until_a_month"]</label>
                    </div>
                    <select class="form-select mb-3" data-pi-end-select aria-label="@L["pr.last_month_paid"]" disabled></select>
                </div>
                <p class="hrms-text-sm" data-pi-end-instalment hidden>@L["pr.the_remaining_instalments_are_not_deducted_the_balance_i"]</p>
                <label class="form-label" for="pi-end-comment">@L["pr.comment"]</label>
                <textarea class="form-control" id="pi-end-comment" rows="2" maxlength="500" data-pi-end-comment placeholder="@L["pr.why_is_it_stopped"]"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="submit" class="btn btn-danger" data-pi-end-save>@L["pr.end_item"]</button>
            </div>
        </form>
    </div>
</div>

@* ---- import ---- *@
@if (r.CanCreate)
{
    <div class="modal fade" id="pi-import-modal" tabindex="-1" aria-hidden="true" aria-labelledby="pi-import-title">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <form class="modal-content" data-pi-import-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="pi-import-title">@L["pr.import_pay_items"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="hrms-muted hrms-text-sm">@L["pr.1_download_the_template_2_fill_one_row_per_item_3_upload"]</p>
                    <div class="mb-3">
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Template", "PayItems", new { cls = pg.ItemClass })">@Html.Icon("download", 15)<span>@L["pr.download_template_xlsx"]</span></a>
                    </div>
                    <label class="pr-upload" data-pi-drop>
                        <span class="pr-upload__icon" aria-hidden="true">@Html.Icon("upload", 22)</span>
                        <strong data-pi-file-name>@L["pr.choose_the_excel_file_or_drop_it_here"]</strong>
                        <span class="hrms-muted hrms-text-sm">@L["pr.xlsx_or_csv_up_to_2000_rows_and_5_mb"]</span>
                        <input type="file" accept=".xlsx,.csv" data-pi-file hidden />
                    </label>
                    <ul class="pr-import-help hrms-text-sm mt-3">
                        <li><strong>@L["pr.item_type"]</strong>: @L["pr.the_code_or_name_from_payroll_settings_pay_item_types_e"]</li>
                        <li><strong>@L["pr.applies"]</strong>: @L["pr.one_time_every_month_or_instalments_empty_salary_every_m"]</li>
                        <li><strong>@L["pr.from_month"]</strong> / <strong>@L["pr.until_month"]</strong>: @L["pr.like_2026_11"]</li>
                        <li><strong>@L["pr.loans"]</strong>: @L["pr.fill_total_loans_and_instalments_the_monthly_instalment"]</li>
                    </ul>
                    <div data-pi-import-result hidden>
                        <div class="pr-banner pr-banner--err mt-3">@Html.Icon("x-circle", 18)<div data-pi-import-message></div></div>
                        <div class="hrms-table-wrap mt-2">
                            <table class="hrms-table">
                                <caption class="hrms-sr-only">@L["pr.rows_with_errors"]</caption>
                                <thead><tr><th scope="col" class="text-center">@L["pr.row"]</th><th scope="col">@L["pr.problem"]</th></tr></thead>
                                <tbody data-pi-import-errors></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                    <button type="submit" class="btn btn-primary" data-pi-import-save disabled>@Html.Icon("upload", 15)<span>@L["pr.import"]</span></button>
                </div>
            </form>
        </div>
    </div>
}

<div hidden data-pi-month-names>@for (var m = 1; m <= 12; m++) { <span>@L.Month(m)</span> }</div>
@await Html.PartialAsync("~/Views/Payroll/_Modals.cshtml")

@section PageActions {
    @if (r.CanCreate)
    {
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#pi-import-modal">@Html.Icon("upload", 15)<span>@L["pr.import_excel"]</span></button>
    }
    <button type="button" class="btn btn-outline-secondary" data-pi-export>@Html.Icon("download", 15)<span>@L["common.export"]</span></button>
    @if (r.CanCreate)
    {
        <button type="button" class="btn btn-primary" data-pi-add>@Html.Icon("plus", 15)<span>@L["pc.add_" + pg.Route]</span></button>
    }
}
@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
