@model PayItemFormModel
@{
    var i = Model.Item;
    var mode = Model.Mode;
    var locked = mode == "locked";
    var revise = mode == "revise";
    var cls = Model.ItemClass;
    var start = revise ? Model.DefaultMonth : i?.StartMonth ?? Model.DefaultMonth;
    var applies = i?.AppliesMode ?? (cls == ItemClass.Loan ? AppliesMode.Instalment : cls == ItemClass.Salary ? AppliesMode.Monthly : AppliesMode.Once);
    var amount = i is null ? "" : PayrollFormat.Money(i.Amount);
    // Deductions (db/111 page): the user enters the Total Amount and the period (From / To month); the monthly
    // deductible amount is worked out (total / months) and posted as the Amount. Shown for a deduction only.
    var dedMonths = i is null ? 1
        : i.AppliesMode == AppliesMode.Instalment ? Math.Max(1, i.InstalmentCount ?? 1)
        : i.AppliesMode == AppliesMode.Monthly && i.EndMonth is { } dEnd ? Math.Max(1, (dEnd.Year - i.StartMonth.Year) * 12 + dEnd.Month - i.StartMonth.Month + 1)
        : 1;
    DateTime? dedTo = i is null || i.AppliesMode == AppliesMode.Once ? null
        : i.AppliesMode == AppliesMode.Instalment ? i.StartMonth.AddMonths(dedMonths - 1)
        : i.EndMonth;
    var dedTotal = i is null || (i.AppliesMode == AppliesMode.Monthly && i.EndMonth is null) ? ""
        : PayrollFormat.Money(i.AppliesMode == AppliesMode.Instalment ? i.TotalAmount ?? i.Amount * dedMonths : i.Amount * dedMonths);
    // the To month can reach well past the From list: a deduction may run for years
    var dedFirst = Model.Months.Count > 0 ? Model.Months.Min() : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var dedLast = Model.Months.Count > 0 ? Model.Months.Max() : dedFirst;
    var dedEnd = dedFirst.AddMonths(72) > dedLast ? dedFirst.AddMonths(72) : dedLast;
    string ToMonthOptions(DateTime? selected) => string.Concat(Enumerable.Range(0, (dedEnd.Year - dedFirst.Year) * 12 + dedEnd.Month - dedFirst.Month + 1).Select(dedFirst.AddMonths).Select(m =>
        $"<option value=\"{PayItemFormat.MonthValue(m)}\"{(selected is { } s && s.Year == m.Year && s.Month == m.Month ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(L.MonthYear(m))}</option>"));
    var lockAttr = locked ? "disabled" : null;
    // Salary Revisions (db/111): a new revision or a change of an approved amount is entered as an
    // increment / decrement of the current salary - the item type is the Basic Salary (not asked)
    var revision = Model.FixedClass && cls == ItemClass.Salary && (i is null || revise);
    var revCurrent = revise ? i!.Amount.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) : "";
    var classInfo = new (string Value, string Label, string Hint)[]
    {
        (ItemClass.Salary, L["pr.salary"], L["pr.paid_every_month_basic_and_allowances"]),
        (ItemClass.Earning, L["pr.earning"], L["pr.overtime_bonus_commission"]),
        (ItemClass.Deduction, L["pr.deduction"], L["pr.absence_penalty_recovery"]),
        (ItemClass.Loan, L["pr.loan_advance"], L["pr.paid_back_in_monthly_instalments"])
    };
    // a salary change (revise) can only start after the current amount's month
    string MonthOptions(DateTime? selected, DateTime? after = null) => string.Concat(Model.Months.Where(m => after is not { } a || m > a).Select(m =>
        $"<option value=\"{PayItemFormat.MonthValue(m)}\"{(selected is { } s && s.Year == m.Year && s.Month == m.Month ? " selected" : "")}>{System.Net.WebUtility.HtmlEncode(L.MonthYear(m))}</option>"));
}
<input type="hidden" name="EmployeePayItemId" value="@(i?.EmployeePayItemId ?? 0)" />
<div data-pi-mode="@mode" data-pi-figures-of="@(Model.EmployeeId ?? 0)">

@if (revise)
{
    <div class="pr-banner pr-banner--info mb-3">@Html.Icon("info", 18)<div>@L["pr.a_salary_change_is_saved_as_a_new_amount_from_the_month", PayrollFormat.Money(i!.Amount)]</div></div>
}
else if (locked)
{
    <div class="pr-banner pr-banner--lock mb-3">@Html.Icon("lock", 18)<div>@(i!.IsUsed
        ? L["pr.a_payroll_has_already_paid_this_item_so_its_amount_and_m"]
        : L["pr.an_approved_loan_keeps_its_terms_you_can_change_the_comm"])</div></div>
}
else if (i?.IsPending == true)
{
    <div class="pr-banner pr-banner--lock mb-3">@Html.Icon("clock", 18)<div>@L["pr.waiting_for_approval_saving_a_change_sends_it_for_approv"]</div></div>
}

<div class="row g-3">
    <div class="col-12">
        <label class="form-label" for="pi-employee">@L["pr.employee"] <span class="req" aria-hidden="true">*</span></label>
        @if (i is not null)
        {
            <input type="hidden" name="EmployeeId" value="@i.EmployeeId" />
            <select class="form-select" id="pi-employee" data-pi-employee disabled>
                <option value="@i.EmployeeId" data-company="@i.CompanyId" selected>@PayItemFormat.EmployeeName(L, i.EmployeeName, i.EmployeeArabicName) · @i.EmployeeNo</option>
            </select>
        }
        else
        {
            <select class="form-select" id="pi-employee" name="EmployeeId" data-pi-employee required>
                <option value="">@L["pr.select_an_employee"]</option>
                @foreach (var e in Model.Employees.Where(x => x.IsActive || x.EmployeeId == Model.EmployeeId))
                {
                    <option value="@e.EmployeeId" data-company="@e.CompanyId" selected="@(e.EmployeeId == Model.EmployeeId)">@PayItemFormat.EmployeeName(L, e.EmployeeName, e.EmployeeArabicName) · @e.EmployeeNo</option>
                }
            </select>
        }
    </div>

    @* what the employee has now (loaded when an employee is chosen): salary, allowances, earnings,
       deductions and loans, with the amounts paid and still due - for reference *@
    <div class="col-12" data-pi-ref hidden></div>

    @* the class is the Payroll Components page's (db/111): kept for the form's logic, not shown *@
    <div class="col-12" hidden="@Model.FixedClass">
        <span class="form-label d-block">@L["pr.class"] <span class="req" aria-hidden="true">*</span></span>
        <div class="pr-choice pr-choice--4" data-pi-class-choice role="radiogroup" aria-label="@L["pr.class"]">
            @foreach (var c in classInfo)
            {
                var on = c.Value == cls;
                var off = i is not null && !on;
                <label class="@(on ? "is-selected" : null) @(off ? "is-disabled" : null)">
                    <input type="radio" name="pi-class" value="@c.Value" class="form-check-input" checked="@on" disabled="@(off ? "disabled" : null)" />
                    <span><strong>@c.Label</strong><span>@c.Hint</span></span>
                </label>
            }
        </div>
    </div>

    <div class="col-md-6" hidden="@revision">
        <label class="form-label" for="pi-type">@L["pr.item_type"] <span class="req" aria-hidden="true">*</span></label>
        @if (locked || revise || (i is not null && cls == ItemClass.Salary))
        {
            <input type="hidden" name="PayComponentId" value="@i!.PayComponentId" />
        }
        <select class="form-select" id="pi-type" name="@(locked || revise || (i is not null && cls == ItemClass.Salary) ? null : "PayComponentId")" data-pi-type disabled="@(locked || revise || (i is not null && cls == ItemClass.Salary) ? "disabled" : null)">
            <option value="">@L["pr.select_an_item_type"]</option>
            @foreach (var t in Model.Types.Where(x => x.IsActive || x.PayComponentId == i?.PayComponentId))
            {
                <option value="@t.PayComponentId" data-cls="@t.ItemClass" data-company="@t.CompanyId" data-code="@t.ComponentCode" selected="@(t.PayComponentId == i?.PayComponentId)">@PayItemFormat.TypeName(L, t.ComponentName, t.ArabicName)</option>
            }
        </select>
        <span class="form-text" data-pi-type-hint hidden>@L["pi.select_employee_first"]</span>
    </div>

    @* Applies sits beside the Item type; the period (From / To) and the amounts follow *@
    <div class="col-md-6" data-show-for="EARNING DEDUCTION">
        <label class="form-label" for="pi-applies">@L["pr.applies"] <span class="req" aria-hidden="true">*</span></label>
        @if (locked)
        {
            <input type="hidden" name="AppliesMode" value="@applies" />
        }
        <select class="form-select" id="pi-applies" data-pi-applies disabled="@lockAttr">
            <option value="ONCE" selected="@(applies == AppliesMode.Once)">@L["pr.one_time"]</option>
            <option value="MONTHLY" selected="@(applies == AppliesMode.Monthly)">@L["pr.every_month"]</option>
            <option value="INSTALMENT" selected="@(applies == AppliesMode.Instalment)" data-cls-only="DEDUCTION">@L["pr.in_instalments"]</option>
        </select>
    </div>
    @* amount: salary, earnings, deductions (a loan's instalment is calculated) *@
    @if (revision)
    {
        @* the revision: increment / decrement of the current salary, the new amount worked out (posted as Amount) *@
        <div class="col-12" data-pi-rev data-current="@revCurrent" data-new="@(i is null ? "1" : null)">
            <div class="pc-revform">
                <div class="pc-revform__kind" role="radiogroup" aria-label="@L["pc.revision_type"]">
                    <input type="radio" class="btn-check" name="pi-rev-kind" id="pi-rev-up" value="UP" checked />
                    <label class="pc-revform__opt is-up" for="pi-rev-up">@Html.Icon("trend", 16)<span><strong>@L["pc.increment"]</strong><small>@L["pc.increment_hint"]</small></span></label>
                    <input type="radio" class="btn-check" name="pi-rev-kind" id="pi-rev-down" value="DOWN" />
                    <label class="pc-revform__opt is-down" for="pi-rev-down">@Html.Icon("trend", 16, "is-flip")<span><strong>@L["pc.decrement"]</strong><small>@L["pc.decrement_hint"]</small></span></label>
                </div>

                <div class="pc-revform__fields">
                    <div>
                        <div class="pc-revform__head">
                            <label class="form-label mb-0" for="pi-rev-change"><span data-pi-rev-change-label data-up="@L["pc.increment_by"]" data-down="@L["pc.decrement_by"]">@L["pc.increment_by"]</span> <span class="req" aria-hidden="true">*</span></label>
                            @* the change as an amount (default) or a percentage of the current salary *@
                            <div class="pc-revform__unit" role="radiogroup" aria-label="@L["pc.revise_by"]">
                                <input type="radio" class="btn-check" name="pi-rev-unit" id="pi-rev-kwd" value="KWD" checked />
                                <label for="pi-rev-kwd">@L["pc.unit_amount"]</label>
                                <input type="radio" class="btn-check" name="pi-rev-unit" id="pi-rev-pct" value="PCT" />
                                <label for="pi-rev-pct">%</label>
                            </div>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text pc-revform__sign" data-pi-rev-sign>+</span>
                            <input class="form-control pr-input-money" id="pi-rev-change" inputmode="decimal" placeholder="0.000" autocomplete="off" data-pi-rev-change />
                            <span class="input-group-text pc-revform__suffix" data-pi-rev-suffix>@L["pr.kwd"]</span>
                        </div>
                        <div class="pc-revform__error" data-pi-rev-error hidden>@L["pc.decrement_too_big"]</div>
                    </div>
                    <span class="pc-revform__arrow" aria-hidden="true">@Html.Icon("chevron-right", 18)</span>
                    <div>
                        <label class="form-label" for="pi-rev-new">@L["pc.new_revised_salary"]</label>
                        <input class="form-control pr-input-money pc-revform__new" id="pi-rev-new" disabled placeholder="—" data-pi-rev-new />
                        <span class="pc-revform__delta" data-pi-rev-delta></span>
                    </div>
                </div>
                <input type="hidden" name="Amount" data-pi-rev-amount />
            </div>
        </div>
    }
    @if (!revision)
    {
    <div class="col-md-6" data-show-for="SALARY EARNING">
        <label class="form-label" for="pi-amount"><span data-pi-amount-label>@(revise ? L["pr.new_amount_kwd"] : L["pr.amount_kwd"])</span> <span class="req" aria-hidden="true">*</span></label>
        @if (locked)
        {
            <input type="hidden" name="Amount" value="@i!.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        }
        <input class="form-control pr-input-money" id="pi-amount" name="@(locked ? null : "Amount")" inputmode="decimal" placeholder="0.000" value="@amount" autocomplete="off" disabled="@lockAttr" data-pi-amount
               data-label-instalment="@L["pr.amount_per_instalment_kwd"]" data-label-default="@(revise ? L["pr.new_amount_kwd"] : L["pr.amount_kwd"])" />
    </div>
    }

    @* the item type picked: what the employee has of it now (or had before) *@
    <div class="col-12" data-pi-ref-focus hidden data-off="@(revision ? "1" : null)">
        <div class="pi-ref-focus">
            @Html.Icon("info", 16)
            <div>
                <strong data-pi-ref-focus-title></strong>
                <ul class="pi-ref-focus__list" data-pi-ref-focus-list></ul>
            </div>
        </div>
    </div>

    @* salary: every month from - a change to an approved salary keeps the current amount
       (and its own Effective from) and starts a new amount from a later month *@
    @if (revise && !revision)
    {
        <div class="col-md-6" data-show-for="SALARY">
            <span class="form-label d-block">@L["pr.current_amount"]</span>
            <div class="pr-pi-current">
                <span class="pr-pi-current__amount pr-money">@PayrollFormat.Money(i!.Amount)</span>
                <span class="pr-pi-current__since">@L["pr.effective_from"] <strong>@PayItemFormat.Month(L, i.StartMonth)</strong></span>
            </div>
        </div>
    }
    <div class="col-md-6" data-show-for="SALARY">
        <label class="form-label" for="pi-from-salary">@(revise ? L["pr.new_amount_from"] : L["pr.effective_from"]) <span class="req" aria-hidden="true">*</span></label>
        <select class="form-select" id="pi-from-salary" data-pi-start="SALARY" disabled="@lockAttr">@Html.Raw(MonthOptions(start, revise ? i!.StartMonth : null))</select>
        @if (revise)
        {
            <div class="form-text">@L["pr.new_amount_from_hint", PayItemFormat.Month(L, i!.StartMonth)]</div>
        }
    </div>
    <div class="col-12" data-show-for="SALARY">
        @if (!revise)
        {
            <div class="pr-banner pr-banner--info">@Html.Icon("info", 18)<div>@L["pr.salary_items_are_paid_every_month_from_this_month_after"]</div></div>
        }
    </div>

    @* earnings and deductions *@
    <div class="col-md-6" data-show-for="EARNING DEDUCTION">
        <label class="form-label" for="pi-from"><span data-pi-from-label data-once="@L["pr.month"]" data-many="@L["pr.from_month"]">@L["pr.month"]</span> <span class="req" aria-hidden="true">*</span></label>
        <select class="form-select" id="pi-from" data-pi-start="EARNING DEDUCTION" disabled="@lockAttr">@Html.Raw(MonthOptions(start))</select>
    </div>
    <div class="col-md-6" data-show-for="EARNING" data-show-applies="MONTHLY">
        <label class="form-label" for="pi-until">@L["pr.until_month"]</label>
        <select class="form-select" id="pi-until" name="EndMonth" data-pi-until>
            <option value="">@L["pr.no_end_every_month"]</option>
            @Html.Raw(MonthOptions(i?.EndMonth))
        </select>
    </div>
    @* a deduction: To month (the period, with From month above), then the Total Amount and the Monthly Deductible
       amount worked out from them. The number of instalments is the months from From to To. *@
    <div class="col-md-6" data-show-for="DEDUCTION" data-show-applies="MONTHLY INSTALMENT">
        <label class="form-label" for="pi-to-ded">@L["pr.to_month"] <span class="req" aria-hidden="true" data-pi-to-req>*</span></label>
        <select class="form-select" id="pi-to-ded" name="EndMonth" data-pi-dto disabled="@lockAttr">
            <option value="" data-open-ended>@L["pr.no_end_every_month"]</option>
            @Html.Raw(ToMonthOptions(dedTo))
        </select>
        <span class="form-text" data-pi-dto-hint></span>
    </div>
    <input type="hidden" id="pi-count-ded" data-pi-count="DEDUCTION" value="@(i?.InstalmentCount ?? dedMonths)" />
    <div class="col-md-6" data-show-for="DEDUCTION">
        <label class="form-label" for="pi-ded-total">@L["pr.total_deduction_kwd"] <span class="req" aria-hidden="true">*</span></label>
        <input class="form-control pr-input-money" id="pi-ded-total" inputmode="decimal" placeholder="0.000" autocomplete="off"
               value="@dedTotal" disabled="@lockAttr" data-pi-dtotal />
    </div>
    <div class="col-md-6" data-show-for="DEDUCTION">
        <label class="form-label" for="pi-ded-monthly"><span data-pi-dmonthly-label data-auto="@L["pr.monthly_deductible_kwd"]" data-manual="@L["pr.monthly_deduction_kwd"]">@L["pr.monthly_deductible_kwd"]</span></label>
        <input class="form-control pr-input-money" id="pi-ded-monthly" inputmode="decimal" placeholder="—" autocomplete="off"
               value="@(i is null ? "" : PayrollFormat.Money(i.Amount))" readonly disabled="@lockAttr" data-pi-dmonthly />
        <span class="form-text" data-pi-dmonthly-hint></span>
    </div>

    @* loans and advances *@
    <div class="col-md-4" data-show-for="LOAN">
        <label class="form-label" for="pi-total">@L["pr.total_amount_kwd"] <span class="req" aria-hidden="true">*</span></label>
        <input class="form-control pr-input-money" id="pi-total" name="@(locked ? null : "TotalAmount")" inputmode="decimal" placeholder="0.000" autocomplete="off"
               value="@(i?.TotalAmount is { } tot ? PayrollFormat.Money(tot) : "")" disabled="@lockAttr" data-pi-total />
        @if (locked)
        {
            <input type="hidden" name="TotalAmount" value="@i!.TotalAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        }
    </div>
    <div class="col-md-4" data-show-for="LOAN">
        <label class="form-label" for="pi-count-loan">@L["pr.instalments"] <span class="req" aria-hidden="true">*</span></label>
        <input class="form-control" type="number" min="1" max="600" id="pi-count-loan" data-pi-count="LOAN" value="@(i?.InstalmentCount ?? 12)" disabled="@lockAttr" />
    </div>
    <div class="col-md-4" data-show-for="LOAN">
        <label class="form-label" for="pi-from-loan">@L["pr.first_deduction"] <span class="req" aria-hidden="true">*</span></label>
        <select class="form-select" id="pi-from-loan" data-pi-start="LOAN" disabled="@lockAttr">@Html.Raw(MonthOptions(i is null ? Model.DefaultMonth.AddMonths(1) : start))</select>
    </div>
    <div class="col-12" data-show-for="LOAN">
        <ul class="pr-check" data-pi-loan-checks>
            <li><span class="pr-check__icon is-ok">@Html.Icon("check", 14)</span><span class="pr-check__text">@L["pr.monthly_instalment"]</span><span class="pr-check__meta"><strong>@L["pr.kwd"] <span data-pi-loan-monthly>—</span></strong></span></li>
            <li data-pi-check="cap"><span class="pr-check__icon is-ok">@Html.Icon("check", 14)</span><span class="pr-check__text">@L["pc.loan_within_basic"]</span><span class="pr-check__meta" data-pi-check-meta></span></li>
            <li data-pi-check="share"><span class="pr-check__icon is-ok">@Html.Icon("check", 14)</span><span class="pr-check__text">@L["pc.loan_share_basic"]</span><span class="pr-check__meta" data-pi-check-meta></span></li>
        </ul>
        <span class="form-text">@L["pr.these_checks_are_a_guide_the_approvers_decide"]</span>
    </div>

    @* the fields actually posted for the class / applies chosen (filled by payroll.js) *@
    <input type="hidden" name="@(locked ? null : "AppliesMode")" data-pi-out="applies" value="@applies" />
    <input type="hidden" name="@(locked ? null : "StartMonth")" data-pi-out="start" value="@PayItemFormat.MonthValue(start)" />
    <input type="hidden" name="@(locked ? null : "InstalmentCount")" data-pi-out="count" value="@i?.InstalmentCount" />
    @if (locked)
    {
        <input type="hidden" name="StartMonth" value="@PayItemFormat.MonthValue(i!.StartMonth)" />
        <input type="hidden" name="InstalmentCount" value="@i.InstalmentCount" />
    }

    <div class="col-12">
        <label class="form-label" for="pi-comment">@L["pr.comment"] <span class="req" aria-hidden="true">*</span></label>
        <textarea class="form-control" id="pi-comment" name="Comment" rows="2" maxlength="500" required
                  placeholder="@L["pr.why_is_it_paid_or_deducted_it_is_shown_on_the_payroll_an"]">@(revise ? "" : i?.Comment)</textarea>
    </div>
</div>
</div>
