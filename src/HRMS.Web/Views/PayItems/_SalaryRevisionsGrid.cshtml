@using HRMS.Web.Models.Organization
@model PayItemsGridModel
@{
    // Salary Revisions (db/111): one row per salary amount - the contract amount (default) and each
    // revision - as Emp No, Employee, Basic (the amount from that month), Increment / Decrement
    // against the amount it replaces, Effective from, Comment, Status and the actions.
    var pg = Model.Page;
    var r = Model.Rights;
}
<div data-total="@pg.TotalCount" data-count-text="@(pg.TotalCount == 1 ? L["pr.1_item"] : L["pr.0_items", PayrollFormat.Count(pg.TotalCount)])">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "trend", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["pr.no_pay_items_match_the_filters"] : L["pc.no_revisions_yet"])</p>
        <p class="hrms-empty__text">@L["pc.no_revisions_text"]</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table pr-pi-table pc-rev-table">
            <caption class="hrms-sr-only">@L["pc.salary"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["pc.col_emp_no"]</th>
                    <th scope="col">@L["pc.col_employee"]</th>
                    <th scope="col" class="pr-money">@L["pc.col_basic"]</th>
                    <th scope="col" class="pr-money">@L["pc.increment"]</th>
                    <th scope="col" class="pr-money">@L["pc.decrement"]</th>
                    <th scope="col">@L["pr.effective_from"]</th>
                    <th scope="col" class="col-p3">@L["pr.comment"]</th>
                    <th scope="col">@L["common.status"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in pg.Items)
                {
                    var emp = PayItemFormat.EmployeeName(L, i.EmployeeName, i.EmployeeArabicName);
                    var type = PayItemFormat.TypeName(L, i.ComponentName, i.ComponentArabicName);
                    var isBasic = string.Equals(i.ComponentCode, "BASIC", StringComparison.OrdinalIgnoreCase);
                    decimal? diff = i.ReplacedAmount is { } before ? i.Amount - before : null;
                    var contract = i.SourceRef == "CONTRACT";
                    <tr data-id="@i.EmployeePayItemId" data-name="@type · @emp" data-mode="@i.AppliesMode" data-start="@PayItemFormat.MonthValue(i.StartMonth)"
                        class="@(i.IsEnded ? "is-ended" : null)">
                        <td data-label="@L["pc.col_emp_no"]" class="font-monospace pc-rev-table__no">@i.EmployeeNo</td>
                        <td data-label="@L["pc.col_employee"]" class="pr-pi-cell-emp">
                            <span class="hrms-table__primary">@emp</span>
                            @if (Model.ManyCompanies && i.CompanyName is not null)
                            {
                                <span class="pr-emp-sub">@i.CompanyName</span>
                            }
                        </td>
                        <td data-label="@L["pc.col_basic"]" class="pr-money">
                            @PayrollFormat.Money(i.Amount)
                            @if (!isBasic)
                            {
                                <span class="pr-per">@type</span>
                            }
                            @if (contract)
                            {
                                <span class="pc-contract">@L["pc.contract_default"]</span>
                            }
                        </td>
                        <td data-label="@L["pc.increment"]" class="pr-money pc-rev-table__up">
                            @if (diff is { } up && up > 0)
                            {
                                <span>+@PayrollFormat.Money(up)</span>
                                <span class="pr-per">+@((up / i.ReplacedAmount!.Value * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%</span>
                            }
                            else { <span class="hrms-muted">—</span> }
                        </td>
                        <td data-label="@L["pc.decrement"]" class="pr-money pc-rev-table__down">
                            @if (diff is { } dn && dn < 0)
                            {
                                <span>−@PayrollFormat.Money(-dn)</span>
                                <span class="pr-per">−@((-dn / i.ReplacedAmount!.Value * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%</span>
                            }
                            else { <span class="hrms-muted">—</span> }
                        </td>
                        <td data-label="@L["pr.effective_from"]">
                            <span class="pr-pi-from">@PayItemFormat.Month(L, i.StartMonth)</span>
                            @if (i.EndMonth is { } until)
                            {
                                <span class="pr-pi-until">→ @PayItemFormat.Month(L, until)</span>
                            }
                        </td>
                        <td data-label="@L["pr.comment"]" class="pr-line-comment col-p3">@(string.IsNullOrWhiteSpace(i.Comment) ? "—" : i.Comment)</td>
                        <td data-label="@L["common.status"]" class="pr-pi-cell-status">
                            <span class="hrms-badge hrms-badge--@PayItemFormat.StatusBadge(i)"><span class="hrms-badge__dot"></span>@PayItemFormat.StatusLabel(L, i)</span>
                            @if (i.IsPending)
                            {
                                <span class="pr-pi-level">@(i.ApprovalLevel == 0 ? L["pr.waiting_for_hr"] : L["pr.hr_approved_waiting_for_finance"])</span>
                            }
                        </td>
                        <td class="hrms-table__actions">
                            @if (Model.WithSalaryHistory?.Contains(i.EmployeeId) == true)
                            {
                                <button type="button" class="btn-icon" data-pi-salary-history="@i.EmployeeId" title="@L["pc.salary_history"]" aria-label="@L["pc.salary_history_of_0", emp]">@Html.Icon("history", 15)</button>
                            }
                            @if (i.IsPending && r.CanApprove(i))
                            {
                                <button type="button" class="btn-icon btn-icon--success" data-pi-approve title="@L["pr.approve"]" aria-label="@L["pr.approve_0", type]" disabled="@(r.IsOwnSubmission(i) ? "disabled" : null)">@Html.Icon("check", 15)</button>
                            }
                            @if (i.IsPending && r.IsApprover)
                            {
                                <button type="button" class="btn-icon btn-icon--danger" title="@L["pr.reject"]" aria-label="@L["pr.reject_0", type]"
                                        data-reason-open data-reason-url="@Url.Action("Reject", "PayItems", new { id = i.EmployeePayItemId })"
                                        data-reason-title="@L["pr.reject_pay_item"]" data-reason-text="@L["pr.the_item_is_removed_and_is_not_paid_enter_the_reason_it"]"
                                        data-reason-label="@L["pr.reason"]" data-reason-button="@L["pr.reject"]" data-reason-danger="true" data-reason-refresh="payitems">@Html.Icon("x-circle", 15)</button>
                            }
                            @if (!i.IsEnded && r.CanEdit && !(i.Status == PayItemStatus.Active && i.EndMonth is not null))
                            {
                                <button type="button" class="btn-icon" data-pi-edit title="@(i.Status == PayItemStatus.Active ? L["pc.revise"] : L["common.edit"])" aria-label="@L["common.edit_named", type]">@Html.Icon("edit", 15)</button>
                            }
                            @{
                                var canEnd = !i.IsEnded && !i.IsPending && r.CanEdit && !contract;
                                var canDelete = !i.IsUsed && !i.IsEnded && r.CanDelete && !contract;
                            }
                            <div class="dropdown d-inline-block">
                                <button type="button" class="btn-icon" data-bs-toggle="dropdown" aria-expanded="false" data-bs-popper-config='{"strategy":"fixed"}'
                                        title="@L["pr.more"]" aria-label="@L["pr.more_actions_for_0", type]">@Html.Icon("more", 15)</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button type="button" class="dropdown-item" data-pi-history>@Html.Icon("history", 15)<span>@L["pr.history"]</span></button></li>
                                    @if (canEnd)
                                    {
                                        <li><button type="button" class="dropdown-item" data-pi-end>@Html.Icon("power", 15)<span>@L["pr.end_item"]</span></button></li>
                                    }
                                    @if (canDelete)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><button type="button" class="dropdown-item text-danger" data-pi-delete>@Html.Icon("trash", 15)<span>@L["common.delete"]</span></button></li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount,
        FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage,
        PageSize = Model.PageSize, PageSizes = Model.PageSizes
    })
}
</div>
