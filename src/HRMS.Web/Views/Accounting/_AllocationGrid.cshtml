@using HRMS.Web.Models.Organization
@model SettingsGridModel<CostAllocation>
@{
    var pg = Model.Page;
    var countText = pg.TotalCount == 1 ? L["fin.1_split"] : L["fin.0_splits", PayrollFormat.Count(pg.TotalCount)];
}
<div data-total="@pg.TotalCount" data-count-text="@countText">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "layers", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["fin.no_splits"])</p>
        <p class="hrms-empty__text">@L["fin.no_splits_text"]</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table st-table">
            <caption class="hrms-sr-only">@L["prv.cost_center_split"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["pr.employee"]</th>
                    <th scope="col">@L["prv.split"]</th>
                    <th scope="col" class="col-p2">@L["prv.from"]</th>
                    <th scope="col" class="col-p2">@L["prv.to"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in pg.Items)
                {
                    var name = a.EmployeeNo + " · " + a.EmployeeName;
                    <tr data-id="@a.CostAllocationId" data-name="@name">
                        <td data-label="@L["pr.employee"]">
                            <span class="hrms-table__primary">@a.EmployeeName</span>
                            @if (a.IsCurrent)
                            {
                                <span class="st-inforce">@L["fin.in_force"]</span>
                            }
                            <span class="pr-emp-sub"><span class="hrms-code-chip">@a.EmployeeNo</span>@(Model.ManyCompanies ? " · " + a.CompanyName : "")</span>
                        </td>
                        <td data-label="@L["prv.split"]">
                            <ul class="fin-split">
                                @foreach (var part in (a.Split ?? "").Split(" · ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li>@part</li>
                                }
                            </ul>
                            @if (a.Notes is not null)
                            {
                                <span class="pr-emp-sub">@a.Notes</span>
                            }
                        </td>
                        <td data-label="@L["prv.from"]" class="col-p2">@L.Date(a.EffectiveFrom)</td>
                        <td data-label="@L["prv.to"]" class="col-p2">@L.Date(a.EffectiveTo)</td>
                        <td class="hrms-table__actions">
                            @if (Model.Rights.CanEdit)
                            {
                                <button type="button" class="btn-icon" data-st-edit title="@L["common.edit"]" aria-label="@L["common.edit_named", name]">@Html.Icon("edit", 15)</button>
                            }
                            @if (Model.Rights.CanDelete)
                            {
                                <button type="button" class="btn-icon btn-icon--danger" data-st-delete title="@L["common.delete"]" aria-label="@L["common.delete_named", name]">@Html.Icon("trash", 15)</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount, FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
