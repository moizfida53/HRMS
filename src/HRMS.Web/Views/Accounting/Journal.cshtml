@model JournalPageModel
@{
    // Payroll > Accounting > Payroll Journal (db/49-50): the closed payrolls of the period with
    // their journal; View opens the journal (or its preview) in a popup.
    ViewData["Title"] = "Payroll Journal";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "accounting";
    ViewData["PayrollPage"] = "ac-journal";
    ViewData["Subtitle"] = L["fin.journal_subtitle"];
    var act = Model.Rights.CanAct;
}
<div class="pr-stack fin-page" data-fin-page>
    <section class="hrms-card">
        @await Html.PartialAsync("~/Views/PayrollFinance/_Filters.cshtml", Model.Filters)
        @if (Model.Runs.Count == 0)
        {
            <div class="hrms-empty">
                <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "book", 26)</span>
                <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["fin.no_closed_payrolls"])</p>
                <p class="hrms-empty__text">@L["fin.no_closed_payrolls_text"]</p>
            </div>
        }
        else
        {
            <div class="hrms-table-wrap">
                <table class="hrms-table fin-table">
                    <caption class="hrms-sr-only">@L["fin.journals"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["fin.payroll"]</th>
                            <th scope="col" class="text-end col-p2">@L["prv.gross_kwd"]</th>
                            <th scope="col" class="text-end col-p3">@L["pr.deductions"]</th>
                            <th scope="col" class="text-end">@L["pr.net_kwd"]</th>
                            <th scope="col">@L["prv.journal"]</th>
                            <th scope="col">@L["common.status"]</th>
                            <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Runs)
                        {
                            var viewUrl = r.JournalId is { } jid
                                ? Url.Action("JournalView", "Accounting", new { id = jid })
                                : Url.Action("JournalView", "Accounting", new { run = r.PayrollRunId });
                            <tr>
                                <td data-label="@L["fin.payroll"]">
                                    <span class="hrms-code-chip">@r.RunCode</span>
                                    <span class="pr-emp-sub">@L.MonthYear(r.RunMonth)@(r.RunType == "OFFCYCLE" ? " · " + L["fin.off_cycle"] : "")@(Model.ManyCompanies ? " · " + r.CompanyName : "") · @L["fin.n_employees", r.EmployeeCount]</span>
                                </td>
                                <td data-label="@L["prv.gross_kwd"]" class="text-end pr-money col-p2">@PayrollFormat.Money(r.TotalGross)</td>
                                <td data-label="@L["pr.deductions"]" class="text-end pr-money col-p3">@PayrollFormat.Money(r.TotalDeductions)</td>
                                <td data-label="@L["pr.net_kwd"]" class="text-end pr-money fw-semibold">@PayrollFormat.Money(r.TotalNet)</td>
                                <td data-label="@L["prv.journal"]">
                                    @if (r.JournalNo is not null)
                                    {
                                        <span class="hrms-code-chip">@r.JournalNo</span>
                                    }
                                    else
                                    {
                                        <span class="hrms-muted">—</span>
                                    }
                                </td>
                                <td data-label="@L["common.status"]">
                                    @if (r.JournalStatus is not null)
                                    {
                                        <span class="hrms-badge hrms-badge--@FinanceFormat.JournalStatusBadge(r.JournalStatus)"><span class="hrms-badge__dot"></span>@L[FinanceFormat.JournalStatusKey(r.JournalStatus)]</span>
                                    }
                                    else
                                    {
                                        <span class="hrms-badge hrms-badge--warning"><span class="hrms-badge__dot"></span>@L["fin.not_created"]</span>
                                    }
                                </td>
                                <td class="hrms-table__actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary fin-view-btn" data-fin-view="@viewUrl"
                                            aria-label="@L["fin.view_journal"] · @r.RunCode">@Html.Icon("eye", 14)<span>@L["fin.view"]</span></button>
                                    @if (r.JournalId is { } id)
                                    {
                                        <a class="btn-icon" href="@Url.Action("Export", "Accounting", new { id })" title="@L["prv.export_excel"]" aria-label="@L["prv.export_excel"]">@Html.Icon("download", 15)</a>
                                    }
                                    else if (act)
                                    {
                                        <button type="button" class="btn-icon btn-icon--success" title="@L["fin.create_journal"]" aria-label="@L["fin.create_journal"] · @r.RunCode"
                                                data-fin-action="@Url.Action("CreateJournal", "Accounting")" data-fin-extra='{"run":"@r.PayrollRunId"}'
                                                data-fin-title="@L["fin.create_journal"] · @r.RunCode" data-fin-text="@L["fin.create_journal_text"]" data-fin-ok="@L["fin.create_journal"]">@Html.Icon("plus", 15)</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
@await Html.PartialAsync("~/Views/PayrollFinance/_ViewModal.cshtml")
@await Html.PartialAsync("~/Views/PayrollFinance/_Dialog.cshtml")

@section Scripts {
    <script src="~/js/payroll-finance.js" asp-append-version="true"></script>
}
