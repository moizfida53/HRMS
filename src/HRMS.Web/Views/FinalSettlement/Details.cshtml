@model SettlementPageModel
@{
    var s = Model.Settlement;
    var r = Model.Rights;
    var edit = Model.Editable;
    var name = SettlementFormat.Name(L, s.EmployeeName, s.EmployeeArabicName);
    var sub = string.Join(" · ", new[] { s.EmployeeNo, SettlementFormat.Name(L, s.DepartmentName, s.DepartmentArabicName),
                                        SettlementFormat.Name(L, s.DesignationName, s.DesignationArabicName) }.Where(x => !string.IsNullOrWhiteSpace(x)));
    ViewData["Title"] = s.IsExit ? "Final Settlement" : "Leave Encashment";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "settlement";
    ViewData["Subtitle"] = s.SettlementNo + " · " + name;

    var step = s.Status switch
    {
        SettlementStatus.Draft => 1,
        SettlementStatus.Pending => 2,
        SettlementStatus.Approved => 3,
        SettlementStatus.Paid => 4,
        _ => 1
    };
    var canApprove = s.IsPending && r.CanApprove(s.ApprovalLevel);
    var ownSubmission = r.IsOwnSubmission(s.SubmittedBy);
    var salary = Model.Section(SettlementSection.Salary).ToList();
    var earnings = Model.Section(SettlementSection.Earning).ToList();
    var leave = Model.Section(SettlementSection.Leave).ToList();
    var slabs = Model.Section(SettlementSection.Indemnity).ToList();
    var recoveries = Model.Section(SettlementSection.Recovery).ToList();
    var lastReturn = Model.History.FirstOrDefault(h => h.ActionCode is "RETURNED");
    var returnedNow = s.IsDraft && lastReturn is not null && !Model.History.TakeWhile(h => h != lastReturn).Any(h => h.ActionCode == "SUBMITTED");
    var n = 0;
    string Money(decimal v) => PayrollFormat.Money(v);
    var statusLine = s.Status switch
    {
        SettlementStatus.Draft => L["fs.hero_draft"],
        SettlementStatus.Pending => s.ApprovalLevel == 0 ? L["fs.status_pending_hr"] : L["fs.status_pending_finance"],
        SettlementStatus.Approved => s.IsExit ? L["fs.hero_to_pay"] : L["fs.in_payroll_of", s.PayMonth is { } hm ? L.MonthYear(hm) : ""],
        SettlementStatus.Paid => L["fs.st_paid_on", L.Date(s.PaidDate), s.PaymentRef ?? SettlementFormat.MethodLabel(L, s.PaymentMethod)],
        _ => L["fs.status_cancelled"]
    };
}
@await Html.PartialAsync("~/Views/Payroll/_Tabs.cshtml", "fs-detail")

<div class="fs-page d-flex flex-column gap-3" data-fs-page="details" data-id="@s.FinalSettlementId"
     data-urls-base="@Url.Action("Details", "FinalSettlement", new { id = s.FinalSettlementId })"
     data-urls-save="@Url.Action("Save", "FinalSettlement")"
     data-urls-details="@Url.Action("Details", "FinalSettlement", new { id = 0 })"
     data-urls-list="@Url.Action("Index", "FinalSettlement")">

    @await Html.PartialAsync("_Steps", s.IsCancelled ? 0 : step)

    @* ================= employee and the result ================= *@
    <section class="card fs-hero">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3">
                <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                    <span class="fs-hero__avatar flex-shrink-0" aria-hidden="true">@SettlementFormat.Initials(s.EmployeeName)</span>
                    <div class="min-w-0">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h2 class="fs-hero__name mb-0">@name</h2>
                            <span class="hrms-badge hrms-badge--@(s.IsExit ? "purple" : "info")"><span class="hrms-badge__dot"></span>@L[SettlementFormat.TypeKey(s.SettlementType)]</span>
                            <span class="hrms-badge hrms-badge--@SettlementFormat.StatusBadge(s.Status)"><span class="hrms-badge__dot"></span>@SettlementFormat.StatusLabel(L, s.Status, s.ApprovalLevel)</span>
                        </div>
                        <div class="fs-hero__sub">
                            <span class="hrms-code-chip">@s.SettlementNo</span>
                            <span>@sub</span>
                        </div>
                    </div>
                </div>
                <div class="fs-hero__net@(s.NetPayable < 0 ? " is-negative" : "")">
                    <span class="fs-hero__net-label">@L["fs.net_payable"]</span>
                    <strong class="fs-hero__net-value">@L["pr.kwd"] @Money(s.NetPayable)</strong>
                    <span class="fs-hero__net-note">@statusLine</span>
                </div>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-xxl-@(s.IsExit && s.NoticeDate is not null ? "5" : "4") g-2 mt-3">
                <div class="col"><div class="fs-fact"><span class="fs-fact__label">@L["fs.joined"]</span><span class="fs-fact__value">@L.Date(s.HireDate)</span></div></div>
                <div class="col"><div class="fs-fact"><span class="fs-fact__label">@(s.IsExit ? L["fs.last_working_day"] : L["fs.balance_on"])</span><span class="fs-fact__value">@L.Date(s.LastWorkingDay)</span></div></div>
                <div class="col"><div class="fs-fact"><span class="fs-fact__label">@L["fs.service"]</span><span class="fs-fact__value">@SettlementFormat.Service(L, s.HireDate, s.LastWorkingDay)</span></div></div>
                <div class="col"><div class="fs-fact"><span class="fs-fact__label">@L["fs.monthly_salary"]</span><span class="fs-fact__value">@L["pr.kwd"] @Money(s.MonthlySalary)</span></div></div>
                @if (s.IsExit && s.NoticeDate is { } nd)
                {
                    <div class="col"><div class="fs-fact"><span class="fs-fact__label">@L["fs.notice_date"]</span><span class="fs-fact__value">@L.Date(nd)</span>@if (s.NoticePeriodDays is { } np) {<span class="fs-fact__note">@L["fs.notice_period_n", np]</span>}</div></div>
                }
                @if (!s.IsExit && s.PayMonth is { } pm)
                {
                    <div class="col"><div class="fs-fact"><span class="fs-fact__label">@L["fs.paid_in_payroll_of"]</span><span class="fs-fact__value">@L.MonthYear(pm)</span></div></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(s.Reason))
            {
                <p class="fs-hero__reason mb-0 mt-3">@Html.Icon("info", 14)<span><strong>@L["fs.reason"]:</strong> @s.Reason</span></p>
            }
        </div>
    </section>

    @* ================= banners ================= *@
    @if (s.IsCancelled)
    {
        <div class="pr-banner pr-banner--err">@Html.Icon("x-circle", 18)<div><strong>@L["fs.cancelled_banner"]</strong> @s.CancelReason</div></div>
    }
    @if (returnedNow && lastReturn is not null)
    {
        <div class="pr-banner pr-banner--lock">@Html.Icon("undo", 18)<div><strong>@L["fs.returned_banner", lastReturn.ActionByName ?? ""]</strong> @lastReturn.Comment</div></div>
    }
    @if (s.IsExit && !s.RuleSetVerified && !s.IsCancelled && !s.IsPaid && s.IndemnityRuleSetId is not null)
    {
        <div class="pr-banner pr-banner--lock">@Html.Icon("alert", 18)<div>@L["fs.rule_set_unverified", s.RuleSetCode ?? ""]</div></div>
    }
    @if (s.IsExit && s.IndemnityRuleSetId is null && !s.IsCancelled)
    {
        <div class="pr-banner pr-banner--err">@Html.Icon("alert", 18)<div>@L["fs.no_rule_set"]</div></div>
    }
    @if (s.SalaryFromProfile)
    {
        <div class="pr-banner pr-banner--info">@Html.Icon("info", 18)<div>@L["fs.salary_from_profile"]</div></div>
    }
    @if (s.NetPayable < 0)
    {
        <div class="pr-banner pr-banner--lock">@Html.Icon("alert", 18)<div>@L["fs.net_negative", Money(-s.NetPayable)]</div></div>
    }

    <div class="row g-3 align-items-start">
        @* ================= the calculation ================= *@
        <div class="col-12 col-xl-8 d-flex flex-column gap-3">

            @if (Model.Form is not null)
            {
                <section class="card fs-section fs-section--edit">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__icon" aria-hidden="true">@Html.Icon("sliders", 16)</span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="fs-section__title">@L["fs.settlement_details"]</h3>
                            <p class="fs-section__hint">@L["fs.settlement_details_hint"]</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 flex-shrink-0" data-fs-edit-toggle
                                data-bs-toggle="collapse" data-bs-target="#fs-edit-body" aria-expanded="false" aria-controls="fs-edit-body">
                            @Html.Icon("edit", 14)<span>@L["fs.change_details"]</span>
                        </button>
                    </header>
                    <div class="collapse" id="fs-edit-body">
                        <div class="card-body">
                            @await Html.PartialAsync("_Form", Model.Form)
                        </div>
                    </div>
                </section>
            }

            @if (s.IsExit)
            {
                @* ---- pending salary ---- *@
                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__num">@(++n)</span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="fs-section__title">@L["fs.pending_salary"]</h3>
                            <p class="fs-section__hint">
                                @if (s.SalaryFrom is { } from && from <= s.LastWorkingDay)
                                {
                                    @L["fs.unpaid_from_to", L.Date(from), L.Date(s.LastWorkingDay)]
                                }
                                else
                                {
                                    @L["fs.no_pending_salary"]
                                }
                            </p>
                        </div>
                        <span class="fs-section__total">@Money(s.PendingSalaryAmount)</span>
                    </header>
                    @if (salary.Count > 0)
                    {
                        <ul class="fs-rows">
                            @foreach (var l in salary)
                            {
                                <li class="fs-row">
                                    <div class="fs-row__text"><span class="fs-row__title">@SettlementFormat.Title(L, l)</span><span class="fs-row__sub">@SettlementFormat.Detail(L, l, s.DailyDivisor)</span></div>
                                    <span class="fs-row__amt">@Money(l.Amount)</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="fs-empty">@Html.Icon("check", 16)<span>@L["fs.no_pending_salary"]</span></div>
                    }
                    @if (s.PaidThrough is { } pt)
                    {
                        <div class="fs-section__note">@Html.Icon("info", 14)<span>@L["fs.paid_through_by", L.Date(pt), s.PaidByRun ?? ""]</span></div>
                    }
                    <footer class="card-footer fs-section__foot"><span>@L["fs.pending_salary"]</span><strong>@Money(s.PendingSalaryAmount)</strong></footer>
                </section>

                @* ---- other earnings ---- *@
                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__num">@(++n)</span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="fs-section__title">@L["fs.other_earnings"]</h3>
                            <p class="fs-section__hint">@L["fs.other_earnings_hint"]</p>
                        </div>
                        <span class="fs-section__total">@Money(s.OtherEarningsAmount)</span>
                    </header>
                    @if (earnings.Count == 0)
                    {
                        <div class="fs-empty">@Html.Icon("inbox", 16)<span>@L["fs.no_other_earnings"]</span></div>
                    }
                    else
                    {
                        @await Html.PartialAsync("_Lines", new ValueTuple<IReadOnlyList<FinalSettlementLine>, bool, decimal>(earnings, edit, s.DailyDivisor))
                    }
                    @if (edit)
                    {
                        <div class="fs-section__add">@await Html.PartialAsync("_AddLine", SettlementSection.Earning)</div>
                    }
                </section>
            }

            @* ---- leave encashment ---- *@
            <section class="card fs-section">
                <header class="card-header fs-section__head">
                    <span class="fs-section__num">@(++n)</span>
                    <div class="flex-grow-1 min-w-0">
                        <h3 class="fs-section__title">@L["fs.leave_encashment"]</h3>
                        <p class="fs-section__hint">@L["fs.leave_balance_manual"]</p>
                    </div>
                    <span class="fs-section__total">@Money(s.LeaveAmount)</span>
                </header>
                <div class="card-body">
                    <div class="row row-cols-1 row-cols-sm-3 g-2">
                        <div class="col"><div class="fs-metric"><span class="fs-metric__label">@L["fs.leave_balance_on", L.Date(s.LastWorkingDay)]</span><span class="fs-metric__value">@L["fs.n_days", SettlementFormat.Num(s.LeaveBalanceDays)]</span></div></div>
                        <div class="col"><div class="fs-metric"><span class="fs-metric__label">@L["fs.days_to_encash"]</span><span class="fs-metric__value">@L["fs.n_days", SettlementFormat.Num(s.EncashDays)]</span></div></div>
                        <div class="col"><div class="fs-metric"><span class="fs-metric__label">@L["fs.daily_rate"]</span><span class="fs-metric__value">@PayrollFormat.Money(s.DailyDivisor > 0 ? Math.Round(s.LeaveBase / s.DailyDivisor, 3) : 0)</span><span class="fs-metric__note">@Money(s.LeaveBase) ÷ @SettlementFormat.Num(s.DailyDivisor)</span></div></div>
                    </div>
                    @if (leave.Count == 0 && s.EncashDays > 0)
                    {
                        <p class="fs-section__hint mt-2 mb-0">@L["fs.no_leave_salary"]</p>
                    }
                </div>
                <footer class="card-footer fs-section__foot">
                    <span>@L["fs.leave_encashment"] <small>@SettlementFormat.Num(s.EncashDays) × @PayrollFormat.Money(s.DailyDivisor > 0 ? Math.Round(s.LeaveBase / s.DailyDivisor, 3) : 0)</small></span>
                    <strong>@Money(s.LeaveAmount)</strong>
                </footer>
            </section>

            @if (s.IsExit)
            {
                @* ---- indemnity ---- *@
                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__num">@(++n)</span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="fs-section__title">@L["fs.indemnity"]</h3>
                            <p class="fs-section__hint">@L["fs.indemnity_salary"]: @L["pr.kwd"] @Money(s.IndemnityBase) · @L["fs.service_years_n", SettlementFormat.Years(s.ServiceYears)]@(s.RuleSetCode is not null ? " · " + s.RuleSetCode : "")</p>
                        </div>
                        <span class="fs-section__total">@Money(s.IndemnityAmount)</span>
                    </header>
                    <ul class="fs-rows">
                        @foreach (var l in slabs)
                        {
                            <li class="fs-row">
                                <div class="fs-row__text"><span class="fs-row__title">@SettlementFormat.Title(L, l)</span><span class="fs-row__sub">@SettlementFormat.Detail(L, l, s.DailyDivisor)</span></div>
                                <span class="fs-row__amt">@Money(l.Amount)</span>
                            </li>
                        }
                        <li class="fs-row fs-row--sub">
                            <div class="fs-row__text">
                                <span class="fs-row__title">@L["fs.gross_indemnity"]</span>
                                <span class="fs-row__sub">@(s.IndemnityCap is { } cap ? (s.CapReached ? L["fs.cap_reached", Money(cap)] : L["fs.cap_not_reached", Money(cap)]) : L["fs.no_cap"])</span>
                            </div>
                            <span class="fs-row__amt">@Money(s.IndemnityCapped)</span>
                        </li>
                        <li class="fs-row fs-row--sub">
                            <div class="fs-row__text">
                                <span class="fs-row__title">@L["fs.entitlement_for_0", L[SettlementFormat.TypeKey(s.SettlementType)]]</span>
                                <span class="fs-row__sub">@L["fs.entitlement_rule", SettlementFormat.Years(s.ServiceYears)]</span>
                            </div>
                            <span class="fs-row__amt"><span class="fs-pct">@SettlementFormat.Pct(s.IndemnityPercent)</span></span>
                        </li>
                    </ul>
                    @if (s.BelowMinService)
                    {
                        <div class="fs-section__note">@Html.Icon("info", 14)<span>@L["fs.below_min_service"]</span></div>
                    }
                    <footer class="card-footer fs-section__foot"><span>@L["fs.indemnity_payable"]</span><strong>@Money(s.IndemnityAmount)</strong></footer>
                </section>

                @* ---- recoveries ---- *@
                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__num fs-section__num--neg">@(++n)</span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="fs-section__title">@L["fs.recoveries"]</h3>
                            <p class="fs-section__hint">@L["fs.recoveries_hint"]</p>
                        </div>
                        <span class="fs-section__total pr-neg">@Money(s.RecoveryAmount)</span>
                    </header>
                    @if (recoveries.Count == 0)
                    {
                        <div class="fs-empty">@Html.Icon("check", 16)<span>@L["fs.no_recoveries"]</span></div>
                    }
                    else
                    {
                        @await Html.PartialAsync("_Lines", new ValueTuple<IReadOnlyList<FinalSettlementLine>, bool, decimal>(recoveries, edit, s.DailyDivisor))
                    }
                    @if (edit)
                    {
                        <div class="fs-section__add">@await Html.PartialAsync("_AddLine", SettlementSection.Recovery)</div>
                    }
                </section>
            }
        </div>

        @* ================= summary, actions, approval, history ================= *@
        <aside class="col-12 col-xl-4">
            <div class="fs-side d-flex flex-column gap-3">
                <section class="card fs-section fs-summary">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__icon" aria-hidden="true">@Html.Icon("calculator", 16)</span>
                        <h3 class="fs-section__title flex-grow-1">@L["fs.summary"]</h3>
                    </header>
                    <div class="card-body">
                        <ul class="fs-sum">
                            @if (s.IsExit)
                            {
                                <li><span>@L["fs.pending_salary"]</span><span>@Money(s.PendingSalaryAmount)</span></li>
                                <li><span>@L["fs.other_earnings"]</span><span>@Money(s.OtherEarningsAmount)</span></li>
                            }
                            <li><span>@L["fs.leave_encashment"]</span><span>@Money(s.LeaveAmount)</span></li>
                            @if (s.IsExit)
                            {
                                <li><span>@L["fs.indemnity"]</span><span>@Money(s.IndemnityAmount)</span></li>
                                <li class="fs-sum__gross"><span>@L["fs.st_total_entitlements"]</span><span>@Money(s.GrossPayable)</span></li>
                                <li><span>@L["fs.recoveries"]</span><span class="pr-neg">@Money(s.RecoveryAmount)</span></li>
                            }
                        </ul>
                        <div class="fs-net@(s.NetPayable < 0 ? " is-negative" : "")">
                            <span>@L["fs.net_payable"]</span>
                            <strong>@L["pr.kwd"] @Money(s.NetPayable)</strong>
                        </div>
                        @if (s.CalculatedDate is { } calc)
                        {
                            <p class="fs-calculated">@L["fs.calculated_on", L.Date(calc)]</p>
                        }

                        <div class="d-grid gap-2 mt-3 fs-actions">
                            @if (s.IsDraft && r.CanProcess)
                            {
                                @if (s.IsExit && !s.RuleSetVerified && s.IndemnityRuleSetId is not null)
                                {
                                    <div class="form-check fs-ack">
                                        <input class="form-check-input" type="checkbox" id="fs-ack" data-fs-ack />
                                        <label class="form-check-label" for="fs-ack">@L["fs.ack_unverified"]</label>
                                    </div>
                                }
                                <button type="button" class="btn btn-primary" data-fs-submit data-needs-ack="@((s.IsExit && !s.RuleSetVerified && s.IndemnityRuleSetId is not null) ? "true" : "false")">
                                    @Html.Icon("send", 15)<span>@L["pr.submit_for_approval"]</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-fs-act="recalc">@Html.Icon("refresh", 15)<span>@L["fs.recalculate"]</span></button>
                            }
                            @if (canApprove)
                            {
                                @if (ownSubmission)
                                {
                                    <p class="fs-hint">@L["fs.own_submission"]</p>
                                }
                                <button type="button" class="btn btn-success" data-fs-reason="approve" data-optional="true" disabled="@(ownSubmission ? "disabled" : null)"
                                        data-title="@(s.ApprovalLevel == 0 ? L["fs.approve_hr"] : L["fs.approve_finance"])"
                                        data-text="@(s.ApprovalLevel == 0 ? L["fs.approve_hr_text"] : (s.IsExit ? L["fs.approve_finance_text"] : L["fs.approve_finance_text_enc"]))"
                                        data-button="@L["pr.approve"]">@Html.Icon("check", 15)<span>@L["pr.approve"]</span></button>
                                <div class="row g-2">
                                    <div class="col-6 d-grid">
                                        <button type="button" class="btn btn-outline-secondary" data-fs-reason="return"
                                                data-title="@L["fs.return_title"]" data-text="@L["fs.return_text"]" data-button="@L["fs.return"]">@Html.Icon("undo", 15)<span>@L["fs.return"]</span></button>
                                    </div>
                                    <div class="col-6 d-grid">
                                        <button type="button" class="btn btn-outline-danger" data-fs-reason="reject" data-danger="true"
                                                data-title="@L["fs.reject_title"]" data-text="@L["fs.reject_text"]" data-button="@L["pr.reject"]">@Html.Icon("x-circle", 15)<span>@L["pr.reject"]</span></button>
                                    </div>
                                </div>
                            }
                            @if (s.IsApproved && r.CanPay)
                            {
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#fs-pay-modal">@Html.Icon("wallet", 15)<span>@L["fs.record_payment"]</span></button>
                            }
                            @if (!s.IsCancelled)
                            {
                                <a class="btn btn-outline-secondary" href="@Url.Action("Statement", "FinalSettlement", new { id = s.FinalSettlementId })">@Html.Icon("printer", 15)<span>@L["fs.statement_en_ar"]</span></a>
                            }
                            @if ((s.IsDraft || s.IsPending) && r.CanCancel)
                            {
                                <button type="button" class="btn btn-link btn-sm text-danger" data-fs-reason="cancel" data-danger="true"
                                        data-title="@L["fs.cancel_title"]" data-text="@L["fs.cancel_text"]" data-button="@L["fs.cancel_settlement"]">@L["fs.cancel_settlement"]</button>
                            }
                        </div>
                    </div>
                </section>

                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__icon" aria-hidden="true">@Html.Icon("shield", 16)</span>
                        <h3 class="fs-section__title flex-grow-1">@L["fs.approval_route"]</h3>
                    </header>
                    <div class="card-body">
                        @{
                            string State(int level) => s.IsCancelled ? "is-todo"
                                : s.IsPaid || s.IsApproved ? "is-done"
                                : s.IsPending ? (s.ApprovalLevel >= level ? "is-done" : s.ApprovalLevel + 1 == level ? "is-current" : "is-todo")
                                : "is-todo";
                            var hrBy = Model.History.FirstOrDefault(h => h.ActionCode == "APPROVED" && h.ApprovalLevel == 1);
                            var finBy = Model.History.FirstOrDefault(h => h.ActionCode == "APPROVED" && h.ApprovalLevel == 2);
                        }
                        <ol class="pr-timeline mb-0">
                            <li class="@(s.IsDraft ? "is-current" : s.IsCancelled ? "is-rejected" : "is-done")">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@L["fs.prepared"]</div>
                                <div class="pr-timeline__meta">@(s.SubmittedByName ?? s.CreatedByName)@(s.SubmittedDate is { } sd ? " · " + L.Date(sd) : "")</div>
                            </li>
                            <li class="@State(1)">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@L["prv.hr_manager"]</div>
                                <div class="pr-timeline__meta">@(hrBy is not null && !s.IsDraft ? hrBy.ActionByName + " · " + L.Date(hrBy.ActionDate) : L["fs.level_hr_hint"])</div>
                            </li>
                            <li class="@State(2)">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@L["prv.finance_manager"]</div>
                                <div class="pr-timeline__meta">@(finBy is not null && (s.IsApproved || s.IsPaid) ? finBy.ActionByName + " · " + L.Date(finBy.ActionDate) : L["fs.level_finance_hint"])</div>
                            </li>
                            <li class="@(s.IsPaid ? "is-done" : s.IsApproved ? "is-current" : "is-todo")">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@(s.IsExit ? L["fs.payment"] : L["fs.paid_by_payroll"])</div>
                                <div class="pr-timeline__meta">
                                    @if (s.IsPaid)
                                    {
                                        @(SettlementFormat.MethodLabel(L, s.PaymentMethod) + (s.PaymentRef is not null ? " · " + s.PaymentRef : "") + " · " + L.Date(s.PaidDate))
                                    }
                                    else if (!s.IsExit && s.PayMonth is { } pm2)
                                    {
                                        @L["fs.in_payroll_of", L.MonthYear(pm2)]
                                    }
                                    else
                                    {
                                        @L["fs.payment_hint"]
                                    }
                                </div>
                            </li>
                        </ol>
                    </div>
                </section>

                <section class="card fs-section">
                    <header class="card-header fs-section__head">
                        <span class="fs-section__icon" aria-hidden="true">@Html.Icon("history", 16)</span>
                        <h3 class="fs-section__title flex-grow-1">@L["pr.history"]</h3>
                        <span class="hrms-count">@Model.History.Count</span>
                    </header>
                    <div class="card-body pt-2">
                        <ol class="fs-history">
                            @foreach (var h in Model.History)
                            {
                                <li>
                                    <div class="fs-history__head">
                                        <strong>@SettlementFormat.HistoryLabel(L, h.ActionCode, h.ApprovalLevel)</strong>
                                        @if (h.NetPayable is { } net)
                                        {
                                            <span class="fs-history__amt">@Money(net)</span>
                                        }
                                    </div>
                                    <div class="fs-history__meta">@h.ActionByName · @L.Date(h.ActionDate) @h.ActionDate.ToString("HH:mm")</div>
                                    @if (!string.IsNullOrWhiteSpace(h.Comment))
                                    {
                                        <div class="pr-timeline__note">@h.Comment</div>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                </section>
            </div>
        </aside>
    </div>
</div>

@* ---- comment / reason dialog (approve, return, reject, cancel) ---- *@
<div class="modal fade" id="fs-reason-modal" tabindex="-1" aria-hidden="true" aria-labelledby="fs-reason-title">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-fs-reason-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="fs-reason-title" data-fs-reason-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p class="hrms-muted hrms-text-sm" data-fs-reason-text></p>
                <label class="form-label" for="fs-reason-input">@L["pr.comment"] <span class="req" aria-hidden="true" data-fs-reason-req>*</span></label>
                <textarea class="form-control" id="fs-reason-input" rows="3" maxlength="500" data-fs-reason-input></textarea>
                <span class="field-validation-error" data-fs-reason-error hidden>@L["pr.this_field_is_required"]</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                <button type="submit" class="btn btn-primary" data-fs-reason-submit><span data-fs-reason-button></span></button>
            </div>
        </form>
    </div>
</div>

@if (s.IsApproved && r.CanPay)
{
    <div class="modal fade" id="fs-pay-modal" tabindex="-1" aria-hidden="true" aria-labelledby="fs-pay-title">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" data-fs-pay-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="fs-pay-title">@L["fs.record_payment"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="hrms-muted hrms-text-sm">@L["fs.record_payment_text", Money(s.NetPayable)]</p>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="fs-pay-date">@L["fs.payment_date"] <span class="req" aria-hidden="true">*</span></label>
                            <input class="form-control" type="date" id="fs-pay-date" name="paidDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="fs-pay-method">@L["fs.paid_by"] <span class="req" aria-hidden="true">*</span></label>
                            <select class="form-select" id="fs-pay-method" name="method" required>
                                @foreach (var m in PaymentMethod.All)
                                {
                                    <option value="@m" selected="@(m == (s.IsExit ? PaymentMethod.Bank : PaymentMethod.Payroll))">@SettlementFormat.MethodLabel(L, m)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="fs-pay-ref">@L["fs.payment_reference"]</label>
                            <input class="form-control" id="fs-pay-ref" name="reference" maxlength="100" placeholder="@L["fs.payment_reference_placeholder"]" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="fs-pay-comment">@L["pr.comment"]</label>
                            <textarea class="form-control" id="fs-pay-comment" name="comment" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                    <button type="submit" class="btn btn-primary" data-fs-pay-submit>@Html.Icon("check", 15)<span>@L["fs.record_payment"]</span></button>
                </div>
            </form>
        </div>
    </div>
}
@Html.AntiForgeryToken()

@section PageActions {
    <a class="btn btn-outline-secondary" href="@Url.Action(s.IsExit ? "Index" : "Encashment", "FinalSettlement")">@Html.Icon("chevron-left", 15)<span>@L["fs.all_settlements"]</span></a>
}
@section Styles {
    <link rel="stylesheet" href="~/css/settlement.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/settlement.js" asp-append-version="true"></script>
}
