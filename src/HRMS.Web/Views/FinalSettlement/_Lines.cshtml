@model ValueTuple<IReadOnlyList<FinalSettlementLine>, bool, decimal>
@{
    // Lines of the Other earnings / Recoveries cards. Editable (draft): pay item and
    // loan lines can be waived, lines added by hand removed.
    var (lines, editable, divisor) = Model;
}
<ul class="fs-rows">
    @foreach (var l in lines)
    {
        var title = SettlementFormat.Title(L, l);
        var detail = SettlementFormat.Detail(L, l, divisor);
        <li class="fs-row@(l.IsIncluded ? "" : " is-waived")@(l.IsManual ? " is-manual" : "")" data-line="@l.SettlementLineId">
            <div class="fs-row__text">
                <span class="fs-row__title">
                    @title
                    @if (l.LineCode == "LOAN" && !string.IsNullOrWhiteSpace(l.SourceRef))
                    {
                        <span class="hrms-code-chip">@l.SourceRef</span>
                    }
                    @if (l.IsManual)
                    {
                        <span class="fs-tag">@L["fs.added_by_hand"]</span>
                    }
                    @if (!l.IsIncluded)
                    {
                        <span class="fs-tag fs-tag--muted">@L["fs.waived"]</span>
                    }
                </span>
                @if (!string.IsNullOrWhiteSpace(detail) && !l.IsManual)
                {
                    <span class="fs-row__sub">@detail</span>
                }
            </div>
            <span class="fs-row__amt@(l.Amount < 0 ? " pr-neg" : "")">@PayrollFormat.Money(l.Amount)</span>
            @if (editable && (l.IsWaivable || l.IsManual))
            {
                <span class="fs-row__act">
                    @if (l.IsWaivable)
                    {
                        <button type="button" class="btn btn-sm btn-light fs-row__btn" data-fs-line="toggle"
                                aria-label="@(l.IsIncluded ? L["fs.waive_0", title] : L["fs.include_again_0", title])">@Html.Icon(l.IsIncluded ? "eye-off" : "eye", 14)<span>@(l.IsIncluded ? L["fs.waive"] : L["fs.include_again"])</span></button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-light fs-row__btn text-danger" data-fs-line="remove"
                                aria-label="@L["fs.remove_0", title]">@Html.Icon("trash", 14)<span>@L["common.delete"]</span></button>
                    }
                </span>
            }
        </li>
    }
</ul>
