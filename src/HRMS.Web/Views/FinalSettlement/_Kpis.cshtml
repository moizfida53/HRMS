@model FinalSettlementSummary
<section class="pr-kpis pr-kpis--4" aria-label="@L["pr.key_figures"]">
    <div class="hrms-card hrms-kpi">
        <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["fs.kpi_drafts"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("edit", 16)</span></div>
        <div class="hrms-kpi__value">@PayrollFormat.Count(Model.DraftCount)</div>
        <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["fs.kpi_drafts_note"]</span></div>
    </div>
    <div class="hrms-card hrms-kpi">
        <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["fs.kpi_pending"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("clock", 16)</span></div>
        <div class="hrms-kpi__value">@PayrollFormat.Count(Model.PendingCount)</div>
        <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["fs.kpi_pending_note", PayrollFormat.Count(Model.PendingHrCount), PayrollFormat.Count(Model.PendingFinanceCount)]</span></div>
    </div>
    <div class="hrms-card hrms-kpi">
        <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["fs.kpi_to_pay"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("wallet", 16)</span></div>
        <div class="hrms-kpi__value">@PayrollFormat.Money(Model.ApprovedAmount)</div>
        <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["fs.kpi_to_pay_note", PayrollFormat.Count(Model.ApprovedCount)]</span></div>
    </div>
    <div class="hrms-card hrms-kpi">
        <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["fs.kpi_paid_year"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("check", 16)</span></div>
        <div class="hrms-kpi__value">@PayrollFormat.Money(Model.PaidAmount)</div>
        <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["fs.kpi_paid_year_note", PayrollFormat.Count(Model.PaidCount)]</span></div>
    </div>
</section>
