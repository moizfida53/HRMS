@model SettlementFormModel
@{
    ViewData["Title"] = "New Settlement";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "settlement";
    ViewData["Subtitle"] = L["fs.new_subtitle"];
}
@await Html.PartialAsync("~/Views/Payroll/_Tabs.cshtml", "fs-new")

<div class="fs-page fs-new d-flex flex-column gap-3" data-fs-page="new"
     data-urls-save="@Url.Action("Save", "FinalSettlement")"
     data-urls-details="@Url.Action("Details", "FinalSettlement", new { id = 0 })">
    @await Html.PartialAsync("_Steps", 0)
    <div class="row g-3 align-items-start">
        <section class="col-12 col-xl-8">
            <div class="card fs-section">
                <header class="card-header fs-section__head">
                    <span class="fs-section__num">1</span>
                    <div class="flex-grow-1 min-w-0">
                        <h2 class="fs-section__title">@L["fs.step_1_employee"]</h2>
                        <p class="fs-section__hint">@L["fs.new_subtitle"]</p>
                    </div>
                </header>
                <div class="card-body">
                    @await Html.PartialAsync("_Form", Model)
                </div>
            </div>
        </section>
        <aside class="col-12 col-xl-4">
            <section class="card fs-section">
                <header class="card-header fs-section__head">
                    <span class="fs-section__icon" aria-hidden="true">@Html.Icon("info", 16)</span>
                    <h2 class="fs-section__title flex-grow-1">@L["fs.how_it_is_calculated"]</h2>
                </header>
                <div class="card-body">
                    <ol class="fs-howto">
                        <li><strong>@L["fs.pending_salary"]</strong> @L["fs.howto_pending"]</li>
                        <li><strong>@L["fs.leave_encashment"]</strong> @L["fs.howto_leave"]</li>
                        <li><strong>@L["fs.indemnity"]</strong> @L["fs.howto_indemnity"]</li>
                        <li><strong>@L["fs.recoveries"]</strong> @L["fs.howto_recoveries"]</li>
                    </ol>
                    <p class="hrms-muted hrms-text-sm mb-0">@L["fs.howto_note"]</p>
                </div>
            </section>
        </aside>
    </div>
</div>
@Html.AntiForgeryToken()
@section Styles {
    <link rel="stylesheet" href="~/css/settlement.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/settlement.js" asp-append-version="true"></script>
}
