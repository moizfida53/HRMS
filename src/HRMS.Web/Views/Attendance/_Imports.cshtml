@using HRMS.Web.Models.Organization
@model AttImportsModel
@{
    var pg = Model.Page;
}
<div data-total="@pg.TotalCount" data-count-text="@(pg.TotalCount == 1 ? L["att.1_file"] : L["att.0_files", PayrollFormat.Count(pg.TotalCount)])">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon("file", 26)</span>
        <p class="hrms-empty__title">@L["att.no_imports"]</p>
        <p class="hrms-empty__text">@L["att.no_imports_text"]</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table">
            <caption class="hrms-sr-only">@L["att.imports_title"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["att.col_file"]</th>
                    <th scope="col">@L["att.p_period"]</th>
                    <th scope="col" class="text-center">@L["att.p_employees"]</th>
                    <th scope="col" class="text-center">@L["att.p_days"]</th>
                    <th scope="col" class="col-p2">@L["att.col_imported_by"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in pg.Items)
                {
                    <tr data-id="@i.ImportId">
                        <td data-label="@L["att.col_file"]">
                            <span class="hrms-table__primary att-file" title="@i.MappingText">@i.FileName</span>
                            <span class="pr-emp-sub">@(i.FileFormat == "PUNCH" ? L["att.format_punch"] : L["att.format_paired"])@(i.SkippedCount > 0 ? " · " + L["att.0_skipped", i.SkippedCount] : "")</span>
                        </td>
                        <td data-label="@L["att.p_period"]" class="hrms-nowrap">@(i.FromDate is { } f ? L.Date(f) : "—") – @(i.ToDate is { } t ? L.Date(t) : "—")</td>
                        <td data-label="@L["att.p_employees"]" class="text-center">@PayrollFormat.Count(i.EmployeeCount)</td>
                        <td data-label="@L["att.p_days"]" class="text-center">
                            @PayrollFormat.Count(i.LiveCount)
                            @if (i.LiveCount < i.RecordCount) { <span class="pr-emp-sub" title="@L["att.replaced_hint"]">@L["att.of_0", i.RecordCount]</span> }
                        </td>
                        <td data-label="@L["att.col_imported_by"]" class="col-p2 hrms-text-sm">@(i.CreatedByName ?? "—") · @L.Date(i.CreatedDate)</td>
                        <td class="hrms-table__actions">
                            <a class="btn-icon" href="@Url.Action("Index", "Attendance", new { month = i.FromDate?.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture) })"
                               title="@L["att.open_days"]" aria-label="@L["att.open_days"] · @i.FileName">@Html.Icon("eye", 15)</a>
                            @if (Model.Rights.CanImport && i.LiveCount > 0)
                            {
                                <button type="button" class="btn-icon btn-icon--danger" data-att-delete-import="@i.ImportId" data-name="@i.FileName"
                                        title="@L["att.delete_import"]" aria-label="@L["att.delete_import"] · @i.FileName">@Html.Icon("trash", 15)</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount,
        FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
