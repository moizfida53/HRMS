@model AttRegisterModel
@{
    // Time & Attendance > Attendance (db/126): every employee's day of a month - clock in / out, worked,
    // late, short hours, overtime and the deduction - corrected by hand where the device missed.
    ViewData["Title"] = "Attendance";
    ViewData["ActiveArea"] = "attendance";
    ViewData["AttendancePage"] = "register";
    ViewData["Subtitle"] = L["att.register_subtitle"];
    var k = Model.Kpis;
    var monthKey = Model.Month.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
    var statuses = new (string Value, string Key)[]
    {
        ("", "att.all_days"), ("ISSUES", "att.f_issues"), ("DEDUCTED", "att.f_deducted"), ("LATE", "att.f_late"), ("SHORT", "att.f_short"),
        ("ABSENT", "att.st_absent"), ("MISSING", "att.st_missing"), ("OVERTIME", "att.f_overtime"), ("PRESENT", "att.st_present"),
        ("LEAVE", "att.st_leave"), ("EXCUSED", "att.st_excused"), ("NO_PATTERN", "att.st_no_pattern")
    };
}
<div class="pr-stack att-page" data-att-page="register"
     data-url-grid="@Url.Action("Grid", "Attendance")"
     data-url-day="@Url.Action("Day", "Attendance")"
     data-url-save="@Url.Action("SaveDay", "Attendance")"
     data-url-recalc="@Url.Action("Recalculate", "Attendance")">

    <section class="pr-kpis pr-kpis--4" aria-label="@L["pr.key_figures"]">
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["att.kpi_present"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("user-check", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Count(k.PresentDays)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["att.kpi_present_note", PayrollFormat.Count(k.EmployeeCount), k.FirstDate is { } fd ? L.Date(fd) : "—", k.LastDate is { } ld ? L.Date(ld) : "—"]</span></div>
        </div>
        <div class="hrms-card hrms-kpi @(k.LateDays + k.ShortDays > 0 ? "att-kpi--warn" : null)">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["att.kpi_late_short"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("clock", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Count(k.LateDays) <small>/ @PayrollFormat.Count(k.ShortDays)</small></div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["att.kpi_late_short_note", AttFormat.HmOrZero(k.LateMinutes), AttFormat.HmOrZero(k.ShortMinutes)]</span></div>
        </div>
        <div class="hrms-card hrms-kpi @(k.AbsentDays + k.ReviewDays > 0 ? "att-kpi--danger" : null)">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["att.kpi_absent"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("user-x", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Count(k.AbsentDays)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["att.kpi_review_note", PayrollFormat.Count(k.ReviewDays)]</span></div>
        </div>
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["att.kpi_deduction"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("wallet", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Money(k.DeductionAmount)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["att.kpi_overtime_note", PayrollFormat.Money(k.OvertimeAmount), AttFormat.HmOrZero(k.OvertimeMinutes)]</span></div>
        </div>
    </section>

    <section class="hrms-card" data-att-list>
        <form class="hrms-card__toolbar att-filters" method="get" action="@Url.Action("Index", "Attendance")" data-att-filters>
            <div class="hrms-card__filters">
                @if (Model.Companies.Count > 1)
                {
                    <select class="form-select pr-filter" name="company" data-att-filter aria-label="@L["common.company"]">
                        <option value="">@L["att.all_companies"]</option>
                        @foreach (var c in Model.Companies)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.CompanyId)">@c.Text</option>
                        }
                    </select>
                }
                <select class="form-select pr-filter" name="month" data-att-filter aria-label="@L["pr.period"]">
                    @foreach (var m in Model.Months)
                    {
                        <option value="@m.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" selected="@(m == Model.Month)">@L.MonthYear(m)</option>
                    }
                </select>
                <select class="form-select pr-filter" name="status" data-att-filter data-att-grid-only aria-label="@L["common.status"]">
                    @foreach (var (value, key) in statuses)
                    {
                        <option value="@value" selected="@(value == (Model.Status ?? ""))">@L[key]</option>
                    }
                </select>
                <label class="hrms-search pr-search">
                    @Html.Icon("search", 16)
                    <input type="search" name="q" value="@Model.Search" data-att-search autocomplete="off" placeholder="@L["att.search_employee"]" aria-label="@L["att.search_employee"]" />
                </label>
                @if (Model.EmployeeId is { } emp)
                {
                    <input type="hidden" name="employee" value="@emp" />
                }
            </div>
            <div class="hrms-card__count" data-att-count></div>
        </form>
        <div data-att-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>

@* the day: correct the times, excuse it, add a note *@
<div class="modal fade" id="att-day-modal" tabindex="-1" aria-hidden="true" aria-labelledby="att-day-title">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-att-day-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="att-day-title" data-att-day-title>@L["att.edit_day"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-att-day-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                <button type="submit" class="btn btn-primary" data-att-day-save>@Html.Icon("check", 15)<span>@L["emp.save"]</span></button>
            </div>
        </form>
    </div>
</div>
@Html.AntiForgeryToken()

@section PageActions {
    @if (Model.Rights.CanImport)
    {
        <button type="button" class="btn btn-outline-secondary" data-att-recalc data-month="@monthKey" data-company="@Model.CompanyId"
                title="@L["att.recalculate_hint"]">@Html.Icon("refresh", 15)<span>@L["att.recalculate"]</span></button>
        <button type="button" class="btn btn-outline-secondary" data-att-add title="@L["att.add_day_hint"]">@Html.Icon("plus", 15)<span>@L["att.add_day"]</span></button>
        <a class="btn btn-primary" asp-action="Import">@Html.Icon("upload", 15)<span>@L["att.import"]</span></a>
    }
}
@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
