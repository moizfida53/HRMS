@model AttSummaryModel
@{
    // Time & Attendance > Monthly Summary (db/126): each employee's month and its deduction / overtime,
    // posted to the payroll as one-time pay items (Attendance deduction / Overtime).
    ViewData["Title"] = "Attendance Summary";
    ViewData["ActiveArea"] = "attendance";
    ViewData["AttendancePage"] = "summary";
    ViewData["Subtitle"] = L["att.summary_subtitle"];
    var monthKey = Model.Month.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
    var k = Model.Kpis;
    var posted = Model.AnyPosted;
}
<div class="pr-stack att-page" data-att-page="summary"
     data-url-post="@Url.Action("Post", "Attendance")" data-url-unpost="@Url.Action("Unpost", "Attendance")"
     data-url-recalc="@Url.Action("Recalculate", "Attendance")"
     data-company="@Model.CompanyId" data-month="@monthKey">

    <section class="hrms-card">
        <form class="hrms-card__toolbar" method="get" action="@Url.Action("Summary", "Attendance")" data-att-filters>
            <div class="hrms-card__filters">
                <select class="form-select pr-filter" name="company" data-att-filter aria-label="@L["common.company"]" disabled="@(Model.Companies.Count <= 1)">
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CompanyId)">@c.Text</option>
                    }
                </select>
                <select class="form-select pr-filter" name="month" data-att-filter aria-label="@L["pr.period"]">
                    @foreach (var m in Model.Months)
                    {
                        <option value="@m.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" selected="@(m == Model.Month)">@L.MonthYear(m)</option>
                    }
                </select>
            </div>
            <div class="hrms-card__count">@(Model.Rows.Count == 1 ? L["att.1_employee"] : L["att.0_employees", PayrollFormat.Count(Model.Rows.Count)])</div>
        </form>

        @if (posted)
        {
            <div class="pr-banner @(Model.AnyChanged ? "pr-banner--err" : "pr-banner--ok") mx-3 mt-3">
                @Html.Icon(Model.AnyChanged ? "alert" : "check", 18)
                <div>
                    <strong>@(Model.AnyChanged ? L["att.posted_changed_title"] : L["att.posted_title"])</strong>
                    @(Model.AnyChanged ? L["att.posted_changed_text"] : L["att.posted_text"])
                </div>
            </div>
        }

        <div class="att-sumbar">
            <div><span>@L["att.kpi_present"]</span><strong>@PayrollFormat.Count(k.PresentDays)</strong></div>
            <div><span>@L["att.late_days"]</span><strong>@PayrollFormat.Count(k.LateDays)</strong></div>
            <div><span>@L["att.short_days"]</span><strong>@PayrollFormat.Count(k.ShortDays)</strong></div>
            <div><span>@L["att.absent"]</span><strong>@PayrollFormat.Count(k.AbsentDays)</strong></div>
            <div class="@(k.ReviewDays > 0 ? "is-warn" : null)"><span>@L["att.to_review"]</span><strong>@PayrollFormat.Count(k.ReviewDays)</strong></div>
            <div class="is-ded"><span>@L["att.deduction_kwd"]</span><strong>@PayrollFormat.Money(Model.TotalDeduction)</strong></div>
            <div class="is-ot"><span>@L["att.overtime_kwd"]</span><strong>@PayrollFormat.Money(Model.TotalOvertime)</strong></div>
        </div>
        @if (k.ReviewDays > 0)
        {
            <div class="pr-banner pr-banner--info mx-3 mb-3">@Html.Icon("info", 18)<div><strong>@L["att.review_title", k.ReviewDays]</strong> @L["att.review_text"]
                <a href="@Url.Action("Index", "Attendance", new { company = Model.CompanyId, month = monthKey, status = "ISSUES" })">@L["att.review_link"]</a></div></div>
        }

        @if (Model.Rows.Count == 0)
        {
            <div class="hrms-empty">
                <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon("clock", 26)</span>
                <p class="hrms-empty__title">@L["att.no_days_yet"]</p>
                <p class="hrms-empty__text">@L["att.no_days_text"]</p>
            </div>
        }
        else
        {
            <div class="hrms-table-wrap">
                <table class="hrms-table att-summary">
                    <caption class="hrms-sr-only">@L["att.nav_summary"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["att.col_employee"]</th>
                            <th scope="col" class="text-center">@L["att.present"]</th>
                            <th scope="col" class="text-center">@L["att.col_late"]</th>
                            <th scope="col" class="text-center">@L["att.col_short"]</th>
                            <th scope="col" class="text-center">@L["att.absent"]</th>
                            <th scope="col" class="text-center col-p3">@L["att.leave"]</th>
                            <th scope="col" class="text-center col-p2">@L["att.col_overtime"]</th>
                            <th scope="col" class="pr-money">@L["att.col_deduction"]</th>
                            <th scope="col" class="pr-money col-p2">@L["att.overtime_kwd"]</th>
                            <th scope="col">@L["att.col_payroll"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td data-label="@L["att.col_employee"]">
                                    <a class="hrms-table__primary" href="@Url.Action("Index", "Attendance", new { company = Model.CompanyId, month = monthKey, employee = r.EmployeeId })">@PayrollFormat.EmployeeName(L, r.EmployeeName, r.ArabicName)</a>
                                    <span class="pr-emp-sub">@r.EmployeeNo@(r.PatternName is null ? " · " + L["att.no_pattern"] : " · " + r.PatternName)</span>
                                </td>
                                <td data-label="@L["att.present"]" class="text-center">@r.PresentDays</td>
                                <td data-label="@L["att.col_late"]" class="text-center @(r.LateDays > 0 ? "att-warn" : "hrms-muted")">@r.LateDays<span class="pr-emp-sub">@AttFormat.Hm(r.LateMinutes)</span></td>
                                <td data-label="@L["att.col_short"]" class="text-center @(r.ShortDays > 0 ? "att-warn" : "hrms-muted")">@r.ShortDays<span class="pr-emp-sub">@AttFormat.Hm(r.ShortMinutes)</span></td>
                                <td data-label="@L["att.absent"]" class="text-center @(r.AbsentDays > 0 ? "att-bad" : "hrms-muted")">@r.AbsentDays@if (r.ReviewDays > 0) { <span class="pr-emp-sub att-review">@L["att.0_to_review", r.ReviewDays]</span> }</td>
                                <td data-label="@L["att.leave"]" class="text-center col-p3 hrms-muted">@r.LeaveDays</td>
                                <td data-label="@L["att.col_overtime"]" class="text-center col-p2">@AttFormat.Hm(r.OvertimeMinutes)</td>
                                <td data-label="@L["att.col_deduction"]" class="pr-money @(r.DeductionAmount > 0 ? "pr-neg" : "hrms-muted")">@(r.DeductionAmount > 0 ? PayrollFormat.Money(r.DeductionAmount) : "—")</td>
                                <td data-label="@L["att.overtime_kwd"]" class="pr-money col-p2 @(r.OvertimeAmount > 0 ? "pr-pos" : "hrms-muted")">@(r.OvertimeAmount > 0 ? PayrollFormat.Money(r.OvertimeAmount) : "—")</td>
                                <td data-label="@L["att.col_payroll"]">
                                    @if (r.ChangedSincePosted)
                                    {
                                        <span class="hrms-badge hrms-badge--danger" title="@L["att.posted_0_1", PayrollFormat.Money(r.PostedDeduction), PayrollFormat.Money(r.PostedOvertime)]"><span class="hrms-badge__dot"></span>@L["att.changed"]</span>
                                    }
                                    else if (r.IsPosted)
                                    {
                                        <span class="hrms-badge hrms-badge--success" title="@(r.PostedByName) · @L.Date(r.PostedDate)"><span class="hrms-badge__dot"></span>@L["att.posted"]</span>
                                    }
                                    else if (r.DeductionAmount > 0 || r.OvertimeAmount > 0)
                                    {
                                        <span class="hrms-badge hrms-badge--warning"><span class="hrms-badge__dot"></span>@L["att.not_posted"]</span>
                                    }
                                    else
                                    {
                                        <span class="hrms-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">@L["prv.total"]</th>
                            <td class="text-center">@Model.Rows.Sum(r => r.PresentDays)</td>
                            <td class="text-center">@Model.Rows.Sum(r => r.LateDays)</td>
                            <td class="text-center">@Model.Rows.Sum(r => r.ShortDays)</td>
                            <td class="text-center">@Model.Rows.Sum(r => r.AbsentDays)</td>
                            <td class="text-center col-p3">@Model.Rows.Sum(r => r.LeaveDays)</td>
                            <td class="text-center col-p2">@AttFormat.Hm(Model.Rows.Sum(r => r.OvertimeMinutes))</td>
                            <td class="pr-money">@PayrollFormat.Money(Model.TotalDeduction)</td>
                            <td class="pr-money col-p2">@PayrollFormat.Money(Model.TotalOvertime)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>
    <p class="hrms-muted hrms-text-sm mb-0">@Html.Icon("info", 13) @L["att.summary_hint"]</p>
</div>
@Html.AntiForgeryToken()

@section PageActions {
    @if (Model.CompanyId is { } co && Model.Rows.Count > 0)
    {
        <a class="btn btn-outline-secondary" href="@Url.Action("Export", "Attendance", new { company = co, month = monthKey })">@Html.Icon("download", 15)<span>@L["common.export"]</span></a>
        @if (Model.Rights.CanPost)
        {
            @if (posted)
            {
                <button type="button" class="btn btn-outline-danger" data-att-unpost>@Html.Icon("undo", 15)<span>@L["att.unpost"]</span></button>
            }
            <button type="button" class="btn btn-primary" data-att-post data-confirm-title="@L["att.post_title"]"
                    data-confirm-text="@L["att.post_text_0_1", PayrollFormat.Money(Model.TotalDeduction), PayrollFormat.Money(Model.TotalOvertime)]">
                @Html.Icon("send", 15)<span>@(posted ? L["att.post_again"] : L["att.post"])</span>
            </button>
        }
    }
}
@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}
