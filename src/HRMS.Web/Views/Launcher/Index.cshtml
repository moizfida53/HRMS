@model IReadOnlyList<HRMS.Web.Controllers.LauncherController.AppTile>
@{
    Layout = null;
    var name = User.FindFirst(HrmsClaims.DisplayName)?.Value ?? User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Apps &middot; @L["layout.app_name"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Lexend:wght@500;600;700&amp;family=Public+Sans:wght@400;500;600;700&amp;family=Noto+Kufi+Arabic:wght@500;600;700&amp;display=swap" />
    @if (L.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/hrms.css" asp-append-version="true" />
</head>
<body class="hrms-launcher-body">
    <header class="hrms-launcher-bar">
        <div class="container-xl d-flex align-items-center justify-content-between gap-3">
            <span class="hrms-launcher-bar__brand">@L["layout.app_name"]</span>
            <div class="d-flex align-items-center gap-3">
                <span class="hrms-launcher-bar__user">@Html.Icon("user", 16) @name</span>
                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light">@Html.Icon("exit", 16) Sign out</button>
                </form>
            </div>
        </div>
    </header>

    <main class="container-xl hrms-launcher">
        <h1 class="hrms-launcher__title">Choose an application</h1>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">Your account has no applications assigned yet. Ask an administrator to give your role access.</div>
        }

        <div class="row g-3 g-lg-4 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4">
            @foreach (var tile in Model)
            {
                <div class="col">
                    @if (tile.Url is null)
                    {
                        <div class="hrms-app-tile is-soon" data-app="@tile.Key" aria-disabled="true">
                            <span class="hrms-app-tile__icon">@Html.Icon(tile.Icon, 28)</span>
                            <span class="hrms-app-tile__name">@tile.Title</span>
                            <span class="hrms-app-tile__text">@tile.Description</span>
                            <span class="hrms-app-tile__badge">Coming soon</span>
                        </div>
                    }
                    else
                    {
                        <a class="hrms-app-tile" data-app="@tile.Key" href="@tile.Url">
                            <span class="hrms-app-tile__icon">@Html.Icon(tile.Icon, 28)</span>
                            <span class="hrms-app-tile__name">@tile.Title</span>
                            <span class="hrms-app-tile__text">@tile.Description</span>
                        </a>
                    }
                </div>
            }
        </div>
    </main>
</body>
</html>
