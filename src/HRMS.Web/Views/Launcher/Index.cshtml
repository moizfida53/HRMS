@model IReadOnlyList<HRMS.Web.Security.AppItem>
@{
    Layout = null;
    var name = User.FindFirst(HrmsClaims.DisplayName)?.Value ?? User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@L.Tr("All Apps") &middot; TMM</title>
    <link rel="icon" type="image/svg+xml" href="~/img/tmm-logo-dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Lexend:wght@500;600;700&amp;family=Public+Sans:wght@400;500;600;700&amp;family=Noto+Kufi+Arabic:wght@500;600;700&amp;display=swap" />
    @if (L.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/hrms.css" asp-append-version="true" />
</head>
<body class="hrms-launcher-body">
    <header class="hrms-launcher-bar">
        <div class="container-xl d-flex align-items-center justify-content-between gap-3">
            <a class="hrms-launcher-bar__brand" href="~/apps">
                <img src="~/img/tmm-logo-dark.svg" alt="" />
                <span><strong>TMM</strong><small>@L.Tr("Business Suite")</small></span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="hrms-launcher-bar__user">@Html.Icon("user", 16) @name</span>
                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                    <button type="submit" class="btn btn-sm hrms-launcher-bar__signout">@Html.Icon("exit", 16) @L.Tr("Sign out")</button>
                </form>
            </div>
        </div>
    </header>

    <main class="container-xl hrms-launcher">
        <h1 class="hrms-launcher__title">@L.Tr("Choose an application")</h1>

        @if (ViewData["Notice"] is string notice)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">@Html.Icon("info", 18)<span>@L.Tr(notice)</span></div>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">@L.Tr("Your account has no applications assigned yet. Ask an administrator to give your role access.")</div>
        }

        @* Icon + name only; the description shows in a tooltip on hover / focus
           (and stays readable to screen readers through aria-describedby). *@
        <ul class="hrms-app-grid list-unstyled m-0" role="list">
            @foreach (var tile in Model)
            {
                var descId = $"app-desc-{tile.Key}";
                var title = L.Tr(tile.Title);
                var text = L.Tr(tile.Description);
                <li class="hrms-app-grid__item">
                    @if (tile.Url is null)
                    {
                        <span class="hrms-app-tile is-soon" data-app="@tile.Key" aria-disabled="true" tabindex="0"
                              data-bs-toggle="tooltip" data-bs-title="@text" aria-describedby="@descId">
                            <span class="hrms-app-tile__icon" aria-hidden="true">@Html.Icon(tile.Icon, 30)</span>
                            <span class="hrms-app-tile__name">@title</span>
                            <span class="hrms-app-tile__badge">@L.Tr("Coming soon")</span>
                        </span>
                    }
                    else
                    {
                        <a class="hrms-app-tile" data-app="@tile.Key" href="@tile.Url"
                           data-bs-toggle="tooltip" data-bs-title="@text" aria-describedby="@descId"
                           target="@(tile.NewTab ? "_blank" : null)" rel="@(tile.NewTab ? "noopener" : null)">
                            <span class="hrms-app-tile__icon" aria-hidden="true">@Html.Icon(tile.Icon, 30)</span>
                            <span class="hrms-app-tile__name">@title</span>
                            @if (tile.NewTab)
                            {
                                <span class="hrms-app-tile__ext" aria-hidden="true">@Html.Icon("external", 13)</span>
                            }
                        </a>
                    }
                    <span class="visually-hidden" id="@descId">@text</span>
                </li>
            }
        </ul>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/launcher.js" asp-append-version="true"></script>
</body>
</html>
