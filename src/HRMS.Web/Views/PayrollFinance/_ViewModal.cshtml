@* The details popup of the finance lists (payroll-finance.js loads [data-fin-view] urls into it). *@
<div class="modal fade fin-view-modal" id="fin-view" tabindex="-1" aria-hidden="true" aria-labelledby="fin-view-title">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="fin-view-title" data-fin-view-heading></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-fin-view-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
            </div>
        </div>
    </div>
</div>
