@model HistoryPageModel
@{
    ViewData["Title"] = "Payroll History";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["Subtitle"] = L["pr.closed_and_cancelled_payrolls_their_totals_and_who_close"];
}
@{
    // Payroll Processing sub-section in the sidebar; a payroll shows only the page of its own stage, so no tab rail.
    ViewData["PayrollPage"] = "history";
}

<div class="pr-stack" data-pr-page="history">
    <section class="hrms-card" data-runs data-url="@Url.Action("RunsGrid", "Payroll")" data-mode="history">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <label class="hrms-search" style="max-width:280px;flex:1 1 200px">
                    @Html.Icon("search", 16)
                    <input type="search" data-runs-search autocomplete="off" placeholder="@L["pr.search_payrolls"]" aria-label="@L["pr.search_payrolls"]" />
                </label>
                <select class="form-select" style="width:auto" data-runs-year data-searchable aria-label="@L["pr.year"]">
                    <option value="">@L["pr.all_years"]</option>
                    @foreach (var y in Model.Years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                @* Period follows the year: only the months of the chosen year are offered. *@
                <select class="form-select" style="width:auto" data-runs-month data-runs-month-of-year data-searchable aria-label="@L["pr.period"]">
                    <option value="all">@L["pr.all_periods"]</option>
                    @foreach (var m in Model.Months)
                    {
                        <option value="@m.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" data-year="@m.Year">@L.MonthYear(m)</option>
                    }
                </select>
                <select class="form-select" style="width:auto" data-runs-type data-searchable aria-label="@L["org.type"]">
                    <option value="">@L["pr.all_types"]</option>
                    <option value="@RunType.Regular">@L["pr.regular"]</option>
                    <option value="@RunType.OffCycle">@L["pr.off_cycle"]</option>
                </select>
                <select class="form-select" style="width:auto" data-runs-stage data-searchable aria-label="@L["pr.stage"]">
                    <option value="">@L["pr.closed_and_cancelled"]</option>
                    <option value="@RunStage.Closed">@L["pr.closed"]</option>
                    <option value="@RunStage.Cancelled">@L["emp.cancelled"]</option>
                </select>
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <div class="hrms-card__count" data-runs-count></div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Payroll" asp-action="Compare">@Html.Icon("chart", 15)<span>@L["pr.cmp_compare_payrolls"]</span></a>
            </div>
        </div>
        <div data-runs-slot><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>

    <div class="pr-banner pr-banner--lock">@Html.Icon("lock", 18)<div><strong>@L["pr.closed_payrolls_are_read_only"]</strong> @L["pr.reopen_is_possible_only_before_the_bank_file_and_the_jou_2"]</div></div>
</div>
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
