@model HistoryPageModel
@{
    ViewData["Title"] = "Payroll Processing";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["Subtitle"] = L["pr.closed_and_cancelled_payrolls_their_totals_and_who_close"];
}
@await Html.PartialAsync("_Tabs", "history")

<div class="pr-stack" data-pr-page="history">
    <section class="hrms-card" data-runs data-url="@Url.Action("RunsGrid", "Payroll")" data-mode="history">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <label class="hrms-search" style="max-width:280px;flex:1 1 200px">
                    @Html.Icon("search", 16)
                    <input type="search" data-runs-search autocomplete="off" placeholder="@L["pr.search_payrolls"]" aria-label="@L["pr.search_payrolls"]" />
                </label>
                <select class="form-select" style="width:auto" data-runs-year aria-label="@L["pr.year"]">
                    <option value="">@L["pr.all_years"]</option>
                    @foreach (var y in Model.Years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <select class="form-select" style="width:auto" data-runs-type aria-label="@L["org.type"]">
                    <option value="">@L["pr.all_types"]</option>
                    <option value="@RunType.Regular">@L["pr.regular"]</option>
                    <option value="@RunType.OffCycle">@L["pr.off_cycle"]</option>
                </select>
                <select class="form-select" style="width:auto" data-runs-stage aria-label="@L["pr.stage"]">
                    <option value="">@L["pr.closed_and_cancelled"]</option>
                    <option value="@RunStage.Closed">@L["pr.closed"]</option>
                    <option value="@RunStage.Cancelled">@L["emp.cancelled"]</option>
                </select>
            </div>
            <div class="hrms-card__count" data-runs-count></div>
        </div>
        <div data-runs-slot><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>

    <section class="hrms-card" data-compare data-url="@Url.Action("Compare", "Payroll")">
        <div class="pr-card-body">
            <h2 class="pr-card-title">@L["pr.compare_two_payrolls"]</h2>
            @if (Model.FinishedRuns.Count < 2)
            {
                <p class="hrms-muted mb-0">@L["pr.two_closed_payrolls_are_needed_to_compare"]</p>
            }
            else
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label" for="cmp-a">@L["pr.payroll_a"]</label>
                        <select class="form-select" id="cmp-a" data-compare-a>
                            @foreach (var r in Model.FinishedRuns)
                            {
                                <option value="@r.PayrollRunId" selected="@(r == Model.FinishedRuns[1])">@r.RunCode · @PayrollFormat.Period(L, r)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="cmp-b">@L["pr.payroll_b"]</label>
                        <select class="form-select" id="cmp-b" data-compare-b>
                            @foreach (var r in Model.FinishedRuns)
                            {
                                <option value="@r.PayrollRunId" selected="@(r == Model.FinishedRuns[0])">@r.RunCode · @PayrollFormat.Period(L, r)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-outline-primary" data-compare-run>@Html.Icon("chart", 15)<span>@L["pr.compare"]</span></button>
                    </div>
                </div>
                <div class="mt-3" data-compare-slot></div>
            }
        </div>
    </section>

    <div class="pr-banner pr-banner--lock">@Html.Icon("lock", 18)<div><strong>@L["pr.closed_payrolls_are_read_only"]</strong> @L["pr.reopen_is_possible_only_before_the_bank_file_and_the_jou_2"]</div></div>
</div>
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
