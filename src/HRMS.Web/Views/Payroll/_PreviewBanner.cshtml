@* Shown on every payroll page that is still a design preview (not yet functional). *@
<div class="pr-banner pr-banner--lock pr-preview-banner" role="note">
    @Html.Icon("eye", 18)
    <div>
        <strong>@L["pr.design_preview_this_screen_is_not_working_yet"]</strong>
        @L["pr.it_shows_sample_data_so_the_screen_can_be_reviewed_nothi"]
    </div>
    <a class="btn btn-sm btn-outline-secondary pr-preview-banner__link" href="@Url.Content("~/payroll/calendar")">@L["pr.open_payroll_processing"]</a>
</div>
