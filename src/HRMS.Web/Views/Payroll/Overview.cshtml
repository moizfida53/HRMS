@using HRMS.Web.Models.Payroll
@using HRMS.Domain.Payroll
@model WorkspaceOverviewModel
@{
    // db/123: the Overview tab of a payroll's workspace - where it stands, what is left (the next
    // action first), the key figures and the payroll funding.
    var nav = Model.Nav;
    var run = nav.Run;
    var p = nav.Payout;
    var sum = Model.Summary;
    var gross = sum.TotalSalary + sum.TotalEarnings;
    ViewData["Title"] = "Payroll Overview";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["PayrollPage"] = "payrolls";
    ViewData["Subtitle"] = L["ws.overview_subtitle"];
    ViewData["BackUrl"] = Url.Action("Payrolls", "Payroll");
    ViewData["BackLabel"] = "Payrolls";
    string Tab(string t) => Url.Content(WorkspaceNav.Path(t, run.PayrollRunId));
    bool Open(string t) => nav.Tabs.Any(x => x.Slug == t && !x.Locked);
    string When(DateTime? d) => d is { } v ? L.Date(v) : "—";
    string Action(string code) => code switch
    {
        "CREATED" => L["pr.created"], "RECALCULATED" => L["pr.recalculated"], "REGISTRATION_DONE" => L["pr.registration_completed"],
        "BACK_TO_REGISTER" => L["pr.back_to_register"], "SUBMITTED" => L["pr.submitted_for_approval"], "RETURNED" => L["pr.returned_for_correction"],
        "APPROVED" => L["pr.approved"], "REJECTED" => L["pr.rejected"], "CANCELLED" => L["emp.cancelled"], "REOPENED" => L["pr.reopened"],
        "PAYOUT_STARTED" => L["ws.h_payout_started"], "PAYOUT_COMPLETED" => L["ws.h_payout_completed"],
        "PAYOUT_REOPENED" => L["ws.h_payout_reopened"], "PAYOUT_RESET" => L["ws.h_payout_reset"],
        _ => code
    };

    // the next thing to do: before approval the stage's own page, after it the first pay-out step left
    (string Text, string Href, string Button)? next = null;
    if (!run.IsCancelled)
    {
        if (run.Stage == RunStage.Registered) next = (L["ws.next_register"], Tab(WorkspaceTab.Register), L["ws.tab_register"]);
        else if (run.Stage == RunStage.Validation) next = (L["ws.next_validate"], Tab(WorkspaceTab.Validation), L["ws.tab_validation"]);
        else if (run.Stage == RunStage.AwaitingApproval) next = (L["ws.next_approve_0", run.ApprovalLevel + 1], Tab(WorkspaceTab.Approval), L["ws.tab_approval"]);
        else if (run.IsClosed && p?.NextAction is { } na && Open(na.Tab == WorkspaceTab.Payments ? WorkspaceTab.Bank : na.Tab))
            next = (L[na.Key], Tab(na.Tab), L[na.Tab switch
            {
                WorkspaceTab.Payslips => "ws.tab_payslips", WorkspaceTab.Accounting => "ws.tab_accounting",
                WorkspaceTab.Payments => "ws.payment_register", _ => "ws.tab_bank"
            }]);
    }
    var steps = p?.StepsDone ?? 0;
    var completedAt = p?.CompletedDate is { } cd ? DateTime.SpecifyKind(cd, DateTimeKind.Utc).ToLocalTime() : (DateTime?)null;
}

<div class="pr-stack ws-page" data-pr-page="overview">
    @await Html.PartialAsync("_RunBar", nav)

    @if (run.IsCompleted)
    {
        <div class="pr-banner pr-banner--ok ws-complete" role="status">
            @Html.Icon("check", 18)
            <div><strong>@L["ws.completed_title"]</strong>
                @(completedAt is { } at ? L["ws.completed_0_1", L.Date(at), p?.CompletedByName ?? "—"] : null) @L["ws.completed_text"]</div>
        </div>
    }
    else if (run.IsCancelled)
    {
        <div class="pr-banner pr-banner--lock">@Html.Icon("lock", 18)<div><strong>@L["pr.this_payroll_is_cancelled"]</strong> @L["pr.it_keeps_its_number_and_is_read_only"]</div></div>
    }

    <div class="ws-overview">
        @* ------------------------------------------------ what is left *@
        <section class="hrms-card ws-check" aria-labelledby="ws-check-title">
            <header class="ws-check__head">
                <div>
                    <h2 class="pr-card-title mb-0" id="ws-check-title">@L["ws.checklist_title"]</h2>
                    <p class="hrms-muted hrms-text-sm mb-0">@(run.IsClosed ? L["ws.checklist_payout_text"] : L["ws.checklist_prepare_text"])</p>
                </div>
                @if (run.IsClosed)
                {
                    <div class="ws-check__score" aria-label="@L["ws.0_of_3_done", steps]">
                        <span class="ws-check__num">@steps<small>/3</small></span>
                        <span class="ws-progress" aria-hidden="true"><i style="width:@(steps * 100 / 3)%"></i></span>
                    </div>
                }
            </header>

            @if (next is { } n)
            {
                <div class="ws-next">
                    <span class="ws-next__icon" aria-hidden="true">@Html.Icon("bolt", 18)</span>
                    <div class="ws-next__text"><span class="ws-next__label">@L["ws.next_action"]</span><strong>@n.Text</strong></div>
                    <a class="btn btn-primary btn-sm ws-next__btn" href="@n.Href">@Html.Icon("chevron-right", 14)<span>@n.Button</span></a>
                </div>
            }

            <ol class="ws-steps">
                @* preparation, as one line once approved *@
                <li class="ws-step @(run.IsClosed ? "is-done" : "is-current")">
                    <span class="ws-step__dot">@if (run.IsClosed) { @Html.Icon("check", 12) } else { @Html.Icon("clock", 12) }</span>
                    <div class="ws-step__body">
                        <div class="ws-step__title">@L["ws.step_prepare"]</div>
                        <div class="ws-step__meta">@(run.IsClosed ? L["ws.step_prepare_done_0_1", run.ClosedByName ?? "—", When(run.ClosedDate)] : L.Tr(run.StageLabel))</div>
                    </div>
                    <a class="ws-step__go" href="@Tab(run.IsClosed ? WorkspaceTab.Approval : (run.StageIndex switch { 1 => WorkspaceTab.Validation, 2 => WorkspaceTab.Approval, _ => WorkspaceTab.Register }))" aria-label="@L["common.open"]">@Html.Icon("chevron-right", 15)</a>
                </li>

                @if (nav.CanSlips)
                {
                    var done = p?.PayslipsDone == true;
                    <li class="ws-step @(done ? "is-done" : null) @(!run.IsClosed ? "is-locked" : null)">
                        <span class="ws-step__dot">@if (done) { @Html.Icon("check", 12) } else { @Html.Icon("receipt", 12) }</span>
                        <div class="ws-step__body">
                            <div class="ws-step__title">@L["ws.step_payslips"] <span class="ws-req">@L["ws.required"]</span></div>
                            <div class="ws-step__meta">@(p is null ? L["ws.lock_payout"] : L["ws.0_of_1_generated", PayrollFormat.Count(p.PayslipCount), PayrollFormat.Count(p.EmployeeCount)])</div>
                        </div>
                        @if (Open(WorkspaceTab.Payslips)) { <a class="ws-step__go" href="@Tab(WorkspaceTab.Payslips)" aria-label="@L["ws.tab_payslips"]">@Html.Icon("chevron-right", 15)</a> }
                    </li>
                    var mailed = p?.EmailDone == true;
                    <li class="ws-step ws-step--optional @(mailed ? "is-done" : null) @(!run.IsClosed ? "is-locked" : null)">
                        <span class="ws-step__dot">@if (mailed) { @Html.Icon("check", 12) } else { @Html.Icon("mail", 12) }</span>
                        <div class="ws-step__body">
                            <div class="ws-step__title">@L["ws.step_email"] <span class="ws-opt">@L["ws.optional"]</span></div>
                            <div class="ws-step__meta">@(p is null ? L["ws.lock_payout"] : L["ws.0_of_1_emailed", PayrollFormat.Count(p.EmailedCount), PayrollFormat.Count(p.PayslipCount)])
                                @if (p is { EmailFailedCount: > 0 }) { <span class="pr-neg"> · @L["ws.0_failed", p.EmailFailedCount]</span> }</div>
                        </div>
                        @if (Open(WorkspaceTab.Payslips)) { <a class="ws-step__go" href="@Url.Action("Email", "Payslips", new { year = run.RunMonth.Year, month = run.RunMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture) })" aria-label="@L["ws.step_email"]">@Html.Icon("chevron-right", 15)</a> }
                    </li>
                }

                @if (nav.CanBank)
                {
                    var done = p?.PaymentsDone == true;
                    <li class="ws-step @(done ? "is-done" : null) @(!run.IsClosed ? "is-locked" : null) @(p is { FailedCount: > 0 } ? "is-alert" : null)">
                        <span class="ws-step__dot">@if (done) { @Html.Icon("check", 12) } else { @Html.Icon("bank", 12) }</span>
                        <div class="ws-step__body">
                            <div class="ws-step__title">@L["ws.step_bank"] <span class="ws-req">@L["ws.required"]</span></div>
                            <div class="ws-step__meta">
                                @if (p is null) { @L["ws.lock_payout"] }
                                else
                                {
                                    @L["ws.0_of_1_paid", PayrollFormat.Count(p.PayeeCount - p.UnpaidPayeeCount), PayrollFormat.Count(p.PayeeCount)]
                                    <span> · @L["pr.kwd"] @PayrollFormat.Money(p.PaidAmount)</span>
                                    @if (p.FailedCount > 0) { <span class="pr-neg"> · @L["ws.0_failed", p.FailedCount]</span> }
                                    @if (p.BankFileCount > 0) { <span> · @L["ws.0_files", p.BankFileCount]</span> }
                                }
                            </div>
                        </div>
                        @if (Open(WorkspaceTab.Bank)) { <a class="ws-step__go" href="@Tab(WorkspaceTab.Bank)" aria-label="@L["ws.tab_bank"]">@Html.Icon("chevron-right", 15)</a> }
                    </li>
                }

                @if (nav.CanCollections && nav.HasCollections)
                {
                    var done = p is { CollectionPendingCount: 0 };
                    <li class="ws-step ws-step--optional @(done ? "is-done" : null) @(!run.IsClosed ? "is-locked" : null)">
                        <span class="ws-step__dot">@if (done) { @Html.Icon("check", 12) } else { @Html.Icon("wallet", 12) }</span>
                        <div class="ws-step__body">
                            <div class="ws-step__title">@L["ws.step_collections"] <span class="ws-opt">@L["ws.reminder"]</span></div>
                            <div class="ws-step__meta">
                                @if (p is null) { @L["ws.lock_payout"] }
                                else if (p.CollectionCount == 0) { @L["ws.no_collections"] }
                                else { @L["ws.0_pending_1", p.CollectionPendingCount, PayrollFormat.Money(p.CollectionPendingAmount)] }
                            </div>
                        </div>
                        @if (Open(WorkspaceTab.Collections)) { <a class="ws-step__go" href="@Tab(WorkspaceTab.Collections)" aria-label="@L["ws.tab_collections"]">@Html.Icon("chevron-right", 15)</a> }
                    </li>
                }

                @if (nav.CanGl)
                {
                    var done = p?.GlPosted == true;
                    <li class="ws-step @(done ? "is-done" : null) @(!run.IsClosed ? "is-locked" : null)">
                        <span class="ws-step__dot">@if (done) { @Html.Icon("check", 12) } else { @Html.Icon("book", 12) }</span>
                        <div class="ws-step__body">
                            <div class="ws-step__title">@L["ws.step_gl"] <span class="ws-req">@L["ws.required"]</span></div>
                            <div class="ws-step__meta">
                                @if (p is null) { @L["ws.lock_payout"] }
                                else if (p.JournalId is null) { @L["fin.not_created"] }
                                else
                                {
                                    <span class="hrms-code-chip">@p.JournalNo</span>
                                    <span> · @(p.GlPosted ? L["ws.posted_0_1", When(p.GlPostedDate), p.GlReference ?? "—"] : L["ws.journal_" + (p.JournalStatus ?? "ready").ToLowerInvariant()])</span>
                                }
                            </div>
                        </div>
                        @if (Open(WorkspaceTab.Accounting)) { <a class="ws-step__go" href="@Tab(WorkspaceTab.Accounting)" aria-label="@L["ws.tab_accounting"]">@Html.Icon("chevron-right", 15)</a> }
                    </li>
                }
            </ol>
            <p class="ws-check__rule">@Html.Icon("info", 14)<span>@L["ws.rule_text"]</span></p>
        </section>

        @* ------------------------------------------------ figures and recent activity *@
        <div class="pr-stack">
            <section class="hrms-card">
                <div class="pr-card-body">
                    <h2 class="pr-card-title">@L["pr.summary"]</h2>
                    <dl class="pr-dl">
                        <div><dt>@L["common.employees"]</dt><dd>@PayrollFormat.Count(sum.EmployeeCount)</dd></div>
                        <div><dt>@L["pr.gross"]</dt><dd>@L["pr.kwd"] @PayrollFormat.Money(gross)</dd></div>
                        <div><dt>@L["pr.deductions"]</dt><dd>@L["pr.kwd"] @PayrollFormat.Money(sum.TotalDeductions)</dd></div>
                        <div><dt>@L["pr.net_pay"]</dt><dd><strong>@L["pr.kwd"] @PayrollFormat.Money(sum.TotalNet)</strong></dd></div>
                        <div><dt>@L["pr.excluded"]</dt><dd>@PayrollFormat.Count(sum.ExcludedCount)</dd></div>
                        <div><dt>@L["pr.pay_date"]</dt><dd>@When(run.PaymentDate)</dd></div>
                    </dl>
                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <a class="btn btn-sm btn-outline-secondary" href="@Tab(WorkspaceTab.Register)">@Html.Icon("users", 15)<span>@L["ws.tab_register"]</span></a>
                        @if (!run.IsCancelled)
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Export", "Payroll", new { run = run.PayrollRunId })">@Html.Icon("download", 15)<span>@L["common.export"]</span></a>
                        }
                    </div>
                </div>
            </section>
            <section class="hrms-card hrms-panel">
                <header class="hrms-panel__head">
                    <h2 class="hrms-panel__title">@L["ws.recent_activity"]</h2>
                    <a class="btn btn-sm btn-link" href="@Tab(WorkspaceTab.History)">@L["ws.see_all"]</a>
                </header>
                <div class="pr-card-body pt-0">
                    <ol class="pr-timeline">
                        @foreach (var h in Model.History.Reverse().Take(5))
                        {
                            <li class="@(h.ActionCode is "REJECTED" or "CANCELLED" or "RETURNED" or "PAYOUT_REOPENED" ? "is-rejected" : "is-done")">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@Action(h.ActionCode)</div>
                                <div class="pr-timeline__meta">@h.ActionByName · @L.Date(h.ActionDate) @h.ActionDate.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                            </li>
                        }
                    </ol>
                </div>
            </section>
        </div>
    </div>

    @if (Model.Funding is { Rows.Count: > 0 } funding)
    {
        <section class="hrms-card">
            <div class="pr-card-body">
                @await Html.PartialAsync("_RunFunding", funding)
            </div>
        </section>
    }
</div>
@await Html.PartialAsync("_RunUrls", run)
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
