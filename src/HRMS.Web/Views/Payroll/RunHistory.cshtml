@using HRMS.Web.Models.Payroll
@using HRMS.Domain.Payroll
@model WorkspaceHistoryModel
@{
    // db/123: the History tab of a payroll's workspace - every action from creation to completion,
    // and the bank file process (generated, generated again, sent, paid, posted to the GL).
    var nav = Model.Nav;
    var run = nav.Run;
    ViewData["Title"] = "Payroll History";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["PayrollPage"] = "payrolls";
    ViewData["Subtitle"] = L["ws.history_subtitle"];
    ViewData["BackUrl"] = Url.Action("Payrolls", "Payroll");
    ViewData["BackLabel"] = "Payrolls";
    string Action(string code) => code switch
    {
        "CREATED" => L["pr.created"], "RECALCULATED" => L["pr.recalculated"], "REGISTRATION_DONE" => L["pr.registration_completed"],
        "BACK_TO_REGISTER" => L["pr.back_to_register"], "SUBMITTED" => L["pr.submitted_for_approval"], "RETURNED" => L["pr.returned_for_correction"],
        "APPROVED" => L["pr.approved"], "REJECTED" => L["pr.rejected"], "CANCELLED" => L["emp.cancelled"], "REOPENED" => L["pr.reopened"],
        "PAYOUT_STARTED" => L["ws.h_payout_started"], "PAYOUT_COMPLETED" => L["ws.h_payout_completed"],
        "PAYOUT_REOPENED" => L["ws.h_payout_reopened"], "PAYOUT_RESET" => L["ws.h_payout_reset"],
        _ => code
    };
    string AuditKey(string a) => a switch { "REGENERATED" => "fin.audit_regenerated", "SENT" => "fin.audit_sent", "PAID" => "fin.audit_paid", "GL_POSTED" => "fin.audit_gl_posted", _ => "fin.audit_generated" };
    string KindKey(string? k) => k switch { "MINISTRY" => "fin.kind_ministry", "COMPANY" => "fin.kind_company", "RETRY" => "fin.kind_retry", _ => "fin.kind_full" };
}

<div class="pr-stack ws-page" data-pr-page="run-history">
    @await Html.PartialAsync("_RunBar", nav)

    <div class="pr-row">
        <section class="hrms-card hrms-panel">
            <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["ws.payroll_history"]</h2></header>
            <div class="pr-card-body pt-0">
                @if (Model.History.Count == 0)
                {
                    <p class="hrms-muted mb-0">@L["ws.no_history"]</p>
                }
                else
                {
                    <ol class="pr-timeline">
                        @foreach (var h in Model.History.Reverse())
                        {
                            <li class="@(h.ActionCode is "REJECTED" or "CANCELLED" or "RETURNED" or "PAYOUT_REOPENED" ? "is-rejected" : h.ActionCode is "PAYOUT_COMPLETED" or "APPROVED" ? "is-done" : "is-todo")">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">@Action(h.ActionCode)@(h.ApprovalLevel is { } lv && h.ActionCode is "APPROVED" or "RETURNED" or "REJECTED" ? " " + L["pr.level_0", lv] : "")</div>
                                <div class="pr-timeline__meta">@(h.ActionByName ?? "—") · @L.Date(h.ActionDate) @h.ActionDate.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                                @if (!string.IsNullOrWhiteSpace(h.Comment)) { <div class="pr-timeline__note">@h.Comment</div> }
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>

        <section class="hrms-card hrms-panel">
            <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["fin.process_history"]</h2></header>
            <div class="pr-card-body pt-0">
                @if (!run.IsClosed)
                {
                    <p class="hrms-muted mb-0">@L["ws.lock_payout"]</p>
                }
                else if (Model.BankAudit.Count == 0)
                {
                    <p class="hrms-muted mb-0">@L["fin.no_process_history"]</p>
                }
                else
                {
                    <ol class="pr-timeline">
                        @foreach (var h in Model.BankAudit)
                        {
                            var local = DateTime.SpecifyKind(h.ActionDate, DateTimeKind.Utc).ToLocalTime();
                            <li class="@(h.ActionCode is "PAID" or "GL_POSTED" ? "is-done" : h.ActionCode is "REGENERATED" ? "is-rejected" : "is-todo")">
                                <span class="pr-timeline__dot"></span>
                                <div class="pr-timeline__title">
                                    @L[AuditKey(h.ActionCode)]@if (h.FileKind is { } kind) { <span> · </span><span class="bf-kind bf-kind--@kind.ToLowerInvariant()">@L[KindKey(kind)]</span> }
                                    @if (!string.IsNullOrWhiteSpace(h.FileNo)) { <span class="hrms-code-chip ms-1">@h.FileNo</span> }
                                    @if (h.TotalAmount is { } amt)
                                    {
                                        <span class="hrms-muted ms-1">@L["pr.kwd"] @PayrollFormat.Money(amt)</span>
                                    }
                                </div>
                                <div class="pr-timeline__meta">@h.ActionByName · @L.Date(local) @local.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
                                @if (!string.IsNullOrWhiteSpace(h.Reason)) { <div class="pr-timeline__text">@h.Reason</div> }
                                @if (!string.IsNullOrWhiteSpace(h.Reference)) { <div class="pr-timeline__meta">@L["fin.reference_0", h.Reference]</div> }
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>
    </div>
</div>
@await Html.PartialAsync("_RunUrls", run)
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
