@using HRMS.Web.Models.Payroll
@using HRMS.Domain.Payroll
@model CalendarPageModel
@{
    ViewData["Title"] = "Payroll Processing";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["Subtitle"] = L["pr.payrolls_and_their_stage_pay_groups_and_their_periods"];
    var selectedMonth = Model.SelectedMonth?.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
    var stageOptions = new[] { RunStage.Registered, RunStage.Validation, RunStage.AwaitingApproval, RunStage.Closed, RunStage.Cancelled };
    var year = Model.SelectedYear;
}
@await Html.PartialAsync("_Tabs", "calendar")

<div class="pr-stack" data-pr-page="calendar">
    @* ---------------------------------------------------------- payrolls *@
    <section class="hrms-card" data-runs data-url="@Url.Action("RunsGrid", "Payroll")" data-mode="calendar">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <h2 class="pr-card-title mb-0 me-1">@L["pr.payrolls"]</h2>
                <select class="form-select" style="width:auto" data-runs-month aria-label="@L["pr.period"]">
                    <option value="all" selected="@(selectedMonth is null)">@L["pr.all_periods"]</option>
                    @foreach (var m in Model.Months)
                    {
                        var v = m.RunMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
                        <option value="@v" selected="@(v == selectedMonth)">@L.MonthYear(m.RunMonth)</option>
                    }
                </select>
                <select class="form-select" style="width:auto" data-runs-stage aria-label="@L["pr.stage"]">
                    <option value="">@L["pr.all_stages"]</option>
                    @foreach (var s in stageOptions)
                    {
                        <option value="@s">@L.Tr(RunStage.Label(s))</option>
                    }
                </select>
            </div>
            <div class="hrms-card__count" data-runs-count></div>
        </div>
        <div data-runs-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
        <div class="hrms-card__footer">
            <span class="hrms-muted hrms-text-sm">@L["pr.run_name_company_code_year_month_number_of_the_payroll_f"]</span>
        </div>
    </section>

    @* --------------------------------------------------------- calendars *@
    <section class="hrms-card" data-calendars data-url="@Url.Action("CalendarsGrid", "Payroll")">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <h2 class="pr-card-title mb-0 me-1">@L["pr.payroll_calendars"]</h2>
                <label class="hrms-search" style="max-width:280px;flex:1 1 200px">
                    @Html.Icon("search", 16)
                    <input type="search" data-cal-search autocomplete="off" placeholder="@L["pr.search_calendars"]" aria-label="@L["pr.search_calendars"]" />
                </label>
                <select class="form-select" style="width:auto" data-cal-status aria-label="@L["common.status"]">
                    <option value="">@L["common.all_statuses"]</option>
                    <option value="active">@L["common.active_only"]</option>
                    <option value="inactive">@L["common.inactive_only"]</option>
                </select>
            </div>
            <div class="hrms-card__count" data-cal-count></div>
        </div>
        <div data-cal-slot><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>

    @* ----------------------------------------------------------- periods *@
    <section class="hrms-card" data-periods data-url="@Url.Action("PeriodsGrid", "Payroll")">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <h2 class="pr-card-title mb-0 me-1">@L["pr.periods"]</h2>
                @{
                    var selCal = Model.Calendars.FirstOrDefault(x => x.PayrollCalendarId == Model.SelectedCalendarId);
                    var companies = Model.Calendars.GroupBy(x => x.CompanyId).Select(g => g.First()).OrderBy(x => x.CompanyName).ToList();
                }
                <select class="form-select" style="width:auto" data-period-company aria-label="@L["common.company"]">
                    @foreach (var co in companies)
                    {
                        <option value="@co.CompanyId" selected="@(co.CompanyId == selCal?.CompanyId)">@co.CompanyName</option>
                    }
                </select>
                <select class="form-select" style="width:auto" data-period-calendar aria-label="@L["pr.payroll_calendar"]">
                    @foreach (var c in Model.Calendars)
                    {
                        <option value="@c.PayrollCalendarId" data-company="@c.CompanyId" selected="@(c.PayrollCalendarId == Model.SelectedCalendarId)">@PayrollFormat.Calendar(L, c.CalendarName, c.ArabicName)</option>
                    }
                </select>
                <select class="form-select" style="width:auto" data-period-year aria-label="@L["pr.year"]">
                    @for (var y = year + 1; y >= year - 3; y--)
                    {
                        <option value="@y" selected="@(y == year)">@y</option>
                    }
                </select>
            </div>
            @if (Model.CanSetup)
            {
                <button type="button" class="btn btn-outline-primary" data-periods-generate
                        data-url="@Url.Action("PeriodsGenerate", "Payroll")">@Html.Icon("plus", 15)<span>@L["pr.generate_periods"]</span></button>
            }
        </div>
        <div data-period-slot><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>

@* calendar / period forms - the body is loaded from the server *@
<div class="modal fade" id="record-modal" tabindex="-1" aria-hidden="true" aria-labelledby="record-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-record-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title h5" id="record-modal-title" data-record-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-record-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                <button type="submit" class="btn btn-primary" data-record-save>@Html.Icon("check", 15)<span>@L["emp.save"]</span></button>
            </div>
        </form>
    </div>
</div>
<div hidden
     data-cal-urls
     data-form="@Url.Action("CalendarForm", "Payroll")"
     data-save="@Url.Action("CalendarSave", "Payroll")"
     data-delete="@Url.Action("CalendarDelete", "Payroll")"
     data-toggle="@Url.Action("CalendarToggle", "Payroll")"
     data-period-form="@Url.Action("PeriodForm", "Payroll")"
     data-period-save="@Url.Action("PeriodSave", "Payroll")"
     data-period-delete="@Url.Action("PeriodDelete", "Payroll")"
     data-title-new="@L["pr.new_payroll_calendar"]"
     data-title-edit="@L["pr.edit_payroll_calendar"]"
     data-title-period="@L["pr.edit_period"]"
     data-delete-title="@L["common.delete"]"
     data-delete-calendar="@L["pr.delete_this_payroll_calendar_it_can_only_be_deleted_whil"]"
     data-delete-period="@L["pr.delete_this_period_only_an_open_period_without_payrolls"]"></div>
@await Html.PartialAsync("_Modals")

@section PageActions {
    <a class="btn btn-primary" asp-controller="Payroll" asp-action="Create">@Html.Icon("plus", 15)<span>@L["pr.create_payroll"]</span></a>
    @if (Model.CanSetup)
    {
        <button type="button" class="btn btn-outline-secondary" data-cal-add>@Html.Icon("calendar", 15)<span>@L["pr.add_calendar"]</span></button>
    }
}
@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
