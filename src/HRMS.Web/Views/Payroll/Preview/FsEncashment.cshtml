</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col" class="text-center"></th><th scope="col">@(L["pr.employee"])</th><th scope="col" class="text-center">@(L["prv.leave_balance_days"])</th><th scope="col" class="text-center">@(L["prv.encash_days"])</th><th scope="col" class="pr-money">@(L["prv.daily_rate"])</th><th scope="col" class="pr-money">@(L["pr.amount_kwd"])</th></tr>
