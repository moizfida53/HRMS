<tr><td data-label="" class="text-center"><input class="form-check-input" type="checkbox" checked></td><td data-label="@L["pr.employee"]">Fatima Al-Ali · E1002</td><td data-label="@L["prv.leave_balance_days"]" class="text-center">36.5</td><td data-label="@L["prv.encash_days"]" class="text-center"><input class="form-control pr-input-cell mx-auto" value="10" style="width:70px"></td><td data-label="@L["prv.daily_rate"]" class="pr-money">70.385</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">703.846</td></tr>
<tr><td data-label="" class="text-center"><input class="form-check-input" type="checkbox"></td><td data-label="@L["pr.employee"]">Rahul Menon · E1003</td><td data-label="@L["prv.leave_balance_days"]" class="text-center">21.0</td><td data-label="@L["prv.encash_days"]" class="text-center"><input class="form-control pr-input-cell mx-auto" value="0" style="width:70px"></td><td data-label="@L["prv.daily_rate"]" class="pr-money">36.538</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">0.000</td></tr>
</tbody>
<tfoot><tr class="pr-total-row"><td></td><td><strong>@(L["prv.0_employees", "2"])</strong></td><td></td><td>22</td><td class="pr-money"></td><td class="pr-money"><strong>1,243.846</strong></td></tr>
</tfoot></table>
</div>
</div>
<div class="pr-actionbar"><div class="pr-actionbar__status"></div>
<div class="pr-actionbar__spacer"></div>
<button type="button" class="btn btn-outline-secondary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 15V3"/><polyline points="7,8 12,3 17,8"/><path d="M4 20h16"/></svg><span>@(L["prv.import_balances"])</span></button><button type="button" class="btn btn-primary" data-toast="@L["prv.sent_to_hr_manager"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 10 14"/><path d="M21 3l-7 18-4-7-7-4z"/></svg><span>@(L["pr.submit_for_approval"])</span></button></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
