</div>
<div class="mt-3"></div>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["prv.pay_in_october_0_run", "2026"]"><option>@(L["prv.pay_in_october_0_run", "2026"])</option>
<option>@(L["prv.off_cycle_run"])</option>
