@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_settings"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("st-gl-mapping")?.Key;
    ViewData["Subtitle"] = L["prv.which_gl_accounts_each_component_posts_to"];
}
@section PageActions {
<button type="button" class="btn btn-outline-secondary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["common.export"])</span></button><button type="button" class="btn btn-primary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg><span>@(L["prv.add_mapping"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "st-gl-mapping")
<div class="pr-preview" data-preview>
<div class="pr-banner pr-banner--info"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.8" r="0.7" fill="currentColor" stroke="none"/></svg><div>@(L["prv.a_component_s_own_gl_code_salary_components_is_the_defau"])</div>
</div>
<div class="mt-3"></div>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["prv.all_components"]"><option>@(L["prv.all_components"])</option>
<option>@(L["pr.earnings"])</option>
<option>@(L["pr.deductions"])</option>
</select></div>
<div class="hrms-card__count">@(L["prv.0_mappings", "5"])</div>
</div>
