@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.final_settlement"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("fs-history")?.Key;
    ViewData["Subtitle"] = L["prv.all_settlements_and_their_statements"];
}
@section PageActions {
<button type="button" class="btn btn-outline-secondary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["common.export"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "fs-history")
<div class="pr-preview" data-preview>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["pr.all_types"]"><option>@(L["pr.all_types"])</option>
<option>@(L["prv.resignation"])</option>
<option>@(L["prv.termination"])</option>
<option>@(L["prv.end_of_contract"])</option>
</select><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["common.all_statuses"]"><option>@(L["common.all_statuses"])</option>
<option>@(L["prv.draft"])</option>
<option>@(L["prv.pending"])</option>
<option>@(L["prv.paid"])</option>
</select></div>
<div class="hrms-card__count">@(L["prv.0_settlements", "4"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.settlement"])</th><th scope="col">@(L["pr.employee"])</th><th scope="col">@(L["prv.type"])</th><th scope="col" class="col-p2">@(L["prv.last_day"])</th><th scope="col" class="col-p3">@(L["prv.service"])</th><th scope="col" class="pr-money">@(L["prv.payable_kwd"])</th><th scope="col">@(L["common.status"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.settlement"]" class="hrms-nowrap"><span class="hrms-code-chip">FS-2026-10-004</span></td><td data-label="@L["pr.employee"]">Mohammed Saleh · E1005</td><td data-label="@L["prv.type"]">@(L["prv.resignation"])</td><td data-label="@L["prv.last_day"]" class="col-p2 col-date">@(L["prv.0_oct_1", "15", "2026"])</td><td data-label="@L["prv.service"]" class="col-p3">8y 7m</td><td data-label="@L["prv.payable_kwd"]" class="pr-money">3,347.211</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--muted"><span class="hrms-badge__dot"></span>@(L["prv.draft"])</span></td><td class="hrms-table__actions"><a class="btn-icon" href="~/payroll/preview/fs-resignation" title="@L["pr.continue"]" aria-label="@L["pr.continue"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></a></td></tr>
<tr><td data-label="@L["prv.settlement"]" class="hrms-nowrap"><span class="hrms-code-chip">FS-2026-09-003</span></td><td data-label="@L["pr.employee"]">Omar Faisal · E1088</td><td data-label="@L["prv.type"]">@(L["prv.end_of_contract"])</td><td data-label="@L["prv.last_day"]" class="col-p2 col-date">@(L["prv.0_sep_1", "28", "2026"])</td><td data-label="@L["prv.service"]" class="col-p3">2y 0m</td><td data-label="@L["prv.payable_kwd"]" class="pr-money">1,912.500</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--warning"><span class="hrms-badge__dot"></span>@(L["prv.pending_finance"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["prv.view"]" aria-label="@L["prv.view"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></button></td></tr>
<tr><td data-label="@L["prv.settlement"]" class="hrms-nowrap"><span class="hrms-code-chip">FS-2026-07-002</span></td><td data-label="@L["pr.employee"]">Leena Joseph · E1019</td><td data-label="@L["prv.type"]">@(L["prv.resignation"])</td><td data-label="@L["prv.last_day"]" class="col-p2 col-date">@(L["prv.0_jul_1", "15", "2026"])</td><td data-label="@L["prv.service"]" class="col-p3">4y 2m</td><td data-label="@L["prv.payable_kwd"]" class="pr-money">2,140.000</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.paid"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["prv.view"]" aria-label="@L["prv.view"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></button><button type="button" class="btn-icon" title="@L["prv.download"]" aria-label="@L["prv.download"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg></button></td></tr>
<tr><td data-label="@L["prv.settlement"]" class="hrms-nowrap"><span class="hrms-code-chip">FS-2026-07-001</span></td><td data-label="@L["pr.employee"]">Tariq Nasser · E1011</td><td data-label="@L["prv.type"]">@(L["prv.termination"])</td><td data-label="@L["prv.last_day"]" class="col-p2 col-date">@(L["prv.0_jul_1", "01", "2026"])</td><td data-label="@L["prv.service"]" class="col-p3">11y 4m</td><td data-label="@L["prv.payable_kwd"]" class="pr-money">6,912.400</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.paid"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["prv.view"]" aria-label="@L["prv.view"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></button><button type="button" class="btn-icon" title="@L["prv.download"]" aria-label="@L["prv.download"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg></button></td></tr>
</tbody>
</table>
</div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
