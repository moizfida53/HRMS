<div class="col-md-4"><label class="form-label">@(L["prv.wps_employer_code"])</label><input class="form-control" type="text" value="E-458812" placeholder="" /></div>
<div class="col-md-4"><label class="form-label">@(L["prv.pam_file_no"])</label><input class="form-control" type="text" value="" placeholder="" /></div>
<div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" checked><label class="form-check-label">@(L["prv.default_account"])</label></div>
</div>
</div>
</fieldset>
</div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(L["common.cancel"])</button><button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-toast="@L["prv.saved_prototype"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg><span>@(L["prv.save"])</span></button></div>
</div>
</div>
</div>
        
</div>
