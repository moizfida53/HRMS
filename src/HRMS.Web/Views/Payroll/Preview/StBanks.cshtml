</thead>
<tbody><tr><td data-label="@L["common.code"]" class="hrms-nowrap"><span class="hrms-code-chip">MAIN</span></td><td data-label="@L["prv.account"]">@(L["prv.salary_account"])</td><td data-label="@L["prv.bank"]">@(L["prv.national_bank_of_kuwait"])</td><td data-label="IBAN">KW81 NBOK 0000 0000 0000 1234 5601 01</td><td data-label="@L["prv.wps_employer_code"]" class="col-p2">E-458812</td><td data-label="@L["pr.default"]" class="text-center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button><button type="button" class="btn-icon btn-icon--success" title="@L["prv.activate_deactivate"]" aria-label="@L["prv.activate_or_deactivate"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v8"/><path d="M7.5 6.5a7.5 7.5 0 1 0 9 0"/></svg></button><button type="button" class="btn-icon btn-icon--danger" title="@L["common.delete"]" aria-label="@L["common.delete"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M10 4h4M9 7v11M15 7v11"/><path d="M6 7l1 13h10l1-13"/></svg></button></td></tr>
