<div class="modal fade" id="record-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">@(L["prv.company_bank_account"])</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button></div>
<div class="modal-body"><fieldset class="hrms-fieldset"><legend>@(L["prv.company_bank_account"])</legend><div class="row g-3"><div class="col-md-6"><label class="form-label">@(L["common.company"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.demo_trading_co"])</option>
</select></div>
<div class="col-md-6"><label class="form-label">@(L["prv.bank"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.national_bank_of_kuwait"])</option>
</select></div>
<div class="col-md-4"><label class="form-label">@(L["prv.account_code"]) <span class="req" aria-hidden="true">*</span></label><input class="form-control" type="text" value="MAIN" placeholder="" /></div>
<div class="col-md-8"><label class="form-label">@(L["prv.account_title"]) <span class="req" aria-hidden="true">*</span></label><input class="form-control" type="text" value="Salary account" placeholder="" /></div>
<div class="col-md-8"><label class="form-label">IBAN</label><input class="form-control" type="text" value="KW81 NBOK 0000 0000 0000 1234 5601 01" placeholder="" /><span class="form-text">@(L["prv.checked_with_the_iban_check_digits_kuwait_ibans_are_0_ch", "30"])</span></div>
