@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payslips"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("slip-email")?.Key;
    ViewData["Subtitle"] = L["prv.email_password_protected_payslips_and_track_delivery"];
}
@section PageActions {
<button type="button" class="btn btn-primary" data-toast="@L["prv.queued_0_emails", "6"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 10 14"/><path d="M21 3l-7 18-4-7-7-4z"/></svg><span>@(L["prv.send_to_all_not_yet_sent"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "slip-email")
<div class="pr-preview" data-preview>
<section class="pr-kpis pr-kpis--4" aria-label="@L["pr.key_figures"]"><div class="hrms-card hrms-kpi"><div class="hrms-kpi__head"><span class="hrms-kpi__label">@(L["prv.payslips"])</span><span class="hrms-kpi__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span></div>
<div class="hrms-kpi__value">407</div>
<div class="hrms-kpi__foot"><span class="hrms-kpi__note">DTC-2026-09-01</span></div>
</div>
<div class="hrms-card hrms-kpi"><div class="hrms-kpi__head"><span class="hrms-kpi__label">@(L["prv.delivered"])</span><span class="hrms-kpi__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span></div>
<div class="hrms-kpi__value">401</div>
<div class="hrms-kpi__foot"><span class="hrms-kpi__note">98.5%</span></div>
</div>
<div class="hrms-card hrms-kpi"><div class="hrms-kpi__head"><span class="hrms-kpi__label">@(L["prv.bounced"])</span><span class="hrms-kpi__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4l9.5 16H2.5z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r="0.7" fill="currentColor" stroke="none"/></svg></span></div>
<div class="hrms-kpi__value">3</div>
<div class="hrms-kpi__foot"><span class="hrms-kpi__note">@(L["prv.resend_after_fixing"])</span></div>
</div>
<div class="hrms-card hrms-kpi"><div class="hrms-kpi__head"><span class="hrms-kpi__label">@(L["prv.no_email"])</span><span class="hrms-kpi__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg></span></div>
<div class="hrms-kpi__value">3</div>
<div class="hrms-kpi__foot"><span class="hrms-kpi__note">@(L["prv.print_or_add_email"])</span></div>
</div>
</section>
<div class="mt-3"></div>
<div class="pr-banner pr-banner--info"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><div>@(L["prv.each_pdf_is_password_protected_with_the"]) <strong>@(L["prv.last_0_digits_of_the_employee_s_civil_id", "6"])</strong>@(L["prv.the_password_is_never_written_in_the_email"])</div>
</div>
<div class="mt-3"></div>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["common.all_statuses"]"><option>@(L["common.all_statuses"])</option>
<option>@(L["prv.delivered"])</option>
<option>@(L["prv.bounced"])</option>
<option>@(L["prv.missing"])</option>
</select></div>
<div class="hrms-card__count">@(L["prv.0_recipients", "407"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["pr.employee"])</th><th scope="col">@(L["prv.email"])</th><th scope="col">@(L["common.status"])</th><th scope="col">@(L["prv.sent"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ahmed Hassan · E1001</td><td data-label="@L["prv.email"]">ahmed.hassan@@demo.example</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.delivered"])</span></td><td data-label="@L["prv.sent"]">@(L["prv.0_sep_1", "29", "09:02"])</td><td></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Rahul Menon · E1003</td><td data-label="@L["prv.email"]">rahul.m@@demo.example</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--danger"><span class="hrms-badge__dot"></span>@(L["prv.bounced"])</span></td><td data-label="@L["prv.sent"]">@(L["prv.0_sep_1", "29", "09:02"])</td><td class="hrms-table__actions"><button class="btn btn-sm btn-outline-secondary" data-toast="@L["prv.resent"]">@(L["prv.resend"])</button></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">John Mathew · E1007</td><td data-label="@L["prv.email"]"><span class="pr-neg">@(L["prv.no_email_address"])</span></td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--danger"><span class="hrms-badge__dot"></span>@(L["prv.missing"])</span></td><td data-label="@L["prv.sent"]">—</td><td class="hrms-table__actions"><a class="btn btn-sm btn-outline-secondary" href="#">@(L["prv.add_email"])</a></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Maria Santos · E1004</td><td data-label="@L["prv.email"]">maria.santos@@demo.example</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--info"><span class="hrms-badge__dot"></span>@(L["prv.sent"])</span></td><td data-label="@L["prv.sent"]">@(L["prv.0_sep_1", "29", "09:03"])</td><td></td></tr>
</tbody>
</table>
</div>
<div class="hrms-card__footer"><span class="hrms-muted hrms-text-sm hrms-numeric">@(L["common.showing_range", "1", "4", "407"])</span><nav class="hrms-pagination" aria-label="@L["common.pagination"]"><button type="button" class="hrms-pagination__btn" disabled><svg class="hrms-flip-rtl" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="14,6 8,12 14,18"/></svg></button><button type="button" class="hrms-pagination__btn is-active">1</button><button type="button" class="hrms-pagination__btn">2</button><button type="button" class="hrms-pagination__btn">3</button><button type="button" class="hrms-pagination__btn"><svg class="hrms-flip-rtl" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10,6 16,12 10,18"/></svg></button></nav></div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
