</thead>
<tbody><tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ahmed Hassan · E1001</td><td data-label="@L["prv.bank"]">NBK</td><td data-label="IBAN" class="col-p3">KW74 NBOK … 3388</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">1,087.425</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.paid"])</span></td><td data-label="@L["prv.bank_reference"]" class="col-p2">NBK-29092026-00012</td><td></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Rahul Menon · E1003</td><td data-label="@L["prv.bank"]">KFH</td><td data-label="IBAN" class="col-p3">KW12 KFHO … 9021</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">1,000.000</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.paid"])</span></td><td data-label="@L["prv.bank_reference"]" class="col-p2">KFH-29092026-4471</td><td></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Maria Santos · E1004</td><td data-label="@L["prv.bank"]">@(L["prv.gulf_bank"])</td><td data-label="IBAN" class="col-p3">KW55 GULB … 0410</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">575.000</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--danger"><span class="hrms-badge__dot"></span>@(L["prv.failed"])</span></td><td data-label="@L["prv.bank_reference"]" class="col-p2">@(L["prv.invalid_account"])</td><td class="hrms-table__actions"><button class="btn btn-sm btn-outline-secondary" data-toast="@L["prv.added_to_next_bank_file"]">@(L["prv.re_issue"])</button></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">John Mathew · E1007</td><td data-label="@L["prv.bank"]">@(L["prv.cash"])</td><td data-label="IBAN" class="col-p3">—</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">310.000</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.paid"])</span></td><td data-label="@L["prv.bank_reference"]" class="col-p2">@(L["prv.cash_voucher_cv_0", "0912"])</td><td></td></tr>
