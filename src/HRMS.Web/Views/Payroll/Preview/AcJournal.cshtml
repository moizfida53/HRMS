@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.accounting"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("ac-journal")?.Key;
    ViewData["Subtitle"] = L["prv.journal_preview_of_a_closed_payroll_grouped_by_gl_accoun"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "ac-journal")
<div class="pr-preview" data-preview>
<div class="d-flex flex-wrap gap-2 align-items-center mb-3"><select class="form-select" style="width:auto"><option>@(L["prv.dtc_0_1_2_october_3_closed", "2026", "10", "01", "2026"])</option>
</select><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.balanced"])</span></div>
<div class="hrms-card "><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.gl_account"])</th><th scope="col">@(L["prv.account_name"])</th><th scope="col">@(L["prv.cost_center"])</th><th scope="col" class="pr-money">@(L["prv.debit_kwd"])</th><th scope="col" class="pr-money">@(L["prv.credit_kwd"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">510100</span></td><td data-label="@L["prv.account_name"]">@(L["prv.salaries_basic"])</td><td data-label="@L["prv.cost_center"]">CC-OPS</td><td data-label="@L["prv.debit_kwd"]" class="pr-money">112,400.000</td><td data-label="@L["prv.credit_kwd"]" class="pr-money"></td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">510100</span></td><td data-label="@L["prv.account_name"]">@(L["prv.salaries_basic"])</td><td data-label="@L["prv.cost_center"]">CC-FIN</td><td data-label="@L["prv.debit_kwd"]" class="pr-money">41,250.000</td><td data-label="@L["prv.credit_kwd"]" class="pr-money"></td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">510200</span></td><td data-label="@L["prv.account_name"]">@(L["prv.allowances"])</td><td data-label="@L["prv.cost_center"]">@(L["prv.all_0", "6"])</td><td data-label="@L["prv.debit_kwd"]" class="pr-money">118,206.115</td><td data-label="@L["prv.credit_kwd"]" class="pr-money"></td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">510300</span></td><td data-label="@L["prv.account_name"]">@(L["layout.overtime"])</td><td data-label="@L["prv.cost_center"]">CC-OPS</td><td data-label="@L["prv.debit_kwd"]" class="pr-money">2,904.118</td><td data-label="@L["prv.credit_kwd"]" class="pr-money"></td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">510900</span></td><td data-label="@L["prv.account_name"]">@(L["prv.pifss_employer_share"])</td><td data-label="@L["prv.cost_center"]">@(L["prv.all_0", "6"])</td><td data-label="@L["prv.debit_kwd"]" class="pr-money">9,812.400</td><td data-label="@L["prv.credit_kwd"]" class="pr-money"></td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">210100</span></td><td data-label="@L["prv.account_name"]">@(L["prv.salaries_payable_net"])</td><td data-label="@L["prv.cost_center"]">—</td><td data-label="@L["prv.debit_kwd"]" class="pr-money"></td><td data-label="@L["prv.credit_kwd"]" class="pr-money">287,450.250</td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">210200</span></td><td data-label="@L["prv.account_name"]">@(L["prv.pifss_payable"])</td><td data-label="@L["prv.cost_center"]">—</td><td data-label="@L["prv.debit_kwd"]" class="pr-money"></td><td data-label="@L["prv.credit_kwd"]" class="pr-money">22,076.280</td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">130500</span></td><td data-label="@L["prv.account_name"]">@(L["prv.employee_loans_receivable"])</td><td data-label="@L["prv.cost_center"]">—</td><td data-label="@L["prv.debit_kwd"]" class="pr-money"></td><td data-label="@L["prv.credit_kwd"]" class="pr-money">3,185.000</td></tr>
<tr><td data-label="@L["prv.gl_account"]" class="hrms-nowrap"><span class="hrms-code-chip">…</span></td><td data-label="@L["prv.account_name"]">@(L["prv.0_more_lines", "11"])</td><td data-label="@L["prv.cost_center"]"></td><td data-label="@L["prv.debit_kwd"]" class="pr-money">57,045.982</td><td data-label="@L["prv.credit_kwd"]" class="pr-money">29,107.085</td></tr>
</tbody>
<tfoot><tr class="pr-total-row"><td><strong>@(L["prv.total"])</strong></td><td></td><td></td><td class="pr-money"><strong>341,618.615</strong></td><td class="pr-money"><strong>341,618.615</strong></td></tr>
</tfoot></table>
</div>
</div>
<div class="pr-actionbar"><div class="pr-actionbar__status">@(L["prv.debits_credits"])</div>
<div class="pr-actionbar__spacer"></div>
<button type="button" class="btn btn-primary" data-toast="@L["prv.journal_exported_to_excel"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["prv.export_excel"])</span></button></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
