@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payslips"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("slip-generate")?.Key;
    ViewData["Subtitle"] = L["prv.generate_bilingual_pdf_payslips_for_a_closed_approved_pa"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "slip-generate")
<div class="pr-preview" data-preview>
<div class="hrms-wizard-steps" role="list"><div class="hrms-wizard-step is-active" role="listitem"><span class="hrms-wizard-step__circle">1</span><span class="hrms-wizard-step__label">@(L["prv.run"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">2</span><span class="hrms-wizard-step__label">@(L["prv.template"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">3</span><span class="hrms-wizard-step__label">@(L["prv.generate"])</span></div>
</div>
<div class="hrms-card "><div class="pr-wizard-body"><div data-step-pane><h2 class="pr-card-title">@(L["prv.0_run", "1"])</h2><fieldset class="hrms-fieldset"><legend>@(L["prv.run"])</legend><div class="row g-3"><div class="col-md-8"><label class="form-label">@(L["prv.payroll_run"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.dtc_0_1_2_september_3_closed", "2026", "09", "01", "2026"])</option>
<option>@(L["prv.dtc_0_1_2_october_3_awaiting_approval_preview_only", "2026", "10", "01", "2026"])</option>
</select></div>
<div class="col-md-4"><label class="form-label">@(L["common.employees"])</label><select class="form-select" ><option>@(L["prv.all_in_run_0", "407"])</option>
<option>@(L["prv.selected_department"])</option>
</select></div>
</div>
</fieldset>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_template", "2"])</h2><div class="pr-choice"><label class="is-selected"><input type="radio" class="form-check-input" checked><span><strong>@(L["prv.bilingual"])</strong><span>@(L["prv.english_and_arabic_on_one_page_default"])</span></span></label><label><input type="radio" class="form-check-input"><span><strong>@(L["prv.english"])</strong><span>@(L["prv.english_only"])</span></span></label><label><input type="radio" class="form-check-input"><span><strong>@(L["prv.arabic"])</strong><span>@(L["prv.arabic_only_right_to_left"])</span></span></label></div>
<div class="mt-3"><a class="btn btn-outline-secondary btn-sm" href="~/payroll/preview/slip-view"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg><span>@(L["prv.preview_a_payslip"])</span></a></div>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_generate", "3"])</h2><div class="pr-progress" style="max-width:520px"><span style="width:100%"></span></div>
<p class="hrms-muted mt-2">@(L["prv.0_of_1_payslips_generated_2_errors", "407", "407", "0"])</p><ul class="pr-check"><li><span class="pr-check__icon is-ok"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span><span class="pr-check__text">@(L["prv.pdfs_stored_per_employee_and_period"])</span><span class="pr-check__meta">407</span></li>
<li><span class="pr-check__icon is-ok"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span><span class="pr-check__text">@(L["prv.passwords_set_last_0_digits_of_civil_id", "6"])</span><span class="pr-check__meta">407</span></li>
<li><span class="pr-check__icon is-warn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4l9.5 16H2.5z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r="0.7" fill="currentColor" stroke="none"/></svg></span><span class="pr-check__text">@(L["prv.employees_without_an_email_address"])</span><span class="pr-check__meta"><a href="~/payroll/preview/slip-email">@(L["prv.0_see_email_payslips", "3"])</a></span></li>
</ul></div>
</div>
</div>
<div class="pr-actionbar"><div class="pr-actionbar__status"></div>
<div class="pr-actionbar__spacer"></div>
<button type="button" class="btn btn-outline-secondary" data-step-back><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="14,6 8,12 14,18"/></svg><span>@(L["layout.back"])</span></button><button type="button" class="btn btn-primary" data-step-next><span>@(L["prv.next"])</span><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10,6 16,12 10,18"/></svg></button><a class="btn btn-primary" href="~/payroll/preview/slip-email" data-step-finish hidden><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg><span>@(L["prv.email_payslips"])</span></a></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
