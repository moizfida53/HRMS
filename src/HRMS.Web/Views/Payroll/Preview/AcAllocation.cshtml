@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.accounting"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("ac-allocation")?.Key;
    ViewData["Subtitle"] = L["prv.split_an_employee_s_cost_across_cost_centers"];
}
@section PageActions {
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg><span>@(L["prv.add_split"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "ac-allocation")
<div class="pr-preview" data-preview>
<div class="pr-banner pr-banner--info"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.8" r="0.7" fill="currentColor" stroke="none"/></svg><div>@(L["prv.cost_center_the_employee_s_own_split_if_set_otherwise_th"])</div>
</div>
<div class="mt-3"></div>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["prv.all_cost_centers"]"><option>@(L["prv.all_cost_centers"])</option>
<option>CC-IT</option>
<option>CC-OPS</option>
<option>CC-FIN</option>
</select></div>
<div class="hrms-card__count">@(L["prv.0_rows", "4"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["pr.employee"])</th><th scope="col">@(L["prv.cost_center"])</th><th scope="col" class="text-center">@(L["prv.share"])</th><th scope="col">@(L["prv.from"])</th><th scope="col">@(L["prv.to"])</th><th scope="col">@(L["pr.source"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ali Rashid · E1009</td><td data-label="@L["prv.cost_center"]">@(L["prv.cc_it_it"])</td><td data-label="@L["prv.share"]" class="text-center">60%</td><td data-label="@L["prv.from"]" class="col-date">@(L["prv.0_jan_1", "01", "2026"])</td><td data-label="@L["prv.to"]">—</td><td data-label="@L["pr.source"]">@(L["pr.employee"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button><button type="button" class="btn-icon btn-icon--danger" title="@L["common.delete"]" aria-label="@L["common.delete"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M10 4h4M9 7v11M15 7v11"/><path d="M6 7l1 13h10l1-13"/></svg></button></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ali Rashid · E1009</td><td data-label="@L["prv.cost_center"]">@(L["prv.cc_ops_operations"])</td><td data-label="@L["prv.share"]" class="text-center">40%</td><td data-label="@L["prv.from"]" class="col-date">@(L["prv.0_jan_1", "01", "2026"])</td><td data-label="@L["prv.to"]">—</td><td data-label="@L["pr.source"]">@(L["pr.employee"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button><button type="button" class="btn-icon btn-icon--danger" title="@L["common.delete"]" aria-label="@L["common.delete"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M10 4h4M9 7v11M15 7v11"/><path d="M6 7l1 13h10l1-13"/></svg></button></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ahmed Hassan · E1001</td><td data-label="@L["prv.cost_center"]">@(L["prv.cc_fin_finance"])</td><td data-label="@L["prv.share"]" class="text-center">100%</td><td data-label="@L["prv.from"]">—</td><td data-label="@L["prv.to"]">—</td><td data-label="@L["pr.source"]"><span class="hrms-muted">@(L["prv.department_default"])</span></td><td></td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Maria Santos · E1004</td><td data-label="@L["prv.cost_center"]">@(L["prv.cc_sal_sales"])</td><td data-label="@L["prv.share"]" class="text-center">100%</td><td data-label="@L["prv.from"]">—</td><td data-label="@L["prv.to"]">—</td><td data-label="@L["pr.source"]"><span class="hrms-muted">@(L["prv.department_default"])</span></td><td></td></tr>
</tbody>
</table>
</div>
</div>
<div class="modal fade" id="record-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">@(L["prv.cost_center_split"])</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button></div>
<div class="modal-body"><fieldset class="hrms-fieldset"><legend>@(L["prv.split"])</legend><div class="row g-3"><div class="col-md-6"><label class="form-label">@(L["pr.employee"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>Ali Rashid · E1009</option>
</select></div>
<div class="col-md-6"><label class="form-label">@(L["pr.effective_from"]) <span class="req" aria-hidden="true">*</span></label><input class="form-control" type="date" value="2026-01-01" placeholder="" /></div>
<div class="col-12"><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.cost_center"])</th><th scope="col" class="text-center">@(L["prv.share_2"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.cost_center"]" class="hrms-nowrap"><select class="form-select" ><option>@(L["prv.cc_it_it"])</option>
</select></td><td data-label="@L["prv.share_2"]" class="text-center"><input class="form-control" type="text" value="60" placeholder="" /></td></tr>
<tr><td data-label="@L["prv.cost_center"]" class="hrms-nowrap"><select class="form-select" ><option>@(L["prv.cc_ops_operations"])</option>
</select></td><td data-label="@L["prv.share_2"]" class="text-center"><input class="form-control" type="text" value="40" placeholder="" /></td></tr>
</tbody>
</table>
</div>
<span class="form-text">@(L["prv.shares_must_add_up_to_0", "100"])</span></div>
</div>
</fieldset>
</div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(L["common.cancel"])</button><button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-toast="@L["prv.saved_prototype"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg><span>@(L["prv.save"])</span></button></div>
</div>
</div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
