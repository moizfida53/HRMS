@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.final_settlement"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("fs-termination")?.Key;
    ViewData["Subtitle"] = L["prv.termination_by_employer_full_indemnity"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "fs-termination")
<div class="pr-preview" data-preview>
<div class="hrms-wizard-steps" role="list"><div class="hrms-wizard-step is-active" role="listitem"><span class="hrms-wizard-step__circle">1</span><span class="hrms-wizard-step__label">@(L["pr.employee"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">2</span><span class="hrms-wizard-step__label">@(L["prv.pending_salary"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">3</span><span class="hrms-wizard-step__label">@(L["prv.leave_encashment"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">4</span><span class="hrms-wizard-step__label">@(L["prv.indemnity"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">5</span><span class="hrms-wizard-step__label">@(L["prv.recoveries"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step" role="listitem"><span class="hrms-wizard-step__circle">6</span><span class="hrms-wizard-step__label">@(L["pr.summary"])</span></div>
</div>
<div class="hrms-card "><div class="pr-wizard-body"><div data-step-pane><h2 class="pr-card-title">@(L["prv.0_employee", "1"])</h2><fieldset class="hrms-fieldset"><legend>@(L["prv.separation"])</legend><div class="row g-3"><div class="col-md-6"><label class="form-label">@(L["pr.employee"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.mohammed_saleh_e0_warehouse_supervisor", "1005"])</option>
</select></div>
<div class="col-md-3"><label class="form-label">@(L["prv.separation_type"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.termination"])</option>
<option>@(L["prv.resignation"])</option>
<option>@(L["prv.termination"])</option>
<option>@(L["prv.end_of_contract"])</option>
<option>@(L["prv.retirement"])</option>
</select></div>
<div class="col-md-3"><label class="form-label">@(L["prv.last_working_day"]) <span class="req" aria-hidden="true">*</span></label><input class="form-control" type="date" value="2026-10-15" placeholder="" /></div>
</div>
</fieldset>
<dl class="pr-dl"><div><dt>@(L["prv.joined"])</dt><dd>@(L["prv.0_mar_1", "01", "2018"])</dd></div>
<div><dt>@(L["prv.service"])</dt><dd>@(L["prv.0_years_1_months_2_days", "8", "7", "15"])</dd></div>
<div><dt>@(L["prv.last_basic"])</dt><dd>KWD 520.000</dd></div>
<div><dt>@(L["prv.indemnity_base"])</dt><dd>@(L["prv.kwd_0_basic_housing_transport", "660.000"])</dd></div>
</dl></div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_pending_salary", "2"])</h2><table class="pr-calc"><tr><td>@(L["prv.basic_fixed_allowances_0_1_oct", "01", "15"])<span class="pr-calc__sub">@(L["prv.0_1_2_calendar_days", "695.000", "31", "15"])</span></td><td>336.290</td></tr>
<tr><td>@(L["prv.overtime_october"])</td><td>99.124</td></tr>
<tr class="is-total"><td>@(L["prv.pending_salary"])</td><td>435.414</td></tr>
</table>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_leave_encashment", "3"])</h2><table class="pr-calc"><tr><td>@(L["prv.leave_balance_on_last_working_day"])<span class="pr-calc__sub">@(L["prv.entered_manually_until_the_leave_module_is_integrated"])</span></td><td>@(L["prv.0_days", "18.5"])</td></tr>
<tr><td>@(L["prv.daily_rate"])<span class="pr-calc__sub">660.000 ÷ 26</span></td><td>25.385</td></tr>
<tr class="is-total"><td>@(L["prv.leave_encashment"])</td><td>469.623</td></tr>
</table>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_indemnity", "4"])</h2><table class="pr-calc"><tr><td>@(L["prv.years_0_1_2_days_per_year", "0", "5", "15"])<span class="pr-calc__sub">5 × 15 × (660.000 ÷ 26)</span></td><td>1,903.846</td></tr>
<tr><td>@(L["prv.years_0_1_2_month_per_year", "5", "8.62", "1"])<span class="pr-calc__sub">3.62 × 660.000</span></td><td>2,389.200</td></tr>
<tr><td>@(L["prv.gross_indemnity"])<span class="pr-calc__sub">@(L["prv.cap_0_months_1_not_reached", "18", "11,880.000"])</span></td><td>4,293.046</td></tr>
<tr><td>@(L["prv.entitlement_for_termination"])<span class="pr-calc__sub">@(L["prv.rule_set_kw_ll_0_1_service_2_3_years", "6", "2010", "5", "10"])</span></td><td>100%</td></tr>
<tr class="is-total"><td>@(L["prv.indemnity_payable"])</td><td>4,293.046</td></tr>
</table>
<div class="pr-banner pr-banner--lock"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4l9.5 16H2.5z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r="0.7" fill="currentColor" stroke="none"/></svg><div>@(L["prv.rule_set_kw_ll_0_1_is", "6", "2010"]) <strong>@(L["prv.not_verified"])</strong>@(L["prv.confirm_it_in_payroll_settings_payroll_rules_before_this"])</div>
</div>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_recoveries", "5"])</h2><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.recovery"])</th><th scope="col" class="pr-money">@(L["pr.amount_kwd"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.recovery"]" class="hrms-nowrap">@(L["prv.loan_ln_0_outstanding", "0029"])</td><td data-label="@L["pr.amount_kwd"]" class="pr-money pr-neg">-300.000</td></tr>
<tr><td data-label="@L["prv.recovery"]" class="hrms-nowrap">@(L["prv.salary_advance"])</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">0.000</td></tr>
<tr><td data-label="@L["prv.recovery"]" class="hrms-nowrap">@(L["prv.company_assets_laptop_not_returned"])</td><td data-label="@L["pr.amount_kwd"]" class="pr-money pr-neg">-120.000</td></tr>
</tbody>
<tfoot><tr class="pr-total-row"><td><strong>@(L["prv.total_recoveries"])</strong></td><td class="pr-money"><strong>-420.000</strong></td></tr>
</tfoot></table>
</div>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_summary", "6"])</h2><table class="pr-calc"><tr><td>@(L["prv.pending_salary"])</td><td>435.414</td></tr>
<tr><td>@(L["prv.leave_encashment"])</td><td>469.623</td></tr>
<tr><td>@(L["prv.indemnity"])</td><td>4,293.046</td></tr>
<tr><td>@(L["prv.recoveries"])</td><td class="pr-neg">-420.000</td></tr>
<tr class="is-total"><td>@(L["prv.final_settlement_payable"])</td><td>4,778.083</td></tr>
</table>
<p class="pr-section-label mt-3">@(L["prv.approval_route"])</p><ol class="pr-timeline"><li class="is-current"><span class="pr-timeline__dot"></span><div class="pr-timeline__title">@(L["prv.hr_manager"])</div>
<div class="pr-timeline__meta">Fatima Al-Ali</div>
</li>
<li class="is-todo"><span class="pr-timeline__dot"></span><div class="pr-timeline__title">@(L["prv.finance_manager"])</div>
<div class="pr-timeline__meta">Khalid Hamad</div>
</li>
<li class="is-todo"><span class="pr-timeline__dot"></span><div class="pr-timeline__title">@(L["prv.paid_through_an_off_cycle_run"])</div>
<div class="pr-timeline__meta">@(L["prv.payslip_bank_file_and_journal_as_usual"])</div>
</li>
</ol><div class="mt-3 d-flex gap-2"><button type="button" class="btn btn-outline-secondary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg><span>@(L["prv.settlement_statement_en_ar"])</span></button></div>
</div>
</div>
</div>
<div class="pr-actionbar"><div class="pr-actionbar__status">@(L["prv.settlement_fs_0_1_2_draft", "2026", "10", "004"])</div>
<div class="pr-actionbar__spacer"></div>
<button type="button" class="btn btn-outline-secondary" data-step-back><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="14,6 8,12 14,18"/></svg><span>@(L["layout.back"])</span></button><button type="button" class="btn btn-outline-secondary" data-toast="@L["prv.draft_saved"]"><span>@(L["prv.save_draft"])</span></button><button type="button" class="btn btn-primary" data-step-next><span>@(L["prv.next"])</span><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10,6 16,12 10,18"/></svg></button><button type="button" class="btn btn-primary" data-step-finish hidden data-toast="@L["prv.sent_to_hr_manager"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 10 14"/><path d="M21 3l-7 18-4-7-7-4z"/></svg><span>@(L["pr.submit_for_approval"])</span></button></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
