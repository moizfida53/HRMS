@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.accounting"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("ac-posting")?.Key;
    ViewData["Subtitle"] = L["prv.export_journals_to_excel_and_record_the_posting_referenc"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "ac-posting")
<div class="pr-preview" data-preview>
<div class="pr-banner pr-banner--info"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.8" r="0.7" fill="currentColor" stroke="none"/></svg><div>@(L["prv.no_erp_yet_so_posting"]) <strong>@(L["prv.export_the_journal_to_the_excel_template"])</strong>@(L["prv.enter_it_in_the_books_then_record_the_reference_here_mar"])</div>
</div>
<div class="mt-3"></div>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label><select class="form-select" style="width:auto;min-width:150px" aria-label="@L["common.all_statuses"]"><option>@(L["common.all_statuses"])</option>
<option>@(L["prv.ready"])</option>
<option>@(L["prv.posted"])</option>
<option>@(L["prv.reversed"])</option>
</select></div>
<div class="hrms-card__count">@(L["prv.0_journals", "3"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.journal"])</th><th scope="col">@(L["prv.run"])</th><th scope="col" class="pr-money">@(L["pr.amount_kwd"])</th><th scope="col">@(L["prv.exported"])</th><th scope="col">@(L["prv.posted_ref"])</th><th scope="col">@(L["common.status"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.journal"]" class="hrms-nowrap"><span class="hrms-code-chip">JV-2026-10</span></td><td data-label="@L["prv.run"]">DTC-2026-10-01</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">341,618.615</td><td data-label="@L["prv.exported"]">—</td><td data-label="@L["prv.posted_ref"]">—</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.ready"])</span></td><td class="hrms-table__actions"><button class="btn btn-sm btn-primary" data-toast="@L["prv.exported_mark_as_posted_when_entered_in_the_books"]">@(L["common.export"])</button></td></tr>
<tr><td data-label="@L["prv.journal"]" class="hrms-nowrap"><span class="hrms-code-chip">JV-2026-09</span></td><td data-label="@L["prv.run"]">DTC-2026-09-01</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">339,977.290</td><td data-label="@L["prv.exported"]">@(L["prv.khalid_hamad_0_sep", "28"])</td><td data-label="@L["prv.posted_ref"]">GL-0925-118</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.posted"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["prv.download"]" aria-label="@L["prv.download"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg></button><button type="button" class="btn-icon" title="@L["prv.audit_history"]" aria-label="@L["prv.audit_history"]" data-bs-toggle="modal" data-bs-target="#audit-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg></button></td></tr>
<tr><td data-label="@L["prv.journal"]" class="hrms-nowrap"><span class="hrms-code-chip">JV-2026-08</span></td><td data-label="@L["prv.run"]">DTC-2026-08-01</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">338,410.005</td><td data-label="@L["prv.exported"]">@(L["prv.khalid_hamad_0_aug", "28"])</td><td data-label="@L["prv.posted_ref"]">GL-0825-097</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@(L["prv.posted"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["prv.download"]" aria-label="@L["prv.download"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg></button><button type="button" class="btn-icon" title="@L["prv.audit_history"]" aria-label="@L["prv.audit_history"]" data-bs-toggle="modal" data-bs-target="#audit-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg></button></td></tr>
</tbody>
</table>
</div>
</div>
<div class="modal fade" id="audit-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">@(L["prv.audit_history"])</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button></div>
<div class="modal-body"><div class="hrms-table-wrap"><table class="hrms-table"><thead><tr><th>@(L["prv.when"])</th><th>@(L["prv.user"])</th><th>@(L["prv.field"])</th><th>@(L["prv.old_new"])</th><th>@(L["pr.reason"])</th></tr>
</thead>
<tbody><tr><td class="hrms-nowrap">@(L["prv.0_oct_1_2", "06", "2026", "09:14"])</td><td>Fatima Al-Ali</td><td>@(L["prv.housing_allowance"])</td><td class="pr-diff"><del>150.000</del><ins>200.000</ins></td><td class="hrms-muted">@(L["prv.annual_increment_2026"])</td></tr>
<tr><td class="hrms-nowrap">@(L["prv.0_oct_1_2", "06", "2026", "09:14"])</td><td>Fatima Al-Ali</td><td>@(L["prv.basic_salary"])</td><td class="pr-diff"><del>850.000</del><ins>900.000</ins></td><td class="hrms-muted">@(L["prv.annual_increment_2026"])</td></tr>
<tr><td class="hrms-nowrap">@(L["prv.0_sep_1_2", "12", "2026", "15:02"])</td><td>Khalid Hamad</td><td>@(L["prv.bank_account"])</td><td class="pr-diff"><del>KW81 CBKU …0101</del><ins>KW74 NBOK …3388</ins></td><td class="hrms-muted">@(L["prv.employee_changed_bank"])</td></tr>
<tr><td class="hrms-nowrap">@(L["prv.0_jan_1_2", "01", "2026", "08:00"])</td><td>@(L["layout.system"])</td><td>@(L["prv.salary_record"])</td><td class="pr-diff"><ins>@(L["prv.created_from_structure_acc_std"])</ins></td><td class="hrms-muted">@(L["prv.migrated_from_employee_employeepayroll"])</td></tr>
</tbody>
</table>
</div>
</div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@(L["common.close"])</button></div>
</div>
</div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
