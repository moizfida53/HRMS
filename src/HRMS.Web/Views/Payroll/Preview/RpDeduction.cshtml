@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_reports"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("rp-deduction")?.Key;
    ViewData["Subtitle"] = L["prv.filters_on_the_left_results_on_the_right_export_to_excel"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "rp-deduction")
<div class="pr-preview" data-preview>
<div class="pr-reports"><div class="hrms-card "><ul class=pr-report-list><li><a href="#" class="is-active"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.deductions_by_component"])<small>@(L["prv.per_period"])</small></span></a></li>
<li><a href="#" class=""><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.loans_outstanding"])<small>@(L["layout.per_employee"])</small></span></a></li>
<li><a href="#" class=""><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.deferred_instalments"])<small>@(L["prv.why_and_when"])</small></span></a></li>
</ul></div>
<div class="hrms-card "><div class="pr-card-body pb-0"><h2 class="pr-card-title" data-report-title>@(L["prv.deductions_by_component"])</h2></div>
<div class="hrms-card__toolbar"><div class="hrms-card__filters"><select class="form-select" style="width:auto"><option>@(L["prv.october_0", "2026"])</option>
<option>@(L["prv.september_0", "2026"])</option>
<option>@(L["prv.custom_range"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["layout.all_companies"])</option>
<option>@(L["prv.demo_trading_co"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["pr.all_departments"])</option>
<option>@(L["prv.finance"])</option>
<option>@(L["prv.operations"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["prv.saved_filters"])</option>
<option>@(L["prv.finance_month_end"])</option>
<option>@(L["prv.ops_weekly"])</option>
</select></div>
<div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["prv.excel"])</span></button><button type="button" class="btn btn-outline-secondary btn-sm" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg><span>PDF</span></button></div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.component"])</th><th scope="col" class="text-center">@(L["common.employees"])</th><th scope="col" class="pr-money">@(L["pr.amount_kwd"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.component"]" class="hrms-nowrap">@(L["prv.social_security_pifss"])</td><td data-label="@L["common.employees"]" class="text-center">96</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">12,263.880</td></tr>
<tr><td data-label="@L["prv.component"]" class="hrms-nowrap">@(L["prv.loan"])</td><td data-label="@L["common.employees"]" class="text-center">27</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">3,185.000</td></tr>
<tr><td data-label="@L["prv.component"]" class="hrms-nowrap">@(L["prv.insurance"])</td><td data-label="@L["common.employees"]" class="text-center">140</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">3,850.000</td></tr>
<tr><td data-label="@L["prv.component"]" class="hrms-nowrap">@(L["prv.absence"])</td><td data-label="@L["common.employees"]" class="text-center">14</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">642.115</td></tr>
</tbody>
</table>
</div>
</div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
