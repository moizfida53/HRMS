@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_settings"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("st-deduction-rules")?.Key;
    ViewData["Subtitle"] = L["prv.maximum_deduction_limit_and_the_order_deductions_are_rec"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "st-deduction-rules")
<div class="pr-preview" data-preview>
<div class="hrms-card "><div class="pr-card-body"><fieldset class="hrms-fieldset"><legend>@(L["prv.limit"])</legend><div class="row g-3"><div class="col-md-4"><label class="form-label">@(L["prv.maximum_total_deductions"]) <span class="req" aria-hidden="true">*</span></label><div class="input-group"><input class="form-control" value="50"><span class="input-group-text">@(L["prv.of_gross"])</span></div>
</div>
<div class="col-md-4"><label class="form-label">@(L["prv.applies_to"])</label><select class="form-select" ><option>@(L["pr.all_employees"])</option>
<option>@(L["prv.per_payroll_calendar"])</option>
</select></div>
<div class="col-md-4"><label class="form-label">@(L["prv.when_exceeded"])</label><select class="form-select" ><option>@(L["prv.defer_in_reverse_priority_order"])</option>
<option>@(L["prv.warn_only_v0", "12"])</option>
</select></div>
</div>
</fieldset>
</div>
</div>
<div class="mt-3"></div>
<section class="hrms-card hrms-panel hrms-panel--flush"><header class="hrms-panel__head"><h2 class="hrms-panel__title">@(L["prv.recovery_priority_top_taken_first"])</h2></header><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col" class="text-center">@(L["prv.order"])</th><th scope="col">@(L["pr.deduction"])</th><th scope="col">@(L["prv.when_the_limit_is_exceeded"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.order"]" class="text-center">1</td><td data-label="@L["pr.deduction"]">@(L["prv.social_security_pifss"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.always_taken_statutory"])</td><td></td></tr>
<tr><td data-label="@L["prv.order"]" class="text-center">2</td><td data-label="@L["pr.deduction"]">@(L["prv.absence_unpaid_leave"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.always_taken"])</td><td></td></tr>
<tr><td data-label="@L["prv.order"]" class="text-center">3</td><td data-label="@L["pr.deduction"]">@(L["prv.insurance_and_standing_deductions"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.taken"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
<tr><td data-label="@L["prv.order"]" class="text-center">4</td><td data-label="@L["pr.deduction"]">@(L["prv.salary_advance"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.deferred_to_next_period"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
<tr><td data-label="@L["prv.order"]" class="text-center">5</td><td data-label="@L["pr.deduction"]">@(L["prv.loan_instalment"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.deferred_to_next_period_deferred_first"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
<tr><td data-label="@L["prv.order"]" class="text-center">6</td><td data-label="@L["pr.deduction"]">@(L["prv.other_one_time_deductions"])</td><td data-label="@L["prv.when_the_limit_is_exceeded"]">@(L["prv.deferred_to_next_period"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
</tbody>
</table>
</div>
</section>
<div class="pr-actionbar"><div class="pr-actionbar__status">@(L["prv.admin_configurable_every_change_is_audited"])</div>
<div class="pr-actionbar__spacer"></div>
<button type="button" class="btn btn-primary" data-toast="@L["prv.deduction_rules_saved"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg><span>@(L["prv.save"])</span></button></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
