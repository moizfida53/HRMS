@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_reports"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("rp-compliance")?.Key;
    ViewData["Subtitle"] = L["prv.filters_on_the_left_results_on_the_right_export_to_excel"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "rp-compliance")
<div class="pr-preview" data-preview>
<div class="pr-reports"><div class="hrms-card "><ul class=pr-report-list><li><a href="#" class="is-active"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.pifss_contribution_report"])<small>@(L["prv.employee_employer_share_kuwaiti_staff"])</small></span></a></li>
<li><a href="#" class=""><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.wps_submission_report"])<small>@(L["prv.files_sent_per_period"])</small></span></a></li>
<li><a href="#" class=""><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.indemnity_liability"])<small>@(L["prv.accrued_end_of_service_per_employee"])</small></span></a></li>
<li><a href="#" class=""><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg><span>@(L["prv.audit_report"])<small>@(L["prv.who_changed_what_old_new_reason"])</small></span></a></li>
</ul></div>
<div class="hrms-card "><div class="pr-card-body pb-0"><h2 class="pr-card-title" data-report-title>@(L["prv.pifss_contribution_report"])</h2></div>
<div class="hrms-card__toolbar"><div class="hrms-card__filters"><select class="form-select" style="width:auto"><option>@(L["prv.october_0", "2026"])</option>
<option>@(L["prv.september_0", "2026"])</option>
<option>@(L["prv.custom_range"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["layout.all_companies"])</option>
<option>@(L["prv.demo_trading_co"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["pr.all_departments"])</option>
<option>@(L["prv.finance"])</option>
<option>@(L["prv.operations"])</option>
</select><select class="form-select" style="width:auto"><option>@(L["prv.saved_filters"])</option>
<option>@(L["prv.finance_month_end"])</option>
<option>@(L["prv.ops_weekly"])</option>
</select></div>
<div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["prv.excel"])</span></button><button type="button" class="btn btn-outline-secondary btn-sm" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg><span>PDF</span></button></div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["pr.employee"])</th><th scope="col" class="col-p2">@(L["prv.civil_id"])</th><th scope="col" class="pr-money">@(L["prv.contributory_salary"])</th><th scope="col" class="pr-money">@(L["prv.employee_share"])</th><th scope="col" class="pr-money">@(L["prv.employer_share"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Ahmed Hassan</td><td data-label="@L["prv.civil_id"]" class="col-p2">2XXXXXXXXXX1</td><td data-label="@L["prv.contributory_salary"]" class="pr-money">1,215.000</td><td data-label="@L["prv.employee_share"]" class="pr-money">127.575</td><td data-label="@L["prv.employer_share"]" class="pr-money">139.725</td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Fatima Al-Ali</td><td data-label="@L["prv.civil_id"]" class="col-p2">2XXXXXXXXXX7</td><td data-label="@L["prv.contributory_salary"]" class="pr-money">1,990.000</td><td data-label="@L["prv.employee_share"]" class="pr-money">196.700</td><td data-label="@L["prv.employer_share"]" class="pr-money">228.850</td></tr>
<tr><td data-label="@L["pr.employee"]" class="hrms-nowrap">Sara Khalid</td><td data-label="@L["prv.civil_id"]" class="col-p2">2XXXXXXXXXX4</td><td data-label="@L["prv.contributory_salary"]" class="pr-money">1,075.000</td><td data-label="@L["prv.employee_share"]" class="pr-money">112.875</td><td data-label="@L["prv.employer_share"]" class="pr-money">123.625</td></tr>
</tbody>
</table>
</div>
</div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
