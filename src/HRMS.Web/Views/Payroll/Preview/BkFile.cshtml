@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.bank_processing"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("bk-file")?.Key;
    ViewData["Subtitle"] = L["prv.wps_salary_file_for_a_closed_approved_payroll"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "bk-file")
<div class="pr-preview" data-preview>
<div class="hrms-wizard-steps" role="list"><div class="hrms-wizard-step is-complete" role="listitem"><span class="hrms-wizard-step__circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span><span class="hrms-wizard-step__label">@(L["prv.run"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step is-complete" role="listitem"><span class="hrms-wizard-step__circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span><span class="hrms-wizard-step__label">@(L["prv.debit_account"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step is-complete" role="listitem"><span class="hrms-wizard-step__circle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="4,12 9,17 20,6"/></svg></span><span class="hrms-wizard-step__label">@(L["prv.format"])</span></div>
<div class="hrms-wizard-step__line" aria-hidden="true"></div>
<div class="hrms-wizard-step is-active" role="listitem"><span class="hrms-wizard-step__circle">4</span><span class="hrms-wizard-step__label">@(L["prv.review_generate"])</span></div>
</div>
<div class="hrms-card "><div class="pr-wizard-body"><div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_run", "1"])</h2><fieldset class="hrms-fieldset"><legend>@(L["prv.run"])</legend><div class="row g-3"><div class="col-md-8"><label class="form-label">@(L["prv.closed_payroll"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.dtc_0_1_2_october_3_closed", "2026", "10", "01", "2026"])</option>
</select></div>
<div class="col-md-4"><label class="form-label">@(L["prv.value_date"]) <span class="req" aria-hidden="true">*</span></label><input class="form-control" type="date" value="2026-10-29" placeholder="" /></div>
</div>
</fieldset>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_debit_account", "2"])</h2><fieldset class="hrms-fieldset"><legend>@(L["prv.company_account"])</legend><div class="row g-3"><div class="col-md-8"><label class="form-label">@(L["prv.debit_account"]) <span class="req" aria-hidden="true">*</span></label><select class="form-select" ><option>@(L["prv.nbk_salary_account_kw0_nbok_1_2_3_4_5_6_default", "81", "0000", "0000", "0000", "1234", "5601", "01"])</option>
</select></div>
<div class="col-md-4"><label class="form-label">@(L["prv.wps_employer_code"])</label><input class="form-control" type="text" value="E-458812" placeholder="" readonly/></div>
</div>
</fieldset>
</div>
<div data-step-pane hidden><h2 class="pr-card-title">@(L["prv.0_format", "3"])</h2><div class="pr-choice"><label class="is-selected"><input type="radio" class="form-check-input" checked><span><strong>@(L["prv.default_wps_csv"])</strong><span>@(L["prv.generic_layout_until_each_bank_s_format_is_confirmed"])</span></span></label><label><input type="radio" class="form-check-input"><span><strong>@(L["prv.bank_specific"])</strong><span>@(L["prv.configure_in_settings_bank_formats"])</span></span></label></div>
</div>
<div data-step-pane><h2 class="pr-card-title">@(L["prv.0_review_generate", "4"])</h2><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.bank"])</th><th scope="col" class="text-center">@(L["common.employees"])</th><th scope="col" class="pr-money">@(L["pr.amount_kwd"])</th><th scope="col">@(L["prv.wps_code"])</th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.bank"]" class="hrms-nowrap">@(L["prv.national_bank_of_kuwait"])</td><td data-label="@L["common.employees"]" class="text-center">188</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">142,307.125</td><td data-label="@L["prv.wps_code"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.ready"])</span></td></tr>
<tr><td data-label="@L["prv.bank"]" class="hrms-nowrap">@(L["prv.kuwait_finance_house"])</td><td data-label="@L["common.employees"]" class="text-center">96</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">71,210.400</td><td data-label="@L["prv.wps_code"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.ready"])</span></td></tr>
<tr><td data-label="@L["prv.bank"]" class="hrms-nowrap">@(L["prv.gulf_bank"])</td><td data-label="@L["common.employees"]" class="text-center">57</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">38,882.725</td><td data-label="@L["prv.wps_code"]"><span class="hrms-badge hrms-badge--danger"><span class="hrms-badge__dot"></span>@(L["prv.missing"])</span></td></tr>
<tr><td data-label="@L["prv.bank"]" class="hrms-nowrap">@(L["prv.boubyan_bank"])</td><td data-label="@L["common.employees"]" class="text-center">61</td><td data-label="@L["pr.amount_kwd"]" class="pr-money">33,050.000</td><td data-label="@L["prv.wps_code"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.ready"])</span></td></tr>
</tbody>
<tfoot><tr class="pr-total-row"><td><strong>@(L["prv.bank_transfer"])</strong></td><td><strong>402</strong></td><td class="pr-money"><strong>285,450.250</strong></td><td></td></tr>
</tfoot></table>
</div>
<p class="hrms-text-sm mt-2">@(L["prv.cash_cheque_not_in_file_0_employees_kwd_1", "10", "2,000.000"])</p><div class="pr-banner pr-banner--err"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg><div>@(L["prv.gulf_bank_has_no_wps_bank_code_add_it_in_payroll_setting"])</div>
</div>
</div>
</div>
</div>
<div class="pr-actionbar"><div class="pr-actionbar__status"></div>
<div class="pr-actionbar__spacer"></div>
<span class="pr-actionbar__note">@(L["prv.regenerating_a_file_asks_for_a_reason"])</span><button type="button" class="btn btn-outline-secondary" data-step-back><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="14,6 8,12 14,18"/></svg><span>@(L["layout.back"])</span></button><button type="button" class="btn btn-primary" data-step-next><span>@(L["prv.next"])</span><svg class="hrms-flip-rtl" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10,6 16,12 10,18"/></svg></button><button type="button" class="btn btn-primary" data-step-finish disabled><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["prv.generate_bank_file"])</span></button></div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
