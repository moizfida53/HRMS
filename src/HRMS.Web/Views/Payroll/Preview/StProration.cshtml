@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_settings"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("st-proration")?.Key;
    ViewData["Subtitle"] = L["prv.how_partial_periods_are_paid_per_payroll_calendar"];
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "st-proration")
<div class="pr-preview" data-preview>
<div class="pr-row pr-row--wide-left"><div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label></div>
<div class="hrms-card__count">@(L["prv.0_calendars", "2"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["pr.calendar"])</th><th scope="col">@(L["prv.basis"])</th><th scope="col">@(L["prv.prorate_for"])</th><th scope="col">@(L["prv.components_prorated"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["pr.calendar"]" class="hrms-nowrap">@(L["prv.monthly_staff"])</td><td data-label="@L["prv.basis"]">@(L["prv.fixed_0_days", "26"])</td><td data-label="@L["prv.prorate_for"]">@(L["prv.joiners_leavers_mid_month_revisions_unpaid_leave"])</td><td data-label="@L["prv.components_prorated"]">@(L["prv.all_fixed_earnings_marked_prorated_0", "6"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
<tr><td data-label="@L["pr.calendar"]" class="hrms-nowrap">@(L["prv.weekly_labour"])</td><td data-label="@L["prv.basis"]">@(L["pr.working_days"])</td><td data-label="@L["prv.prorate_for"]">@(L["prv.joiners_leavers"])</td><td data-label="@L["prv.components_prorated"]">@(L["prv.basic_salary_only"])</td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
</tbody>
</table>
</div>
</div>
<section class="hrms-card hrms-panel "><header class="hrms-panel__head"><h2 class="hrms-panel__title">@(L["prv.how_it_is_calculated"])</h2></header><table class="pr-calc"><tr><td>@(L["prv.example_joined_0_oct_basic_1_fixed_2_days", "16", "600.000", "26"])</td><td></td></tr>
<tr><td>@(L["prv.days_worked_fridays_excluded"])</td><td>14</td></tr>
<tr><td>@(L["prv.daily_rate"])<span class="pr-calc__sub">600.000 ÷ 26</span></td><td>23.077</td></tr>
<tr class="is-total"><td>@(L["prv.prorated_basic"])</td><td>323.077</td></tr>
</table>
</section>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
