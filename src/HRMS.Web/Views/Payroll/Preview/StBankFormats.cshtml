@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = L["prv.payroll_settings"];
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("st-bank-formats")?.Key;
    ViewData["Subtitle"] = L["prv.salary_file_layouts_per_bank_one_default_until_the_banks"];
}
@section PageActions {
<button type="button" class="btn btn-primary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg><span>@(L["prv.add_format"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
@await Html.PartialAsync("_Tabs", "st-bank-formats")
<div class="pr-preview" data-preview>
<div class="hrms-card "><div class="hrms-card__toolbar"><div class="hrms-card__filters"><label class="hrms-search" style="max-width:320px;flex:1 1 220px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/></svg><input type="search" placeholder="@L["prv.search"]" aria-label="@L["prv.search"]" /></label></div>
<div class="hrms-card__count">@(L["prv.0_formats", "2"])</div>
</div>
<div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col">@(L["prv.format"])</th><th scope="col">@(L["prv.banks"])</th><th scope="col">@(L["prv.type"])</th><th scope="col">@(L["prv.header_trailer"])</th><th scope="col">@(L["common.status"])</th><th scope="col"><span class="hrms-sr-only">@(L["common.actions"])</span></th></tr>
</thead>
<tbody><tr><td data-label="@L["prv.format"]" class="hrms-nowrap"><span class="hrms-table__primary">@(L["prv.default_wps_csv"])</span> <span class="hrms-badge hrms-badge--info"><span class="hrms-badge__dot"></span>@(L["pr.default"])</span></td><td data-label="@L["prv.banks"]">@(L["prv.all_banks_without_their_own_format"])</td><td data-label="@L["prv.type"]">@(L["prv.csv_comma"])</td><td data-label="@L["prv.header_trailer"]">@(L["prv.header_row_no_trailer"])</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@(L["prv.active"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button></td></tr>
<tr><td data-label="@L["prv.format"]" class="hrms-nowrap"><span class="hrms-table__primary">@(L["prv.nbk_salary_file"])</span></td><td data-label="@L["prv.banks"]">@(L["prv.national_bank_of_kuwait"])</td><td data-label="@L["prv.type"]">@(L["prv.fixed_width"])</td><td data-label="@L["prv.header_trailer"]">@(L["prv.header_trailer_with_totals"])</td><td data-label="@L["common.status"]"><span class="hrms-badge hrms-badge--muted"><span class="hrms-badge__dot"></span>@(L["prv.inactive"])</span></td><td class="hrms-table__actions"><button type="button" class="btn-icon" title="@L["common.edit"]" aria-label="@L["common.edit"]" data-bs-toggle="modal" data-bs-target="#record-modal"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg></button><button type="button" class="btn-icon btn-icon--success" title="@L["prv.activate_deactivate"]" aria-label="@L["prv.activate_or_deactivate"]"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v8"/><path d="M7.5 6.5a7.5 7.5 0 1 0 9 0"/></svg></button></td></tr>
</tbody>
</table>
</div>
</div>
<div class="pr-row mt-3"><section class="hrms-card hrms-panel hrms-panel--flush"><header class="hrms-panel__head"><h2 class="hrms-panel__title">@(L["prv.default_wps_csv_fields"])</h2></header><div class="hrms-table-wrap"><table class="hrms-table"><caption class="hrms-sr-only">@(L["prv.records"])</caption><thead><tr><th scope="col" class="text-center">#</th><th scope="col">@(L["prv.field"])</th><th scope="col">@(L["pr.source"])</th><th scope="col">@(L["prv.format"])</th></tr>
</thead>
<tbody><tr><td data-label="#" class="text-center">1</td><td data-label="@L["prv.field"]">@(L["prv.employer_code"])</td><td data-label="@L["pr.source"]">@(L["prv.company_account_wps_employer_code"])</td><td data-label="@L["prv.format"]">@(L["prv.text"])</td></tr>
<tr><td data-label="#" class="text-center">2</td><td data-label="@L["prv.field"]">@(L["prv.employee_code"])</td><td data-label="@L["pr.source"]">@(L["prv.employee_emp_code"])</td><td data-label="@L["prv.format"]">@(L["prv.text"])</td></tr>
<tr><td data-label="#" class="text-center">3</td><td data-label="@L["prv.field"]">@(L["prv.civil_id"])</td><td data-label="@L["pr.source"]">@(L["prv.kuwait_compliance_civil_id"])</td><td data-label="@L["prv.format"]">@(L["prv.0_digits", "12"])</td></tr>
<tr><td data-label="#" class="text-center">4</td><td data-label="@L["prv.field"]">@(L["prv.employee_name"])</td><td data-label="@L["pr.source"]">@(L["prv.employee_full_name"])</td><td data-label="@L["prv.format"]">@(L["prv.text_max_0", "70"])</td></tr>
<tr><td data-label="#" class="text-center">5</td><td data-label="@L["prv.field"]">@(L["prv.bank_code"])</td><td data-label="@L["pr.source"]">@(L["prv.bank_wps_code"])</td><td data-label="@L["prv.format"]">@(L["prv.text"])</td></tr>
<tr><td data-label="#" class="text-center">6</td><td data-label="@L["prv.field"]">IBAN</td><td data-label="@L["pr.source"]">@(L["pr.employee_bank_account"])</td><td data-label="@L["prv.format"]">@(L["prv.0_chars", "30"])</td></tr>
<tr><td data-label="#" class="text-center">7</td><td data-label="@L["prv.field"]">@(L["prv.net_amount"])</td><td data-label="@L["pr.source"]">@(L["prv.run_net_salary"])</td><td data-label="@L["prv.format"]">0.000</td></tr>
<tr><td data-label="#" class="text-center">8</td><td data-label="@L["prv.field"]">@(L["pr.period"])</td><td data-label="@L["pr.source"]">@(L["prv.run_period"])</td><td data-label="@L["prv.format"]">YYYYMM</td></tr>
</tbody>
</table>
</div>
</section>
<section class="hrms-card hrms-panel "><header class="hrms-panel__head"><h2 class="hrms-panel__title">@(L["prv.sample_output"])</h2></header><div class="pr-code">EmployerCode,EmployeeCode,CivilID,Name,BankCode,IBAN,Amount,Period
E-458812,E1001,2XXXXXXXXXX1,Ahmed Hassan,NBK,KW74NBOK…3388,1087.425,202609
E-458812,E1003,2XXXXXXXXXX9,Rahul Menon,KFH,KW12KFHO…9021,1000.000,202609</div>
</section>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
