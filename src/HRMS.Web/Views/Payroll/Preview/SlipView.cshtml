@* Generated by payroll-src/preview_views.py from the payroll prototype - a design preview, not yet functional. *@
@{
    ViewData["Title"] = "Payslip · Ahmed Hassan · September 2026";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = PayrollNav.SectionOfSlug("slip-view")?.Key;
    ViewData["BackUrl"] = Url.Content("~/payroll/preview/slip-employee");
    ViewData["BackLabel"] = L["prv.back_to_payslips"];
}
@section PageActions {
<button type="button" class="btn btn-outline-secondary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg><span>@(L["prv.print"])</span></button><button type="button" class="btn btn-primary" ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12"/><polyline points="7,10 12,15 17,10"/><path d="M4 20h16"/></svg><span>@(L["prv.download_pdf"])</span></button>
}
@await Html.PartialAsync("_PreviewBanner")
<div class="pr-preview" data-preview>
<div class="pr-payslip"><div class="pr-payslip__head"><div><div class="pr-payslip__co">@(L["prv.demo_trading_co"])</div>
<div class="hrms-text-sm hrms-muted">@(L["prv.shuwaikh_industrial_kuwait_cr_0", "123456"])</div>
</div>
<div class="pr-payslip__ar"><div class="pr-payslip__co">شركة ديمو للتجارة</div>
<div class="hrms-text-sm hrms-muted">الشويخ الصناعية، الكويت</div>
</div>
</div>
<div class="pr-payslip__title">@(L["prv.payslip_september_0", "2026"]) <span class="pr-payslip__ar">كشف راتب - سبتمبر ٢٠٢٦</span></div>
<dl class="pr-dl"><div><dt>@(L["pr.employee"])</dt><dd>Ahmed Hassan</dd></div>
<div><dt>@(L["common.code"])</dt><dd>E1001</dd></div>
<div><dt>@(L["prv.civil_id"])</dt><dd>2XXXXXXXXXX1</dd></div>
<div><dt>@(L["common.department"])</dt><dd>@(L["prv.finance"])</dd></div>
<div><dt>@(L["prv.designation"])</dt><dd>@(L["prv.senior_accountant"])</dd></div>
<div><dt>@(L["prv.bank"])</dt><dd>NBK · KW74 NBOK … 3388</dd></div>
<div><dt>@(L["pr.working_days"])</dt><dd>26</dd></div>
<div><dt>@(L["pr.pay_date"])</dt><dd>@(L["prv.0_sep_1", "29", "2026"])</dd></div>
</dl><div class="pr-payslip__grid mt-3"><table><thead><tr><th>@(L["pr.earnings"]) <span class="pr-payslip__ar" style="float:right">الاستحقاقات</span></th><th class="pr-money">KWD</th></tr>
</thead>
<tbody><tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.basic_salary"])</span><span class="pr-payslip__ar hrms-muted">الراتب الأساسي</span></div>
</td><td class="pr-money">900.000</td></tr>
<tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.housing_allowance"])</span><span class="pr-payslip__ar hrms-muted">بدل السكن</span></div>
</td><td class="pr-money">200.000</td></tr>
<tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.transportation_allowance"])</span><span class="pr-payslip__ar hrms-muted">بدل المواصلات</span></div>
</td><td class="pr-money">60.000</td></tr>
<tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.food_allowance"])</span><span class="pr-payslip__ar hrms-muted">بدل الطعام</span></div>
</td><td class="pr-money">40.000</td></tr>
<tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.telephone_allowance"])</span><span class="pr-payslip__ar hrms-muted">بدل الهاتف</span></div>
</td><td class="pr-money">15.000</td></tr>
<tr class="is-total"><td>@(L["prv.total"])</td><td class="pr-money">1,215.000</td></tr>
</tbody>
</table>
<table><thead><tr><th>@(L["pr.deductions"]) <span class="pr-payslip__ar" style="float:right">الاستقطاعات</span></th><th class="pr-money">KWD</th></tr>
</thead>
<tbody><tr><td><div class="d-flex justify-content-between gap-2"><span>@(L["prv.social_security_pifss"])</span><span class="pr-payslip__ar hrms-muted">التأمينات الاجتماعية</span></div>
</td><td class="pr-money">127.575</td></tr>
<tr class="is-total"><td>@(L["prv.total"])</td><td class="pr-money">127.575</td></tr>
</tbody>
</table>
</div>
<div class="pr-payslip__net"><span>@(L["prv.net_salary"]) <span class="pr-payslip__ar">صافي الراتب</span></span><strong>KWD 1,087.425</strong></div>
<div class="pr-payslip__foot"><span>@(L["prv.one_thousand_eighty_seven_kuwaiti_dinars_and_0_fils", "425"])</span><span>@(L["prv.generated_0_sep_1_dtc_2_3_4_computer_generated_no_signat", "29", "2026", "2026", "09", "01"])</span></div>
</div>
        
</div>
@section Scripts {
    <script src="~/js/payroll-preview.js" asp-append-version="true"></script>
}
