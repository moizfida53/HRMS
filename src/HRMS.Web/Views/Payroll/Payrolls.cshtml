@using HRMS.Web.Models.Payroll
@using HRMS.Domain.Payroll
@model CalendarPageModel
@{
    // Payroll Processing > Payrolls: the open payrolls and their stage. Opening one goes
    // straight to the page of its stage (Register, Validation or Approval) - nothing else.
    ViewData["Title"] = "Payrolls";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["PayrollPage"] = "payrolls";
    ViewData["Subtitle"] = L["pr.payrolls_subtitle"];
    var selectedMonth = Model.SelectedMonth?.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
    var stageOptions = new[] { RunStage.Registered, RunStage.Validation, RunStage.AwaitingApproval, RunStage.Closed, RunStage.Cancelled };
}
<div class="pr-stack" data-pr-page="payrolls">
    @* saved drafts first (Create Payroll > Save draft): continue where you left off *@
    @if (Model.DraftGroups.Count > 0)
    {
        <section class="hrms-card pr-drafts" aria-labelledby="pr-drafts-title">
            <div class="pr-drafts__head">
                <span class="pr-drafts__icon" aria-hidden="true">@Html.Icon("save", 18)</span>
                <div>
                    <h2 class="pr-card-title mb-0" id="pr-drafts-title">@L["pr.cr_saved_drafts"]</h2>
                    <p class="hrms-muted hrms-text-sm mb-0">@L["pr.cr_saved_drafts_text"]</p>
                </div>
            </div>
            <ul class="pr-drafts__list list-unstyled mb-0">
                @foreach (var g in Model.DraftGroups)
                {
                    <li class="pr-drafts__item">
                        <div class="pr-drafts__main">
                            <strong>@L.MonthYear(g.RunMonth)</strong>
                            <span class="hrms-badge hrms-badge--@(g.RunType == RunType.Regular ? "info" : "purple")"><span class="hrms-badge__dot"></span>@L.Tr(RunType.Label(g.RunType))</span>
                            <span class="pr-drafts__meta">@string.Join(", ", g.Calendars) · @L["pr.saved_0", L.Date(g.LastSaved)]</span>
                        </div>
                        <a class="btn btn-sm btn-primary" href="@Url.Action("Create", "Payroll", new { drafts = string.Join(",", g.Ids) })">@Html.Icon("chevron-right", 14)<span>@L["pr.continue"]</span></a>
                    </li>
                }
            </ul>
        </section>
    }
    <section class="hrms-card" data-runs data-url="@Url.Action("RunsGrid", "Payroll")" data-mode="payrolls">
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <select class="form-select pr-filter" data-runs-stage data-searchable aria-label="@L["pr.stage"]">
                    <option value="LIVE" selected="@(Model.SelectedStage == "LIVE")">@L["pr.open_payrolls"]</option>
                    @foreach (var s in stageOptions)
                    {
                        <option value="@s" selected="@(Model.SelectedStage == s)">@L.Tr(RunStage.Label(s))</option>
                    }
                    <option value="" selected="@(Model.SelectedStage == "")">@L["pr.all_stages"]</option>
                </select>
                <label class="form-check pr-pending-check">
                    <input class="form-check-input" type="checkbox" data-runs-pending checked="@Model.PayslipPending" />
                    <span class="form-check-label">@L["pr.pending_generate_payslips"]</span>
                </label>
                <select class="form-select pr-filter" data-runs-month data-searchable aria-label="@L["pr.period"]">
                    <option value="all" selected="@(selectedMonth is null)">@L["pr.all_periods"]</option>
                    @foreach (var m in Model.Months)
                    {
                        var v = m.RunMonth.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
                        <option value="@v" selected="@(v == selectedMonth)">@L.MonthYear(m.RunMonth)</option>
                    }
                </select>
            </div>
            <div class="hrms-card__count" data-runs-count></div>
        </div>
        <div data-runs-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
        <div class="hrms-card__footer">
            <span class="hrms-muted hrms-text-sm">@L["pr.run_name_company_code_year_month_number_of_the_payroll_f"]</span>
        </div>
    </section>
</div>
@await Html.PartialAsync("_Modals")

@section PageActions {
    @if (Model.CanProcess)
    {
        <a class="btn btn-primary" asp-controller="Payroll" asp-action="Create">@Html.Icon("plus", 15)<span>@L["pr.create_payroll"]</span></a>
    }
}
@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
