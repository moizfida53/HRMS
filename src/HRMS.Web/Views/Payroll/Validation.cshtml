@model RunPageModel
@{
    ViewData["Title"] = "Payroll Validation";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["Subtitle"] = L["pr.checks_on_the_selected_payroll_errors_block_approval"];
    var run = Model.Run!;
    var inValidation = run.Stage == RunStage.Validation;
    var open = run.WarningCount - run.AcknowledgedCount;
}
@{
    // Payroll Processing sub-section in the sidebar; a payroll shows only the page of its own stage, so no tab rail.
    ViewData["PayrollPage"] = "validation";
    ViewData["BackUrl"] = Url.Action("Payrolls", "Payroll");
    ViewData["BackLabel"] = "Payrolls";
}

<div class="pr-stack" data-pr-page="validation">
    @await Html.PartialAsync("_RunBar", Model.Bar)
    @if (!inValidation)
    {
        <div class="pr-banner pr-banner--lock">@Html.Icon("lock", 18)<div><strong>@L["pr.validation_is_complete"]</strong> @L["pr.the_payroll_has_moved_on_this_screen_is_read_only"]</div></div>
    }
    <section class="pr-kpis pr-kpis--4" aria-label="@L["pr.key_figures"]">
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["pr.errors"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("x-circle", 16)</span></div>
            <div class="hrms-kpi__value @(run.ErrorCount > 0 ? "pr-neg" : null)">@run.ErrorCount</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["pr.block_approval"]</span></div>
        </div>
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["pr.warnings"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("alert", 16)</span></div>
            <div class="hrms-kpi__value">@run.WarningCount</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["pr.0_acknowledged_1_open", run.AcknowledgedCount, open]</span></div>
        </div>
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["pr.net_pay"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("bank", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Money(run.TotalNet)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["pr.kwd_0_employees", PayrollFormat.Count(run.EmployeeCount)]</span></div>
        </div>
        <div class="hrms-card hrms-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["pr.last_run"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("clock", 16)</span></div>
            <div class="hrms-kpi__value">@(run.ValidatedDate is { } vd ? vd.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "—")</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L.Date(run.ValidatedDate)</span></div>
        </div>
    </section>
    @if (run.ErrorCount > 0)
    {
        <div class="pr-banner pr-banner--err">@Html.Icon("x-circle", 18)<div><strong>@L["pr.0_errors_must_be_fixed_before_this_payroll_can_be_submit", run.ErrorCount]</strong> @L["pr.go_back_to_the_register_to_exclude_the_employee_or_corre"]</div></div>
    }
    else if (inValidation)
    {
        <div class="pr-banner pr-banner--ok">@Html.Icon("check", 18)<div><strong>@L["pr.no_errors"]</strong> @L["pr.review_the_warnings_acknowledge_the_ones_you_accept_then"]</div></div>
    }
    <div class="hrms-card" data-issues>
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <label class="hrms-search" style="max-width:300px;flex:1 1 200px">
                    @Html.Icon("search", 16)
                    <input type="search" data-issue-search autocomplete="off" placeholder="@L["pr.search_issue_or_employee"]" aria-label="@L["pr.search_issue_or_employee"]" />
                </label>
                <select class="form-select" style="width:auto" data-issue-severity aria-label="@L["pr.severity"]">
                    <option value="">@L["pr.all_severities"]</option>
                    <option value="ERROR">@L["pr.errors"]</option>
                    <option value="WARNING">@L["pr.warnings"]</option>
                </select>
                <select class="form-select" style="width:auto" data-issue-status aria-label="@L["common.status"]">
                    <option value="">@L["pr.all"]</option>
                    <option value="OPEN">@L["pr.open"]</option>
                    <option value="ACK">@L["pr.acknowledged"]</option>
                </select>
            </div>
            <div class="hrms-card__count" data-issue-count></div>
        </div>
        <div data-issues-slot><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </div>
</div>

@if (inValidation && Model.CanProcess)
{
    <div class="pr-actionbar">
        <div class="pr-actionbar__status"><span class="hrms-badge hrms-badge--warning"><span class="hrms-badge__dot"></span>@L["pr.validation"]</span></div>
        <div class="pr-actionbar__spacer"></div>
        <button type="button" class="btn btn-outline-secondary" data-run-stage="@RunStage.Registered">@Html.Icon("undo", 15)<span>@L["pr.back_to_register"]</span></button>
        <button type="button" class="btn btn-outline-secondary" data-run-revalidate>@Html.Icon("refresh", 15)<span>@L["pr.revalidate"]</span></button>
        <button type="button" class="btn btn-primary" data-run-stage="@RunStage.AwaitingApproval" disabled="@(run.ErrorCount > 0)">@Html.Icon("send", 15)<span>@L["pr.submit_for_approval"]</span></button>
    </div>
}

@await Html.PartialAsync("_RunUrls", run)
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
