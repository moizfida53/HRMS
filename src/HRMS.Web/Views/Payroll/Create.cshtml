@model CreatePageModel
@{
    ViewData["Title"] = "Payroll Processing";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "processing";
    ViewData["Subtitle"] = L["pr.create_a_payroll_in_four_steps"];
    var draft = Model.Draft;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string[] steps = [L["pr.scope"], L["common.employees"], L["pr.check"], L["common.create"]];
}
@await Html.PartialAsync("_Tabs", "create")

<div class="pr-stack" data-pr-page="create"
     data-run="@(draft?.PayrollRunId)"
     data-urls-calendars="@Url.Action("CalendarsFor", "Payroll")"
     data-urls-periods="@Url.Action("Periods", "Payroll")"
     data-urls-next="@Url.Action("NextCode", "Payroll")"
     data-urls-draft="@Url.Action("DraftSave", "Payroll")"
     data-urls-discard="@Url.Action("DraftDiscard", "Payroll")"
     data-urls-finalize="@Url.Action("FinalizeRun", "Payroll")"
     data-urls-employees="@Url.Action("EmployeesGrid", "Payroll")"
     data-urls-lines="@Url.Action("Lines", "Payroll")"
     data-urls-components="@Url.Action("Components", "Payroll")"
     data-urls-kpis="@Url.Action("Kpis", "Payroll")"
     data-urls-check="@Url.Action("Check", "Payroll")"
     data-urls-excluded="@Url.Action("Excluded", "Payroll")"
     data-urls-addline="@Url.Action("AddLine", "Payroll")"
     data-urls-removeline="@Url.Action("RemoveLine", "Payroll")"
     data-urls-exclude="@Url.Action("Exclude", "Payroll")"
     data-urls-include="@Url.Action("Include", "Payroll")"
     data-urls-open="@Url.Action("Open", "Payroll", new { id = 0 })">

    @if (draft is null && Model.Drafts.Count > 0)
    {
        var d = Model.Drafts[0];
        <div class="pr-banner pr-banner--info" data-draft-banner>
            @Html.Icon("info", 18)
            <div class="flex-grow-1">
                <strong>@L["pr.you_have_an_unfinished_payroll"]</strong> -
                @PayrollFormat.Calendar(L, d.CalendarName, null) · @PayrollFormat.Period(L, d.PayFrequency, d.PeriodNumber, d.StartDate, d.EndDate, new DateTime(d.EndDate.Year, d.EndDate.Month, 1)) ·
                @L.Tr(RunType.Label(d.RunType)) · @L["pr.saved_0", L.Date(d.LastSaved)]
                <div class="mt-2 d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-primary" href="@Url.Action("Create", "Payroll", new { draft = d.PayrollRunId })">@L["pr.continue"]</a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-draft-discard="@d.PayrollRunId">@L["pr.discard_draft"]</button>
                </div>
            </div>
        </div>
    }

    @if (Model.Companies.Count == 0)
    {
        <div class="pr-banner pr-banner--err">@Html.Icon("x-circle", 18)<div>@L["pr.no_company_is_available_for_your_account"]</div></div>
    }

    <div class="hrms-wizard-steps" role="list" data-wizard-steps>
        @for (var i = 0; i < steps.Length; i++)
        {
            if (i > 0)
            {
                <div class="hrms-wizard-step__line" aria-hidden="true"></div>
            }
            <div class="hrms-wizard-step @(i == 0 ? "is-active" : null)" role="listitem" data-step-head="@i">
                <span class="hrms-wizard-step__circle">@(i + 1)</span>
                <span class="hrms-wizard-step__label">@steps[i]</span>
            </div>
        }
    </div>

    <div class="hrms-card">
        <div class="pr-wizard-body">
            @* ===================================================== 1. scope *@
            <div data-step-pane="0">
                <h2 class="pr-card-title">1. @steps[0]</h2>
                <fieldset class="hrms-fieldset">
                    <legend>@L["pr.scope"]</legend>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="cr-company">@L["common.company"] <span class="req" aria-hidden="true">*</span></label>
                            <select class="form-select" id="cr-company" data-cr-company>
                                @foreach (var c in Model.Companies)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CompanyId)">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cr-calendar">@L["pr.payroll_calendar"] <span class="req" aria-hidden="true">*</span></label>
                            <select class="form-select" id="cr-calendar" data-cr-calendar>
                                @foreach (var c in Model.Calendars)
                                {
                                    var sel = draft is not null ? c.PayrollCalendarId == draft.PayrollCalendarId : c.IsDefault;
                                    <option value="@c.PayrollCalendarId" selected="@sel">@PayrollFormat.Calendar(L, c.CalendarName, c.ArabicName)</option>
                                }
                            </select>
                            <span class="field-validation-error" data-cr-error="calendar" hidden>@L["pr.add_a_payroll_calendar_for_this_company_first_payroll_ca"]</span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cr-period">@L["pr.period"] <span class="req" aria-hidden="true">*</span></label>
                            <select class="form-select" id="cr-period" data-cr-period data-selected="@(draft?.PayrollPeriodId)"></select>
                            <span class="form-text">@L["pr.open_periods_and_periods_whose_regular_payroll_is_closed"]</span>
                            <span class="field-validation-error" data-cr-error="period" hidden>@L["pr.no_open_period_generate_periods_on_the_payroll_calendar"]</span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="cr-name">@L["pr.payroll_name"]</label>
                            <div class="input-group">
                                <span class="input-group-text">@Html.Icon("lock", 14)</span>
                                <input type="text" class="form-control pr-runname" id="cr-name" data-cr-name readonly aria-describedby="cr-name-hint" />
                            </div>
                            <span class="form-text" id="cr-name-hint" data-cr-name-hint>@L["pr.generated_company_code_year_month_running_number_for_thi"]</span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="cr-desc">@L["org.description"] <span class="req" aria-hidden="true" data-cr-desc-req hidden>*</span></label>
                            <textarea class="form-control" id="cr-desc" rows="2" maxlength="500" data-cr-desc
                                      placeholder="@L["pr.why_is_this_payroll_being_generated_e_g_q3_sales_commiss"]">@draft?.Description</textarea>
                            <span class="form-text" data-cr-desc-hint></span>
                            <span class="field-validation-error" data-cr-error="desc" hidden>@L["pr.enter_the_reason_for_this_payroll_it_is_not_the_first_pa"]</span>
                        </div>
                    </div>
                </fieldset>
                <p class="pr-section-label mt-2">@L["pr.payroll_type"]</p>
                <div class="pr-choice" data-cr-type>
                    <label class="@(draft is null || draft.RunType == RunType.Regular ? "is-selected" : null)">
                        <input type="radio" name="cr-type" value="@RunType.Regular" class="form-check-input" checked="@(draft is null || draft.RunType == RunType.Regular)" />
                        <span><strong>@L["pr.regular"]</strong><span>@L["pr.the_payroll_of_the_period_salary_earnings_deductions_loa"]</span></span>
                    </label>
                    <label class="@(draft?.RunType == RunType.OffCycle ? "is-selected" : null)">
                        <input type="radio" name="cr-type" value="@RunType.OffCycle" class="form-check-input" checked="@(draft?.RunType == RunType.OffCycle)" />
                        <span><strong>@L["pr.off_cycle"]</strong><span>@L["pr.bonus_correction_or_arrears_outside_the_regular_payroll"]</span></span>
                    </label>
                    <label class="is-disabled" title="@L["pr.final_settlements_are_created_from_the_final_settlement"]">
                        <input type="radio" name="cr-type" value="SETTLEMENT" class="form-check-input" disabled />
                        <span><strong>@L["pr.final_settlement"]</strong><span>@L["pr.created_from_the_final_settlement_screen"]</span></span>
                    </label>
                </div>
                <div class="mt-3" data-cr-regular-exists hidden>
                    <div class="pr-banner pr-banner--lock">@Html.Icon("alert", 18)<div><strong>@L["pr.a_regular_payroll_already_exists_for_this_calendar_and_p"]</strong> (<span data-cr-regular-code></span>). @L["pr.choose_off_cycle_for_a_second_payroll_or_cancel_the_exis"]</div></div>
                </div>
            </div>

            @* ================================================= 2. employees *@
            <div data-step-pane="1" hidden>
                <h2 class="pr-card-title">2. @steps[1]</h2>
                <fieldset class="hrms-fieldset">
                    <legend>@L["pr.who_is_included"]</legend>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="cr-loc">@L["common.location"]</label>
                            <select class="form-select" id="cr-loc" data-cr-scope="ScopeWorkLocationId">
                                <option value="">@L["pr.all_locations"]</option>
                                @foreach (var x in Model.Locations)
                                {
                                    <option value="@x.Id" selected="@(draft?.ScopeWorkLocationId == x.Id)">@x.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="cr-dept">@L["common.department"]</label>
                            <select class="form-select" id="cr-dept" data-cr-scope="ScopeDepartmentId">
                                <option value="">@L["pr.all_departments"]</option>
                                @foreach (var x in Model.Departments)
                                {
                                    <option value="@x.Id" selected="@(draft?.ScopeDepartmentId == x.Id)">@x.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="cr-etype">@L["pr.employment_type"]</label>
                            <select class="form-select" id="cr-etype" data-cr-scope="ScopeEmploymentType">
                                <option value="">@L["pr.all_types"]</option>
                                @foreach (var x in new[] { "Full-Time", "Part-Time", "Temporary", "Contract" })
                                {
                                    <option value="@x" selected="@(draft?.ScopeEmploymentType == x)">@L.Tr(x)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="cr-nat">@L["emp.nationality"]</label>
                            <select class="form-select" id="cr-nat" data-cr-scope="ScopeNationality">
                                <option value="">@L["pr.all"]</option>
                                <option value="KUWAITI" selected="@(draft?.ScopeNationality == "KUWAITI")">@L["pr.kuwaiti"]</option>
                                <option value="NON_KUWAITI" selected="@(draft?.ScopeNationality == "NON_KUWAITI")">@L["pr.non_kuwaiti"]</option>
                            </select>
                        </div>
                    </div>
                </fieldset>
                <div data-kpis-slot></div>
                <div class="hrms-card mt-3" data-employees data-mode="create">
                    @await Html.PartialAsync("_EmployeesToolbar", true)
                    <div data-employees-slot></div>
                </div>
                <div class="mt-3" data-excluded-slot></div>
            </div>

            @* ===================================================== 3. check *@
            <div data-step-pane="2" hidden>
                <h2 class="pr-card-title">3. @steps[2]</h2>
                <div data-check-slot></div>
            </div>

            @* ==================================================== 4. create *@
            <div data-step-pane="3" hidden>
                <div class="text-center py-3">
                    <h2 class="pr-card-title">@L["pr.ready_to_create_the_payroll"]</h2>
                    <p class="hrms-muted mb-1">@L["pr.the_payroll_is_created_as_registered_review_it_in_the_pa"]</p>
                    <div class="pr-runname-big" data-cr-final-name></div>
                </div>
                <div data-final-kpis></div>
            </div>
        </div>
    </div>

    <div class="pr-actionbar">
        <div class="pr-actionbar__status"><span data-cr-status>@L["pr.nothing_is_saved_until_you_press_next"]</span></div>
        <div class="pr-actionbar__spacer"></div>
        <button type="button" class="btn btn-outline-danger" data-cr-discard hidden>@Html.Icon("trash", 15)<span>@L["pr.discard_draft"]</span></button>
        <button type="button" class="btn btn-outline-secondary" data-step-back disabled>@Html.Icon("chevron-left", 15)<span>@L["layout.back"]</span></button>
        <button type="button" class="btn btn-primary" data-step-next>@L["emp.next"]@Html.Icon("chevron-right", 15)</button>
        <button type="button" class="btn btn-primary" data-cr-finalize hidden>@Html.Icon("calculator", 15)<span>@L["pr.create_payroll_2"]</span></button>
    </div>
</div>

<div hidden data-cr-text
     data-saved="@L["pr.draft_saved_0"]"
     data-calculating="@L["pr.calculating"]"
     data-desc-optional="@L["pr.optional_this_is_the_first_payroll_of_the_month"]"
     data-desc-required="@L["pr.required_the_month_already_has_payrolls_or_this_is_not_a"]"
     data-no-calendar="@L["pr.no_payroll_calendar"]"
     data-no-period="@L["pr.no_open_period"]"></div>

@await Html.PartialAsync("_LineDialogs")
@await Html.PartialAsync("_Modals")

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
