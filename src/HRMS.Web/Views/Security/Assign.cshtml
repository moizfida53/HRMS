@using HRMS.Web.Models.Security
@model AssignPageModel
@{
    // Security > Assign Roles (db/57): every user with their roles; Assign roles opens a popup.
    ViewData["Title"] = "Assign Roles";
    ViewData["ActiveArea"] = "security";
    ViewData["SecurityPage"] = "assign";
    ViewData["Subtitle"] = L["sec.assign_subtitle"];
}
<div class="sec-page" data-sec-assign
     data-urls-grid="@Url.Action("UsersGrid", "Security")"
     data-urls-panel="@Url.Action("UserPanel", "Security")"
     data-urls-save="@Url.Action("SaveUserRoles", "Security")">
    <section class="hrms-card" data-sec-users>
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <span class="sec-toolbar-icon" aria-hidden="true">@Html.Icon("user-check", 18)</span>
                <label class="hrms-search sec-users__search">
                    @Html.Icon("search", 16)
                    <input type="search" data-sec-user-search autocomplete="off" placeholder="@L["sec.search_users"]" aria-label="@L["sec.search_users"]" />
                </label>
                <select class="form-select sec-users__role" data-sec-user-role data-searchable aria-label="@L["sec.role"]">
                    <option value="">@L["sec.all_roles"]</option>
                    <option value="none">@L["sec.no_role"]</option>
                    @foreach (var (rref, name) in Model.Roles)
                    {
                        <option value="@rref">@name</option>
                    }
                </select>
            </div>
            <div class="hrms-card__count" data-sec-user-count></div>
        </div>
        <div data-sec-users-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>
@Html.AntiForgeryToken()

<div class="modal fade sec-modal" id="sec-user-modal" tabindex="-1" aria-hidden="true" aria-labelledby="sec-user-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="sec-user-modal-title" data-sec-modal-title>@L["sec.assign_roles"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-sec-modal-body></div>
            <div class="modal-footer" data-sec-modal-footer>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                @if (Model.CanAssign)
                {
                    <button type="button" class="btn btn-primary" data-sec-user-save disabled>@Html.Icon("check", 15)<span>@L["sec.save_roles"]</span></button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/security.js" asp-append-version="true"></script>
}
