@using HRMS.Web.Models.Organization
@model SettingsGridModel<GLMapping>
@{
    var pg = Model.Page;
    var countText = pg.TotalCount == 1 ? L["st.1_mapping"] : L["prv.0_mappings", PayrollFormat.Count(pg.TotalCount)];
}
<div data-total="@pg.TotalCount" data-count-text="@countText">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "book", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["st.no_mappings_yet"])</p>
        <p class="hrms-empty__text">@L["prv.a_component_s_own_gl_code_salary_components_is_the_defau"]</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table st-table">
            <caption class="hrms-sr-only">@L["st.gl_mappings"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["prv.component"]</th>
                    <th scope="col" class="col-p2">@L["prv.cost_center"]</th>
                    <th scope="col">@L["prv.debit_gl"]</th>
                    <th scope="col">@L["prv.credit_gl"]</th>
                    <th scope="col">@L["common.status"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in pg.Items)
                {
                    var name = g.ComponentName + (g.CostCenterName is null ? "" : " · " + g.CostCenterName);
                    <tr data-id="@g.GLMappingId" data-name="@name" class="@(g.IsActive ? null : "is-ended")">
                        <td data-label="@L["prv.component"]">
                            <span class="hrms-table__primary">@g.ComponentName</span>
                            <span class="pr-emp-sub"><span class="hrms-code-chip">@g.ComponentCode</span> · @(g.ComponentType == "DEDUCTION" ? L["pr.deductions"] : L["pr.earnings"])@(Model.ManyCompanies ? " · " + g.CompanyName : "")</span>
                        </td>
                        <td data-label="@L["prv.cost_center"]" class="col-p2">@(g.CostCenterName ?? (string)L["prv.any_2"])</td>
                        <td data-label="@L["prv.debit_gl"]"><span class="font-monospace">@g.DebitAccountCode</span><span class="pr-emp-sub">@g.DebitAccountName</span></td>
                        <td data-label="@L["prv.credit_gl"]"><span class="font-monospace">@g.CreditAccountCode</span><span class="pr-emp-sub">@g.CreditAccountName</span></td>
                        <td data-label="@L["common.status"]">@await Html.PartialAsync("_Status", g.IsActive)</td>
                        <td class="hrms-table__actions">@await Html.PartialAsync("_RowActions", (Model.Rights, name, g.IsActive))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount, FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
