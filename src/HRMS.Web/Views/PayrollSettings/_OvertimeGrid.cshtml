@using HRMS.Web.Models.Organization
@model SettingsGridModel<OvertimeRate>
@{
    var pg = Model.Page;
    var countText = pg.TotalCount == 1 ? L["st.1_rate"] : L["st.0_rates", PayrollFormat.Count(pg.TotalCount)];
}
<div data-total="@pg.TotalCount" data-count-text="@countText">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "clock", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["st.no_rates_yet"])</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table st-table">
            <caption class="hrms-sr-only">@L["st.overtime_rates"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["st.overtime"]</th>
                    <th scope="col">@L["st.applies_to"]</th>
                    <th scope="col" class="text-end">@L["st.multiplier"]</th>
                    <th scope="col" class="col-p2">@L["st.hourly_rate"]</th>
                    <th scope="col" class="col-p3">@L["st.limits"]</th>
                    <th scope="col" class="col-p2">@L["st.effective"]</th>
                    <th scope="col">@L["st.verified"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in pg.Items)
                {
                    <tr data-id="@r.OvertimeRateId" data-name="@r.OvertimeName" class="@(r.IsActive ? null : "is-ended")">
                        <td data-label="@L["st.overtime"]">
                            <span class="hrms-table__primary">@r.OvertimeName</span>
                            <span class="pr-emp-sub">@L[StatutoryFormat.OvertimeKey(r.OvertimeCode)]@(r.IsActive ? "" : " · " + L["org.inactive"])</span>
                        </td>
                        <td data-label="@L["st.applies_to"]">
                            @if (r.IsCompanyOverride)
                            {
                                <span class="hrms-badge hrms-badge--purple"><span class="hrms-badge__dot"></span>@r.CompanyName</span>
                            }
                            else
                            {
                                <span class="hrms-badge hrms-badge--info"><span class="hrms-badge__dot"></span>@L["st.statutory_default"]</span>
                            }
                        </td>
                        <td data-label="@L["st.multiplier"]" class="text-end hrms-numeric"><strong>× @StatutoryFormat.Num(r.Multiplier)</strong></td>
                        <td data-label="@L["st.hourly_rate"]" class="col-p2 hrms-text-sm">@L["st.hourly_rate_formula", StatutoryFormat.Num(r.HourlyRateDivisorDays), StatutoryFormat.Num(r.HoursPerDay)]</td>
                        <td data-label="@L["st.limits"]" class="col-p3 hrms-text-sm">
                            @(r.MaxHoursPerDay is { } d ? L["st.n_hours_day", StatutoryFormat.Num(d)] : "—")@(r.MaxHoursPerYear is { } y ? " · " + L["st.n_hours_year", y] : "")
                        </td>
                        <td data-label="@L["st.effective"]" class="col-p2 hrms-text-sm">@await Html.PartialAsync("_Effective", (r.EffectiveFrom, r.EffectiveTo, r.IsCurrent && r.IsActive))</td>
                        <td data-label="@L["st.verified"]">@await Html.PartialAsync("_Verified", r.IsVerified)</td>
                        <td class="hrms-table__actions">@await Html.PartialAsync("_RowActions", (Model.Rights, r.OvertimeName, r.IsActive))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount, FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
