@* Move up / move down / remove of an ordered line (payroll-settings.js renumbers the rows). *@
<div class="st-line-actions">
    <button type="button" class="btn-icon" data-st-line-up title="@L["st.move_up"]" aria-label="@L["st.move_up"]"><span class="st-flip">@Html.Icon("chevron-down", 14)</span></button>
    <button type="button" class="btn-icon" data-st-line-down title="@L["st.move_down"]" aria-label="@L["st.move_down"]">@Html.Icon("chevron-down", 14)</button>
    <button type="button" class="btn-icon btn-icon--danger" data-st-line-remove title="@L["common.delete"]" aria-label="@L["common.delete"]">@Html.Icon("trash", 14)</button>
</div>
