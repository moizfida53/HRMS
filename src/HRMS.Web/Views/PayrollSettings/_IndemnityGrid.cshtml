@using HRMS.Web.Models.Organization
@model SettingsGridModel<IndemnityRuleSet>
@{
    var pg = Model.Page;
    var countText = pg.TotalCount == 1 ? L["st.1_rule_set"] : L["st.0_rule_sets", PayrollFormat.Count(pg.TotalCount)];
}
<div data-total="@pg.TotalCount" data-count-text="@countText">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "exit", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["st.no_rule_sets_yet"])</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table st-table">
            <caption class="hrms-sr-only">@L["st.indemnity_rules"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["st.rule_set"]</th>
                    <th scope="col" class="text-end">@L["st.daily_divisor"]</th>
                    <th scope="col" class="text-end">@L["st.cap_months"]</th>
                    <th scope="col" class="col-p2">@L["st.slabs_factors"]</th>
                    <th scope="col" class="col-p2">@L["st.effective"]</th>
                    <th scope="col">@L["st.verified"]</th>
                    <th scope="col" class="col-p3">@L["common.status"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in pg.Items)
                {
                    <tr data-id="@r.IndemnityRuleSetId" data-name="@r.RuleSetName" class="@(r.IsActive ? null : "is-ended")">
                        <td data-label="@L["st.rule_set"]">
                            <span class="hrms-table__primary">@r.RuleSetName</span>
                            <span class="pr-emp-sub"><span class="hrms-code-chip">@r.RuleSetCode</span></span>
                        </td>
                        <td data-label="@L["st.daily_divisor"]" class="text-end hrms-numeric">@StatutoryFormat.Num(r.DailyWageDivisor)</td>
                        <td data-label="@L["st.cap_months"]" class="text-end hrms-numeric">@StatutoryFormat.Num(r.MaxIndemnityMonths)</td>
                        <td data-label="@L["st.slabs_factors"]" class="col-p2 hrms-text-sm">@L["st.n_slabs_n_factors", r.SlabCount, r.FactorCount]</td>
                        <td data-label="@L["st.effective"]" class="col-p2 hrms-text-sm">@await Html.PartialAsync("_Effective", (r.EffectiveFrom, r.EffectiveTo, r.IsCurrent && r.IsActive))</td>
                        <td data-label="@L["st.verified"]">@await Html.PartialAsync("_Verified", r.IsVerified)</td>
                        <td data-label="@L["common.status"]" class="col-p3">@await Html.PartialAsync("_Status", r.IsActive)</td>
                        <td class="hrms-table__actions">@await Html.PartialAsync("_RowActions", (Model.Rights, r.RuleSetName, r.IsActive))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount, FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
