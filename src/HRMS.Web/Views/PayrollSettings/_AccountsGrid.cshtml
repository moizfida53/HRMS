@using HRMS.Web.Models.Organization
@model SettingsGridModel<CompanyBankAccount>
@{
    var pg = Model.Page;
    var countText = pg.TotalCount == 1 ? L["st.1_account"] : L["st.0_accounts", PayrollFormat.Count(pg.TotalCount)];
}
<div data-total="@pg.TotalCount" data-count-text="@countText">
@if (pg.TotalCount == 0)
{
    <div class="hrms-empty">
        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "wallet", 26)</span>
        <p class="hrms-empty__title">@(Model.IsFiltered ? L["st.no_rates_match"] : L["st.no_accounts_yet"])</p>
        <p class="hrms-empty__text">@L["st.no_accounts_text"]</p>
    </div>
}
else
{
    <div class="hrms-table-wrap">
        <table class="hrms-table st-table">
            <caption class="hrms-sr-only">@L["st.company_accounts"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["st.account"]</th>
                    <th scope="col">@L["st.bank"]</th>
                    <th scope="col">@L["st.iban"]</th>
                    <th scope="col" class="col-p2">@L["st.wps_employer_code"]</th>
                    <th scope="col" class="col-p3">@L["st.pam_file_no"]</th>
                    <th scope="col">@L["common.status"]</th>
                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in pg.Items)
                {
                    <tr data-id="@a.CompanyBankAccountId" data-name="@a.AccountTitle" class="@(a.IsActive ? null : "is-ended")">
                        <td data-label="@L["st.account"]">
                            <span class="hrms-table__primary">@a.AccountTitle</span>
                            @if (a.IsDefault)
                            {
                                <span class="st-inforce">@L["st.default"]</span>
                            }
                            <span class="pr-emp-sub"><span class="hrms-code-chip">@a.AccountCode</span>@(Model.ManyCompanies ? " · " + a.CompanyName : "")@(a.CurrencyCode is not null ? " · " + a.CurrencyCode : "")</span>
                        </td>
                        <td data-label="@L["st.bank"]">@a.BankName<span class="pr-emp-sub font-monospace">@a.SwiftCode</span></td>
                        <td data-label="@L["st.iban"]" class="font-monospace hrms-text-sm" dir="ltr">@(a.Iban is { } iban ? System.Text.RegularExpressions.Regex.Replace(iban, ".{4}(?!$)", "$0 ") : a.AccountNumber)</td>
                        <td data-label="@L["st.wps_employer_code"]" class="col-p2 font-monospace hrms-text-sm">@(a.WpsEmployerCode ?? "—")</td>
                        <td data-label="@L["st.pam_file_no"]" class="col-p3 font-monospace hrms-text-sm">@(a.PamFileNo ?? "—")</td>
                        <td data-label="@L["common.status"]">@await Html.PartialAsync("_Status", a.IsActive)</td>
                        <td class="hrms-table__actions">@await Html.PartialAsync("_RowActions", (Model.Rights, a.AccountTitle, a.IsActive))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
    {
        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount, FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
    })
}
</div>
