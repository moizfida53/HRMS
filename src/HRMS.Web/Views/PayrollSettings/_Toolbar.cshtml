@model SettingsToolbarModel
@* The filter row of a settings list: search, optional selects, the record count badge. *@
<div class="hrms-card__toolbar">
    <div class="hrms-card__filters">
        @if (Model.Title is not null)
        {
            <h2 class="pr-card-title mb-0 me-2">@Model.Title</h2>
        }
        @if (Model.SearchPlaceholder is not null)
        {
            <label class="hrms-search pr-search">
                @Html.Icon("search", 16)
                <input type="search" name="search" data-st-filter autocomplete="off" placeholder="@Model.SearchPlaceholder" aria-label="@Model.SearchPlaceholder" />
            </label>
        }
        @foreach (var f in Model.Filters)
        {
            <select class="form-select pr-filter" name="@f.Name" data-st-filter data-searchable aria-label="@f.Label">
                @foreach (var (value, text) in f.Options)
                {
                    <option value="@value">@text</option>
                }
            </select>
        }
    </div>
    <div class="hrms-card__count" data-st-count></div>
</div>
