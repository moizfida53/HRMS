@model SettingsSwitch
@{ var id = "st-" + Model.Name.ToLowerInvariant(); }
<div class="st-switch form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="@id" name="@(Model.Disabled ? null : Model.Name)" value="true" checked="@Model.Checked" disabled="@Model.Disabled" />
    @* the browser posts nothing for an unticked box - this sends "false" (the checkbox value comes first when ticked);
       a disabled switch posts nothing at all, so its hidden field carries the current value *@
    <input type="hidden" name="@Model.Name" value="@(Model.Disabled ? (Model.Checked ? "true" : "false") : "false")" />
    <label class="form-check-label" for="@id">
        <span class="st-switch__label">@Model.Label</span>
        @if (Model.Hint is not null)
        {
            <span class="st-switch__hint">@Model.Hint</span>
        }
    </label>
</div>
