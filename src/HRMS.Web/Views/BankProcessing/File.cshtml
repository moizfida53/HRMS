@model BankFilePageModel
@{
    // Payroll > Bank Processing > Bank File (db/49-50): the salary (WPS) file of a closed
    // payroll - reviewed per bank, built from the bank format, kept as generated.
    ViewData["Title"] = "Bank File";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "bank";
    ViewData["PayrollPage"] = "bk-file";
    ViewData["Subtitle"] = L["fin.bank_file_subtitle"];
    var run = Model.Run;
    var bank = Model.Review.Where(r => r.Method == "BANK").ToList();
    var cash = Model.Review.FirstOrDefault(r => r.Method == "CASH");
    var missingWps = bank.Count(r => string.IsNullOrEmpty(r.WpsBankCode));
    var unknownBank = bank.FirstOrDefault(r => r.BankId is null);
    var defaultAccount = Model.Accounts.FirstOrDefault(a => a.IsDefault) ?? Model.Accounts.FirstOrDefault();
    var valueDate = (run?.PaymentDate ?? DateTime.Today).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var downloadUrl = Url.Action("Download", "BankProcessing", new { id = 0 })!.Replace("/0/", "/__id__/");

    // db/116: the two-step process (Ministry Payroll, then Company Payroll); null = db/116 not run
    var st = Model.Stages;
    var staged = st?.IsStaged == true;
    var single = st?.IsSingle == true;
    // db/118: posted to the GL = the bank files can no longer be generated again
    var gl = st?.IsGlPosted == true;
    var canGl = Model.CanPostGl;
    // db/123: the Bank transfer tab of a payroll's workspace - the payroll's header instead of the filters
    var ws = ViewData["Workspace"] as WorkspaceNav;
    if (ws is not null)
    {
        ViewData["PayrollSection"] = "processing";
        ViewData["PayrollPage"] = "payrolls";
        ViewData["BackUrl"] = Url.Action("Payrolls", "Payroll");
        ViewData["BackLabel"] = "Payrolls";
    }

    string AuditKey(string a) => a switch { "REGENERATED" => "fin.audit_regenerated", "SENT" => "fin.audit_sent", "PAID" => "fin.audit_paid", "GL_POSTED" => "fin.audit_gl_posted", _ => "fin.audit_generated" };
    string KindKey(string? k) => k switch { "MINISTRY" => "fin.kind_ministry", "COMPANY" => "fin.kind_company", "RETRY" => "fin.kind_retry", _ => "fin.kind_full" };

    // the fields every generate form asks: banks, value date, debit account, format (and the reason when it replaces a file)
    // async: its <option> tags are tag helpers, so the function must return a Task (MVC1006)
    async Task GenerateFields(string px, bool replaces, bool disabled)
    {
        <div class="col-sm-6">
            <label class="form-label" for="@(px)-bank">@L["fin.banks_in_file"]</label>
            <select class="form-select" id="@(px)-bank" name="bank" data-searchable disabled="@disabled">
                <option value="">@L["fin.all_banks"]</option>
                @foreach (var b in bank.Where(b => b.BankId is not null))
                {
                    <option value="@b.BankId">@b.BankName</option>
                }
            </select>
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="@(px)-date">@L["prv.value_date"] <span class="req" aria-hidden="true">*</span></label>
            <input class="form-control" type="date" id="@(px)-date" name="valueDate" value="@valueDate" disabled="@disabled" />
        </div>
        <div class="col-12">
            <label class="form-label" for="@(px)-account">@L["prv.debit_account"] <span class="req" aria-hidden="true">*</span></label>
            <select class="form-select" id="@(px)-account" name="account" data-searchable disabled="@disabled">
                @foreach (var a in Model.Accounts)
                {
                    <option value="@a.CompanyBankAccountId" selected="@(a.CompanyBankAccountId == defaultAccount?.CompanyBankAccountId)">@a.AccountTitle · @a.BankName · @FinanceFormat.Iban(a.Iban)</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="@(px)-format">@L["prv.format"] <span class="req" aria-hidden="true">*</span></label>
            <select class="form-select" id="@(px)-format" name="format" data-searchable disabled="@disabled">
                @foreach (var f in Model.Formats)
                {
                    <option value="@f.BankFileFormatId" selected="@(f.BankFileFormatId == Model.DefaultFormatId)">@f.FormatName@(f.BankName is not null ? " · " + f.BankName : "")@(f.IsDefault ? " · " + L["st.default"] : "")</option>
                }
            </select>
        </div>
        if (replaces)
        {
            <div class="col-12">
                <label class="form-label" for="@(px)-reason">@L["fin.regenerate_reason"] <span class="req" aria-hidden="true">*</span></label>
                <textarea class="form-control" id="@(px)-reason" name="reason" rows="2" maxlength="500" placeholder="@L["prv.regenerating_a_file_asks_for_a_reason"]" disabled="@disabled"></textarea>
            </div>
        }
    }
}
<div class="pr-stack fin-page" data-fin-page data-fin-download="@downloadUrl">
    @if (ws is not null)
    {
        @await Html.PartialAsync("~/Views/Payroll/_RunBar.cshtml", ws)
        @await Html.PartialAsync("~/Views/Payroll/_WsBankNav.cshtml", ws)
    }
    <section class="hrms-card">
        @if (ws is null)
        {
            @await Html.PartialAsync("~/Views/PayrollFinance/_Filters.cshtml", Model.Filters)
        }
        @if (run is null)
        {
            <div class="hrms-empty">
                <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon("bank", 26)</span>
                <p class="hrms-empty__title">@L["fin.no_closed_payrolls"]</p>
                <p class="hrms-empty__text">@L["fin.no_closed_payrolls_text"]</p>
                <a class="btn btn-outline-secondary btn-sm mt-2" href="@Url.Content("~/payroll/payrolls")">@Html.Icon("calculator", 15)<span>@L["pr.open_payroll_processing"]</span></a>
            </div>
        }
        else
        {
            <dl class="fin-facts">
                <div><dt>@L["fin.payroll"]</dt><dd><span class="hrms-code-chip">@run.RunCode</span>@(run.RunType == "OFFCYCLE" ? " · " + L["fin.off_cycle"] : "")</dd></div>
                <div><dt>@L["pr.period"]</dt><dd>@L.Date(run.StartDate) – @L.Date(run.EndDate)</dd></div>
                <div><dt>@L["pr.pay_date"]</dt><dd>@L.Date(run.PaymentDate)</dd></div>
                <div><dt>@L["common.employees"]</dt><dd class="hrms-numeric">@PayrollFormat.Count(run.EmployeeCount)</dd></div>
                <div><dt>@L["pr.net_kwd"]</dt><dd class="hrms-numeric fw-semibold">@PayrollFormat.Money(run.TotalNet)</dd></div>
                <div>
                    <dt>@L["fin.bank_file"]</dt>
                    <dd>
                        @if (run.FileCount > 0)
                        {
                            <span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@run.LastFileNo</span>
                        }
                        else
                        {
                            <span class="hrms-badge hrms-badge--warning"><span class="hrms-badge__dot"></span>@L["fin.not_generated"]</span>
                        }
                    </dd>
                </div>
            </dl>
        }
    </section>

    @if (run is not null)
    {

        <div class="row g-3 align-items-start">
            @* ------------------------------------------------ review by bank *@
            <div class="col-12 col-xxl-7">
                <section class="hrms-card hrms-panel hrms-panel--flush">
                    <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["fin.review_by_bank"]</h2></header>
                    @if (Model.Review.Count == 0)
                    {
                        <div class="hrms-empty"><p class="hrms-empty__title">@L["fin.nobody_to_pay"]</p></div>
                    }
                    else
                    {
                        <div class="hrms-table-wrap">
                            <table class="hrms-table">
                                <caption class="hrms-sr-only">@L["fin.review_by_bank"]</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">@L["prv.bank"]</th>
                                        <th scope="col">@L["prv.wps_code"]</th>
                                        <th scope="col" class="col-p2">@L["prv.format"]</th>
                                        <th scope="col" class="text-end">@L["common.employees"]</th>
                                        <th scope="col" class="text-end">@L["pr.amount_kwd"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in bank)
                                    {
                                        <tr>
                                            <td data-label="@L["prv.bank"]"><span class="hrms-table__primary">@(r.BankName ?? (string)L["fin.unknown_bank"])</span></td>
                                            <td data-label="@L["prv.wps_code"]">
                                                @if (string.IsNullOrEmpty(r.WpsBankCode))
                                                {
                                                    <span class="hrms-badge hrms-badge--danger"><span class="hrms-badge__dot"></span>@L["prv.missing"]</span>
                                                }
                                                else
                                                {
                                                    <span class="hrms-badge hrms-badge--success"><span class="hrms-badge__dot"></span>@r.WpsBankCode</span>
                                                }
                                            </td>
                                            <td data-label="@L["prv.format"]" class="col-p2 hrms-text-sm">@(r.HasOwnFormat ? L["prv.bank_specific"] : L["fin.default_format"])</td>
                                            <td data-label="@L["common.employees"]" class="text-end hrms-numeric">@PayrollFormat.Count(r.EmployeeCount)</td>
                                            <td data-label="@L["pr.amount_kwd"]" class="text-end pr-money">@PayrollFormat.Money(r.Amount)</td>
                                        </tr>
                                    }
                                    @if (cash is not null)
                                    {
                                        <tr class="fin-row--muted">
                                            <td data-label="@L["prv.bank"]" colspan="3"><span class="hrms-table__primary">@L["fin.cash_cheque"]</span><span class="pr-emp-sub">@L["fin.cash_cheque_hint"]</span></td>
                                            <td data-label="@L["common.employees"]" class="text-end hrms-numeric">@PayrollFormat.Count(cash.EmployeeCount)</td>
                                            <td data-label="@L["pr.amount_kwd"]" class="text-end pr-money">@PayrollFormat.Money(cash.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th scope="row" colspan="3">@L["fin.in_the_file"]</th>
                                        <td class="text-end hrms-numeric fw-semibold">@PayrollFormat.Count(bank.Sum(b => b.EmployeeCount))</td>
                                        <td class="text-end pr-money fw-semibold">@PayrollFormat.Money(bank.Sum(b => b.Amount))</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    @if (missingWps > 0 || unknownBank is not null)
                    {
                        <div class="fin-notes">
                            @if (missingWps > 0)
                            {
                                <p>@Html.Icon("alert", 14)<span>@L["fin.missing_wps_note", missingWps]</span> <a href="@Url.Content("~/payroll/settings/banks")">@L["fin.open_banks"]</a></p>
                            }
                            @if (unknownBank is not null)
                            {
                                <p>@Html.Icon("info", 14)<span>@L["fin.unknown_bank_note", unknownBank.EmployeeCount]</span></p>
                            }
                        </div>
                    }
                </section>
            </div>

            @* ------------------------------------------------ generate *@
            <div class="col-12 col-xxl-5">
                <section class="hrms-card hrms-panel">
                    <header class="hrms-panel__head"><h2 class="hrms-panel__title">@(Model.HasLiveFile ? L["fin.regenerate_file"] : L["prv.generate_bank_file"])</h2></header>
                    <div class="pr-card-body">
                        @if (!Model.Rights.CanAct)
                        {
                            <p class="hrms-muted mb-0">@L["fin.view_only"]</p>
                        }
                        else if (Model.Accounts.Count == 0 || Model.Formats.Count == 0)
                        {
                            <div class="pr-banner pr-banner--lock" role="note">
                                @Html.Icon("alert", 18)
                                <div>
                                    <strong>@L["fin.setup_needed"]</strong>
                                    @(Model.Accounts.Count == 0 ? L["fin.no_accounts_note"] : L["fin.no_formats_note"])
                                    <a href="@Url.Content(Model.Accounts.Count == 0 ? "~/payroll/settings/banks" : "~/payroll/settings/bank-formats")">@L["fin.open_settings"]</a>
                                </div>
                            </div>
                        }
                        else if (bank.Count == 0)
                        {
                            <p class="hrms-muted mb-0">@L["fin.nobody_by_bank"]</p>
                        }
                        else
                        {
                            if (st is not null)
                            {
                                @* db/116: one file of the net pay, or the two steps (Ministry Payroll, then Company Payroll) *@
                                <div class="bf-mode nav" role="tablist" aria-label="@L["fin.process"]">
                                    <button type="button" class="bf-mode__opt @(!staged ? "active" : null)" id="bf-tab-single" data-bs-toggle="pill" data-bs-target="#bf-pane-single"
                                            role="tab" aria-controls="bf-pane-single" aria-selected="@(!staged ? "true" : "false")" disabled="@staged">
                                        @Html.Icon("download", 15)<span><strong>@L["fin.mode_single"]</strong><small>@L["fin.mode_single_hint"]</small></span>
                                    </button>
                                    <button type="button" class="bf-mode__opt @(staged ? "active" : null)" id="bf-tab-staged" data-bs-toggle="pill" data-bs-target="#bf-pane-staged"
                                            role="tab" aria-controls="bf-pane-staged" aria-selected="@(staged ? "true" : "false")" disabled="@single">
                                        @Html.Icon("layers", 15)<span><strong>@L["fin.mode_staged"]</strong><small>@L["fin.mode_staged_hint"]</small></span>
                                    </button>
                                </div>
                                if (staged || single)
                                {
                                    <p class="form-text mt-0">@(staged ? L["fin.mode_locked_staged"] : L["fin.mode_locked_single"])</p>
                                }
                            }
                            <div class="tab-content">
                            <div class="tab-pane fade @(!staged ? "show active" : null)" id="bf-pane-single" role="tabpanel" aria-labelledby="bf-tab-single">
                            @if (gl)
                            {
                                <div class="pr-banner pr-banner--lock" role="note">@Html.Icon("lock", 18)<div>@L["fin.gl_locked"]</div></div>
                            }
                            else
                            {
                            <form class="row g-3" data-fin-generate action="@Url.Action("Generate", "BankProcessing")" novalidate>
                                <input type="hidden" name="run" value="@run.PayrollRunId" />
                                <input type="hidden" name="kind" value="FULL" />
                                <div class="col-sm-6">
                                    <label class="form-label" for="bf-bank">@L["fin.banks_in_file"]</label>
                                    <select class="form-select" id="bf-bank" name="bank" data-searchable>
                                        <option value="">@L["fin.all_banks"]</option>
                                        @foreach (var b in bank.Where(b => b.BankId is not null))
                                        {
                                            <option value="@b.BankId">@b.BankName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="bf-date">@L["prv.value_date"] <span class="req" aria-hidden="true">*</span></label>
                                    <input class="form-control" type="date" id="bf-date" name="valueDate" value="@valueDate" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="bf-account">@L["prv.debit_account"] <span class="req" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="bf-account" name="account" data-searchable>
                                        @foreach (var a in Model.Accounts)
                                        {
                                            <option value="@a.CompanyBankAccountId" selected="@(a.CompanyBankAccountId == defaultAccount?.CompanyBankAccountId)">@a.AccountTitle · @a.BankName · @FinanceFormat.Iban(a.Iban)</option>
                                        }
                                    </select>
                                    @if (defaultAccount is not null && string.IsNullOrEmpty(defaultAccount.WpsEmployerCode))
                                    {
                                        <span class="form-text text-warning">@L["fin.no_employer_code"]</span>
                                    }
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="bf-format">@L["prv.format"] <span class="req" aria-hidden="true">*</span></label>
                                    <select class="form-select" id="bf-format" name="format" data-searchable>
                                        @foreach (var f in Model.Formats)
                                        {
                                            <option value="@f.BankFileFormatId" selected="@(f.BankFileFormatId == Model.DefaultFormatId)">@f.FormatName@(f.BankName is not null ? " · " + f.BankName : "")@(f.IsDefault ? " · " + L["st.default"] : "")</option>
                                        }
                                    </select>
                                </div>
                                @if (Model.HasLiveFile)
                                {
                                    <div class="col-12">
                                        <label class="form-label" for="bf-reason">@L["fin.regenerate_reason"] <span class="req" aria-hidden="true">*</span></label>
                                        <textarea class="form-control" id="bf-reason" name="reason" rows="2" maxlength="500" placeholder="@L["prv.regenerating_a_file_asks_for_a_reason"]"></textarea>
                                    </div>
                                }
                                <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                                    <button type="submit" class="btn btn-primary">@Html.Icon("download", 15)<span>@(Model.HasLiveFile ? L["fin.regenerate_download"] : L["fin.generate_download"])</span></button>
                                    <span class="form-text m-0">@L["fin.generate_hint"]</span>
                                </div>
                            </form>
                            }
                            </div>
                            @if (st is not null)
                            {
                                var ministryLive = Model.HasLive("MINISTRY");
                                var companyLive = Model.HasLive("COMPANY");
                                <div class="tab-pane fade @(staged ? "show active" : null)" id="bf-pane-staged" role="tabpanel" aria-labelledby="bf-tab-staged">
                                    <ol class="bf-steps">
                                        @* ---- step 1: Ministry Payroll - the work permit salary *@
                                        <li class="bf-step @(st.MinistryDone ? "is-done" : "is-current")">
                                            <details class="bf-step__box" open="@(!st.MinistryDone)">
                                            <summary class="bf-step__head">
                                                <span class="bf-step__no" aria-hidden="true">@(st.MinistryDone ? "✓" : "1")</span>
                                                <div class="bf-step__headtext">
                                                    <h3 class="bf-step__title">@L["fin.step1_title"]</h3>
                                                    <p class="bf-step__text">@L["fin.step1_text"]</p>
                                                    @* collapsed: the step at a glance *@
                                                    <p class="bf-step__sum">
                                                        <span class="bf-step__chip @(st.MinistryDone ? "is-done" : "is-todo")">@(st.MinistryDone ? L["fin.step_done"] : L["fin.step_todo"])</span>
                                                        <span>@Html.Icon("users", 13) @PayrollFormat.Count(st.MinistryCount)</span>
                                                        <span class="pr-money">KWD @PayrollFormat.Money(st.MinistryDone ? st.MinistryFileAmount ?? st.MinistryAmount : st.MinistryAmount)</span>
                                                        <span class="bf-step__sumfile">@Html.Icon("file", 13) @(st.MinistryFileNos ?? (string)L["fin.not_generated"])</span>
                                                    </p>
                                                </div>
                                                <span class="bf-step__chev" aria-hidden="true">@Html.Icon("chevron-down", 16)</span>
                                            </summary>
                                            <div class="bf-step__body">
                                                <dl class="bf-step__figs">
                                                    <div><dt>@L["common.employees"]</dt><dd>@PayrollFormat.Count(st.MinistryCount)</dd></div>
                                                    <div><dt>@L["pr.amount_kwd"]</dt><dd class="pr-money">@PayrollFormat.Money(st.MinistryDone ? st.MinistryFileAmount ?? st.MinistryAmount : st.MinistryAmount)</dd></div>
                                                    <div><dt>@L["fin.bank_file"]</dt><dd>@(st.MinistryFileNos ?? (string)L["fin.not_generated"])</dd></div>
                                                </dl>
                                                @if (st.ProbationCount > 0)
                                                {
                                                    <p class="bf-step__note">@Html.Icon("user", 14)<span>@L["fin.step_probation_0_1", st.ProbationCount, PayrollFormat.Money(st.ProbationAmount)]</span></p>
                                                }
                                                @if (st.MissingWpsCount > 0)
                                                {
                                                    <div class="pr-banner pr-banner--err mb-3" role="alert">
                                                        @Html.Icon("alert", 18)
                                                        <div><strong>@L["fin.wps_missing_0", st.MissingWpsCount]</strong> @st.MissingWpsNames@(st.MissingWpsCount > 5 ? " …" : "")
                                                            <a href="@Url.Content("~/employees")">@L["fin.open_employees"]</a></div>
                                                    </div>
                                                }
                                                <form class="row g-3" data-fin-generate action="@Url.Action("Generate", "BankProcessing")" novalidate>
                                                    <input type="hidden" name="run" value="@run.PayrollRunId" />
                                                    <input type="hidden" name="kind" value="MINISTRY" />
                                                    @{ await GenerateFields("m1", ministryLive, gl); }
                                                    <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                                                        <button type="submit" class="btn @(st.MinistryDone ? "btn-outline-primary" : "btn-primary")" disabled="@(gl || st.MissingWpsCount > 0)">
                                                            @Html.Icon("download", 15)<span>@(ministryLive ? L["fin.step1_regenerate"] : L["fin.step1_generate"])</span>
                                                        </button>
                                                        @if (gl)
                                                        {
                                                            <span class="form-text m-0">@L["fin.gl_locked"]</span>
                                                        }
                                                        else if (st.CompanyDone)
                                                        {
                                                            <span class="form-text m-0">@L["fin.step1_regen_note"]</span>
                                                        }
                                                    </div>
                                                </form>
                                            </div>
                                            </details>
                                        </li>

                                        @* ---- step 2: Company Payroll - the net pay less what step 1 transferred *@
                                        <li class="bf-step @(st.CompanyDone ? "is-done" : st.MinistryDone ? "is-current" : "is-locked")">
                                            <details class="bf-step__box" open="@(st.MinistryDone && !st.CompanyDone)">
                                            <summary class="bf-step__head">
                                                <span class="bf-step__no" aria-hidden="true">@(st.CompanyDone ? "✓" : "2")</span>
                                                <div class="bf-step__headtext">
                                                    <h3 class="bf-step__title">@L["fin.step2_title"]</h3>
                                                    <p class="bf-step__text">@L["fin.step2_text"]</p>
                                                    @* collapsed: the step at a glance *@
                                                    <p class="bf-step__sum">
                                                        <span class="bf-step__chip @(st.CompanyDone ? "is-done" : st.MinistryDone ? "is-todo" : "is-locked")">@(st.CompanyDone ? L["fin.step_done"] : st.MinistryDone ? L["fin.step_todo"] : L["fin.step_waiting"])</span>
                                                        <span>@Html.Icon("users", 13) @PayrollFormat.Count(st.CompanyCount)</span>
                                                        <span class="pr-money">KWD @PayrollFormat.Money(st.CompanyDone ? st.CompanyFileAmount ?? st.CompanyAmount : st.CompanyAmount)</span>
                                                        <span class="bf-step__sumfile">@Html.Icon("file", 13) @(st.CompanyFileNos ?? (string)L["fin.not_generated"])</span>
                                                    </p>
                                                </div>
                                                <span class="bf-step__chev" aria-hidden="true">@Html.Icon("chevron-down", 16)</span>
                                            </summary>
                                            <div class="bf-step__body">
                                                <dl class="bf-step__figs">
                                                    <div><dt>@L["common.employees"]</dt><dd>@PayrollFormat.Count(st.CompanyCount)</dd></div>
                                                    <div><dt>@L["pr.amount_kwd"]</dt><dd class="pr-money">@PayrollFormat.Money(st.CompanyDone ? st.CompanyFileAmount ?? st.CompanyAmount : st.CompanyAmount)</dd></div>
                                                    <div><dt>@L["fin.bank_file"]</dt><dd>@(st.CompanyFileNos ?? (string)L["fin.not_generated"])</dd></div>
                                                </dl>
                                                @if (st.OverCount > 0)
                                                {
                                                    <p class="bf-step__note">@Html.Icon("info", 14)<span>@L["fin.step2_over_0_1", st.OverCount, PayrollFormat.Money(st.OverAmount)]</span></p>
                                                }
                                                @if (st.ProbationCount > 0)
                                                {
                                                    <p class="bf-step__note">@Html.Icon("user", 14)<span>@L["fin.step_probation_0_1", st.ProbationCount, PayrollFormat.Money(st.ProbationAmount)]</span></p>
                                                }
                                                @if (st.CashCount > 0)
                                                {
                                                    <p class="bf-step__note">@Html.Icon("wallet", 14)<span>@L["fin.step2_cash_0_1", st.CashCount, PayrollFormat.Money(st.CashAmount)]</span></p>
                                                }
                                                @if (!st.MinistryDone)
                                                {
                                                    <p class="hrms-muted hrms-text-sm mb-0">@Html.Icon("lock", 14) @L["fin.step2_locked"]</p>
                                                }
                                                else
                                                {
                                                    <form class="row g-3" data-fin-generate action="@Url.Action("Generate", "BankProcessing")" novalidate>
                                                        <input type="hidden" name="run" value="@run.PayrollRunId" />
                                                        <input type="hidden" name="kind" value="COMPANY" />
                                                        @{ await GenerateFields("c2", companyLive, gl); }
                                                        <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                                                            <button type="submit" class="btn btn-primary" disabled="@(gl || (st.CompanyCount == 0 && st.CashCount == 0))">
                                                                @Html.Icon("download", 15)<span>@(companyLive ? L["fin.step2_regenerate"] : L["fin.step2_generate"])</span>
                                                            </button>
                                                        </div>
                                                    </form>
                                                }
                                            </div>
                                            </details>
                                        </li>
                                    </ol>
                                </div>
                            }
                            </div>
                        }
                    </div>
                </section>

                @if (Model.RetryReview.Count > 0 && Model.Rights.CanAct && Model.Accounts.Count > 0 && Model.Formats.Count > 0)
                {
                    <section class="hrms-card hrms-panel mt-3 fin-retry">
                        <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["fin.reissue_file"]</h2></header>
                        <div class="pr-card-body">
                            <p class="hrms-text-sm">@L["fin.reissue_file_text", PayrollFormat.Count(Model.RetryReview.Sum(r => r.EmployeeCount)), PayrollFormat.Money(Model.RetryReview.Sum(r => r.Amount))]</p>
                            <form class="row g-3" data-fin-generate action="@Url.Action("Generate", "BankProcessing")" novalidate>
                                <input type="hidden" name="run" value="@run.PayrollRunId" />
                                <input type="hidden" name="kind" value="RETRY" />
                                <input type="hidden" name="account" value="@defaultAccount?.CompanyBankAccountId" />
                                <input type="hidden" name="format" value="@Model.DefaultFormatId" />
                                <div class="col-sm-6">
                                    <label class="form-label" for="rf-date">@L["prv.value_date"]</label>
                                    <input class="form-control" type="date" id="rf-date" name="valueDate" value="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                                </div>
                                <div class="col-sm-6 d-flex align-items-end">
                                    <button type="submit" class="btn btn-outline-primary w-100">@Html.Icon("refresh", 15)<span>@L["fin.generate_reissue"]</span></button>
                                </div>
                            </form>
                        </div>
                    </section>
                }
            </div>
        </div>

        @* ------------------------------------------------ files of this payroll *@
        <section class="hrms-card hrms-panel hrms-panel--flush">
            <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["fin.files_of_payroll"]</h2></header>
            @await Html.PartialAsync("~/Views/BankProcessing/_FilesTable.cshtml", (Model.Files, Model.Rights, false))
        </section>

        @* db/118: Post to GL - the journal is posted; the bank files are final from then on *@
        @if (st is not null)
        {
            <section class="hrms-card bf-gl @(gl ? "is-posted" : null)" aria-label="@L["fin.post_gl"]">
                @if (gl)
                {
                    <div class="bf-gl__body">
                        <span class="bf-gl__icon" aria-hidden="true">@Html.Icon("check", 18)</span>
                        <div>@L["fin.gl_posted_0_1_2", st.JournalNo ?? "", st.GlReference ?? "", L.Date(st.GlPostedDate)]</div>
                    </div>
                }
                else
                {
                    <div class="bf-gl__body">
                        <span class="bf-gl__icon" aria-hidden="true">@Html.Icon("book", 18)</span>
                        <div>
                            <strong>@L["fin.post_gl"]</strong>
                            <span class="d-block hrms-text-sm hrms-muted">@(st.FilesReady ? L["fin.post_gl_hint"] : L["fin.post_gl_needs_file"])</span>
                        </div>
                    </div>
                    if (canGl)
                    {
                        <button type="button" class="btn btn-primary" disabled="@(!st.FilesReady)"
                                data-fin-action="@Url.Action("PostGl", "BankProcessing", new { run = run.PayrollRunId })"
                                data-fin-title="@L["fin.post_gl_title"] · @run.RunCode" data-fin-text="@L["fin.post_gl_text"]"
                                data-fin-field="reference" data-fin-label="@L["fin.post_gl_ref"]" data-fin-ok="@L["fin.post_gl"]">
                            @Html.Icon("book", 15)<span>@L["fin.post_gl"]</span>
                        </button>
                    }
                }
            </section>
        }

        @* db/116: the audit of the bank file process - generated, generated again (with the reason), sent, paid *@
        @if (st is not null)
        {
            <section class="hrms-card hrms-panel">
                <header class="hrms-panel__head"><h2 class="hrms-panel__title">@L["fin.process_history"]</h2></header>
                <div class="pr-card-body">
                    @if (Model.Audit.Count == 0)
                    {
                        <p class="hrms-muted mb-0">@L["fin.no_process_history"]</p>
                    }
                    else
                    {
                        <ol class="pr-timeline">
                            @foreach (var h in Model.Audit)
                            {
                                var local = DateTime.SpecifyKind(h.ActionDate, DateTimeKind.Utc).ToLocalTime();
                                <li class="@(h.ActionCode is "PAID" ? "is-done" : h.ActionCode is "REGENERATED" ? "is-rejected" : "is-todo")">
                                    <span class="pr-timeline__dot"></span>
                                    <div class="pr-timeline__title">
                                        @L[AuditKey(h.ActionCode)]@if (h.FileKind is { } kind) { <span> · </span><span class="bf-kind bf-kind--@kind.ToLowerInvariant()">@L[KindKey(kind)]</span> }
                                        <span class="hrms-code-chip ms-1">@h.FileNo</span>
                                        @if (h.TotalAmount is { } amt)
                                        {
                                            <span class="hrms-muted ms-1">@L["pr.kwd"] @PayrollFormat.Money(amt)@(h.LineCount is { } n ? " · " + L["fin.n_employees", n] : "")</span>
                                        }
                                    </div>
                                    <div class="pr-timeline__meta">@h.ActionByName · @L.Date(local) @local.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)@(h.BankName is not null ? " · " + h.BankName : "")</div>
                                    @if (!string.IsNullOrWhiteSpace(h.ReplacedFileNos))
                                    {
                                        <div class="pr-timeline__meta">@L["fin.audit_replaces_0", h.ReplacedFileNos]</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.Reason))
                                    {
                                        <div class="pr-timeline__text">@h.Reason</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.Reference))
                                    {
                                        <div class="pr-timeline__meta">@L["fin.reference_0", h.Reference]</div>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </section>
        }
    }
</div>
@await Html.PartialAsync("~/Views/PayrollFinance/_Dialog.cshtml")

@section Scripts {
    <script src="~/js/payroll-finance.js" asp-append-version="true"></script>
}
