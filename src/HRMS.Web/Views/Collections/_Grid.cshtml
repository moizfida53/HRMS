@model CollectionGridModel
@* Collection (db/115): the summary of the company's payroll month, then the list - not collected first *@
@{
    var s = Model.Summary;
}
@if (Model.NoMonth)
{
    <div class="hrms-card">
        <div class="hrms-empty">
            <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon("calendar", 26)</span>
            <p class="hrms-empty__title">@L["col.no_payroll_yet"]</p>
            <p class="hrms-empty__text">@L["col.no_payroll_yet_text"]</p>
        </div>
    </div>
}
else
{
    <section class="pr-kpis pr-kpis--3 col-kpis" aria-label="@L["pr.key_figures"]">
        <div class="hrms-card hrms-kpi pc-kpi">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["col.kpi_total"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("wallet", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Money(s.TotalAmount)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["col.kpi_n_employees", PayrollFormat.Count(s.TotalCount)]</span></div>
        </div>
        <div class="hrms-card hrms-kpi pc-kpi @(s.PendingCount > 0 ? "pc-kpi--warn" : null)">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["col.kpi_pending"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("clock", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Money(s.PendingAmount)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["col.kpi_n_to_collect", PayrollFormat.Count(s.PendingCount)]</span></div>
        </div>
        <div class="hrms-card hrms-kpi pc-kpi pc-kpi--ok">
            <div class="hrms-kpi__head"><span class="hrms-kpi__label">@L["col.kpi_collected"]</span><span class="hrms-kpi__icon" aria-hidden="true">@Html.Icon("check", 16)</span></div>
            <div class="hrms-kpi__value">@PayrollFormat.Money(s.CollectedAmount)</div>
            <div class="hrms-kpi__foot"><span class="hrms-kpi__note">@L["col.kpi_n_received", PayrollFormat.Count(s.CollectedCount)]</span></div>
        </div>
    </section>
    @if (s.TotalAmount > 0)
    {
        var pct = (int)Math.Round(s.CollectedAmount / s.TotalAmount * 100m);
        <div class="col-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct" aria-label="@L["col.progress", pct]">
            <span class="col-progress__bar" style="width:@(pct)%"></span>
        </div>
        <p class="hrms-muted hrms-text-sm mt-1 mb-0">@L["col.progress", pct]</p>
    }

    <div class="hrms-card mt-3">
        <div data-col-count hidden data-text="@(Model.Items.Count == 1 ? L["col.1_collection"] : L["col.0_collections", PayrollFormat.Count(Model.Items.Count)])"></div>
        @if (Model.Items.Count == 0)
        {
            <div class="hrms-empty">
                <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "check", 26)</span>
                <p class="hrms-empty__title">@(Model.IsFiltered ? L["col.none_match"] : L["col.none_this_month"])</p>
                <p class="hrms-empty__text">@(Model.IsFiltered ? L["col.none_match_text"] : L["col.none_this_month_text"])</p>
            </div>
        }
        else
        {
            var anyPending = Model.CanEdit && Model.Items.Any(i => !i.IsCollected && !i.IsDraft);
            if (anyPending)
            {
                <div class="col-bulk" data-col-bulk hidden>
                    <span data-col-bulk-text data-one="@L["col.1_selected"]" data-many="@L["col.0_selected"]"></span>
                    <button type="button" class="btn btn-sm btn-primary" data-col-collect-selected>@Html.Icon("check", 14)<span>@L["col.mark_selected"]</span></button>
                </div>
            }
            <div class="hrms-table-wrap">
                <table class="hrms-table pc-table col-table">
                    <caption class="hrms-sr-only">@L["col.title"]</caption>
                    <thead>
                        <tr>
                            @if (anyPending)
                            {
                                <th scope="col" class="col-table__check"><input type="checkbox" class="form-check-input" data-col-all aria-label="@L["col.select_all_pending"]" /></th>
                            }
                            <th scope="col">@L["pc.col_emp_no"]</th>
                            <th scope="col">@L["pc.col_employee"]</th>
                            <th scope="col" class="pr-money">@L["col.net_payable"]</th>
                            <th scope="col" class="pr-money">@L["col.work_permit_salary"]</th>
                            <th scope="col" class="pr-money">@L["col.amount"]</th>
                            <th scope="col">@L["common.status"]</th>
                            <th scope="col">@L["col.received"]</th>
                            <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Items)
                        {
                            var emp = PayItemFormat.EmployeeName(L, i.EmployeeName, i.EmployeeArabicName);
                            var canMark = Model.CanEdit && !i.IsCollected && !i.IsDraft;
                            <tr data-id="@i.CollectionId" data-name="@emp" data-amount="@PayrollFormat.Money(i.Amount)" class="@(i.IsCollected ? "is-collected" : null)">
                                @if (anyPending)
                                {
                                    <td class="col-table__check">
                                        @if (canMark)
                                        {
                                            <input type="checkbox" class="form-check-input" data-col-pick value="@i.CollectionId" aria-label="@L["col.select_0", emp]" />
                                        }
                                    </td>
                                }
                                <td data-label="@L["pc.col_emp_no"]" class="font-monospace pc-table__no">@i.EmployeeNo</td>
                                <td data-label="@L["pc.col_employee"]">
                                    <span class="hrms-table__primary">@emp</span>
                                    @if (!string.IsNullOrWhiteSpace(i.DepartmentName))
                                    {
                                        <span class="pr-emp-sub">@i.DepartmentName</span>
                                    }
                                </td>
                                <td data-label="@L["col.net_payable"]" class="pr-money">@PayrollFormat.Money(i.NetPayable ?? i.GrossMonthly)</td>
                                <td data-label="@L["col.work_permit_salary"]" class="pr-money">@PayrollFormat.Money(i.WorkPermitSalary)</td>
                                <td data-label="@L["col.amount"]" class="pr-money col-table__amount">@PayrollFormat.Money(i.Amount)</td>
                                <td data-label="@L["common.status"]">
                                    <span class="hrms-badge hrms-badge--@CollectionFormat.StatusBadge(i.Status)"><span class="hrms-badge__dot"></span>@L[CollectionFormat.StatusKey(i.Status)]</span>
                                    @if (i.IsDraft)
                                    {
                                        <span class="pr-per">@L["col.draft_payroll"]</span>
                                    }
                                </td>
                                <td data-label="@L["col.received"]">
                                    @if (i.IsCollected)
                                    {
                                        <span class="col-received">
                                            <span>@L.Date(i.CollectedDate)</span>
                                            @if (!string.IsNullOrWhiteSpace(i.Reference))
                                            {
                                                <span class="col-received__sub">@L["col.ref_0", i.Reference]</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(i.CollectedByName))
                                            {
                                                <span class="col-received__sub">@L["col.by_0", i.CollectedByName]</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hrms-muted">—</span>
                                    }
                                </td>
                                <td class="pc-actions col-table__actions">
                                    @if (canMark)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-col-collect="@i.CollectionId">@Html.Icon("check", 14)<span>@L["col.mark_received"]</span></button>
                                    }
                                    @if (Model.CanEdit && i.IsCollected)
                                    {
                                        <button type="button" class="btn-icon" data-col-reopen="@i.CollectionId" title="@L["col.set_back"]" aria-label="@L["col.set_back"]">@Html.Icon("refresh", 15)</button>
                                    }
                                    <button type="button" class="btn-icon" data-col-history="@i.CollectionId" title="@L["pr.history"]" aria-label="@L["pr.history"]">@Html.Icon("clock", 15)</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
