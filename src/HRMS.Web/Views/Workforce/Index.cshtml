@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Employees";             // translated by the layout (L.Tr)
    ViewData["ActiveArea"] = "workforce";
    ViewData["Subtitle"] = "Personal info, employment and Kuwait compliance in one profile per employee";
}


<div id="grid-slot"
     class="hrms-grid-slot"
     role="region"
     aria-label="@L["common.employees"]"
     aria-busy="true"
     data-grid-url="@Url.Action("Grid", "Employees")"
     data-delete-url="@Url.Action("Delete", "Employees")"
     data-toggle-url="@Url.Action("Toggle", "Employees")">

    <div class="hrms-spinner" aria-hidden="true"></div>

    @* First paint: skeleton rows, replaced by the real grid as soon as it arrives. *@
    <div class="hrms-card">
        <div class="hrms-card__toolbar">
            <div class="hrms-skeleton" style="width:220px;height:34px"></div>
            <div class="hrms-card__count"><span class="hrms-skeleton" style="width:70px;display:inline-block"></span></div>
        </div>
        <div style="padding:1.25rem">
            @for (var i = 0; i < 6; i++)
            {
                <div class="hrms-skeleton" style="margin-bottom:14px;width:@(90 - (i * 7))%"></div>
            }
        </div>
    </div>
</div>

@* Delete confirmation. Kept as a real dialog rather than window.confirm so it
   can name the record and explain when a delete will be refused. *@
<div class="modal fade" id="confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="confirm-modal-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="confirm-modal-title">@L["emp.delete_employee"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">@L["common.are_you_sure_you_want_to_delete"] <strong data-confirm-name></strong>?</p>
                <p class="hrms-muted hrms-text-sm mb-0">
                    @L["emp.the_employee_is_hidden_everywhere_in_the_app_but"]
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="button" class="btn btn-primary" data-confirm-accept
                        style="--bs-btn-bg:#b42318;--bs-btn-border-color:#b42318;--bs-btn-hover-bg:#912018;--bs-btn-hover-border-color:#912018">
                    @Html.Icon("trash", 15)
                    <span>@L["common.delete"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@* db/93: Passport In / Out (Actions menu) - the body comes from the server *@
@if (CurrentUser.CanViewPassportCustody())
{
    <div class="modal fade" id="pp-modal" tabindex="-1" aria-hidden="true" aria-labelledby="pp-modal-title"
         data-urls-panel="@Url.Action("Panel", "Passport")" data-urls-log="@Url.Action("Log", "Passport")"
         data-urls-save="@Url.Action("Save", "Passport")" data-urls-export="@Url.Action("Export", "Passport")"
         data-text-show-log="@L["emp.pp_view_transactions"]" data-text-hide-log="@L["emp.pp_hide_transactions"]">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5 pp-title" id="pp-modal-title">@Html.Icon("swap", 18)<span>@L["emp.pp_title"]</span></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
                </div>
                <div class="modal-body" data-pp-body></div>
                <div class="modal-footer pp-footer">
                    <button type="button" class="btn btn-outline-primary me-auto" data-pp-toggle-log>@Html.Icon("history", 15)<span data-pp-toggle-text>@L["emp.pp_view_transactions"]</span></button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
                    <button type="button" class="btn btn-primary" data-pp-submit hidden>@Html.Icon("check", 15)<span>@L["emp.pp_submit"]</span></button>
                </div>
            </div>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/employee.js" asp-append-version="true"></script>
    <script src="~/js/passport.js" asp-append-version="true"></script>
}


@section PageActions {
    <button type="button" class="btn btn-outline-secondary" data-action="export">
        @Html.Icon("download", 15)
        <span>@L["common.export"]</span>
    </button>
    @if (CurrentUser.EmployeeAccess().Create)
    {
        <a class="btn btn-primary" asp-controller="Employees" asp-action="Add">
            @Html.Icon("plus", 15)
            <span>@L["emp.add_employee"]</span>
        </a>
    }
}
