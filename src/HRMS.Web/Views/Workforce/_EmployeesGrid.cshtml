@inject ICurrentUser CurrentUser
@model EmployeeGridViewModel
@{
    var access = CurrentUser.EmployeeAccess();
    var canDelete = access.Delete;
    var canPassport = CurrentUser.CanViewPassportCustody();
}

<div class="hrms-card">
    @await Html.PartialAsync("~/Views/Workforce/Partials/_GridToolbar.cshtml", Model)

    @if (Model.Page.TotalCount == 0)
    {
        @await Html.PartialAsync("~/Views/Workforce/Partials/_EmptyState.cshtml", Model)
    }
    else
    {
        <div class="hrms-table-wrap">
            <table class="hrms-table">
                <caption class="hrms-sr-only">@L["common.records_page_of", Model.PageNumber, Model.TotalPages]</caption>
                <thead>
                    <tr>
                        @await Html.PartialAsync("~/Views/Workforce/Partials/_SortHeader.cshtml", EmployeeSortHeaderModel.For(Model, "EmployeeCode", "Code"))
                        @await Html.PartialAsync("~/Views/Workforce/Partials/_SortHeader.cshtml", EmployeeSortHeaderModel.For(Model, "FullName", "Employee"))
                        <th scope="col">@L["common.department"]</th>
                        <th scope="col">@L["emp.designation"]</th>
                        <th scope="col" class="col-p3">@L["common.contact"]</th>
                        @await Html.PartialAsync("~/Views/Workforce/Partials/_SortHeader.cshtml", EmployeeSortHeaderModel.For(Model, "HireDate", "Hire Date", "col-p2"))
                        @await Html.PartialAsync("~/Views/Workforce/Partials/_SortHeader.cshtml", EmployeeSortHeaderModel.For(Model, "EmploymentStatus", "Status"))
                        <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Page.Items)
                    {
                        <tr data-id="@row.EmployeeId" data-name="@row.FullName" data-active="@row.IsActive.ToString().ToLowerInvariant()">
                            <td data-label="@L.Tr("Code")"><span class="hrms-code-chip">@(string.IsNullOrWhiteSpace(row.EmployeeCode) ? "—" : row.EmployeeCode)</span></td>
                            <td data-label="@L.Tr("Employee")">
                                <a class="hrms-table__primary" asp-controller="Employees" asp-action="Profile" asp-route-id="@row.EmployeeId">
                                    @row.FullName
                                </a>
                            </td>
                            <td data-label="@L.Tr("Department")" class="hrms-muted">@(string.IsNullOrWhiteSpace(row.DepartmentName) ? "—" : row.DepartmentName)</td>
                            <td data-label="@L.Tr("Designation")" class="hrms-muted">@(string.IsNullOrWhiteSpace(row.DesignationName) ? "—" : row.DesignationName)</td>
                            <td data-label="@L.Tr("Contact")" class="hrms-muted col-p3">@(row.WorkEmail ?? row.MobileNumber ?? "—")</td>
                            <td data-label="@L.Tr("Hire Date")" class="col-p2 col-date">@L.Date(row.HireDate)</td>
                            <td data-label="@L.Tr("Status")">@await Html.PartialAsync("~/Views/Workforce/Partials/_StatusBadge.cshtml", row.EmploymentStatus)</td>
                            <td class="hrms-table__actions">
                                @* Actions: each opens the profile at the right place, or the Passport In / Out popup *@
                                <div class="dropdown emp-more">
                                    <button type="button" class="btn-icon" data-bs-toggle="dropdown" aria-expanded="false" data-bs-popper-config='{"strategy":"fixed"}'
                                            title="@L["common.actions"]" aria-label="@L["emp.actions_named", row.FullName]">@Html.Icon("more", 15)</button>
                                    <ul class="dropdown-menu dropdown-menu-end emp-more__menu">
                                        @if (access.EmploymentView)
                                        {
                                            <li><a class="dropdown-item is-danger" asp-controller="Employees" asp-action="Profile" asp-route-id="@row.EmployeeId" asp-route-focus="TerminationDate">@Html.Icon("user-x", 15)<span>@L["emp.act_terminate"]</span></a></li>
                                        }
                                        @if (access.ComplianceView)
                                        {
                                            <li><a class="dropdown-item" asp-controller="Employees" asp-action="Profile" asp-route-id="@row.EmployeeId" asp-route-focus="CivilIdExpiryDate">@Html.Icon("id-card", 15)<span>@L["emp.act_renew_civil_id"]</span></a></li>
                                            <li><a class="dropdown-item" asp-controller="Employees" asp-action="Profile" asp-route-id="@row.EmployeeId" asp-route-focus="PassportExpiryDate">@Html.Icon("passport", 15)<span>@L["emp.act_renew_passport"]</span></a></li>
                                        }
                                        @if (canPassport)
                                        {
                                            <li><button type="button" class="dropdown-item" data-passport-open="@row.EmployeeId">@Html.Icon("swap", 15)<span>@L["emp.act_passport_inout"]</span></button></li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Employees" asp-action="Profile" asp-route-id="@row.EmployeeId" asp-route-tab="personal">@Html.Icon("user", 15)<span>@L["emp.act_general"]</span></a></li>
                                    </ul>
                                </div>
                                @if (canDelete)
                                {
                                    <button type="button" class="btn-icon btn-icon--success" data-action="toggle"
                                            title="@(row.IsActive ? L["common.deactivate"] : L["common.activate"])"
                                            aria-label="@(row.IsActive ? L["common.deactivate_named", row.FullName] : L["common.activate_named", row.FullName])">@Html.Icon("power", 15)</button>
                                    <button type="button" class="btn-icon btn-icon--danger" data-action="delete"
                                            title="@L["common.delete"]" aria-label="@L["common.delete_named", row.FullName]">@Html.Icon("trash", 15)</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Workforce/Partials/_Pagination.cshtml", EmployeePaginationModel.From(Model))
    }
</div>
