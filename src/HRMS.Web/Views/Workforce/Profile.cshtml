@* ------------------------------------------------------- Add/Edit Dependent *@
@* A single static modal, reused for both Add and Edit - JS clears or
   populates it from the clicked row's data attributes rather than fetching
   a server-rendered form partial each time, since the field set is small
   and fixed (unlike Organization Setup's per-master modal forms). *@
<div class="modal fade" id="dependent-modal" tabindex="-1" aria-hidden="true" aria-labelledby="dependent-modal-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="dependent-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="dependent-modal-title">@L["emp.add_dependent"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DependentId" value="0" />
                    <input type="hidden" name="EmployeeId" value="@e.EmployeeId" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="f-dep-FullName">@L["emp.full_name"] <span class="req" aria-hidden="true">*</span></label>
                            <input class="form-control" id="f-dep-FullName" name="FullName" type="text" maxlength="150" required />
                            <span class="field-validation-error" data-valmsg-for="FullName"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="f-dep-Relationship">@L["emp.relationship"] <span class="req" aria-hidden="true">*</span></label>
                            <select class="form-select" id="f-dep-Relationship" name="Relationship" required>
                                @foreach (var relationship in new[] { "Spouse", "Son", "Daughter", "Father", "Mother", "Other" })
                                {
                                    <option value="@relationship">@L.Tr(relationship)</option>
                                }
                            </select>
                            <span class="field-validation-error" data-valmsg-for="Relationship"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="f-dep-Gender">@L["emp.gender"]</label>
                            <select class="form-select" id="f-dep-Gender" name="Gender">
                                <option value="">@L["common.select"]</option>
                                <option value="M">@L["emp.male"]</option>
                                <option value="F">@L["emp.female"]</option>
                            </select>
                            <span class="field-validation-error" data-valmsg-for="Gender"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="f-dep-DateOfBirth">@L["emp.date_of_birth"]</label>
                            <input class="form-control" id="f-dep-DateOfBirth" name="DateOfBirth" type="date" />
                            <span class="field-validation-error" data-valmsg-for="DateOfBirth"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="f-dep-HasHealthInsurance"
                                       name="HasHealthInsurance" value="true" />
                                <input type="hidden" name="HasHealthInsurance" value="false" />
                                <label class="form-check-label" for="f-dep-HasHealthInsurance">@L["emp.health_insurance_coverage"]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                    <button type="submit" class="btn btn-primary" data-submit>
                        @Html.Icon("check", 15)
                        <span>@L["emp.save"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="dependent-confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="dependent-confirm-modal-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="dependent-confirm-modal-title">@L["emp.delete_dependent"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">@L["emp.are_you_sure_you_want_to_remove"] <strong data-dependent-confirm-name></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="button" class="btn btn-primary" data-dependent-confirm-accept
                        style="--bs-btn-bg:#b42318;--bs-btn-border-color:#b42318;--bs-btn-hover-bg:#912018;--bs-btn-hover-border-color:#912018">
                    @Html.Icon("trash", 15)
                    <span>@L["common.delete"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@* ------------------------------------------------------- Remove document *@
<div class="modal fade" id="document-confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="document-confirm-modal-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
