@model EmployeeProfileViewModel
@{
    ViewData["Title"] = Model.DisplayName;
    ViewData["ActiveArea"] = "workforce";
    // Top bar shows the screen name; the employee's own name appears once,
    // in the employee card below - not twice.
    ViewData["Heading"] = Model.IsNew ? "New Employee" : "Employee Profile";
    ViewData["BackUrl"] = "/employees";
    ViewData["BackLabel"] = "Back to Employees";

    var e = Model.Employee;
    var c = Model.Compliance;

    // Wizard mode (Add Employee, and the steps after the employee is created):
    // the very same sections as the tabs, shown one at a time with Previous / Next.
    var wizard = Model.Wizard;
    var wizardTabs = new[] {
        ("personal", "Personal Info"), ("employment", "Employment"),
        ("compliance", "Kuwait Compliance"), ("dependents", "Dependents"),
        ("documents", "Documents") };
}


@* ------------------------------------------- basic employee info strip *@
@* The only place the employee's name is shown - the top bar carries the
   screen name ("Employee Profile"). Save sits here, next to the record it saves. *@
<div class="hrms-card hrms-emp-strip">
    <span class="hrms-profile-photo" title="@L["emp.photo_upload_is_coming_soon"]" aria-label="@L["emp.employee_photo_placeholder"]">
        <span class="hrms-avatar hrms-emp-strip__avatar">@Model.Initials</span>
        <span class="hrms-profile-photo__badge" aria-hidden="true">@Html.Icon("camera", 11)</span>
    </span>

    <div class="hrms-emp-strip__who">
        <div class="hrms-emp-strip__name-row">
            <h2 class="hrms-emp-strip__name">@L.Tr(Model.DisplayName)</h2>
            @if (!Model.IsNew)
            {
                @await Html.PartialAsync("~/Views/Workforce/Partials/_StatusBadge.cshtml", e.EmploymentStatus)
                if (!e.IsActive)
                {
                    <span class="hrms-badge hrms-badge--muted"><span class="hrms-badge__dot"></span>@L["emp.deactivated"]</span>
                }
            }
        </div>
        <div class="hrms-emp-strip__meta">
            <span>@(string.IsNullOrWhiteSpace(e.EmployeeCode) ? L["emp.no_code_assigned"] : L["emp.emp_code", e.EmployeeCode])</span>
            @if (!string.IsNullOrWhiteSpace(e.DepartmentName))
            {
                <span class="hrms-info-chip">@Html.Icon("building", 13)<span>@e.DepartmentName</span></span>
            }
            @if (!string.IsNullOrWhiteSpace(e.DesignationName))
            {
                <span class="hrms-info-chip">@Html.Icon("badge", 13)<span>@e.DesignationName</span></span>
            }
        </div>
    </div>

    <div class="hrms-emp-strip__actions" hidden="@(wizard ? "hidden" : null)">
        <button type="submit" form="employee-form" class="btn btn-primary" data-submit="employee">
            @Html.Icon("check", 15)
            <span>@(Model.IsNew ? L["emp.create_employee"] : L["emp.save_changes"])</span>
        </button>
    </div>
</div>

@if (wizard)
{
    <div class="hrms-wizard-steps" role="list" aria-label="@L["emp.employee_steps"]" data-wizard
         data-start="@Model.ActiveTab" data-employee-id="@e.EmployeeId">
        @for (var i = 0; i < wizardTabs.Length; i++)
        {
            if (i > 0) { <div class="hrms-wizard-step__line" aria-hidden="true"></div> }
            <div class="hrms-wizard-step" data-step-indicator="@wizardTabs[i].Item1" role="listitem">
                <span class="hrms-wizard-step__circle">@(i + 1)</span>
                <span class="hrms-wizard-step__label">@L.Tr(wizardTabs[i].Item2)</span>
            </div>
        }
    </div>
}

@* -------------------------------------------------------------- tabs === *@
<ul class="nav nav-tabs hrms-profile-tabs @(wizard ? "d-none" : null)" id="profile-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "personal" ? "active" : null)" id="tab-personal-btn"
                data-bs-toggle="tab" data-bs-target="#tab-personal" type="button" role="tab"
                aria-controls="tab-personal" aria-selected="@(Model.ActiveTab == "personal" ? "true" : "false")">
            @Html.Icon("user", 15)<span>@L["emp.personal_info"]</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "employment" ? "active" : null)" id="tab-employment-btn"
                data-bs-toggle="tab" data-bs-target="#tab-employment" type="button" role="tab"
                aria-controls="tab-employment" aria-selected="@(Model.ActiveTab == "employment" ? "true" : "false")">
            @Html.Icon("briefcase", 15)<span>@L["emp.employment"]</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "compliance" ? "active" : null)" id="tab-compliance-btn"
                data-bs-toggle="tab" data-bs-target="#tab-compliance" type="button" role="tab"
                aria-controls="tab-compliance" aria-selected="@(Model.ActiveTab == "compliance" ? "true" : "false")"
                disabled="@(Model.IsNew && !wizard ? "disabled" : null)"
                title="@(Model.IsNew ? L["emp.save_employee_first"] : null)">
            @Html.Icon("shield", 15)<span>@L["common.kuwait_compliance"]</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "dependents" ? "active" : null)" id="tab-dependents-btn"
                data-bs-toggle="tab" data-bs-target="#tab-dependents" type="button" role="tab"
                aria-controls="tab-dependents" aria-selected="@(Model.ActiveTab == "dependents" ? "true" : "false")"
                disabled="@(Model.IsNew && !wizard ? "disabled" : null)"
                title="@(Model.IsNew ? L["emp.save_employee_first"] : null)">
            @Html.Icon("heart", 15)<span>@L["emp.dependents"]</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "documents" ? "active" : null)" id="tab-documents-btn"
                data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" role="tab"
                aria-controls="tab-documents" aria-selected="@(Model.ActiveTab == "documents" ? "true" : "false")"
                disabled="@(Model.IsNew && !wizard ? "disabled" : null)"
                title="@(Model.IsNew ? L["emp.save_employee_first"] : null)">
            @Html.Icon("folder", 15)<span>@L["emp.documents"]</span>
        </button>
    </li>
</ul>

<div class="tab-content hrms-profile-tab-content">

    @* The employee-form element itself is declared empty, further down the
       page, outside these tab panes. Every Personal Info and Employment
       field below uses the HTML5 form="employee-form" attribute to attach
       to it without nesting a <form> inside another - Bootstrap's tab
       plugin needs .tab-pane elements to stay plain siblings, and a
       Kuwait Compliance <form> lives in its own pane a few lines down. *@

    <div class="tab-pane fade @(Model.ActiveTab == "personal" ? "show active" : null)" id="tab-personal" role="tabpanel" aria-labelledby="tab-personal-btn">
        <div class="hrms-card"><div class="p-3 p-md-4">

            <input type="hidden" form="employee-form" name="EmployeeId" value="@e.EmployeeId" />

            <div class="accordion hrms-accordion" id="acc-personal">

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                data-bs-target="#acc-personal-identity" aria-expanded="true" aria-controls="acc-personal-identity">
                            <span class="hrms-acc-ico" aria-hidden="true">@Html.Icon("user", 15)</span><span class="hrms-acc-text"><span class="hrms-acc-title">@L["common.identity"]</span></span>
                        </button>
                    </h2>
                    <div id="acc-personal-identity" class="accordion-collapse collapse show" data-bs-parent="#acc-personal">
                        <div class="accordion-body">
                            <div class="row g-3">
                                @* Row 1: Employee No | Employee Code | Arabic Name *@
                                <div class="col-md-3">
                                    <label class="form-label" for="f-EmployeeNo">@L["emp.employee_no"] <span class="req" aria-hidden="true">*</span></label>
                                    <input class="form-control" id="f-EmployeeNo" form="employee-form" name="EmployeeNo" type="text"
                                           value="@e.EmployeeNo" maxlength="20" required autocomplete="off" spellcheck="false" />
                                    <span class="field-validation-error" data-valmsg-for="EmployeeNo"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-EmployeeCode">@L["emp.employee_code"]</label>
                                    <input class="form-control" id="f-EmployeeCode" form="employee-form" name="EmployeeCode" type="text"
                                           value="@e.EmployeeCode" maxlength="20" autocomplete="off" spellcheck="false" />
                                    <span class="form-text">@L["emp.leave_blank_to_assign_later_must_be_unique_per_c"]</span>
                                    <span class="field-validation-error" data-valmsg-for="EmployeeCode"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="f-ArabicName">@L["emp.name_arabic"]</label>
                                    <input class="form-control" id="f-ArabicName" form="employee-form" name="ArabicName" type="text"
                                           value="@e.ArabicName" maxlength="300" dir="rtl" style="font-family:var(--hrms-font-arabic,inherit)" />
                                    <span class="field-validation-error" data-valmsg-for="ArabicName"></span>
                                </div>
                                @* Row 2: First | Middle | Last name - one row *@
                                <div class="col-md-4">
                                    <label class="form-label" for="f-FirstName">@L["emp.first_name"] <span class="req" aria-hidden="true">*</span></label>
                                    <input class="form-control" id="f-FirstName" form="employee-form" name="FirstName" type="text"
                                           value="@e.FirstName" maxlength="100" required />
                                    <span class="field-validation-error" data-valmsg-for="FirstName"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-MiddleName">@L["emp.middle_name"]</label>
                                    <input class="form-control" id="f-MiddleName" form="employee-form" name="MiddleName" type="text"
                                           value="@e.MiddleName" maxlength="100" />
                                    <span class="field-validation-error" data-valmsg-for="MiddleName"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-LastName">@L["emp.last_name"]</label>
                                    <input class="form-control" id="f-LastName" form="employee-form" name="LastName" type="text"
                                           value="@e.LastName" maxlength="100" />
                                    <span class="field-validation-error" data-valmsg-for="LastName"></span>
                                </div>
                                @* Row 3: Gender, DOB, Marital Status, Nationality, Religion, Blood Group - one row *@
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-Gender">@L["emp.gender"]</label>
                                    <select class="form-select" id="f-Gender" form="employee-form" name="Gender">
                                        <option value="">@L["common.select"]</option>
                                        <option value="M" selected="@(e.Gender == "M")">@L["emp.male"]</option>
                                        <option value="F" selected="@(e.Gender == "F")">@L["emp.female"]</option>
                                    </select>
                                    <span class="field-validation-error" data-valmsg-for="Gender"></span>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-DateOfBirth">@L["emp.date_of_birth"]</label>
                                    <input class="form-control" id="f-DateOfBirth" form="employee-form" name="DateOfBirth" type="date"
                                           value="@e.DateOfBirth?.ToString("yyyy-MM-dd")" />
                                    <span class="field-validation-error" data-valmsg-for="DateOfBirth"></span>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-MaritalStatus">@L["emp.marital_status"]</label>
                                    <select class="form-select" id="f-MaritalStatus" form="employee-form" name="MaritalStatus">
                                        <option value="">@L["common.select"]</option>
                                        @foreach (var status in new[] { "Single", "Married", "Divorced", "Widowed" })
                                        {
                                            <option value="@status" selected="@(e.MaritalStatus == status)">@L.Tr(status)</option>
                                        }
                                    </select>
                                    <span class="field-validation-error" data-valmsg-for="MaritalStatus"></span>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-NationalityCountryId">@L["emp.nationality"]</label>
                                    <select class="form-select" id="f-NationalityCountryId" form="employee-form" name="NationalityCountryId">
                                        <option value="">@L["common.select"]</option>
                                        @foreach (var item in Model.Lookup(LookupType.Country))
                                        {
                                            <option value="@item.Id" selected="@(e.NationalityCountryId == item.Id)">@item.Text</option>
                                        }
                                    </select>
                                    <span class="field-validation-error" data-valmsg-for="NationalityCountryId"></span>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-Religion">@L["emp.religion"]</label>
                                    <input class="form-control" id="f-Religion" form="employee-form" name="Religion" type="text"
                                           value="@e.Religion" maxlength="50" />
                                    <span class="field-validation-error" data-valmsg-for="Religion"></span>
                                </div>
                                <div class="col-6 col-md-4 col-xl-2">
                                    <label class="form-label" for="f-BloodGroup">@L["emp.blood_group"]</label>
                                    <select class="form-select" id="f-BloodGroup" form="employee-form" name="BloodGroup">
                                        <option value="">@L["common.select"]</option>
                                        @foreach (var type in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                                        {
                                            <option value="@type" selected="@(e.BloodGroup == type)">@L.Tr(type)</option>
                                        }
                                    </select>
                                    <span class="field-validation-error" data-valmsg-for="BloodGroup"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#acc-personal-contact" aria-expanded="false" aria-controls="acc-personal-contact">
                            <span class="hrms-acc-ico" aria-hidden="true">@Html.Icon("phone", 15)</span><span class="hrms-acc-text"><span class="hrms-acc-title">@L["common.contact"]</span></span>
                        </button>
                    </h2>
                    <div id="acc-personal-contact" class="accordion-collapse collapse" data-bs-parent="#acc-personal">
                        <div class="accordion-body">
                            <div class="row g-3">
                                @* Mobile, Extension, Personal Email and Work Email share one row. *@
                                <div class="col-md-3">
                                    <label class="form-label" for="f-MobileNumber">@L["emp.mobile_number"]</label>
                                    <input class="form-control" id="f-MobileNumber" form="employee-form" name="MobileNumber" type="tel"
                                           value="@e.MobileNumber" maxlength="20" placeholder="+965 …" />
                                    <span class="field-validation-error" data-valmsg-for="MobileNumber"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-Extension">@L["emp.extension"]</label>
                                    <input class="form-control" id="f-Extension" form="employee-form" name="Extension" type="text"
                                           value="@e.Extension" maxlength="10" placeholder="@L["emp.e_g_4521"]" />
                                    <span class="field-validation-error" data-valmsg-for="Extension"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-PersonalEmail">@L["emp.personal_email"]</label>
                                    <input class="form-control" id="f-PersonalEmail" form="employee-form" name="PersonalEmail" type="email"
                                           value="@e.PersonalEmail" maxlength="150" />
                                    <span class="field-validation-error" data-valmsg-for="PersonalEmail"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-WorkEmail">@L["emp.work_email"]</label>
                                    <input class="form-control" id="f-WorkEmail" form="employee-form" name="WorkEmail" type="email"
                                           value="@e.WorkEmail" maxlength="150" />
                                    <span class="field-validation-error" data-valmsg-for="WorkEmail"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-CompanyPhone">@L["emp.company_phone"]</label>
                                    <input class="form-control" id="f-CompanyPhone" form="employee-form" name="CompanyPhone" type="tel"
                                           value="@e.CompanyPhone" maxlength="20" placeholder="+965 …" />
                                    <span class="field-validation-error" data-valmsg-for="CompanyPhone"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#acc-personal-address" aria-expanded="false" aria-controls="acc-personal-address">
                            <span class="hrms-acc-ico" aria-hidden="true">@Html.Icon("pin", 15)</span><span class="hrms-acc-text"><span class="hrms-acc-title">@L["common.address"]</span></span>
                        </button>
                    </h2>
                    <div id="acc-personal-address" class="accordion-collapse collapse" data-bs-parent="#acc-personal">
                        <div class="accordion-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="f-Neighborhood">@L["emp.neighborhood"]</label>
                                    <input class="form-control" id="f-Neighborhood" form="employee-form" name="Neighborhood" type="text"
                                           value="@e.Neighborhood" maxlength="100" />
                                    <span class="field-validation-error" data-valmsg-for="Neighborhood"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-Block">@L["common.block"]</label>
                                    <input class="form-control" id="f-Block" form="employee-form" name="Block" type="text"
                                           value="@e.Block" maxlength="20" />
                                    <span class="field-validation-error" data-valmsg-for="Block"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-StreetName">@L["emp.street_name"]</label>
                                    <input class="form-control" id="f-StreetName" form="employee-form" name="StreetName" type="text"
                                           value="@e.StreetName" maxlength="150" />
                                    <span class="field-validation-error" data-valmsg-for="StreetName"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-BuildingNumber">@L["emp.building_villa_number"]</label>
                                    <input class="form-control" id="f-BuildingNumber" form="employee-form" name="BuildingNumber" type="text"
                                           value="@e.BuildingNumber" maxlength="30" />
                                    <span class="field-validation-error" data-valmsg-for="BuildingNumber"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-FloorNumber">@L["emp.floor_number"]</label>
                                    <input class="form-control" id="f-FloorNumber" form="employee-form" name="FloorNumber" type="text"
                                           value="@e.FloorNumber" maxlength="20" />
                                    <span class="field-validation-error" data-valmsg-for="FloorNumber"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-FlatNumber">@L["emp.flat_number"]</label>
                                    <input class="form-control" id="f-FlatNumber" form="employee-form" name="FlatNumber" type="text"
                                           value="@e.FlatNumber" maxlength="20" />
                                    <span class="field-validation-error" data-valmsg-for="FlatNumber"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-PersonalPaciNumber">@L["emp.paci_number"]</label>
                                    <input class="form-control" id="f-PersonalPaciNumber" form="employee-form" name="PaciNumber" type="text"
                                           value="@e.PaciNumber" maxlength="20" />
                                    <span class="field-validation-error" data-valmsg-for="PaciNumber"></span>
                                </div>
                                <div class="col-md-9">
                                    <label class="form-label" for="f-Landmark">@L["emp.landmark"]</label>
                                    <input class="form-control" id="f-Landmark" form="employee-form" name="Landmark" type="text"
                                           value="@e.Landmark" maxlength="200" placeholder="@L["emp.nearby_landmark_to_help_locate_the_address"]" />
                                    <span class="field-validation-error" data-valmsg-for="Landmark"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#acc-personal-emergency" aria-expanded="false" aria-controls="acc-personal-emergency">
                            <span class="hrms-acc-ico" aria-hidden="true">@Html.Icon("shield", 15)</span><span class="hrms-acc-text"><span class="hrms-acc-title">@L["emp.emergency_contact"]</span></span>
                        </button>
                    </h2>
                    <div id="acc-personal-emergency" class="accordion-collapse collapse" data-bs-parent="#acc-personal">
                        <div class="accordion-body">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label class="form-label" for="f-EmergencyContactName">@L["emp.contact_name"]</label>
                                    <input class="form-control" id="f-EmergencyContactName" form="employee-form" name="EmergencyContactName" type="text"
                                           value="@e.EmergencyContactName" maxlength="150" />
                                    <span class="field-validation-error" data-valmsg-for="EmergencyContactName"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-EmergencyContactPhone">@L["emp.contact_phone"]</label>
                                    <input class="form-control" id="f-EmergencyContactPhone" form="employee-form" name="EmergencyContactPhone" type="tel"
                                           value="@e.EmergencyContactPhone" maxlength="20" />
                                    <span class="field-validation-error" data-valmsg-for="EmergencyContactPhone"></span>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="f-EmergencyContactRelation">@L["emp.relationship"]</label>
                                    <input class="form-control" id="f-EmergencyContactRelation" form="employee-form" name="EmergencyContactRelation" type="text"
                                           value="@e.EmergencyContactRelation" maxlength="50" />
                                    <span class="field-validation-error" data-valmsg-for="EmergencyContactRelation"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#acc-personal-father" aria-expanded="false" aria-controls="acc-personal-father">
                            <span class="hrms-acc-ico hrms-acc-ico--family" aria-hidden="true">@Html.Icon("users", 15)</span>
                            <span class="hrms-acc-text">
                                <span class="hrms-acc-title">@L["emp.father_s_details"]</span>
                                <span class="hrms-acc-sub">@L["emp.name_occupation_and_contact_number_of_the_employ"]</span>
                            </span>
                        </button>
                    </h2>
                    <div id="acc-personal-father" class="accordion-collapse collapse" data-bs-parent="#acc-personal">
                        <div class="accordion-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="f-FatherName">@L["emp.father_s_name"]</label>
                                    <input class="form-control" id="f-FatherName" form="employee-form" name="FatherName" type="text"
                                           value="@e.FatherName" maxlength="150" />
                                    <span class="field-validation-error" data-valmsg-for="FatherName"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="f-FatherOccupation">@L["emp.father_s_occupation"]</label>
                                    <input class="form-control" id="f-FatherOccupation" form="employee-form" name="FatherOccupation" type="text"
                                           value="@e.FatherOccupation" maxlength="100" />
                                    <span class="field-validation-error" data-valmsg-for="FatherOccupation"></span>
