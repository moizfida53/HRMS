@Html.AntiForgeryToken()

@section Styles {
    <style>
        .hrms-profile-tabs {
            border-bottom-color: var(--hrms-line-200); margin-bottom: 1rem;
            /* one line that scrolls sideways on narrow screens, instead of wrapping */
            flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; scrollbar-width: none;
        }
        .hrms-profile-tabs::-webkit-scrollbar { display: none; }
        .hrms-profile-tabs .nav-item { flex: 0 0 auto; }
        .hrms-profile-tabs .nav-link { white-space: nowrap; }
        .hrms-profile-tabs .nav-link {
            display: inline-flex; align-items: center; gap: .4rem;
            color: var(--hrms-ink-600); font-weight: 600; font-size: .85rem;
            border: 1px solid transparent; border-bottom: none;
        }
        .hrms-profile-tabs .nav-link.active {
            color: var(--hrms-blue-700);
            background: #fff;
            border-color: var(--hrms-line-200);
            box-shadow: inset 0 2px 0 var(--hrms-blue-600);
        }
        .hrms-profile-tabs .nav-link:disabled { color: var(--hrms-ink-400); cursor: not-allowed; }
        .hrms-profile-tab-content .hrms-card { margin-bottom: 0; }

        /* Add Employee wizard: the document summary tiles and the search/filter bar are hidden. */
        #documents-slot.is-wizard .hrms-docs__summary,
        #documents-slot.is-wizard .hrms-docs .hrms-card__toolbar { display: none; }

        /* Wizard stepper + footer (Add Employee). */
        .hrms-wizard-steps { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; padding: 0 .25rem; overflow-x: auto; }
        .hrms-wizard-step { display: flex; align-items: center; gap: .55rem; color: var(--hrms-ink-400); font-weight: 600; font-size: .85rem; flex: 0 0 auto; }
        .hrms-wizard-step__circle {
            display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%;
            border: 2px solid var(--hrms-line-200); background: #fff; color: var(--hrms-ink-400);
            font-size: .85rem; font-weight: 700; flex: 0 0 auto;
        }
        .hrms-wizard-step__label { white-space: nowrap; }
        .hrms-wizard-step__line { flex: 1 1 24px; min-width: 16px; height: 2px; background: var(--hrms-line-200); }
        .hrms-wizard-step.is-active { color: var(--hrms-blue-700); }
        .hrms-wizard-step.is-active .hrms-wizard-step__circle { border-color: var(--hrms-blue-600); background: var(--hrms-blue-600); color: #fff; }
        .hrms-wizard-step.is-complete { color: var(--hrms-blue-700); }
        .hrms-wizard-step.is-complete .hrms-wizard-step__circle { border-color: var(--hrms-blue-600); background: var(--hrms-blue-050); color: var(--hrms-blue-600); }
        .hrms-wizard-footer { display: flex; align-items: center; gap: .5rem; padding: .85rem 1.25rem; margin: 1rem 0 0; }
        @@media (max-width: 767.98px) { .hrms-wizard-step__label { display: none; } .hrms-wizard-step.is-active .hrms-wizard-step__label { display: inline; } }

        /* Accordion headers: icon chip + title (+ optional subtitle). */
        .hrms-acc-ico {
            display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
            width: 28px; height: 28px; border-radius: 8px;
            background: #fff; color: var(--hrms-blue-600); border: 1px solid var(--hrms-line-200);
        }
        .hrms-acc-ico--family { width: 38px; height: 38px; border-radius: 10px; background: var(--hrms-blue-600); color: #fff; border-color: var(--hrms-blue-600); }
        .hrms-acc-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; text-align: start; }
        .hrms-acc-title { font-weight: 700; }
        .hrms-acc-sub { font-weight: 400; font-size: .76rem; color: var(--hrms-ink-500); margin-top: .1rem; }

        /* Basic Employee Info strip: photo placeholder + Department/Designation chips. */
        .hrms-profile-photo { position: relative; display: inline-flex; flex: 0 0 auto; }
        .hrms-profile-photo__badge {
            position: absolute; inset-inline-end: -3px; bottom: -3px;
            width: 20px; height: 20px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: var(--hrms-blue-600); color: #fff;
            border: 2px solid #fff;
        }
        .hrms-info-chip {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .35rem .7rem; border-radius: 999px;
            background: var(--hrms-blue-050); color: var(--hrms-blue-700);
            font-size: .8rem; font-weight: 600; white-space: nowrap;
        }

        /* Collapsible sections inside each tab, shaded so they read as
           distinct from the surrounding card (per the Edit-mode request). */
        .hrms-accordion .accordion-item {
            border: 1px solid var(--hrms-line-200);
            border-radius: var(--hrms-radius, 10px);
            overflow: hidden;
            margin-bottom: .75rem;
        }
        .hrms-accordion .accordion-item:last-child { margin-bottom: 0; }
        .hrms-accordion .accordion-header { margin: 0; }
        .hrms-accordion .accordion-button {
            display: inline-flex; align-items: center; gap: .5rem;
            font-weight: 600; font-size: .88rem; color: var(--hrms-blue-700);
            background: var(--hrms-blue-050);
            padding: .8rem 1.1rem;
            box-shadow: none;
        }
        .hrms-accordion .accordion-button:not(.collapsed) {
            background: var(--hrms-blue-100);
            box-shadow: inset 0 -1px 0 var(--hrms-line-200);
        }
        .hrms-accordion .accordion-button:focus { box-shadow: 0 0 0 3px rgba(29, 95, 191, 0.16); }
        .hrms-accordion .accordion-button::after { margin-inline-start: auto; }
        .hrms-accordion .accordion-body { padding: 1.25rem 1.1rem; background: #fff; }

        /* Employee card: avatar | name + code/department/designation | Save. */
        .hrms-emp-strip {
            display: flex; align-items: center; flex-wrap: wrap; gap: .75rem 1.25rem;
            padding: 1rem 1.25rem; margin-bottom: 1rem;
        }
        .hrms-emp-strip__avatar { width: 52px; height: 52px; font-size: 1.15rem; }
        .hrms-emp-strip__who { flex: 1 1 180px; min-width: 0; }
        .hrms-emp-strip__name-row { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; }
        .hrms-emp-strip__name { margin: 0; font-size: 1.1rem; font-weight: 600; }
        .hrms-emp-strip__meta {
