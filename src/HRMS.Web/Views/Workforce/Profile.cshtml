            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="button" class="btn btn-danger" data-document-confirm-accept>@L["emp.remove"]</button>
            </div>
