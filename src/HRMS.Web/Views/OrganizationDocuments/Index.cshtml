@model OrgDocumentsPageModel
@{
    ViewData["Title"] = "Organizations";
    ViewData["ActiveArea"] = "organizations";
    ViewData["Subtitle"] = L["od.page_subtitle"];
}
<div class="od-page" data-od-page
     data-urls-companies="@Url.Action("Companies", "OrganizationDocuments")"
     data-urls-panel="@Url.Action("Panel", "OrganizationDocuments")"
     data-urls-form="@Url.Action("Form", "OrganizationDocuments")"
     data-urls-save="@Url.Action("Save", "OrganizationDocuments")"
     data-urls-delete="@Url.Action("Delete", "OrganizationDocuments")"
     data-urls-history="@Url.Action("History", "OrganizationDocuments")"
     data-selected="@Model.SelectedCompanyId"
     data-text-add="@L["od.add_document"]" data-text-edit="@L["od.edit_document"]" data-text-renew="@L["od.renew_document"]"
     data-text-history="@L["od.history_of"]">

    @if (Model.Companies.Count == 0)
    {
        <div class="hrms-card"><div class="hrms-empty">
            <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon("building", 26)</span>
            <p class="hrms-empty__title">@L["od.no_companies"]</p>
        </div></div>
    }
    else
    {
        @* the companies in one row (scroll sideways); the one picked opens below *@
        <section class="od-strip" aria-label="@L["od.companies"]">
            <h2 class="od-side-title">@L["od.companies"] <span class="od-side-title__count">@Model.Companies.Count</span></h2>
            <div class="od-strip__scroller" data-od-scroller>
                <button type="button" class="od-strip__arrow is-prev" data-od-scroll="-1" aria-label="@L["common.previous_page"]" hidden>@Html.Icon("chevron-left", 18)</button>
                <div class="od-strip__track" data-od-companies>
                    @await Html.PartialAsync("~/Views/OrganizationDocuments/_CompanyList.cshtml", new OrgCompanyListModel { Companies = Model.Companies })
                </div>
                <button type="button" class="od-strip__arrow is-next" data-od-scroll="1" aria-label="@L["common.next_page"]" hidden>@Html.Icon("chevron-right", 18)</button>
            </div>
        </section>
        <section class="od-docs" data-od-panel aria-live="polite">
            <div class="pr-loading"><div class="hrms-spinner"></div></div>
        </section>
    }
</div>

@* ---- add / change / renew: the body comes from the server ---- *@
<div class="modal fade" id="od-form-modal" tabindex="-1" aria-hidden="true" aria-labelledby="od-form-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-od-form novalidate enctype="multipart/form-data">
            <div class="modal-header">
                <h2 class="modal-title h5" id="od-form-title" data-od-form-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-od-form-body></div>
            <div class="modal-footer">
                <span class="field-validation-error me-auto" data-od-form-error></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="submit" class="btn btn-primary" data-od-save>@Html.Icon("check", 15)<span>@L["common.save_changes"]</span></button>
            </div>
        </form>
    </div>
</div>

@* ---- versions ---- *@
<div class="modal fade" id="od-history-modal" tabindex="-1" aria-hidden="true" aria-labelledby="od-history-title">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="od-history-title" data-od-history-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-od-history-body></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button></div>
        </div>
    </div>
</div>

@* ---- a scan ---- *@
<div class="modal fade doc-viewer" id="od-viewer-modal" tabindex="-1" aria-hidden="true" aria-labelledby="od-viewer-title">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="doc-viewer__title">
                    <h2 class="modal-title h5" id="od-viewer-title" data-od-viewer-title></h2>
                    <span class="doc-viewer__file" data-od-viewer-file></span>
                </div>
                <div class="doc-viewer__tools">
                    <a class="doc-viewer__tool" href="#" data-od-viewer-download title="@L["emp.download"]" aria-label="@L["emp.download"]">@Html.Icon("download", 17)</a>
                    <button type="button" class="doc-viewer__tool doc-viewer__tool--close" data-bs-dismiss="modal" title="@L["common.close"]" aria-label="@L["common.close"]">@Html.Icon("close", 18)</button>
                </div>
            </div>
            <div class="modal-body" data-od-viewer-body></div>
        </div>
    </div>
</div>

@* ---- remove ---- *@
<div class="modal fade" id="od-confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="od-confirm-title">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="od-confirm-title">@L["od.remove_document"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body"><p class="mb-0">@L["od.remove_document_text"] <strong data-od-confirm-name></strong></p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="button" class="btn btn-danger" data-od-confirm-accept>@L["emp.remove"]</button>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/org-documents.js" asp-append-version="true"></script>
}
