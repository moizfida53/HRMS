@model OrgCompanyListModel
@* The active companies with the health of their documents; one opens on the right. *@
<ul class="od-colist">
    @foreach (var c in Model.Companies)
    {
        var pct = c.TypeCount > 0 ? (int)Math.Round(100.0 * c.RecordedCount / c.TypeCount) : 0;
        var initials = string.Concat(c.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0])).Take(2).Select(w => char.ToUpperInvariant(w[0])));
        var tone = c.ExpiredCount > 0 ? "bad" : c.DueCount > 0 || c.MissingCount > 0 ? "warn" : "ok";
        <li>
            <button type="button" class="od-co od-co--@tone" data-od-company="@c.CompanyId" aria-pressed="false">
                <span class="od-co__avatar" aria-hidden="true">@initials</span>
                <span class="od-co__body">
                    <span class="od-co__name">@c.CompanyName</span>
                    <span class="od-co__sub">@string.Join(" · ", new[] { c.CompanyCode, c.CommercialRegistrationNo is { Length: > 0 } cr ? L["od.cr_no", cr] : null }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                    <span class="od-co__bar" title="@L["od.recorded_of", c.RecordedCount, c.TypeCount]"><span style="width:@(pct)%"></span></span>
                    <span class="od-co__chips">
                        <span class="od-co__chip">@L["od.recorded_of", c.RecordedCount, c.TypeCount]</span>
                        @if (c.ExpiredCount > 0) { <span class="od-co__chip is-bad">@Html.Icon("alert", 11)@L["od.n_expired", c.ExpiredCount]</span> }
                        @if (c.DueCount > 0) { <span class="od-co__chip is-warn">@Html.Icon("bell", 11)@L["od.n_due", c.DueCount]</span> }
                        @if (c.MissingCount > 0) { <span class="od-co__chip is-miss">@L["od.n_missing", c.MissingCount]</span> }
                    </span>
                </span>
            </button>
        </li>
    }
</ul>
