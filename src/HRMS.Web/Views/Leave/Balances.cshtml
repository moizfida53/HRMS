@model LeaveBalancesPageModel
@{
    ViewData["Title"] = "Leave Balances";
    ViewData["ActiveArea"] = "leave";
    ViewData["LeavePage"] = "balances";
    ViewData["Subtitle"] = L["lv.balances_subtitle"];
    var categories = new[] { "ANNUAL", "SICK", "EMERGENCY", "HAJJ", "MATERNITY", "BEREAVEMENT", "UNPAID", "OTHER" };
}
<div class="lv-page" data-lv-page="balances"
     data-urls-grid="@Url.Action("BalancesGrid", "Leave")"
     data-urls-export="@Url.Action("BalancesExport", "Leave")">

    <div class="pr-banner pr-banner--info">
        @Html.Icon("info", 18)
        <div>@L["lv.balances_banner"]</div>
    </div>

    <section class="hrms-card" data-lv-list>
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters lv-filters">
                <label class="hrms-search lv-filter-search">
                    @Html.Icon("search", 16)
                    <input type="search" data-lv-f="search" autocomplete="off" placeholder="@L["lv.search_employee"]" aria-label="@L["lv.search_employee"]" />
                </label>
                <select class="form-select lv-filter" data-lv-f="category" aria-label="@L["lv.leave_kind"]">
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(c == "ANNUAL")">@LeaveFormat.CategoryLabel(L, c)</option>
                    }
                    <option value="">@L["lv.all_leave_types"]</option>
                </select>
                <select class="form-select lv-filter lv-filter--emp" data-lv-f="emp" aria-label="@L["lv.employee"]">
                    <option value="">@L["lv.all_employees"]</option>
                    @foreach (var e in Model.Employees)
                    {
                        <option value="@e.EmployeeId">@LeaveFormat.Name(L, e.EmployeeName, e.ArabicName) · @e.EmployeeNo</option>
                    }
                </select>
                <label class="lv-asof">
                    <span>@L["lv.as_of_date"]</span>
                    <input type="date" class="form-control" data-lv-f="asOf" value="@DateTime.Today.ToString("yyyy-MM-dd")" aria-label="@L["lv.as_of_date"]" />
                </label>
            </div>
            <div class="hrms-card__count" data-lv-count></div>
        </div>
        <div data-lv-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>

@await Html.PartialAsync("~/Views/Leave/_Modals.cshtml")

@section PageActions {
    <button type="button" class="btn btn-outline-secondary" data-lv-export>@Html.Icon("download", 15)<span>@L["common.export"]</span></button>
}
@section Scripts {
    <script src="~/js/leave.js" asp-append-version="true"></script>
}
