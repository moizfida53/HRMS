@model LeavePageModel
@{
    ViewData["Title"] = "Leave Management";
    ViewData["ActiveArea"] = "leave";
    ViewData["LeavePage"] = "requests";
    ViewData["Subtitle"] = L["lv.requests_subtitle"];
    var r = Model.Rights;
    var statuses = new List<(string Value, string Label)>();
    if (r.AnyApproval) { statuses.Add(("MINE", L["lv.f_waiting_for_me"])); }
    if (r.CanView)
    {
        statuses.AddRange(new[]
        {
            ("PENDING", L["lv.f_pending"]), ("ONLEAVE", L["lv.f_on_leave_today"]), ("UPCOMING", L["lv.f_upcoming"]),
            ("APPROVED", L["lv.f_approved"]), ("REJECTED", L["lv.f_rejected"]), ("CANCELLED", L["lv.f_cancelled"]), ("ALL", L["lv.f_all"])
        });
    }
    var currentStatus = statuses.Any(s => s.Value == Model.Status) ? Model.Status : statuses.FirstOrDefault().Value;
}

<div class="lv-page" data-lv-page="requests"
     data-urls-grid="@Url.Action("RequestsGrid", "Leave")"
     data-urls-kpis="@Url.Action("Kpis", "Leave")"
     data-urls-export="@Url.Action("Export", "Leave")">

    <div data-lv-kpis aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>

    <section class="hrms-card" data-lv-list>
        <div class="hrms-card__toolbar">
            @* the status as buttons (a dropdown hid the choice); the value goes in the hidden field *@
            <div class="lv-status-bar">
                <input type="hidden" data-lv-f="status" value="@currentStatus" />
                <div class="lv-status-chips" role="group" aria-label="@L["common.status"]" data-lv-status-chips>
                    @foreach (var s in statuses)
                    {
                        var on = s.Value == currentStatus;
                        <button type="button" class="lv-status-chip lv-status-chip--@s.Value.ToLowerInvariant() @(on ? "is-active" : null)" data-lv-status="@s.Value" aria-pressed="@(on ? "true" : "false")">@s.Label</button>
                    }
                </div>
            </div>
            <div class="hrms-card__filters lv-filters">
                @if (r.CanView)
                {
                    <label class="hrms-search lv-filter-search">
                        @Html.Icon("search", 16)
                        <input type="search" data-lv-f="search" autocomplete="off" placeholder="@L["lv.search_requests"]" aria-label="@L["lv.search_requests"]" />
                    </label>
                }
                @if (r.CanView)
                {
                    <select class="form-select lv-filter" data-lv-f="type" aria-label="@L["lv.leave_type"]">
                        <option value="">@L["lv.all_leave_types"]</option>
                        @foreach (var t in Model.Types.Where(t => t.IsActive))
                        {
                            <option value="@t.LeaveTypeId">@LeaveFormat.Name(L, t.TypeName, t.ArabicName)@(Model.ManyCompanies ? " · " + t.CompanyName : "")</option>
                        }
                    </select>
                    <select class="form-select lv-filter lv-filter--emp" data-lv-f="emp" aria-label="@L["lv.employee"]">
                        <option value="">@L["lv.all_employees"]</option>
                        @foreach (var e in Model.Employees)
                        {
                            <option value="@e.EmployeeId">@LeaveFormat.Name(L, e.EmployeeName, e.ArabicName) · @e.EmployeeNo</option>
                        }
                    </select>
                    <div class="lv-filter-dates">
                        <input type="date" class="form-control" data-lv-f="from" aria-label="@L["lv.from"]" title="@L["lv.from"]" />
                        <span aria-hidden="true">–</span>
                        <input type="date" class="form-control" data-lv-f="to" aria-label="@L["lv.to"]" title="@L["lv.to"]" />
                    </div>
                }
            </div>
            <div class="hrms-card__count" data-lv-count></div>
        </div>
        <div data-lv-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>

@await Html.PartialAsync("~/Views/Leave/_Modals.cshtml")

@section PageActions {
    @if (r.CanView)
    {
        <button type="button" class="btn btn-outline-secondary" data-lv-export>@Html.Icon("download", 15)<span>@L["common.export"]</span></button>
    }
    @if (r.CanManage)
    {
        <button type="button" class="btn btn-primary" data-lv-new="hr">@Html.Icon("plus", 15)<span>@L["lv.new_request"]</span></button>
    }
}
@section Scripts {
    <script src="~/js/leave.js" asp-append-version="true"></script>
}
