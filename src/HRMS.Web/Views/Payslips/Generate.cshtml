@inject IRefProtector Refs
@model PayslipGenerateModel
@{
    // Payroll > Payslips > Generate Payslips (db/42-43): the payrolls - by default the closed
    // ones with payslips still to generate. View opens the payroll's figures and the generate
    // form in a popup; View Payslips opens its employees' payslips in a popup. Every payroll
    // is named by an opaque reference (never its id) - see IRefProtector.
    ViewData["Title"] = "Generate Payslips";
    ViewData["ActiveArea"] = "payroll";
    ViewData["PayrollSection"] = "payslips";
    ViewData["PayrollPage"] = "slip-generate";
    ViewData["Subtitle"] = L["ps.generate_subtitle"];
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var countText = Model.Rows.Count == 1 ? L["fin.1_payroll"] : L["fin.0_payrolls", PayrollFormat.Count(Model.Rows.Count)];
}

<div class="pr-stack ps-page ps-gen-page" data-ps-page="generate-list"
     data-urls-panel="@Url.Action("RunPanel", "Payslips")"
     data-urls-slips="@Url.Action("SlipsPanel", "Payslips")"
     data-urls-grid="@Url.Action("Grid", "Payslips")"
     data-urls-generate="@Url.Action("GeneratePayslips", "Payslips")">

    @* ------------------------------------------------ filters *@
    <section class="hrms-card ps-gen-filters">
        <form class="hrms-card__toolbar" method="get" action="@Url.Action("Generate", "Payslips")" data-ps-filters>
            <div class="hrms-card__filters">
                <span class="ps-gen-filters__icon" aria-hidden="true">@Html.Icon("receipt", 18)</span>
                <select class="form-select ps-gen-filters__year" name="year" data-ps-filter aria-label="@L["pr.year"]">
                    <option value="">@L["pr.all_years"]</option>
                    @foreach (var y in Model.Years)
                    {
                        <option value="@y" selected="@(Model.Year == y)">@y</option>
                    }
                </select>
                <select class="form-select ps-gen-filters__month" name="month" data-ps-filter aria-label="@L["pr.period"]">
                    <option value="">@L["pr.all_periods"]</option>
                    @foreach (var m in Model.Months)
                    {
                        <option value="@m.ToString("yyyy-MM", inv)" data-year="@m.Year" selected="@(Model.Month == m)">@L.MonthYear(m)</option>
                    }
                </select>
                <select class="form-select ps-gen-filters__show" name="show" data-ps-filter aria-label="@L["ps.show"]">
                    @foreach (var sh in PayslipShow.Values)
                    {
                        <option value="@sh" selected="@(Model.Show == sh)">@L[PayslipShow.Key(sh)]</option>
                    }
                </select>
                <label class="hrms-search ps-gen-filters__search">
                    @Html.Icon("search", 16)
                    <input type="search" name="q" value="@Model.Search" data-ps-filter-search autocomplete="off" maxlength="100"
                           placeholder="@L["ps.search_payrolls"]" aria-label="@L["ps.search_payrolls"]" />
                </label>
                <noscript><button type="submit" class="btn btn-outline-secondary">@L["dash.show"]</button></noscript>
            </div>
            <div class="hrms-card__count">@countText</div>
        </form>
    </section>

    @if (Model.Show != PayslipShow.Pending && Model.PendingCount > 0)
    {
        <div class="pr-banner pr-banner--lock" role="note">
            @Html.Icon("receipt", 18)
            <div><strong>@L["ps.n_payrolls_pending", PayrollFormat.Count(Model.PendingCount)]</strong> <a href="@Url.Action("Generate", "Payslips")">@L["ps.show_pending_link"]</a></div>
        </div>
    }

    @* ------------------------------------------------ payrolls *@
    <section class="hrms-card">
        @if (Model.Rows.Count == 0)
        {
            <div class="hrms-empty">
                <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.Show == PayslipShow.Pending && !Model.IsFiltered ? "check" : "search", 26)</span>
                @if (Model.Runs.Count == 0)
                {
                    <p class="hrms-empty__title">@L["ps.no_payrolls_title"]</p>
                    <p class="hrms-empty__text">@L["ps.no_payrolls_text"]</p>
                }
                else if (Model.Show == PayslipShow.Pending && !Model.IsFiltered)
                {
                    <p class="hrms-empty__title">@L["ps.all_generated_title"]</p>
                    <p class="hrms-empty__text">@L["ps.all_generated_text"]</p>
                    <a class="btn btn-outline-secondary btn-sm mt-2" href="@Url.Action("Generate", "Payslips", new { show = PayslipShow.All })">@L["ps.show_all"]</a>
                }
                else
                {
                    <p class="hrms-empty__title">@L["pr.no_payrolls_match_the_filters"]</p>
                    <p class="hrms-empty__text">@L["pr.change_the_period_or_stage_to_see_more_payrolls"]</p>
                }
            </div>
        }
        else
        {
            <div class="hrms-table-wrap">
                <table class="hrms-table ps-run-table">
                    <caption class="hrms-sr-only">@L["pr.payrolls"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["layout.payroll"]</th>
                            @if (Model.ManyCompanies)
                            {
                                <th scope="col">@L["common.company"]</th>
                            }
                            <th scope="col">@L["pr.period"]</th>
                            <th scope="col" class="col-p2">@L["pr.pay_date"]</th>
                            <th scope="col">@L["common.status"]</th>
                            <th scope="col" class="text-center col-p3">@L["common.employees"]</th>
                            <th scope="col">@L["ps.payslips"]</th>
                            <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var rref = Refs.Protect(RefPurpose.PayslipRun, r.PayrollRunId);
                            var upToDate = Math.Max(0, r.EmployeeCount - r.ToGenerateCount);
                            var pct = r.EmployeeCount == 0 ? 0 : (int)Math.Round(upToDate * 100m / r.EmployeeCount);
                            <tr class="@(r.IsPending ? "ps-run-row--pending" : null)">
                                <td data-label="@L["layout.payroll"]" class="hrms-nowrap">
                                    <span class="hrms-code-chip">@r.RunCode</span>
                                    <span class="pr-emp-sub">@L.Tr(RunType.Label(r.RunType)) · @PayrollFormat.Calendar(L, r.CalendarName ?? "", r.CalendarArabicName)</span>
                                </td>
                                @if (Model.ManyCompanies)
                                {
                                    <td data-label="@L["common.company"]">
                                        <span class="pr-run-company" title="@r.CompanyName">@r.CompanyName</span>
                                        <span class="pr-emp-sub">@r.CompanyCode</span>
                                    </td>
                                }
                                <td data-label="@L["pr.period"]" class="hrms-nowrap">@PayslipFormat.Period(L, r)</td>
                                <td data-label="@L["pr.pay_date"]" class="col-p2 hrms-nowrap">@L.Date(r.PaymentDate)</td>
                                <td data-label="@L["common.status"]">
                                    <span class="hrms-badge hrms-badge--@(r.IsClosed ? "success" : "warning")"><span class="hrms-badge__dot"></span>@L[PayslipFormat.StageKey(r.Stage)]</span>
                                </td>
                                <td data-label="@L["common.employees"]" class="text-center col-p3">@PayrollFormat.Count(r.EmployeeCount)</td>
                                <td data-label="@L["ps.payslips"]" class="ps-run-progress">
                                    @if (!r.IsClosed)
                                    {
                                        <span class="hrms-muted hrms-text-sm">@L["ps.after_close"]</span>
                                    }
                                    else
                                    {
                                        <span class="ps-run-progress__text">@L["ps.0_of_1_generated", PayrollFormat.Count(upToDate), PayrollFormat.Count(r.EmployeeCount)]</span>
                                        <span class="ps-run-progress__bar" aria-hidden="true"><span class="@(pct == 100 ? "is-done" : null)" style="width:@(pct)%"></span></span>
                                        @if (r.ToGenerateCount > 0)
                                        {
                                            <span class="hrms-badge hrms-badge--warning ps-run-progress__todo"><span class="hrms-badge__dot"></span>@L["ps.n_to_generate", PayrollFormat.Count(r.ToGenerateCount)]</span>
                                        }
                                    }
                                </td>
                                <td class="hrms-table__actions ps-run-actions"><div class="ps-run-actions__wrap">
                                    <button type="button" class="btn-icon" data-ps-view="@rref" data-ps-title="@r.RunCode"
                                            title="@L["ps.view"]" aria-label="@L["ps.view_payroll_0", r.RunCode ?? ""]">@Html.Icon("eye", 15)</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-ps-slips="@rref" data-ps-title="@r.RunCode">
                                        @Html.Icon("receipt", 14)<span>@L["ps.view_payslips"]</span>
                                    </button>
                                    @if (Model.Rights.CanEmail && r.IsClosed && r.GeneratedCount > 0)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Email", "Payslips", new { @ref = rref })">
                                            @Html.Icon("send", 14)<span>@L["ps.email_payslips"]</span>
                                        </a>
                                    }
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
@Html.AntiForgeryToken()

@* ------------------------------------------------ popups *@
<div class="modal fade ps-modal" id="ps-run-modal" tabindex="-1" aria-hidden="true" aria-labelledby="ps-run-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="ps-run-modal-title" data-ps-modal-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-ps-modal-body></div>
        </div>
    </div>
</div>
<div class="modal fade ps-modal" id="ps-slips-modal" tabindex="-1" aria-hidden="true" aria-labelledby="ps-slips-modal-title">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="ps-slips-modal-title" data-ps-modal-title></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body" data-ps-modal-body></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.close"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payslips.js" asp-append-version="true"></script>
}
