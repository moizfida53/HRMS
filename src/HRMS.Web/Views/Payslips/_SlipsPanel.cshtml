@model PayslipSlipsPanelModel
@{
    // The View Payslips popup: the employees of one payroll with their payslip
    // (the list itself is loaded from Grid, by POST, with the payroll's reference).
    var run = Model.Run;
}
<div class="ps-panel" data-ps-slips-panel data-ref="@Model.Ref">
    <span hidden data-ps-panel-title>@L["ps.payslips"] · @run.RunCode · @PayslipFormat.Period(L, run)</span>

    @if (!run.IsClosed)
    {
        <div class="pr-banner pr-banner--lock mb-3" role="note">
            @Html.Icon("lock", 18)
            <div><strong>@L["ps.not_closed_title"]</strong> @L["ps.not_closed_text"]</div>
        </div>
    }

    <section class="hrms-card" data-ps-list>
        <div class="hrms-card__toolbar">
            <div class="hrms-card__filters">
                <label class="hrms-search ps-search">
                    @Html.Icon("search", 16)
                    <input type="search" data-ps-search autocomplete="off" placeholder="@L["ps.search_placeholder"]" aria-label="@L["ps.search_placeholder"]" />
                </label>
                @if (Model.Departments.Count > 0)
                {
                    <select class="form-select ps-filter" data-ps-dept aria-label="@L["pr.all_departments"]">
                        <option value="">@L["pr.all_departments"]</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id">@d.Text</option>
                        }
                    </select>
                }
                <select class="form-select ps-filter" data-ps-status aria-label="@L["common.status"]">
                    @foreach (var f in new[] { PayslipFilter.All, PayslipFilter.Generated, PayslipFilter.NotGenerated, PayslipFilter.Outdated })
                    {
                        <option value="@f">@L[PayslipFormat.FilterKey(f)]</option>
                    }
                </select>
            </div>
            <div class="hrms-card__count" data-ps-count></div>
        </div>
        <div data-ps-slot aria-live="polite"><div class="pr-loading"><div class="hrms-spinner"></div></div></div>
    </section>
</div>
