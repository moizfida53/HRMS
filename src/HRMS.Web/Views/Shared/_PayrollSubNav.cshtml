@using HRMS.Web.Models.Payroll
@inject ICurrentUser CurrentUser
@model (PayrollNav.Section Section, bool Active, HRMS.Web.Services.PayrollNavCountsResult? Counts)
@inject HRMS.Web.Services.IApprovalNotifications Approvals
@{
    // db/110 / db/111: records waiting for this user's approval, per sub-section and for the section
    var ap = await Approvals.GetAsync();
    var apSection = Model.Section.Key switch { "processing" => ap.For("PAYROLL"), "components" => ap.Components, _ => 0 };
    // A payroll section that opens in the sidebar into its pages (sub-sections), each with
    // its record count where it has one: Payroll Processing, Payslips, Bank Processing,
    // Accounting (under Payroll) and Payroll Settings (under Setup).
    var section = Model.Section;
    var activeSub = PayrollNav.SubSection(ViewData["PayrollPage"] as string);
    var subId = "nav-sub-" + section.Key;
}
<button type="button" class="hrms-nav-link hrms-nav-parent @(Model.Active ? "is-open" : "collapsed")"
        data-bs-toggle="collapse" data-bs-target="#@subId"
        aria-expanded="@(Model.Active ? "true" : "false")" aria-controls="@subId">
    @Html.Icon(section.Icon)<span>@L.Tr(section.Title)</span>@if (apSection > 0)
    {
        <span class="hrms-nav-approval" title="@L["ap.badge_title", apSection]" aria-hidden="true">@apSection.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
    }@Html.Icon("chevron-down", 14, "hrms-nav-parent__chev")
</button>
<div class="collapse hrms-nav-sub @(Model.Active ? "show" : null)" id="@subId">
    @foreach (var tab in section.Tabs)
    {
        // a page the user has no read access to is not offered (Security > Create Roles)
        if (!CurrentUser.CanOpen("tab:" + tab.Slug)) { continue; }
        var count = Model.Counts?.For(tab.Slug);
        string? title = count is null ? null : tab.Slug switch
        {
            "payrolls" => L["layout.nav_count_payrolls", count],
            "calendars" => L["layout.nav_count_calendars", count],
            "pay-periods" => L["layout.nav_count_periods", count],
            "slip-generate" => L["layout.nav_count_slips_to_generate", count],
            "slip-employee" => L["layout.nav_count_slips_generated", count],
            "slip-email" => L["layout.nav_count_slips_to_email", count],
            "bk-file" => L["layout.nav_count_bank_files", count],
            "bk-register" => L["layout.nav_count_payments_open", count],
            "ac-journal" => L["layout.nav_count_journals_to_make", count],
            "ac-posting" => L["layout.nav_count_journals_to_post", count],
            _ => null
        };
        var subActive = Model.Active && activeSub == tab.Slug;
        <a class="hrms-nav-link hrms-nav-sub__link @(subActive ? "is-active" : null)"
           href="@(Context.Request.PathBase + PayrollNav.Url(tab.Slug))"
           aria-current="@(subActive ? "page" : null)">
            <span>@L.Tr(tab.Title)</span>
            @if (ap.ForSlug(tab.Slug) is var apTab && apTab > 0)
            {
                @* db/110 / db/111: records of this page waiting for this user's approval *@
                <span class="hrms-nav-approval" title="@L["ap.badge_title", apTab]" aria-label="@L["ap.badge_title", apTab]">@apTab.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
            }
            @if (count is { } n)
            {
                <span class="hrms-nav-count @(n == 0 ? "is-zero" : null)" title="@title" aria-label="@title">@n.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
            }
        </a>
    }
</div>
