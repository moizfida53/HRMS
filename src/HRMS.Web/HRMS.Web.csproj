<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HRMS.Data\HRMS.Data.csproj" />
    <ProjectReference Include="..\HRMS.Domain\HRMS.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      appsettings.{Environment}.local.json carries real credentials on a
      developer's own machine (git-ignored - see .gitignore). It must be
      present next to the app for `dotnet run` / F5 debugging to pick it up,
      but it must NEVER ride along inside a `dotnet publish` output - that
      output is a deployable artifact that can end up copied, zipped or
      shipped somewhere else, and a real password has no business inside it.
    -->
    <Content Update="appsettings.*.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      Server database connection (Program.cs, Services/DatabaseSetup.cs):
      dbsettings.json is written ON THE SERVER by Set-DatabaseConnection.cmd and
      holds the password - never published, so a publish never overwrites it.
      The template and the helper script go into the publish output, next to
      HRMS.Web.dll, where they are run.
    -->
    <Content Update="dbsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="dbsettings.template.json">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="Deploy\Set-DatabaseConnection.ps1;Deploy\Set-DatabaseConnection.cmd">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
