<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=4.4.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="POSConnection" connectionString="__SET_IN_LOCAL_CONFIG__" />
       <add name="ConnStr" connectionString="__SET_IN_LOCAL_CONFIG__" providerName="System.Data.SqlClient" />
    <add name="SqlConnectionString" connectionString="__SET_IN_LOCAL_CONFIG__" providerName="System.Data.SqlClient" />
    
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="autoFormsAuthentication" value="false" />
    <add key="enableSimpleMembership" value="false" />
    <add key="Width" value="600" />
    <add key="Height" value="400" />
    <add key="ThumbnailWidth" value="150" />
    <add key="ThumbnailHeight" value="150" />
    <add key="WebSlideShowImageWidth" value="600" />
    <add key="POSPORT" value="80" />
    <add key="WebSlideShowImageHeight" value="400" />
    <add key="aspnet:MaxJsonDeserializerMembers" value="150000" />
    <add key="IsCartVisible" value="true" />
    <!--if eCommerce site then hide geneate qr code button and show Check Out button-->
    <add key="IsGenerateQRCode" value="false" />
    <add key="IsEcommerce" value="true" />
    <add key="KNetPayment" value="true" />
    <add key="VisaPayment" value="false" />
    <add key="DesignTheme" value="Design1" />
    <add key="IsSubCategory" value="true" />
    <add key="IsPermenantDelete" value="true" />
    <!--<add key="CallCenterUrl" value="__SET_IN_LOCAL_CONFIG__" />-->
    <add key="CallCenterUrl" value="__SET_IN_LOCAL_CONFIG__" />
    <!--<add key="CallCenterUrl" value="__SET_IN_LOCAL_CONFIG__" />-->
    <!--<add key="CallCenterUrl" value="__SET_IN_LOCAL_CONFIG__" />-->
    <!--<add key="CallCenterUrl" value="__SET_IN_LOCAL_CONFIG__" />-->
    <add key="KNETPublicKey" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="KNETMerchantId" value="__SET_IN_LOCAL_CONFIG__" />
    <!--<add key="KNETPublicKey" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="KNETMerchantId" value="__SET_IN_LOCAL_CONFIG__" />-->
    <add key="IsChoiceBind" value="true" />
    <add key="IsExtraItemsBind" value="true" />
    <add key="IsDeliveryEnable" value="true" />
    <add key="IsScheduleOrderEnabled" value="false" />
    <add key="InvoiceTypeID" value="1" />
    <!-- LocalDB = insert into tblInvoice/tblOrder via sp_POS_ProcessOrder; CallCenter = legacy HTTP post -->
    <add key="OrderMode" value="LocalDB" />
    <!-- tblInvoicePaymentType.ID of the legacy Tap/goSell (KNET) lightbox.
         0 = disabled: every method goes through SubmitOrder, and online ones
         redirect to MyFatoorah. Set this ONLY if the Tap integration is still
         in use - a wrong value sends cash orders to a payment page. -->
    <add key="LegacyTapPaymentTypeID" value="0" />
    <!-- ==================== MyFatoorah ====================
         Get the API token from the MyFatoorah portal:
             Live  -> MyFatoorah portal > Integration Settings > API Key
             Test  -> https://demo.myfatoorah.com  (test token)

         BaseUrl is REGIONAL on live. Using the wrong region returns
         "Invalid token" even when the token is correct:
             Kuwait          https://api.myfatoorah.com
             Saudi Arabia    https://api-sa.myfatoorah.com
             UAE             https://api-ae.myfatoorah.com
             Qatar / Bahrain / Oman / Jordan / Egypt  - see MyFatoorah docs
             TEST (any)      https://apitest.myfatoorah.com
    ==================================================== -->
    <add key="MyFatoorah.Enabled" value="true" />
    <add key="MyFatoorah.BaseUrl" value="https://apitest.myfatoorah.com" />
    <add key="MyFatoorah.ApiToken" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="MyFatoorah.CurrencyIso" value="KWD" />
    <add key="MyFatoorah.Language" value="EN" />
    <add key="MyFatoorah.MobileCountryCode" value="965" />
    <!-- LNK = just return a payment link. SMS / EML / ALL make MyFatoorah
         message the customer directly as well. -->
    <add key="MyFatoorah.NotificationOption" value="LNK" />
    <!-- Leave blank to use this site's own /POS/Payment/Callback and /Failed.
         Set them only if the site is reached on a different public host. -->
    <add key="MyFatoorah.CallBackUrl" value="" />
    <add key="MyFatoorah.ErrorUrl" value="" />
    <!-- Webhook URL to register in the MyFatoorah portal:
         https://YOUR-SITE/POS/Payment/Webhook -->
    <add key="MyFatoorah.WebhookSecret" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="MyFatoorah.TimeoutMs" value="20000" />

    <!-- ====================================================
         WHATSAPP ORDER CONFIRMATION            Helper/WhatsAppService.cs

         Sent to the customer's mobile once an order is placed. OFF until
         Enabled is true AND the credentials below are filled in, so leaving
         this block alone changes nothing.

         READ THIS FIRST: WhatsApp does not allow a business to send free-form
         text to a customer out of the blue. A business-initiated message - and
         an order confirmation is one - must use a message TEMPLATE that Meta
         approved in advance. Free-form only works inside 24 hours of the
         customer messaging you first. That is a Meta platform rule, not a
         limitation of this code.

         Provider = Meta   Official WhatsApp Cloud API, sends an approved
                           template. Correct choice for order confirmations.
         Provider = Text   One plain-text POST to WhatsApp.Text.Url. For the
                           third-party bridges (UltraMsg, Wati, 360dialog...)
                           that accept free-form. The request body is a
                           template below, so swapping provider is config only.
         ==================================================== -->
    <add key="WhatsApp.Enabled" value="true" />
    <add key="WhatsApp.Provider" value="Meta" />
    <add key="WhatsApp.Currency" value="KD" />
    <!-- Prefixed to numbers stored without one. 965 Kuwait, 966 Saudi. -->
    <add key="WhatsApp.DefaultCountryCode" value="965" />
    <add key="WhatsApp.TimeoutMs" value="15000" />

    <!-- Provider = Meta.
         PhoneNumberId and AccessToken come from the WhatsApp section of your
         Meta app dashboard. Use a PERMANENT token, not the 24-hour test one.
         TemplateName must name a template Meta has APPROVED, whose body is:
             Hi {{1}}, your order {{2}} is confirmed. Total: {{3}}. Thank you!
         Three parameters, in that order: name, order number, total+currency. -->
    <add key="WhatsApp.Meta.BaseUrl" value="https://graph.facebook.com/v21.0" />
    <add key="WhatsApp.Meta.PhoneNumberId" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="WhatsApp.Meta.AccessToken" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="WhatsApp.Meta.TemplateName" value="order_confirmation" />
    <add key="WhatsApp.Meta.TemplateLanguage" value="en" />
    <!-- Must equal the number of {{n}} placeholders in the approved template,
         or Meta rejects the send with error 132000.
         FOR A FIRST SMOKE TEST: Meta's built-in "hello_world" template takes no
         parameters and exists before you have had anything approved, so set
             TemplateName = hello_world
             TemplateLanguage = en_US
             TemplateParameterCount = 0
         to prove the wiring end to end, then put these three back. -->
    <add key="WhatsApp.Meta.TemplateParameterCount" value="3" />

    <!-- Provider = Text.
         {TO} is the normalised number, {TEXT} the message (already JSON-escaped,
         so it sits inside quotes in the body below). Example shape shown is
         UltraMsg's; change it to match whichever provider you use. -->
    <add key="WhatsApp.Text.Url" value="" />
    <add key="WhatsApp.Text.ContentType" value="application/json" />
    <add key="WhatsApp.Text.AuthorizationHeader" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="WhatsApp.Text.BodyTemplate" value="{&quot;token&quot;:&quot;YOUR_TOKEN&quot;,&quot;to&quot;:&quot;{TO}&quot;,&quot;body&quot;:&quot;{TEXT}&quot;}" />

    <!-- The words the customer reads in Text mode. Placeholders:
         {CustomerName} {OrderNo} {Total} {Currency} {TrackingCode} -->
    <add key="WhatsApp.MessageTemplate" value="Hi {CustomerName}, your order {OrderNo} is confirmed. Total: {Total} {Currency}. Tracking code: {TrackingCode}. Thank you!" />

    <!--start Reservation email send data-->
    <!--<add key="Subject" value="Reservation Details"/>
    <add key="SMTPHost" value="cp-49.webhostbox.net" /> -->
    <!--smtp.gmail.com-->
    <!--
    <add key="SMTPPort" value="465" />   -->
    <!--587  for gmail id-->
    <!--
    <add key="IsSSL" value="true" />
    <add key="FromEmail" value="__SET_IN_LOCAL_CONFIG__" />  -->
    <!--
    <add key="SenderPassword" value="__SET_IN_LOCAL_CONFIG__" />-->
    <!--<add key="Subject" value="Reservation Details"/>
    <add key="SMTPHost" value="smtp.gmail.com" /> -->
    <!---->
    <!--
    <add key="SMTPPort" value="587" />   -->
    <!--587  for gmail id-->
    <!--
    <add key="IsSSL" value="true" />
    <add key="FromEmail" value="__SET_IN_LOCAL_CONFIG__" />  -->
    <!--
    <add key="SenderPassword" value="__SET_IN_LOCAL_CONFIG__" />-->
    <add key="Subject" value="Reservation Details" />
    <add key="SMTPHost" value="mail.tmm-menu.com" />
    <add key="SMTPPort" value="587" />
    <add key="IsSSL" value="true" />
    <add key="FromEmail" value="__SET_IN_LOCAL_CONFIG__" />
    <add key="SenderPassword" value="__SET_IN_LOCAL_CONFIG__" />
    <!--End Reservation email send data-->
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <!--<compilation debug="true" targetFramework="4.5.2"/>-->
    <httpRuntime targetFramework="4.5.2" />
    <httpHandlers>
      <add path="Reserved.ReportViewerWebControl.axd" verb="*" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" validate="false" />
      <add verb="*" path="routes.axd" type="AttributeRouting.Web.Logging.LogRoutesHandler, AttributeRouting.Web" />
    </httpHandlers>
    <!--<httpRuntime executionTimeout="600000" maxRequestLength="30000000" requestLengthDiskThreshold="80" useFullyQualifiedRedirectUrl="false" minFreeThreads="8" minLocalRequestFreeThreads="4" appRequestQueueLimit="50000" enableKernelOutputCache="true" enableVersionHeader="true" requireRootedSaveAsPath="true" enable="true" shutdownTimeout="900" delayNotificationTimeout="5" waitChangeNotification="0" maxWaitChangeNotification="0" enableHeaderChecking="true" sendCacheControlHeader="true" apartmentThreading="false" />-->
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="Microsoft.Build.Framework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
      <buildProviders>
        <add extension=".rdlc" type="Microsoft.Reporting.RdlBuildProvider, Microsoft.ReportViewer.WebForms, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
      </buildProviders>
    </compilation>
    <pages controlRenderingCompatibilityVersion="4.5">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <profile defaultProvider="DefaultProfileProvider">
      <providers>
        <add name="DefaultProfileProvider" type="System.Web.Providers.DefaultProfileProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/" />
      </providers>
    </profile>
    <membership defaultProvider="DefaultMembershipProvider">
      <providers>
        <add name="DefaultMembershipProvider" type="System.Web.Providers.DefaultMembershipProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="false" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" passwordAttemptWindow="10" applicationName="/" />
      </providers>
    </membership>
    <roleManager defaultProvider="DefaultRoleProvider">
      <providers>
        <add name="DefaultRoleProvider" type="System.Web.Providers.DefaultRoleProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" applicationName="/" />
      </providers>
    </roleManager>
    <sessionState mode="InProc" customProvider="DefaultSessionProvider">
      <providers>
        <add name="DefaultSessionProvider" type="System.Web.Providers.DefaultSessionStateProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" />
      </providers>
    </sessionState>
    <webServices>
      <protocols>
        <add name="HttpGet" />
        <add name="HttpPost" />
      </protocols>
    </webServices>
  </system.web>
  <system.webServer>
    <staticContent>
      <!-- Older IIS installs have no .svg mapping, so the file 404s and the
           logo silently does not appear. remove-then-add is safe either way:
           adding a duplicate mimeMap on its own throws HTTP 500.19. -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <add name="ReportViewerWebControlHandler" preCondition="integratedMode" verb="*" path="Reserved.ReportViewerWebControl.axd" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
      <add name="AttributeRouting" path="routes.axd" verb="*" type="AttributeRouting.Web.Logging.LogRoutesHandler, AttributeRouting.Web" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <clear />
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
        <add name="Access-Control-Allow-Methods" value="POST, GET, OPTIONS" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
  </entityFramework>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="50000000" />
      </webServices>
    </scripting>
  </system.web.extensions>
</configuration>