<body>
    <script type="text/javascript">
        var RoleID, ThemeUser;
        var OtherLanguages;
        $(document).ready(function () {
            $(document)
                .ajaxStart(function () {
                    debugger;
                    showLoading();
                });
            $(document).ajaxStop(function () {
                hideLoading();
            });
            $(document).ajaxError(function () {
                hideLoading();
            });

            RoleID = "<%= Html.Raw(ViewData["RoleID"]) %>";
            OtherLanguages = "<%= Html.Raw(ViewData["OtherLanguages"]) %>";
            $("#ItemsTab").hide();
            $("#btnBrands").hide();
            $("#AdminTab").hide();
            $("#FeedBackTab").hide();
            $("#ThemesTab").hide();
            $("#SlideShowsTab").hide();
            $("#WebSlideShowsTab").hide();

            switch (RoleID) {
                case "1": {
                    $("#ItemsTab").show();
                    $("#AdminTab").show();
                    $("#btnBrands").show();
                    $("#FeedBackTab").show();
                    $("#SlideShowsTab").show();
                    $("#ThemesTab").show();
                    $("#WebSlideShowsTab").show();
                } break;
                case "3": {
                    $("#ThemesTab").show();
                    $('#jqxTabs').jqxTabs({ selectedItem: 3 });
                }
                    break;
                case "4": {
                    $("#WebSlideShowsTab").show();
                    $("#SlideShowsTab").show();
                    $("#ItemsTab").show();
                    $('#jqxTabs').jqxTabs({ selectedItem: 0 });
                } break;


            }

            if (OtherLanguages == "False") {
                document.getElementById("Languageingr").style.display = 'none';
                document.getElementById("itemNameLanguage").style.display = 'none';
                $("#chklang").hide();
                $("#CatLanguage").hide();
                $("#Languageingr").hide();
                $("#itemNameLanguage").hide();

            }


        })
    </script>

