    function SubmitData() {
        debugger;
        if (InvoiceNo != "") {
            FillCustinfoAndAddressInfo();

            var objdata = {
                InvoiceNo: InvoiceNo,
                addressInfo: AddrInfo,
            }

            $.ajax({
                type: "Post",
                data: JSON.stringify(objdata),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                url: "/AddressConfirm/UpdateAddress",
                success: function (result) {
                    debugger;
                    if (result.Message == "Success") {
                        $('#divOrderUpdateStatusView').show();
                        $('#divDeliveryAddress').hide();
                        $('#CustomerOrderNo').html(InvoiceNo);
                    }
                    else {
                        ShowNotification(result.Message);
                    }
                }
            });

        }

    }
    function FillCustinfoAndAddressInfo() {
        debugger;
        AddrInfo["id"] = 0;
        AddrInfo["CustomerId"] = 0;
        AddrInfo["Email"] = $('#txtCustomerEmailnew').val();
        AddrInfo["HouseNo"] = "";                            
        AddrInfo["AreaID"] = 1;
        var selectedAddressIndex = 2;
        $('.clSelectedDeliveryAddress').each(function (index) {
            if ($(this).hasClass("active")) {
                selectedAddressIndex = parseInt($(this).attr("data-val"));
            }
        });

        if ($('#hdnIsFromWaiterLogin').val() == "true") {
            AddrInfo["AreaID"] = 1;
            AddrInfo["Block"] = "";
            AddrInfo["Street"] = "";
            AddrInfo["Building"] = "";
            AddrInfo["Floor"] = "";
            AddrInfo["Flat"] = "";
            //Custinfo["Lane"] = data.Lane;
            AddrInfo["Lat"] = "";
            AddrInfo["Long"] = "";
            AddrInfo["AddressRemark"] = "";
        }
        else {
            if (selectedAddressIndex < 2) {
                //bind from customerAddresses object
                if (customerAddresses != null) {
                    var data = customerAddresses[selectedAddressIndex];
                    areaName = data.AreaName;
                    AddrInfo["AreaID"] = data.AreaID;
                    AddrInfo["Block"] = data.Block;
                    AddrInfo["Street"] = data.Street;
                    AddrInfo["Building"] = data.Building;
                    AddrInfo["Floor"] = data.Floor;
                    AddrInfo["Flat"] = data.flat;
                    //Custinfo["Lane"] = data.Lane;
                    AddrInfo["Lat"] = data.Latitude == null ? 0 : data.Latitude;
                    AddrInfo["Long"] = data.Longitude == null ? 0 : data.Longitude;
                    AddrInfo["AddressRemark"] = data.AddressRemarks;
                    selectedbranchid = $('#hdnBranchId').val();
                }
            }
            else {
                AddrInfo["AreaID"] = $('#AddressArea').val();
                areaName = $("#AddressArea option:selected").text();
                if ($('#CustAddressHome').hasClass("active")) {
                    AddrInfo["Block"] = $('#txtHomeBlock').val();
                    AddrInfo["Street"] = $('#txtHomeStreet').val();
                    AddrInfo["Flat"] = $('#txtHomeFlat').val();
                    AddrInfo["AddressRemark"] = $('#txtHouseLandmark').val();
                    //Custinfo["Building"] = $('#Building').val();
                }

                else if ($('#CustAddressApartment').hasClass("active")) {
                    AddrInfo["Block"] = $('#txtApartmentBlock').val();
                    AddrInfo["Street"] = $('#txtApartmentStreet').val();
                    AddrInfo["Building"] = $('#txtApartmentBuilding').val();
                    AddrInfo["Floor"] = $('#txtApartmentFloor').val();
                    AddrInfo["Flat"] = $('#txtApartmentFlatNo').val();
                    AddrInfo["AddressRemark"] = $('#txtApartmentLandmark').val();
                }
                else if ($('#CustAddressOffice').hasClass("active")) {
                    AddrInfo["Block"] = $('#txtOfficeBlock').val();
                    AddrInfo["Street"] = $('#txtOfficeStreet').val();
                    AddrInfo["Building"] = $('#txtOfficeBuilding').val();
                    AddrInfo["Floor"] = $('#txtOfficeFloor').val();
                    AddrInfo["Flat"] = $('#txtOfficeFlat').val();
                    AddrInfo["AddressRemark"] = $('#txtOfficeLandmark').val();
                }

                AddrInfo["Lat"] = $('#hdnlat').val();
                AddrInfo["Long"] = $('#hdnlong').val();
                //Custinfo["Floor"] = "";
            }
        }
       


        //////////////start bind last confrim view lables //////////////

        var area = areaName.length > 0 ? "" + lblDSArea + ": " + areaName + ", " : "";
        var block = AddrInfo["Block"] === undefined ? "" : AddrInfo["Block"].length > 0 ? "" + lblDSBlock + ": " + AddrInfo["Block"].replace("Block", "") + ", " : "";
        var firstline = area + block;
        //remove last commaseprate
        firstline = firstline.slice(0, -2)

        var Street = AddrInfo["Street"] === undefined ? "" : AddrInfo["Street"].length > 0 ? "" + lblDSStreet + ": " + AddrInfo["Street"].replace("Street", "") + ", " : "";
        var Landmark = AddrInfo["AddressRemark"] === undefined ? "" : AddrInfo["AddressRemark"].length > 0 ? "" + lblADLandmark + ": " + AddrInfo["AddressRemark"] + ", " : "";
        var building = AddrInfo["Building"] === undefined ? "" : AddrInfo["Building"].length > 0 ? "" + lblDSBuilding + ": " + AddrInfo["Building"] + ", " : "";
        var floor = AddrInfo["Floor"] === undefined ? "" : AddrInfo["Floor"].length > 0 ? "" + lblDSFloor + ": " + AddrInfo["Floor"] + ", " : "";
        var flat = AddrInfo["Flat"] === undefined ? "" : AddrInfo["Flat"].length > 0 ? "" + lblDSFlat + ": " + AddrInfo["Flat"] + ", " : "";

        var secondline = Street + Landmark + building + floor + flat;
        //remove last commaseprate
        secondline = secondline.slice(0, -2)

        //$('#lblOrderConfirmOrderCustomerName').html($('#txtCustomerFullname').val());
        //$('#lblOrderConfirmOrderEmail').html($('#txtCustomerEmailnew').val());
        //$('#lblOrderConfirmOrderMobile').html($('#txtCustomerPhoneNumber').val());
        $('#lblOrderConfirmOrderAddre1').html(firstline);
        $('#lblOrderConfirmOrderAddre2').html(secondline);
        //////////////End bind last confrim view lables //////////////
    }




    var mapboxUrl = 'https://api.tiles.mapbox.com/v4/{id}/{z}/{x}/{y}.png?access_token=__MAPBOX_ACCESS_TOKEN__';
    var mapboxAttribution = 'Map data &copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors, ' +
        '<a href="https://creativecommons.org/licenses/by-sa/2.0/">CC-BY-SA</a>, ' +
        'Imagery © <a href="https://www.mapbox.com/">Mapbox</a>';

    var LeafIcon = L.Icon.extend({
        options: {
            iconAnchor: [30, 40],
            popupAnchor: [-3, -35]
        }
    });


    debugger
    var CustomerAddressMap = new L.Map('divAddressMap', {
        //center: [0, 0],
        zoom: 2,
        layers: [
            new L.TileLayer('https://{s}.tile.openstreetmap.de/tiles/osmde/{z}/{x}/{y}.png', {
                'attribution': '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            })
        ]
    }).setView([29.378586, 47.990341], 12);

    var arcgisOnline = L.esri.Geocoding.arcgisOnlineProvider();

    L.esri.Geocoding.geosearch({
        providers: [
            arcgisOnline,
            L.esri.Geocoding.featureLayerProvider({
                url: 'https://services.arcgis.com/uCXeTVveQzP4IIcx/arcgis/rest/services/gisday/FeatureServer/0/',
                searchFields: ['Name', 'AddressArea'],
                label: 'GIS Day Events',
                bufferRadius: 5000,
                formatSuggestion: function (feature) {
                    return feature.properties.Name + ' - ' + feature.properties.Organization;
                }
            })
        ]
    }).addTo(CustomerAddressMap);

    function createCustomerAddressMap() {
        var curlat = 29.378586;
        var curlong = 47.990341;
        debugger;
        if ("geolocation" in navigator) { //check geolocation available
            debugger;
            //try to get user current location using getCurrentPosition() method
            navigator.geolocation.getCurrentPosition(function (position) {
                debugger;
                curlat = position.coords.latitude;
                curlong = position.coords.longitude;
                CustomerAddressMap.setView([curlat, curlong], 20);
                if (marker !== null) {
                    CustomerAddressMap.removeLayer(marker);
                }
                marker = L.marker([curlat, curlong]).addTo(CustomerAddressMap);
                //$("#result").html("Found your location <br />Lat : " + position.coords.latitude + " </br>Lang :" + position.coords.longitude);

                ///////////////////////Begin Set current location values in the textboxes////////////////////
                latlng = {}
                latlng["lat"] = curlat;
                latlng["lng"] = curlong;

                bindAddressData(latlng);
                ///////////////////////End Set current location values in the textboxes////////////////////
            });
        } else {
            debugger;
            console.log("Browser doesn't support geolocation!");
        }

        setClickOnmapclick(CustomerAddressMap);
    }


    function setClickOnmapclick(CustomerAddressMap) {
        debugger;
        CustomerAddressMap.on('click', function (e) {
            debugger;
            latlng = {}
            latlng["lat"] = e.latlng.lat;
            latlng["lng"] = e.latlng.lng;

            bindAddressData(latlng);
        });
    }

    function bindAddressData(objlatlng) {
        debugger;
        var geocodeService = L.esri.Geocoding.geocodeService();
        var areaArb = "";
        var areaEng = "";
        geocodeService.reverse().latlng([objlatlng.lat, objlatlng.lng]).run(function (error, result) {
            debugger;
            areaArb = "";
            if (result != null) {
                if (result.address != null) {
                    debugger;
                    var data = result.address;
                    var latlongdata = result.latlng;
