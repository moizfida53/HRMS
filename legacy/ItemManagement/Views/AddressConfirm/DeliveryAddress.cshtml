<script>
    var marker = null;
    var InvoiceNo = "";
    var AddrInfo = {};
    $(document).ready(function () {
        debugger;
        InvoiceNo = GetParameterValuesFromQueryString('InvoiceNo');
        if (InvoiceNo != "" && InvoiceNo != undefined) {
            $('#lblInvoiceNo').text(InvoiceNo);
            createCustomerAddressMap();
            createCustomerDetailsObject();
            BindAddress(InvoiceNo);
        }
    });

    function BindAddress(invoiceno) {
        debugger
        var obj = {
            InoiceNumber: invoiceno
        }
        $.ajax({
            type: "Post",
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            cache: false,
            url: "/AddressConfirm/GetInvoiceAddress",
            success: function (result) {
                debugger;
                if (result.Message == "Success") {
                    var dtAddr = JSON.parse(result.dtresult);
                    if (dtAddr != null) {

                        //if (CustomerDetails["DeliveryAddressType"] == "Home"
                        //    || CustomerDetails["DeliveryAddressType"] == "Apartment"
                        //    || CustomerDetails["DeliveryAddressType"] == "Office") {
                        //$('#CustAddressHome').removeClass("active");
                        //$('#CustAddressApartment').removeClass("active");
                        //$('#CustAddressOffice').removeClass("active");

                        //$('#nav-home').removeClass("active show");
                        //$('nav-apartment').addClass("active show");
                        //$('nav-office').addClass("active show");

                        //}


                        //if (dtAddr["DeliveryAddressType"] == "Home") {
                        //$('#CustAddressHome').addClass("active");
                        //$('#CustAddressHome').click();
                        //$('#nav-home').addClass("active show");

                        $('#txtHomeBlock').val(dtAddr[0]["Block"]);
                        $('#txtHomeStreet').val(dtAddr[0]["Street"]);
                        $('#txtHomeFlat').val(dtAddr[0]["Flat"]);
                        $('#txtHouseLandmark').val(dtAddr[0]["AddressRemarks"]);
                        //Custinfo["Building"] = $('#Building').val();
                        //}

                        //else if (dtAddr["DeliveryAddressType"] == "Apartment") {
                        /*$('#CustAddressApartment').addClass("active");*/
                        //$('#CustAddressApartment').click();
                        //$('#nav-apartment').addClass("active show");

                        $('#txtApartmentBlock').val(dtAddr[0]["Block"]);
                        $('#txtApartmentStreet').val(dtAddr[0]["Street"]);
                        $('#txtApartmentBuilding').val(dtAddr[0]["Building"]);
                        $('#txtApartmentFloor').val(dtAddr[0]["Floor"]);
                        $('#txtApartmentFlatNo').val(dtAddr[0]["Flat"]);
                        $('#txtApartmentLandmark').val(dtAddr[0]["AddressRemarks"]);
                        //}
                        //else if (dtAddr["DeliveryAddressType"] == "Office") {
                        //$('#CustAddressOffice').addClass("active");
                        //$('#CustAddressOffice').click();
                        //$('#nav-office').addClass("active show");

                        $('#txtOfficeBlock').val(dtAddr[0]["Block"]);
                        $('#txtOfficeStreet').val(dtAddr[0]["Street"]);
                        $('#txtOfficeBuilding').val(dtAddr[0]["Building"]);
                        $('#txtOfficeFloor').val(dtAddr[0]["Floor"]);
                        $('#txtOfficeFlat').val(dtAddr[0]["Flat"]);
                        $('#txtOfficeLandmark').val(dtAddr[0]["AddressRemarks"]);
                        //}

                        if (dtAddr[0]["Latitude"] != "" && dtAddr[0]["Longitude"] != "" && dtAddr[0]["Latitude"] != null && dtAddr[0]["Longitude"] != null) {
                            $('#divOrderUpdateStatusView').show();
                            $('#divDeliveryAddress').hide();
                            $('#CustomerOrderNo').html(InvoiceNo);

                            $('#lblOrderConfirmOrderAddre1').html("Address already updated.");
                            $('#lblOrderConfirmOrderAddre2').html("");
                        }
                       
                        //$('#hdnlat').val(dtAddr[0]["Latitude"]);
                        //$('#hdnlong').val(dtAddr[0]["Longitude"]);

                        ////set areaid
                        //if ($('#pickup').hasClass("active")) {
                        //    $('.clrbranchList').each(function (index) {
                        //        $(this).removeClass("active");
                        //        if (parseInt($(this).attr("data-arId")) == CustomerDetails["AreaID"]) {
                        //            $(this).addclass("active");
                        //        }
                        //    });
