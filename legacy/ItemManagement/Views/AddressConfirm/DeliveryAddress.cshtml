                        /*}*/


                        if (dtAddr[0]["Latitude"] != "" && dtAddr[0]["Longitude"] != "" && dtAddr[0]["Latitude"] != null && dtAddr[0]["Longitude"] != null) {
                            if (marker !== null) {
                                CustomerAddressMap.removeLayer(marker);
                            }
                            marker = L.marker([dtAddr[0]["Latitude"], dtAddr[0]["Longitude"]]).addTo(CustomerAddressMap);

                            CustomerAddressMap.setView([dtAddr[0]["Latitude"], dtAddr[0]["Longitude"]], 16);
                        }

                        if (parseInt(dtAddr[0]["AreaID"]) > 0) {
                            debugger;
                            $('#hdnSelectedArea').val(dtAddr[0]["AreaID"]);
                            $('#AddressArea').val(dtAddr[0]["AreaID"]);
