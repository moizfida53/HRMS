                        'PostalExt:' + data["PostalExt"] + "\n" +
                        'Region:' + data["Region"] + "\n" +
                        'Sector:' + data["Sector"] + "\n" +
                        'ShortLabel:' + data["ShortLabel"] + "\n" +
                        'Subregion:' + data["Subregion"] + "\n" +
                        'Territory:' + data["Territory"] + "\n" +
                        'Type:' + data["Type"];
                    console.log(strmsg);
                    areaArb = data["Neighborhood"];
                }
            }
        });

        geocodeService.reverse().latlng([objlatlng.lat, objlatlng.lng]).language("eng").run(function (error, result) {
            debugger;
            areaEng = "";
            //$('#Block').val("");
            //$('#Street').val("");
            //$('#Landmark').val("");

            $('#hdnlat').val("");
            $('#hdnlong').val("");
            $("#AddressArea").val("");
            if ($('#CustAddressHome').hasClass("active")) {
                $('#txtHomeBlock').val("");
                $('#txtHomeStreet').val("");
                $('#txtHouseLandmark').val("");
            }
            if ($('#CustAddressHome').hasClass("active")) {
                $('#txtApartmentBlock').val("");
                $('#txtApartmentStreet').val("");
                $('#txtApartmentLandmark').val("");
            }
            if ($('#CustAddressHome').hasClass("active")) {
                $('#txtOfficeBlock').val("");
                $('#txtOfficeStreet').val("");
                $('#txtOfficeLandmark').val("");
            }




            if (result != null) {
                if (result.address != null) {
                    //new L.Marker([e.latlng.lat, e.latlng.lng]).addTo(CustomerAddressMap);
                    if (marker !== null) {
                        CustomerAddressMap.removeLayer(marker);
                    }
                    marker = L.marker([objlatlng.lat, objlatlng.lng]).addTo(CustomerAddressMap);

                    var data = result.address;
                    var latlongdata = result.latlng;
                    var strmsg = 'lat:' + latlongdata["lat"] + "\n" +
                        'long:' + latlongdata["lng"] + "\n" +
                        'AddNum:' + data["AddNum"] + "\n" +
                        'Addr_type:' + data["Addr_type"] + "\n" +
                        'Address:' + data["Address"] + "\n" +
                        'Block:' + data["Block"] + "\n" +
                        'City:' + data["City"] + "\n" +
                        'CountryCode:' + data["CountryCode"] + "\n" +
                        'District:' + data["District"] + "\n" +
                        'LongLabel:' + data["LongLabel"] + "\n" +
                        'Match_addr:' + data["Match_addr"] + "\n" +
                        'MetroArea:' + data["MetroArea"] + "\n" +
                        'Neighborhood:' + data["Neighborhood"] + "\n" +
                        'PlaceName:' + data["PlaceName"] + "\n" +
                        'Postal:' + data["Postal"] + "\n" +
                        'PostalExt:' + data["PostalExt"] + "\n" +
                        'Region:' + data["Region"] + "\n" +
                        'Sector:' + data["Sector"] + "\n" +
                        'ShortLabel:' + data["ShortLabel"] + "\n" +
                        'Subregion:' + data["Subregion"] + "\n" +
                        'Territory:' + data["Territory"] + "\n" +
                        'Type:' + data["Type"];
                    console.log(strmsg);
                    areaEng = data["Neighborhood"];
                    //alert(strmsg);

                    $('#hdnlat').val(latlongdata["lat"]);
                    $('#hdnlong').val(latlongdata["lng"]);

                    //if ($('#CustAddressHome').hasClass("active")) {
                    $('#txtHomeBlock').val(data["Block"]);
                    $('#txtHomeStreet').val(data["Address"]);
                    $('#txtHouseLandmark').val(data["PlaceName"]);
                    //}
                    //if ($('#CustAddressApartment').hasClass("active")) {
                    $('#txtApartmentBlock').val(data["Block"]);
                    $('#txtApartmentStreet').val(data["Address"]);
                    $('#txtApartmentLandmark').val(data["PlaceName"]);
                    //}
                    //if ($('#CustAddressOffice').hasClass("active")) {
                    $('#txtOfficeBlock').val(data["Block"]);
                    $('#txtOfficeStreet').val(data["Address"]);
                    if (data["PlaceName"] == "" && data["District"] != "") {
                        data["PlaceName"] = data["District"]
                    }
                    $('#txtOfficeLandmark').val(data["PlaceName"]);
                    //}


                    debugger;
                    //$("#AddressArea option:contains(" + area + ")").attr("selected", true);
                    $("#AddressArea option").filter(function () {
                        if ($(this).text() == areaEng || $(this).text() == areaArb) {
                            return true;
                        }
                        else {
                            return false;
                        }
                    }).prop('selected', true);
                }
            }
        });
    }
    function AddressTypeClick(addrType) {
        debugger;
        $('.ApartmentFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        $('.OfficeFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        $('.HomeFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        if (addrType == "Home") {
            $('.HomeFields').each(function (index) {
                var attr = $(this).attr('required');
                if (typeof attr == typeof undefined || attr == false) {
                    $(this).attr("required", "");
                }
            });
        }
        if (addrType == "Apartment") {
            $('.ApartmentFields').each(function (index) {
                var attr = $(this).attr('required');
                if (typeof attr == typeof undefined || attr == false) {
                    $(this).attr("required", "");
                }
            });
        }
        if (addrType == "Office") {
