    @*  ORDER-FLOW LAYOUT HOOK (desktop)

        The cart and everything after it - customer info, delivery service,
        address, payment, order confirmation - are centred on the page, and
        the right-hand logo column steps aside while any of them is open.
        The rules live in the "FOLLOW-UP FIX 7" block of
        cssNew/responsive-categories.css and key off one class,
        "order-flow-open", on #divleftsideMenuListView.

        Those panels are shown and hidden from dozens of places across
        Index.js, BindCartDetails.js, DeliveryService.js, DeliveryAddress.js,
        Payment.cshtml and others. Rather than edit every one of them - and
        depend on whoever adds the next one remembering to - this watches the
        panels themselves and mirrors "is any of them visible" onto that one
        class. Adding another step to the flow needs no change here either:
        give its panel the existing .order-mode-page class (as the five
        checkout panels already do) and it is picked up automatically.

        Lives here rather than in one of the partials because this is the
        view that owns #divleftsideMenuListView and renders all of them.   *@
    <script>
        (function () {
            function wireOrderFlowClass() {
                var root = document.getElementById('divleftsideMenuListView');
                if (!root) { return; }

                var panels = [].slice.call(
                    document.querySelectorAll('#divCartView, .main-content.order-mode-page'));
                if (!panels.length) { return; }

                function sync() {
                    // Computed style, not the inline style attribute: jQuery
                    // .show() CLEARS "display" rather than setting it to
                    // "block", so reading the attribute would miss an opening.
                    var anyOpen = panels.some(function (p) {
                        return window.getComputedStyle(p).display !== 'none';
                    });
                    root.classList.toggle('order-flow-open', anyOpen);
                }

                var observer = new MutationObserver(sync);
                panels.forEach(function (p) {
                    observer.observe(p, { attributes: true, attributeFilter: ['style', 'class'] });
                });

                sync();   // in case something opened a panel before this ran
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', wireOrderFlowClass);
            } else {
                wireOrderFlowClass();
            }
        })();
    </script>

