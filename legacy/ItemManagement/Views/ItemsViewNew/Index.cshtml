        .allergen-list li .icon-allergen {
            height: 21px;
            width: 21px;
        }

        /* Per-item Allergen icon (top-right of the item image). Shown when
           tblbrand.ShowAllergen = 1; toggled via #hdnIsShowAllergen and
           rendered by bindAllergensHtml() in BindCartDetails.js for all
           Design1-Design4 layouts. */
        .allergens {
            top: 8px;
            left: 8px;
            right: auto;
            z-index: 5;
        }

            /* Scoped to .position-absolute (the per-item card overlay icon uses
               Bootstrap's .position-absolute utility class) so this badge styling
               only affects that icon, not the Item Details popup's allergen button
               (#divItemDetailsAllergen), which uses its own .allergens-on-image
               class instead (see below) and keeps the site's original 40x40
               .allergens .btn sizing from cssNew/style.css. */
            .allergens.position-absolute .dropdown-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 28px;
                height: 28px;
                padding: 0;
                border-radius: 50%;
                background-color: rgba(255, 255, 255, 0.9) !important;
                box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
                color: var(--allergen_icon_color, #d9534f);
                font-size: 15px;
                line-height: 1;
            }

                .allergens.position-absolute .dropdown-toggle:after {
                    display: none;
                }

            /* The toggle icon's <img> carries fixed width/height HTML attributes
               that don't match every button size it's dropped into (28px on the
               item card badge, 40px on the Item Details popup), which let the
               image overflow its button. Force it to always fill its own button
               instead of relying on those hard-coded attributes. */
            .allergens .dropdown-toggle img {
                width: 100%;
                height: 100%;
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                display: block;
            }

            /* Item Details popup: the free-text comment box is hidden across all
               designs; #divItemDetailsCommentBox wraps it for exactly this. */
            #divItemDetailsCommentBox {
                display: none;
            }

            .allergens .dropdown-menu {
                min-width: 190px;
                max-height: 220px;
                overflow-y: auto;
                padding: 8px 12px;
            }

                .allergens .dropdown-menu li {
                    list-style: none;
                    margin-bottom: 4px;
                }

        /* Design1: allergen icon sits inline with the item name (top-right
           corner of that row) instead of overlaid on the item image, and its
           dropdown opens toward the left (dropdown-menu-right, set via
           bindAllergensHtml's menuRight option) since it sits at the right
           edge of the card. Declared after .allergens above so these win. */
        .allergens-inline {
            top: 0;
            left: auto;
            right: 0;
        }

        /* Item Details popup/page: the allergen icon overlays the top-left corner
           of the item photo. A DEDICATED class instead of reusing Bootstrap's
           .position-absolute utility - cssNew/style.css already has its own, much
           older, unscoped ".allergens { z-index:9; bottom:8px; }" rule that used to
           be harmless (it only affects positioned elements, and this div was
           position:static before). Reusing .position-absolute here would make that
           old rule active again alongside this one's top:8px, and with both top AND
           bottom set on an absolutely-positioned element with no explicit height,
           the browser stretches the div to fill the gap between them instead of
           sizing it to its (small) content - plus it would wrongly also pick up the
           28px per-item-card badge sizing above. Explicit bottom:auto here cancels
           style.css's bottom:8px outright regardless of stylesheet load order. */
        .allergens.allergens-on-image {
            position: absolute;
            top: 8px;
            left: 8px;
            right: auto;
            bottom: auto;
            z-index: 6;
        }

        /* The badge above is positioned against this wrapper, so the wrapper must
           be exactly the visible photo - not the full content column. It holds the
           image / carousel / video as siblings and is a plain block div, so it was
           spanning the whole column while the photo inside it was narrower and
           centred (mx-auto, plus object-fit:contain letterboxing on desktop). The
           badge therefore landed 8px inside the COLUMN, i.e. in the empty space to
           the left of the photo - which is exactly the "icon outside the image"
           report, on both mobile and desktop. Shrink-wrapping the wrapper to its
           content makes its top-left corner the photo's top-left corner, so the
           badge's 8px/8px lands on the photo itself in every design.
           (Paired with #itemDetailsItemImage width:auto on desktop in
           cssNew/responsive-categories.css FOLLOW-UP FIX 8, so the image's own box
           is the photo rather than a letterboxed 100%-wide box.) */
        .item-media-wrap {
            width: -webkit-fit-content;
            width: fit-content;
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
        }

            /* A shrink-wrapped parent sizes itself from its children's intrinsic
               width, and a percentage width on a child contributes nothing to that
               - the multi-image slider (.item-img-carousel, width:100%, its slides
               absolutely positioned) would collapse to zero inside the wrapper.
               Give it the definite width it was already capped at so the wrapper
               has something real to hug when a multi-image item is open. */
            .item-media-wrap > #itemImageCarousel {
                width: 500px;
                max-width: 100%;
            }

        .product-details .img-thumbnail {
            max-width: 320px;
            box-shadow: none;
        }

        .modal-header {
            background-color: var(--primary);
            color: #fff;
        }

            .modal-header .close {
                color: #fff;
                opacity: 0.7;
            }
    </style>

    @* Menu theme colours loaded from the database (tbl_Menu_Colors) on page load.
       This :root block overrides the static brand-css variables above. If the
       table/proc isn't set up yet, ViewBag.MenuColorsCss is empty and the brand
       css continues to supply the colours (graceful fallback). *@
    @if (!string.IsNullOrEmpty(Convert.ToString(ViewBag.MenuColorsCss)))
    {
        <style id="dbMenuColors">@Html.Raw(ViewBag.MenuColorsCss)</style>
    }
</head>
<body class="@(ViewBag.DesignTheme == "Design5" ? "design5" : (ViewBag.DesignTheme == "Design1" ? "design1" : ""))">
    @* Design5 splash: the brand's home-page image (tblBrand.BrandHomePageImage)
       fills the screen, assembling itself out of scattered pieces, then fades
       away after ~3s. Rendered inline as the first thing in <body> — not injected
       by script — so it is opaque from the very first paint and the menu never
       flashes underneath. D5Splash() in Design5.js builds the pieces and removes
       it; it is a no-op on Design1-4 because this element only exists here. *@
    @if (ViewBag.DesignTheme == "Design5" && !string.IsNullOrEmpty(Convert.ToString(ViewBag.BrandHomePageImage)))
    {
        <div id="d5Splash" class="d5-splash" role="presentation" aria-hidden="true"
             data-src="@Url.Content("~/Images/" + Convert.ToString(ViewBag.BrandHomePageImage).Trim())"></div>
    }
