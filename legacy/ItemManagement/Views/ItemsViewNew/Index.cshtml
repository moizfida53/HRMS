@inherits System.Web.Mvc.WebViewPage<dynamic>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using Jar.Helper   @* Asset.V() - css/js cache-buster, Helper\AssetVersion.cs *@
@{
    Layout = "";
}

<!DOCTYPE html>
<html>
<head>
    @*<base href="../../../">*@
    <meta charset="utf-8" />
    <title>TMM</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    @*  Home Screen app (Guided Access / kiosk). Common TMM name + icon for every
        brand; the manifest's start page is this exact page, so the installed
        icon reopens this brand/branch. See ItemsViewNewController.Manifest().
        (The old theme-color held "var(--primary)" - meta tags cannot read CSS
        variables, so browsers ignored it.) *@
    <meta name="theme-color" content="#ffffff">
    <meta name="application-name" content="TMM">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="TMM">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" sizes="180x180" href="@Asset.V("~/assets/media/logos/app-icons/apple-touch-icon.png")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Asset.V("~/assets/media/logos/app-icons/favicon-32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Asset.V("~/assets/media/logos/app-icons/icon-192.png")">
    @*  The manifest is what makes Chrome/Edge offer "Install app". It is only
        emitted while Offline Mode is on (cookie QRMenuOfflineMode=1), so normal
        customers never see an install prompt. Chrome's own banner is suppressed
        below; OfflineMode.js shows the TMM install offer right after the menu
        has been saved for offline use. *@
    @if (Request.Cookies["QRMenuOfflineMode"] != null && Request.Cookies["QRMenuOfflineMode"].Value == "1")
    {
        <link rel="manifest" href="@Url.Content("~/ItemsViewNew/Manifest")?start=@Url.Encode(Request.Url.PathAndQuery)">
    }
    <script>
        window.__tmmInstallPrompt = null;
        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            window.__tmmInstallPrompt = e;
            try { document.dispatchEvent(new Event('tmm:installable')); } catch (x) { }
        });
    </script>

    <!--begin::Fonts-->
    @*<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,400i,600,700,800" rel="stylesheet">*@
    @*<link href="https://fonts.googleapis.com/css?family=Montserrat:100,300,400,500,700&display=swap" rel="stylesheet">*@
    @*<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">*@

    @*  CACHE BUSTING - Asset.V(), Helper\AssetVersion.cs

        Every local css/js on this page is stamped with its own file
        modification time, so a published change gets a new URL and the browser
        fetches it instead of serving the copy it already has. Files that did
        not change keep their URL and stay cached.

        The old "?v=ViewBag.CssVersion" survives as a second token on the brand
        css only. That value is the tblMenuTheme version - it moves when the
        admin saves new colours, which the .css file's timestamp cannot see.  *@

    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/bootstrap.min.css")">

    @*for rtl dynamically load*@
    @*<link rel="stylesheet" type="text/css" href="~/cssNew/bootstrap-rtl.min.css" />*@

    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/bootstrap-select.min.css")">
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/datepicker.css")">
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/owl.carousel.min.css")">
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/font-awesome.min.css")">
    @*  Cast off ViewBag before calling Asset.V: a dynamic argument would push
        overload resolution to runtime for no benefit.                        *@
    @{
        string brandCssPath = "~/cssNew/" + Convert.ToString(ViewBag.BrandCssFileName);
        string themeVersion = Convert.ToString(ViewBag.CssVersion);
    }
    <link rel="stylesheet" type="text/css" href="@Asset.V(brandCssPath, themeVersion)">
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/style.css")" />
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/theme-01.css")">
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/root.css")" />
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/responsive-categories.css")" />
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/design5.css")" />
    <link rel="stylesheet" type="text/css" href="@Asset.V("~/cssNew/offline-mode.css")" />

    <link rel="stylesheet" type="text/css" href="@Asset.V("~/Content/ItemView/TrackingOrder.css")" />

    @*for rtl dynamically load*@
    @*<link rel="stylesheet" type="text/css" href="~/cssNew/rtl-style.css" />*@

    @*  The RTL/LTR stylesheets are swapped at runtime by selectLanguage() in
        BindCartDetails.js, so they cannot be stamped in markup. Their versioned
        URLs are handed to that script here instead.                          *@
    <script>
        var AssetUrls = {
            bootstrap:    '@Html.Raw(Asset.V("~/cssNew/bootstrap.min.css"))',
            bootstrapRtl: '@Html.Raw(Asset.V("~/cssNew/bootstrap-rtl.min.css"))',
            rtlStyle:     '@Html.Raw(Asset.V("~/cssNew/rtl-style.css"))'
        };
    </script>

    <script type="text/javascript" src="@Asset.V("~/js/jquery.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/bootstrap.bundle.min.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/jquery.nicescroll.min.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/bootstrap-select.min.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/bootstrap-datepicker.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/owl.carousel.min.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/menu.js")"></script>
    <script type="text/javascript" src="@Asset.V("~/js/general.js")"></script>

