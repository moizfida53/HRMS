    <input type="hidden" id="hdnBranchId" value="@ViewBag.Branchid" />
    <input type="hidden" id="hdnisCartSelected" value="0" />
    <input type="hidden" id="hdnToFormRedirect" value="@ViewBag.ToformRedirect" />
    <input type="hidden" id="hdnIpAddress" value="" />
    <input type="hidden" id="hdnCurrencyENG" value="@ViewBag.CurrencyENG" />
    <input type="hidden" id="hdnCurrencyArab" value="@ViewBag.CurrencyArab" />
    @*@{ var iscart = @Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsCartVisible"]) == true ? "true" : "false";}*@
    <input type="hidden" id="hdnIsCartVisible" value="@ViewBag.IsCrtVisible" />
    <input type="hidden" id="hdnCallcWebServiceUrl" value="@ViewBag.CallcWebServiceUrl" />
    <input type="hidden" id="hdnKNETPublicKey" value="@ViewBag.KNETPublicKey" />
