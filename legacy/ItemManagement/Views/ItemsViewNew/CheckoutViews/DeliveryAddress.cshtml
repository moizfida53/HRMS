    function createCustomerAddressMap(objdata) {
        var curlat = 29.378586;
        var curlong = 47.990341;
        debugger;
        if ("geolocation" in navigator) { //check geolocation available
            debugger;
            //try to get user current location using getCurrentPosition() method
            navigator.geolocation.getCurrentPosition(function (position) {
                debugger;
                curlat = position.coords.latitude;
                curlong = position.coords.longitude;
                CustomerAddressMap.setView([curlat, curlong], 20);
                if (marker !== null) {
                    CustomerAddressMap.removeLayer(marker);
                }
                marker = L.marker([curlat, curlong]).addTo(CustomerAddressMap);
                //$("#result").html("Found your location <br />Lat : " + position.coords.latitude + " </br>Lang :" + position.coords.longitude);

                ///////////////////////Begin Set current location values in the textboxes////////////////////
                latlng = {}
                latlng["lat"] = curlat;
                latlng["lng"] = curlong;

                bindAddressData(latlng);
                ///////////////////////End Set current location values in the textboxes////////////////////

            });
        } else {
            debugger;
            console.log("Browser doesn't support geolocation!");
        }

        setClickOnmapclick(CustomerAddressMap);
    }


    function setClickOnmapclick(CustomerAddressMap) {
        debugger;
        CustomerAddressMap.on('click', function (e) {
            debugger;
            latlng = {}
            latlng["lat"] = e.latlng.lat;
            latlng["lng"] = e.latlng.lng;

            bindAddressData(latlng);
        });
    }

    // =====================================================================
    //  bindAddressData - rewritten
    //
    //  WHAT WAS WRONG
    //  --------------
    //  1. RACE. Two independent reverse-geocode calls ran in parallel. The
    //     Arabic one assigned areaArb inside its callback; the English one
    //     READ areaArb inside its callback. Nothing ordered them, so areaArb
    //     was almost always still "" when the match ran. Arabic matching
    //     therefore never worked at all.
    //
    //  2. EXACT TEXT MATCH. Selection compared $(option).text() == areaEng.
    //     ESRI returns 'Al Salmiyah' / 'AL SALMIYA' where tblArea holds
    //     'Salmiya', and the option text carries markup whitespace that was
    //     never trimmed. Equality essentially never held.
    //
    //  3. EMPTY MATCHES THE PLACEHOLDER. When both names came back empty the
    //     filter compared "" == "" and happily selected the 'Select' option,
    //     so a real failure looked like a deliberate reset.
    //
    //  4. NO CHANGE EVENT. .prop('selected', true) does not fire change, so
    //     the delivery-charge recalculation that reads data-val never ran.
    //     Even on the rare match, the charge stayed at zero.
    //
    //  Matching now happens on the SERVER (sp_POS_ResolveArea): polygon first,
    //  then a normalised name comparison, then nearest centre. The browser
    //  only sets the value it is given.
    // =====================================================================
    // =====================================================================
    //  bindAddressData - map tap / current location -> address fields
    //
    //  ESRI does not return a tidy Kuwaiti address. Two specific quirks drive
    //  everything below:
    //
    //    * Block is usually NOT in data.Block for Kuwait. It turns up inside
    //      District / Sector / Subregion, sometimes as the bare number, and
    //      sometimes only as the text "Block 4" buried in Match_addr.
    //
    //    * Address has the building number glued to the front, which is why
    //      Street was reading "13 11 Street - Lane 1" for building 13 on
    //      11 Street. AddNum carries that same number separately, so it can be
    //      stripped from the front and put in the House No. / Building field
    //      where it belongs.
    //
    //  The raw payload is kept on window.__lastEsriAddress and logged, so if a
    //  specific address still fills badly the exact field values are one
    //  console line away.
    // =====================================================================
    // =====================================================================
    //  bindAddressData - map tap / current location -> address fields
    //
    //  WHY THE BLOCK WAS STILL EMPTY
    //  -----------------------------
    //  The original page made TWO reverse-geocode calls: one with no language
    //  (ESRI answers in the local dataset) and one with .language("eng").
    //  When the race between them was fixed, the local-language call went with
    //  it -- and for Kuwait that is the call that tends to carry block-level
    //  detail. The English response is better for street names but frequently
    //  omits the block entirely.
    //
    //  Both calls are back, run in parallel but JOINED properly: applyAddress
    //  only runs once both have returned, so neither can read a value the
    //  other has not written yet. Street comes from English, block is taken
    //  from whichever response actually has it, and the Arabic area name is
    //  passed to the server as a second matching hint.
    //
    //  Append ?addrdebug=1 to the URL to see both raw payloads on screen.
    // =====================================================================
    // =====================================================================
    //  bindAddressData - map tap / current location -> address fields
    //
    //  WHAT WENT WRONG IN THE LAST VERSION (and why Area stopped working)
    //  -----------------------------------------------------------------
    //  I added a second ESRI reverse call and made the code wait for BOTH
    //  before writing anything:
    //
    //      var pending = 2;  function settle(){ if(--pending>0) return; ... }
    //
    //  If that second call never invokes its callback - throttled, blocked,
    //  no token, network error swallowed by the library - then `pending` never
    //  reaches 0 and applyAddress NEVER RUNS. Not just the block: the area,
    //  the street and the building number all silently stop populating.
    //  A dependency that only ever added a bonus field was allowed to gate
    //  the entire feature. That was the mistake.
    //
    //  STRUCTURE NOW
    //  -------------
    //  One English reverse geocode drives everything, exactly as in the
    //  version you confirmed working. Area, Street and Building are written
    //  the moment it returns - nothing can delay or block them.
    //
    //  The block lookup is a SEPARATE, OPTIONAL, TIME-LIMITED step that runs
    //  afterwards and only ever touches the Block box. If it fails, times out
    //  or returns nothing, everything else is already on screen.
    // =====================================================================
    function bindAddressData(objlatlng) {
        var svc = L.esri.Geocoding.geocodeService();

        // Move the pin immediately; it should never lag the tap.
        if (marker !== null) {
            CustomerAddressMap.removeLayer(marker);
        }
        marker = L.marker([objlatlng.lat, objlatlng.lng]).addTo(CustomerAddressMap);

        $('#hdnlat').val(objlatlng.lat);
        $('#hdnlong').val(objlatlng.lng);

        svc.reverse()
           .latlng([objlatlng.lat, objlatlng.lng])
           .language("eng")
           .run(function (err, res) {
               applyAddress(objlatlng, (res && res.address) ? res.address : null);
           });
    }

    function applyAddress(objlatlng, d) {
        window.__lastEsriAddress = d;
        if (window.console && console.log) { console.log('[address] ESRI', d); }
        renderAddrDebug(d, null);

        if (!d) {
            // Coordinates are still valid even when the geocoder is not.
            resolveAreaFromServer(objlatlng, null, null);
            lookupBlock(objlatlng);
            return;
        }

        var buildingNo = txt(d["AddNum"]);
        var block      = extractBlock(d);
        var street     = extractStreet(d, buildingNo, block);

        var landmark = txt(d["PlaceName"]);
        if (landmark && (landmark === street || landmark === block)) landmark = "";

        setIfPresent('#txtHomeBlock',         block);
        setIfPresent('#txtHomeStreet',        street);
        setIfPresent('#txtHomeFlat',          buildingNo);      // "House No."
        setIfPresent('#txtHouseLandmark',     landmark);

        setIfPresent('#txtApartmentBlock',    block);
        setIfPresent('#txtApartmentStreet',   street);
        setIfPresent('#txtApartmentBuilding', buildingNo);
        setIfPresent('#txtApartmentLandmark', landmark);

        setIfPresent('#txtOfficeBlock',       block);
        setIfPresent('#txtOfficeStreet',      street);
        setIfPresent('#txtOfficeBuilding',    buildingNo);
        setIfPresent('#txtOfficeLandmark',    landmark);

        // Area first - this is the important one and it runs unconditionally.
        resolveAreaFromServer(objlatlng,
                              txt(d["Neighborhood"]),
                              txt(d["District"]) || txt(d["City"]));

        // Block is a bonus. Only chase it if ESRI had nothing.
        if (!block) lookupBlock(objlatlng);
    }

    // ---------------------------------------------------------------------
    //  Optional block lookup.
    //
    //  You are using OpenStreetMap tiles, and OSM's own geocoder (Nominatim)
    //  carries Kuwaiti block detail that the ESRI world geocoder generally
    //  does not - typically in neighbourhood / suburb / city_district.
    //
    //  It is called through the server (/ItemsView/ReverseGeocodeBlock) rather
    //  than from the browser, because Nominatim's usage policy requires a real
    //  User-Agent and rate limiting, and results can be cached there instead
    //  of every customer hitting it directly.
    //
    //  Hard 3s timeout. If it is slow, the customer types the block themselves
    //  - which is exactly what they do today - rather than staring at a form
    //  that appears frozen.
    // ---------------------------------------------------------------------
    // ---------------------------------------------------------------------
    //  Optional block lookup (OpenStreetMap / Nominatim, via the server).
    //
    //  Hard 3s cap. If it is slow the customer types the block themselves --
    //  which is what they do today -- rather than facing a form that looks
    //  frozen. Nothing on the checkout path depends on this succeeding.
    // ---------------------------------------------------------------------
    function lookupBlock(objlatlng) {
        var dbg = window.location.search.indexOf('addrdebug=1') >= 0;

        $.ajax({
            type: "Post",
            url: "/ItemsView/ReverseGeocodeBlock",
            data: { lat: objlatlng.lat, lng: objlatlng.lng, debug: dbg ? 1 : 0 },
            cache: false,
            timeout: 3000
        }).done(function (res) {
            if (res && res.Message === "Success" && res.Block) {
                setIfPresent('#txtHomeBlock', res.Block);
                setIfPresent('#txtApartmentBlock', res.Block);
                setIfPresent('#txtOfficeBlock', res.Block);
                showBlockHint("");
            } else {
                showBlockHint("Block could not be detected - please enter it.");
            }

            // Surface WHY, so this stops being guesswork.
            if (dbg) {
                appendAddrDebug('BLOCK LOOKUP: ' + JSON.stringify(res, null, 1));
            }
        }).fail(function (xhr, status) {
            showBlockHint("Block could not be detected - please enter it.");
            if (dbg) {
                appendAddrDebug('BLOCK LOOKUP FAILED: ' + status + ' ' + (xhr && xhr.responseText || ''));
            }
        });
    }

    // ---------------------------------------------------------------------
    //  Block extraction from the ESRI payload.
    // ---------------------------------------------------------------------
    function extractBlock(d) {
        if (!d) return "";

        // 1. The documented field, when ESRI populates it.
        var b = txt(d["Block"]);
        if (b) return stripBlockWord(b);

        // 2. "Block 4" / "Blk 4" / "قطعة 4" wherever it hides.
        var re = /(?:block|blk|qitaa|قطعة|قطعه|القطعة)\s*[:\-]?\s*([0-9]+[A-Za-z]?)/i;
        var keys = ["District", "Sector", "Subregion", "Neighborhood", "MetroArea",
                    "Match_addr", "LongLabel", "ShortLabel", "Address", "PlaceName", "Territory"];
        for (var k = 0; k < keys.length; k++) {
            var m = re.exec(txt(d[keys[k]]));
            if (m) return m[1];
        }

        // 3. Kuwaiti labels are comma-delimited and often carry the block as a
        //    segment that is nothing but a number:
        //      "13 11 Street - Lane 1, 4, Salmiya, Hawalli, Kuwait"
        //    Only a whole segment counts - pulling a loose digit out of a
        //    longer string would put a wrong block on a delivery.
        var label = txt(d["LongLabel"]) || txt(d["Match_addr"]);
        if (label) {
            var parts = label.split(',');
            for (var p = 1; p < parts.length; p++) {     // skip the street segment
                var seg = txt(parts[p]);
                if (/^[0-9]{1,3}[A-Za-z]?$/.test(seg)) return seg;
            }
        }

        // 4. A field that is entirely a number.
        var bare = ["District", "Sector", "Subregion"];
        for (var i = 0; i < bare.length; i++) {
            var v = txt(d[bare[i]]);
            if (/^[0-9]{1,3}[A-Za-z]?$/.test(v)) return v;
        }

        return "";
    }

    function extractStreet(d, buildingNo, block) {
        var s = txt(d["Address"]) || txt(d["ShortLabel"]);
        if (!s) return "";

        // ESRI glues the building number to the front:
        //   "13 11 Street - Lane 1"  ->  "11 Street - Lane 1"
        // The lookahead stops building 1 from mangling "11 Street".
        if (buildingNo) {
            s = s.replace(new RegExp('^\\s*' + escapeRe(buildingNo) + '(?![0-9])\\s*[,\\-]?\\s*'), '');
        }

        s = s.replace(/^\s*(?:block|blk)\s*[:\-]?\s*[0-9]+[A-Za-z]?\s*[,\-]?\s*/i, '');
        if (block) {
            s = s.replace(new RegExp('^\\s*' + escapeRe(block) + '(?![0-9])\\s*[,\\-]\\s*'), '');
        }

        return s.replace(/^[\s,\-]+/, '').replace(/[\s,\-]+$/, '');
    }

    // ---------------------------------------------------------------------
    //  On-screen diagnostic: append ?addrdebug=1 to the URL.
    //  Console logging is easy to miss on a phone, which is where this screen
    //  is actually used.
    // ---------------------------------------------------------------------
    // ---------------------------------------------------------------------
    //  On-screen diagnostic: append ?addrdebug=1 to the URL.
    //  Console logging is easy to miss on a phone, which is where this screen
    //  is actually used.
    // ---------------------------------------------------------------------
    function ensureAddrDebugPanel() {
        if (window.location.search.indexOf('addrdebug=1') < 0) return null;
        var $d = $('#addrDebugPanel');
        if ($d.length === 0) {
            $d = $('<pre id="addrDebugPanel" style="max-height:240px;overflow:auto;'
                 + 'background:#111;color:#0f0;font-size:11px;padding:8px;margin-top:8px;'
                 + 'white-space:pre-wrap;"></pre>');
            $('#AddressArea').closest('.form-group, div').append($d);
        }
        return $d;
    }

    function renderAddrDebug(esri, osm) {
        var $d = ensureAddrDebugPanel();
        if (!$d) return;
        $d.text('ESRI:\n' + JSON.stringify(esri, null, 1) +
                (osm ? '\n\nOSM:\n' + JSON.stringify(osm, null, 1) : ''));
    }

    function appendAddrDebug(line) {
        var $d = ensureAddrDebugPanel();
        if (!$d) return;
        $d.text($d.text() + '\n\n' + line);
    }

    function txt(v) {
        return (v === null || v === undefined) ? '' : String(v).trim();
    }

    function stripBlockWord(v) {
        var m = /([0-9]+[A-Za-z]?)/.exec(v);
        return m ? m[1] : txt(v);
    }

    function escapeRe(s) {
        return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Only overwrite when there is something to write. Blanking a field the
    // customer already typed because the geocoder had no value is worse than
    // leaving it alone.
    function setIfPresent(sel, val) {
        if (val !== null && val !== undefined && String(val).length > 0) {
            $(sel).val(val);
        }
    }

    // ---------------------------------------------------------------------
    //  Server-side area resolution.
    // ---------------------------------------------------------------------
    function resolveAreaFromServer(objlatlng, hint1, hint2) {
        $.ajax({
            type: "Post",
            url: "/ItemsView/ResolveArea",
            data: {
                lat:       objlatlng.lat,
                lng:       objlatlng.lng,
                areaHint:  hint1 || "",
                areaHint2: hint2 || "",
                branchId:  parseInt($('#hdnBranchId').val(), 10) || 0
            },
            cache: false
        }).done(function (res) {

            if (!res || res.Message !== "Success" || !res.AreaID) {
                // Leave the dropdown untouched. An unresolved pin means the
                // customer picks the area themselves -- which is correct, and
                // far better than guessing.
                showAreaHint("Could not detect the area automatically. Please select it.");
                return;
            }

            var $sel = $('#AddressArea');

            // The option must actually exist: the list is filtered by branch,
            // so a pin can legitimately land in an area this branch does not
            // serve.
            if ($sel.find("option[value='" + res.AreaID + "']").length === 0) {
                showAreaHint("We do not deliver to " + (res.AreaName || "this area") + " from this branch.");
                return;
            }

            if (res.MatchType === "Nearest") {
                // A distance guess is a suggestion, never a silent commitment.
                showAreaHint("Nearest area looks like " + res.AreaName + ". Please confirm.");
                return;
            }

            if (res.ServedByBranch === false) {
                showAreaHint("This branch does not deliver to " + res.AreaName + ".");
                return;
            }

            // .val() + .change() -- change is what triggers the delivery-charge
            // recalculation that reads the option's data-val attribute.
            $sel.val(String(res.AreaID)).trigger('change');
            showAreaHint("");
        }).fail(function () {
            showAreaHint("Could not detect the area automatically. Please select it.");
        });
    }

    function showAreaHint(msg) {
        var $h = $('#areaAutoHint');
        if ($h.length === 0) {
            $h = $('<div id="areaAutoHint" class="text-muted" style="font-size:12px;margin-top:4px;"></div>');
            $('#AddressArea').after($h);
        }
        $h.text(msg || "").toggle(!!msg);
    }

    // ---------------------------------------------------------------------
    //  Hints now sit under the BLOCK field, not next to the Area dropdown.
    //  A message about the block belongs beside the box the customer has to
    //  fill in, and one is rendered under each address type so it is visible
    //  whichever tab is open.
    // ---------------------------------------------------------------------
    function showBlockHint(msg) {
        var targets = ['#txtHomeBlock', '#txtApartmentBlock', '#txtOfficeBlock'];
        for (var i = 0; i < targets.length; i++) {
            var $inp = $(targets[i]);
            if ($inp.length === 0) continue;

            var hintId = 'blockHint_' + targets[i].replace('#', '');
            var $h = $('#' + hintId);
            if ($h.length === 0) {
                $h = $('<div class="blockAutoHint" id="' + hintId + '" '
                     + 'style="font-size:12px;margin-top:4px;color:#b26a00;"></div>');
                $inp.after($h);
            }
            $h.text(msg || "").toggle(!!msg);
        }
    }

    var _areaMaster = null;      // [{value, text, dataVal}]
    var _areaFiltering = false;  // stops our own edits retriggering the cache

    function cacheAreaOptions() {
        if (_areaFiltering) return;
        var opts = [];
        $('#AddressArea option').each(function () {
            opts.push({
                value: $(this).val(),
                text: $(this).text(),
                dataVal: $(this).attr('data-val')
            });
        });
        // Never cache a list we already filtered down to nothing.
        if (opts.length > 0) _areaMaster = opts;
    }

    function filterAreaOptions(term) {
        if (!_areaMaster) cacheAreaOptions();
        if (!_areaMaster) return;

        var $sel = $('#AddressArea');
        var current = $sel.val();
        var q = (term || '').trim().toLowerCase();

        _areaFiltering = true;
        $sel.empty();

        var shown = 0;
        for (var i = 0; i < _areaMaster.length; i++) {
            var o = _areaMaster[i];
            // Always keep the placeholder, and always keep the option that is
            // currently chosen -- dropping it would silently clear the
            // customer's selection while they type.
            var isPlaceholder = (o.value === '' || o.value === null);
            var isCurrent = (o.value === current && current !== '' && current !== null);

            if (q === '' || isPlaceholder || isCurrent ||
                o.text.toLowerCase().indexOf(q) >= 0) {
                var $o = $('<option>').val(o.value).text(o.text);
                if (o.dataVal !== undefined && o.dataVal !== null) $o.attr('data-val', o.dataVal);
                $sel.append($o);
                if (!isPlaceholder) shown++;
            }
        }

        $sel.val(current);
        _areaFiltering = false;

        $('#areaFilterCount').text(q === '' ? '' : shown + ' match' + (shown === 1 ? '' : 'es'));
    }

    function initAreaFilter() {
        var $sel = $('#AddressArea');
        if ($sel.length === 0 || $('#areaFilterBox').length > 0) return;

        var $box = $('<input type="text" id="areaFilterBox" class="form-control" '
                   + 'placeholder="Type to search area..." autocomplete="off" '
                   + 'style="margin-bottom:6px;" />');
        var $cnt = $('<div id="areaFilterCount" class="text-muted" '
                   + 'style="font-size:11px;margin-top:2px;"></div>');

        $sel.before($box);
        $sel.after($cnt);

        var t = null;
        $box.on('input', function () {
            var v = this.value;
            clearTimeout(t);                       // 150ms: 121 areas is small,
            t = setTimeout(function () {           // but this keeps typing smooth
                filterAreaOptions(v);              // on low-end counter hardware
            }, 150);
        });

        // Enter picks the only remaining match - the fast path when someone
        // types four letters and there is exactly one area left.
        $box.on('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            var $real = $('#AddressArea option').filter(function () {
                return $(this).val() !== '' && $(this).val() !== null;
            });
            if ($real.length === 1) {
                $('#AddressArea').val($real.first().val()).trigger('change');
                $box.val('');
                filterAreaOptions('');
            }
        });

        // The list is rebuilt by BindCartDetails.js after the areas load, so
        // re-snapshot when that happens instead of caching a stale or empty
        // list on first paint.
        if (window.MutationObserver) {
            new MutationObserver(function () {
                if (!_areaFiltering) {
                    _areaMaster = null;
                    cacheAreaOptions();
                }
            }).observe($sel[0], { childList: true });
        }

        cacheAreaOptions();
    }

    $(function () { initAreaFilter(); });

    function AddressTypeClick(addrType) {
        debugger;
        $('.ApartmentFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        $('.OfficeFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        $('.HomeFields').each(function (index) {
            var attr = $(this).attr('required');
            if (typeof attr !== typeof undefined && attr !== false) {
                $(this).removeAttr("required");
            }
        });
        if (addrType == "Home") {
            $('.HomeFields').each(function (index) {
                var attr = $(this).attr('required');
                if (typeof attr == typeof undefined || attr == false) {
                    $(this).attr("required", "");
                }
            });
        }
        if (addrType == "Apartment") {
            $('.ApartmentFields').each(function (index) {
                var attr = $(this).attr('required');
                if (typeof attr == typeof undefined || attr == false) {
                    $(this).attr("required", "");
                }
            });
        }
        if (addrType == "Office") {
            $('.OfficeFields').each(function (index) {
                var attr = $(this).attr('required');
                if (typeof attr == typeof undefined || attr == false) {
                    $(this).attr("required", "");
                }
            });
        }
    }
</script>
