<main class="main-content item-management">

    <!-- Category Management Section -->
    <div class="container-fluid h-100 item-management-list" id="divCategoryList">
        <div class="item-management-heading d-flex">
            @*<a href="#" title="Back" class="back-btn"><img src="~/Images/back-arrow.svg" alt=""></a>*@
            <h2>Slide Shows</h2>
        </div>

        <div class="row ml-n2 mr-n2 uk-sortable catDroppable">
            <div class="col-3">
                <div class="form-group">
                    <label>Select Brand</label>
                    <select id="ddBrand" class="form-control" name="ItemComments[]" required></select>
                    <div class="invalid-feedback">
                        Please select a valid brand.
                    </div>
                </div>
                <div class="col-md-6 upload-file-block mb-3">
                    <div class="form-group">
                        <input type="hidden" id="hdnImageFileName" value="" />
                        <label>Select Image</label>
                        <div class="custom-file">
                            <input id="imageFileUpload" type="file" name="ImageFileUpload" class="custom-file-input">
                            <label id="lblImageuploadName" class="custom-file-label text-truncate" for="customFile">Choose file</label>
                        </div>
                    </div>
                    <div class="d-flex align-content-start">
                        <img src="https://placehold.it/75x75" id="Imagepreview" class="img-thumbnail">
