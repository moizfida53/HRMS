<style>
    .hexagon {
        position: relative;
        width: 100px;
        height: 57.74px;
        background-color: inherit;
        margin: 28.87px 0;
        box-shadow: 0 0 20px rgba(0,0,0,0.25);
        border-left: solid 1px #333333;
        border-right: solid 1px #333333;
    }

    .tablecss {
        -moz-box-shadow: inset 0px 1px 0px 0px #bee2f9;
        -webkit-box-shadow: inset 0px 1px 0px 0px #bee2f9;
        box-shadow: inset 0px 1px 0px 0px #bee2f9;
        filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#63b8ee', endColorstr='#468ccf',GradientType=0);
        -moz-border-radius: 6px;
        -webkit-border-radius: 6px;
        border-radius: 6px;
        padding-top: 10px;
        text-align: center;
        display: inline-block;
        cursor: pointer;
        background: inherit;
        color: black;
        font-size: 14px;
        font-weight: bold;
        vertical-align: central;
        text-decoration: none;
        height: 60px;
        width: 90px;
    }

    .branch_td2 {
    }

    .branch_td3 {
        width: 25px !important;
        padding-right: 0px !important;
        padding-left: 0px !important;
    }
</style>
<main class="main-content item-management">
    <div class="container-fluid h-100">
        @*<div class="item-management-heading d-flex">
            <h2>Reservation Master</h2>
            <a href="#" class="btn btn-icon btn-secondary  w-100 text-left" data-target="WindowTable" onclick="AddTable()" style="width:150px !important"><img class="icon" src="../Images/add-b.svg" alt=""> <span>Add Table</span></a>
        </div>*@
        <div id="posX" style="display:none"></div>
        <div id="posY" style="display:none"></div>
        <div class="table-management-list">
            <ul class="nav nav-pills nav-fill" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link flex-fill active" id="inner-areas" data-toggle="tab" href="#inner" role="tab" aria-controls="inner" aria-selected="true">Inner Areas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link flex-fill" id="outer-areas" data-toggle="tab" href="#outer" role="tab" aria-controls="outer" aria-selected="false">Outer Areas</a>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active p-3" id="inner" role="tabpanel" aria-labelledby="inner-areas">

                </div>
                <div class="tab-pane fade" id="outer" role="tabpanel" aria-labelledby="profile-tab">

                </div>
            </div>
        </div>
    </div>

    <div class="right-navigation right-part">
        @*<div class="p-2">
            <a onclick="clearAllSelection();" class="btn btn-icon btn-secondary w-100 text-left"> <img class="icon" src="../Images/clear.svg" ā alt=""> <span>Clear All</span></a>
        </div>*@
        <a href="#" class="btn btn-icon btn-primary w-100 text-left mt-2" data-toggle="modal" data-target="#WindowTable" onclick="AddTable();">
            <img class="icon" src="images/add-w.svg" alt=""><span>Add Table</span>
        </a>
        <div class="accordion" id="accordionExample">
            <div class="card">
                <div class="card-header" id="Branch-heading">
                    <a class="card-title" role="button" data-toggle="collapse" data-target="#Branch" aria-expanded="true" aria-controls="Branch">
                        Time Slots
                    </a>
                </div>

                <div id="Branch" class="collapse show" aria-labelledby="Branch-heading" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulTimeSlotList"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>



@*//-------------------------------------------Start Table Add Popup----------------------------------------*@
<div class="modal fade" id="WindowTable" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="AddTableTitle">Table</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <input id="hdnSelectedTableid" type="hidden" />
                        <label>Table Name</label>
                        <input id="txtTableName" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Please insert a valid Table name.
                        </div>
                    </div>
                    @*<div class="form-group">
                        <label>Select Dining Area</label>
                        <select id="ddDiningArea" class="form-control" name="ddDiningArea" required>
                            <option value="">Select Area</option>
                            <option value="Inner Area">Inner Area</option>
                            <option value="Out Area">Out Areaa</option>
                        </select>
                        <div class="invalid-feedback">
                            Please select Dining Area.
                        </div>
                    </div>*@

                    <div class="form-group">
                        <label>Seating Count</label>
                        @*<input id="txtSeatingCount" type="text" class="form-control numericOnly" value="1" required />*@
                        <input type="radio" id="one" name="seatingCount" value="2" checked>
                        <label for="male">1-2</label><br>
                        <input type="radio" id="two" name="seatingCount" value="4">
                        <label for="female">2-4</label><br>
                        <input type="radio" id="fivePlus" name="seatingCount" value="6">
                        <label for="other">5+</label>
                        <div class="invalid-feedback">
                            Please insert a valid Seating Count.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="TimeSlotDeleteButton" type="button" class="btn btn-danger" onclick="InActiveTable();">Delete</button>
                    <button id="TableAddButton" type="button" class="btn btn-primary" onclick="SaveTable();">Add</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*//-------------------------------------------End Table Add Popup----------------------------------------*@


@*//-------------------------------------------Start TimeSlot Add Popup----------------------------------------*@
<div class="modal fade" id="WindowTimeSlot" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="AddTimeSlotTitle">Time Slot</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <input id="hdnSelectedSlotid" type="hidden" />
                        <label>Slot Name English</label>
                        <input id="txtSlotNameEng" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Please insert a valid Slot name.
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Slot Name Arabic</label>
                        <input id="txtSlotNameArab" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Please insert a valid Slot name.
                        </div>
                    </div>
                    <div class="form-group">
                        <label>From Time</label>
                        <input id="txtFromTime" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Please insert a valid From Time.
                        </div>
                    </div>
                    <div class="form-group">
                        <label>To Time</label>
                        <input id="txtToTime" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Please insert a valid To Time.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="TimeSlotDeleteButton" type="button" class="btn btn-danger" onclick="InActiveTimeSlot();">Delete</button>
                    <button id="TimeSlotAddButton" type="button" class="btn btn-primary" onclick="SaveTimeSlot();">Add</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*//-------------------------------------------End TimeSlot Add Popup----------------------------------------*@

