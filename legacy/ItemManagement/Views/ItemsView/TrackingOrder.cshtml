<div id="TrackingOrder" style="display:none">
    @*<h3><a href="#">Order Shipment Tracking</a></h3>*@
    <div class="entry-content">
        <div class="smartcms_ost">
            @*<input class="smartcms_ost_url" type="hidden" value="http://wordpress.smartcmsmarket.net/wp-content/plugins/scorder-shipment-tracking/">*@
            <div class="smartcms_ost_search">
                <input id="txtTrackorderNumber" class="smartcms_ost_search_but" placeholder="Enter Tracking Number">
                <span class="smartcms_ost_submit" onclick="TrackOrder();"></span>
            </div>
            <p id="msgTrackOrderBlank" style="color:red;display:none;">Please enter tracking number.</p>
            <p id="msgTrackOrderWrong" style="color:red;display:none;">Please enter valid tracking number.</p>
            <p id="msgContactManager" style="color:red;display:none;">Error,Contact Your Manager.</p>
            <div class="smartcms_ost_content" style="display: block;">
                <div class="smartcms_ost_timeline" style="display:none;width:100%;">
                    <ul class="timeline">
                        <li id="OrderReceived" class="">
                            <div class="direction-r">
                                <div class="flag-wrapper">
                                    <span class="flag">
                                        <img class="icon" src="https://i.imgur.com/9nnc9Et.png"
                                             style="width: 4rem;height: 4rem;">
                                        Received
                                    </span>
                                </div>
                                @*<div class="desc">2016-11-01 11:00</div>*@
                            </div>
                        </li>
                        <li id="OrderShipped" class="">
                            <div class="direction-r">
                                <div class="flag-wrapper">
                                    <span class="flag">
                                        <img class="icon" src="https://i.imgur.com/u1AzR7w.png"
                                             style="width: 4rem;height: 4rem;">
                                        Preparing
                                    </span>
                                </div>
                                @*<div class="desc">2016-11-01 11:00</div>*@
                            </div>
                        </li>
                        <li id="OrderEnRoute" class="">
                            <div class="direction-r">
                                <div class="flag-wrapper">
                                    <span class="flag">
                                        <img class="icon" src="https://i.imgur.com/TkPm63y.png"
                                             style="width: 4rem;height: 4rem;">
                                        Dispatched
                                    </span>
                                </div>
                                @*<div class="desc">2016-11-01 11:00</div>*@
                            </div>
                        </li>
                        <li id="OrderArrived" class="last_track">
                            <div class="direction-r">
                                <div class="flag-wrapper">
                                    <span class="flag">
                                        <img class="icon" src="https://i.imgur.com/HdsziHP.png"
                                             style="width: 4rem;height: 4rem;">
                                        Delivered
                                    </span>
                                </div>
                                @*<div class="desc">2016-11-01 11:00</div>*@
                            </div>
                        </li>
                    </ul>
                </div>
                <div id="mapcontainer" class="smartcms_ost_map" style="display:none;">
                    <div id='mapid' style='width: 100%; height: 100%;'
                         class='top_map_objects'></div>
                    @*<iframe style="height:100%;width:100%;border:0;"
                        frameborder="0" src="https://www.google.com/maps/embed/v1/place?q=20090&amp;key=__GOOGLE_MAPS_API_KEY__"></iframe>*@
                </div>
            </div>
        </div>

    </div>
</div>