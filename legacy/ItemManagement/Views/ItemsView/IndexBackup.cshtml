                                                                <div class="form-group">
                                                                    <label id="lblFirstName">First Name</label>
                                                                    <input type="text" class="form-control form-control-solid form-control-lg" id="fname" name="fname" placeholder="First Name" value="" />
                                                                    <span id="spnPleaseenteryourfirstname" class="form-text text-muted">Please enter your first name.</span>
                                                                </div>
                                                                <!--end::Input-->
                                                                <!--begin::Input-->
                                                                <div class="form-group">
                                                                    <label id="lblLastName">Last Name</label>
                                                                    <input type="text" class="form-control form-control-solid form-control-lg" id="lname" name="lname" placeholder="Last Name" value="" />
                                                                    <span id="spnPleaseenteryourlastname" class="form-text text-muted">Please enter your last name.</span>
                                                                </div>
                                                                <!--end::Input-->
                                                                <div class="row">
                                                                    <div class="col-xl-6">
                                                                        <!--begin::Input-->
                                                                        <div class="form-group">
                                                                            <label id="lblPhone">Phone</label>
                                                                            <input type="tel" class="form-control form-control-solid form-control-lg" id="phone" name="phone" placeholder="phone" value="" />
                                                                            <span id="spnPleaseenteryourphonenumber" class="form-text text-muted">Please enter your phone number.</span>
                                                                        </div>
                                                                        <!--end::Input-->
                                                                    </div>
                                                                    <div class="col-xl-6">
                                                                        <!--begin::Input-->
                                                                        <div class="form-group">
                                                                            <label id="lblEmail">Email</label>
                                                                            <input type="email" class="form-control form-control-solid form-control-lg" id="email" name="email" placeholder="Email" value="" />
                                                                            <span id="spnPleaseenteryouremailaddress" class="form-text text-muted">Please enter your email address.</span>
                                                                        </div>
                                                                        <!--end::Input-->
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <!--end: Wizard Step 1-->
                                                            <!--begin: Wizard Step 2-->
                                                            <div class="pb-5" data-wizard-type="step-content">
                                                                <div id="divSelectDeleveryType" class="mb-10 font-weight-bold text-dark">Select Delevery Type</div>
                                                                <div class="row">
                                                                    <div class="col-xl-6">
                                                                        <!--begin::Input-->
                                                                        <div class="form-group">
                                                                            <label id="lblOrderType">Order Type</label>
                                                                            @*onchange="onchangeddrOrderType(this);"*@
                                                                            <select id="OrderType" name="OrderType" class="form-control form-control-solid form-control-lg">
                                                                                <option id="OrderType_Delivery" value="Delivery" selected>Delivery</option>
                                                                                <option id="OrderType_Pickup" value="Pickup">Pickup</option>
                                                                            </select>
                                                                            <span id="spnPleaseselectOrderType" class="form-text text-muted">Please select Order Type.</span>
                                                                        </div>
                                                                        <!--end::Input-->
                                                                    </div>
                                                                    @*<div class="col-xl-6">
                                                                            <div class="form-group" id="ddrArea">
                                                                                <label>Area</label>
                                                                                <select name="Area" class="form-control form-control-solid form-control-lg">
                                                                                    <option value="">Select</option>
