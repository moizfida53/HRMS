                            @{
                                Html.RenderPartial("~/Views/ItemsView/MenuWrapper.cshtml");
                            }
                            <!--end::Header Menu Wrapper-->
                        </div>
                        <!--end::Container-->
                    </div>
                    <!--end::Bottom-->
                </div>
                <!--end::Header-->
                <!--begin::Content-->
                <div class="content d-flex flex-column flex-column-fluid" id="kt_content">

                    <!--begin::Entry-->
                    <div class="d-flex flex-column-fluid">
                        <!--begin::Container-->
                        <div class="container">
                            <div class="card card-custom card-transparent" style="width:100%;">
                                <div class="card-body p-0">
                                    <div id="scrolldiv"
                                         class="scroll-content clsScrollArea"
                                         style="background-color:white; margin-bottom: 0px;height:85vh;">
                                        @*onscroll="myFunction();"*@
                                        @{
                                            Html.RenderPartial("~/Views/ItemsView/Desktopview.cshtml");
                                        }
                                        @{
                                            Html.RenderPartial("~/Views/ItemsView/MenuList.cshtml");
                                        }
                                        @{
                                            Html.RenderPartial("~/Views/ItemsView/CartView.cshtml");
                                            <footer id="cartFooter" style="width: 100%;margin:0px;display:none;" class="bg-contrast-lower yx-lo yx-lg yx-ih">
                                                <p class="flex justify-between" style="font-size: 1.5rem;color:rgb(87, 89, 98);">
                                                    <span id="spnTotal">Total:</span>
                                                    <span id="divSubtotal">KD. 0.000</span>
                                                    <input id="hdnSubtotal" type="hidden" value="0" />
                                                </p>
                                                @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsGenerateQRCode"]) == true)
                                                {
                                                    <a href="#0" style="width:49%;" class="btn btn--dark btn--md yx-dy margin-y-xs btnGenerateOrder">Generate Order</a>
                                                }
                                                @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == true)
                                                {
                                                    <a href="#0" style="width:49%;" class="btn btn--dark btn--md yx-dy margin-y-xs btnCheckOut">Check out</a>
                                                }
                                                <a id="btnclearCart" href="#0" onclick="clearCart();" style="width:49%;background-color:var(--primary);" class="btn btn--primary btn--md yx-dy margin-y-xs">Clear Cart</a>
                                            </footer>
                                        }
                                        @{
                                            Html.RenderPartial("~/Views/ItemsView/GenerateQR.cshtml");
                                        }
                                        @{
                                            Html.RenderPartial("~/Views/ItemsView/TrackingOrder.cshtml");
                                        }
                                    </div>
                                    @{
                                        Html.RenderPartial("~/Views/ItemsView/ItemDetailsView.cshtml");
                                    }
                                    <!--begin: Wizard-->
                                    <div id="kt_wizard_v4" style="height: 85vh;overflow-y:scroll;overflow-x:hidden;display:none;" class="wizard wizard-4" data-wizard-state="step-first" data-wizard-clickable="true">
                                        <!--begin: Wizard Nav-->
                                        <div class="wizard-nav">
                                            <div class="wizard-steps">
                                                <!--begin::Wizard Step 1 Nav-->
                                                <div class="wizard-step" data-wizard-type="step" data-wizard-state="current">
                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">1</div>
                                                        <div class="wizard-label">
                                                            <div id="divUserInformation" class="wizard-title">User Information</div>
                                                            <div id="divSetupNameMobileEmail" class="wizard-desc">Setup Name,Mobile,Email</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--end::Wizard Step 1 Nav-->
                                                <!--begin::Wizard Step 2 Nav-->
                                                <div class="wizard-step" data-wizard-type="step">
                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">2</div>
                                                        <div class="wizard-label">
                                                            <div id="divDeliveryServiceType" class="wizard-title">Delivery Service Type</div>
                                                            <div id="divSelectDeliveryPickup" class="wizard-desc">Select Delivery/Pickup</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--end::Wizard Step 2 Nav-->
                                                <!--begin::Wizard Step 3 Nav-->
                                                <div class="wizard-step" data-wizard-type="step">
                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">3</div>
                                                        <div class="wizard-label">
                                                            <div id="divYourAddress" class="wizard-title">Your Address</div>
                                                            <div id="divSetupYourAddress" class="wizard-desc">Setup Your Address</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--end::Wizard Step 3 Nav-->
                                                <!--begin::Wizard Step 4 Nav-->
                                                <div class="wizard-step" data-wizard-type="step">
                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">4</div>
                                                        <div class="wizard-label">
                                                            <div id="divMakePayment" class="wizard-title">Make Payment</div>
                                                            <div id="divSelectPaymentOptions" class="wizard-desc">Select Payment Options</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--end::Wizard Step 4 Nav-->
                                                <!--begin::Wizard Step 5 Nav-->
                                                <div class="wizard-step" data-wizard-type="step">
                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">5</div>
                                                        <div class="wizard-label">
                                                            <div id="divCompleted" class="wizard-title">Completed</div>
                                                            <div id="divReviewandSubmit" class="wizard-desc">Review and Submit</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--end::Wizard Step 5 Nav-->
                                            </div>
                                        </div>
                                        <!--end: Wizard Nav-->
                                        <!--begin: Wizard Body-->
                                        <div class="card card-custom card-shadowless rounded-top-0">
                                            <div class="card-body p-0">
                                                <div class="row justify-content-center py-8 px-8 py-lg-15 px-lg-10">
                                                    <div class="col-xl-12 col-xxl-7">
                                                        <!--begin: Wizard Form-->
                                                        <div class="form mt-0 mt-lg-10" id="kt_form">
                                                            <!--begin: Wizard Step 1-->
                                                            <div class="pb-5" data-wizard-type="step-content" data-wizard-state="current">
