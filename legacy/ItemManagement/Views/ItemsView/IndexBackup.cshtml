                                        <div class="btn btn-icon btn-hover-transparent-white btn-dropdown btn-lg mr-1">
                                            <div class="dropdown">
                                                <button id="BtnlangDesktop" class="dropbtnDesktop" value="AR" onclick="selectLanguage(this);">ع</button>
                                                @*<div class="dropdown-content-Desktop">
                                                        <a onclick="selectLanguage('EN');">EN</a>
                                                        <a onclick="selectLanguage('AR');">AR</a>
