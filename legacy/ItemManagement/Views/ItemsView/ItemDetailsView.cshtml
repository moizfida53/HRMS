<div id="myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="ItemDetailsName" style="margin-top: 0.8rem !important;"></h2>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <img id="itemDetailsImage" class="item-detail-image ng-tns-c1-8 ng-trigger ng-trigger-fadeAnimation ng-star-inserted" style="display: inline; opacity: 1;"
                 src="">
            <div class="item-detail-content-wrapper ng-tns-c1-8" margin="15px 11px 0 19px" style="direction: ltr; margin-top: 10px;">
                @* <ion-row id="ItemDetailsName" class="item-headline row ng-tns-c1-8 ng-star-inserted" style="padding-top: 10px; color: rgb(87, 89, 98);">Shroom's Zuppa</ion-row>*@
                <ion-row class="item-price justify-center row ng-tns-c1-8 ng-star-inserted" style="color: rgb(87, 89, 98);">
                    <span id="ItemDetailsPrice" class="item-currency" style="color: var(--primary);">

                    </span>
                </ion-row>
                <ion-row class="item-body row">
                    <div id="ItemDescription" class="description-container" style="color: rgb(87, 89, 98);">Creamy mushroom soup</div>
                </ion-row>
                <modifier-list class="ng-tns-c1-8">
                    <ion-list class="modifier-list list list-ios">
                        <div class="ng-untouched ng-pristine ng-valid"></div>
                    </ion-list>
                </modifier-list>
                <ion-infinite-scroll class="ng-tns-c1-8"></ion-infinite-scroll>
            </div>
        </div>
        @*<div class="modal-footer">
                <h3>Modal Footer</h3>
            </div>*@
    </div>

</div>