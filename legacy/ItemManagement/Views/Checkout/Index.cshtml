                                                    <div class="wizard-wrapper">
                                                        <div class="wizard-number">1</div>
                                                        <div class="wizard-label">
                                                            <div class="wizard-title">User Information</div>
                                                            <div class="wizard-desc">Setup Name,Mobile,Email</div>
                                                        </div>
                                                    </div>
                                                </div>
