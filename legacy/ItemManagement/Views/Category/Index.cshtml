<main class="main-content item-management">
    <input type="hidden" id="hdnIsCategoryOrItemsSelected" value="Category" />  @*Category/Items*@
    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == true)
    {
        <input type="hidden" id="hdnIsEcommerce" value="true" />
    }
    else
    {
        <input type="hidden" id="hdnIsEcommerce" value="false" />
    }


    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsSubCategory"]) == true)
    {
        <input type="hidden" id="hdnIsSubCategoryProject" value="true" />
    }
    else
    {
        <input type="hidden" id="hdnIsSubCategoryProject" value="false" />
    }

    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsChoiceBind"]) == true)
    {
        <input type="hidden" id="hdnIsChoiceBind" value="true" />
    }
    else
    {
        <input type="hidden" id="hdnIsChoiceBind" value="false" />
    }
    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsExtraItemsBind"]) == true)
    {
        <input type="hidden" id="hdnIsExtraItemsBind" value="true" />
    }
    else
    {
        <input type="hidden" id="hdnIsExtraItemsBind" value="false" />
    }



    <!-- Category Management Section -->
    <div class="container-fluid h-100 item-management-list" id="divCategoryList">
        <div class="item-management-heading d-flex">
            @*<a href="#" title="Back" class="back-btn"><img src="~/Images/back-arrow.svg" alt=""></a>*@
            <h2 data-lbl="adm_secCategory">Category</h2>
        </div>

        <div class="row ml-n2 mr-n2 uk-sortable catDroppable" data-uk-sortable id="CategoryList">

        </div>
    </div>

    <!--Sub Category Section -->
    <div class="container-fluid h-100 item-management-list" id="divSubCategoryList" style="display:none;">
        <input type="hidden" id="selectedSubCategoryId" value="0" />
        <div class="item-management-heading d-flex">
            <a href="#" title="Back" class="back-btn" onclick="BacktoCategoryList();"><img src="~/Images/back-arrow.svg" alt=""></a>
            <h2 id="SubCategoryListHeaderLabel" data-lbl="adm_secSubCategory">Sub Category</h2>
        </div>

        <div class="row ml-n2 mr-n2 uk-sortable catDroppable" data-uk-sortable id="SubCategoryList">

        </div>
    </div>

    <!-- Category Items Section -->
    <div class="container-fluid h-100 item-management-list" id="divCategoryItemsList" style="display:none;">
        <div class="item-management-heading d-flex">
            <a href="#" title="Back" class="back-btn" onclick="BacktoCategoryList();"><img src="~/Images/back-arrow.svg" alt=""></a>
            <h2 id="itemlistHeaderLabel" data-lbl="adm_secItem">Item</h2>
        </div>

        <div class="row ml-n2 mr-n2 catItemsDroppable" id="CategoryItemsList">

        </div>
    </div>
    <!-- Item Management Right Navigation -->

    <div class="right-navigation">
        <div class="p-2">
            <a onclick="clearAllSelection();" class="btn btn-icon btn-secondary w-100 text-left"> <img class="icon" src="../Images/clear.svg" ā alt=""> <span data-lbl="adm_btnClearAll">Clear All</span></a>
        </div>
        <div class="accordion" id="accordionExample">
            <div class="card">
                <div class="card-header" id="Branch-heading">
                    <a class="card-title" data-lbl="adm_navBranch" role="button" data-toggle="collapse" data-target="#Branch" aria-expanded="true" aria-controls="Branch">
                        Branch
                    </a>
                </div>

                <div id="Branch" class="collapse show" aria-labelledby="Branch-heading" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulBranchList"></ul>
                    </div>
                </div>
            </div>

            <div class="card" id="divChoicesList" style="display:none;">
                <div class="card-header" id="Choice-heading">
                    <a class="card-title" data-lbl="adm_navChoices" role="button" data-toggle="collapse" data-target="#Choices" aria-expanded="false" aria-controls="Choices">
                        Choices
                    </a>
                </div>

                <div id="Choices" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulChoicesList"></ul>
                    </div>
                </div>
            </div>

            <div class="card" id="divExtraItemsList" style="display:none;">
                <div class="card-header" id="Extra-heading">
                    <a class="card-title" data-lbl="adm_navExtraItems" role="button" data-toggle="collapse" data-target="#Extra" aria-expanded="false" aria-controls="Extra">
                        Extra Items
                    </a>
                </div>

                <div id="Extra" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulExtraItemsList"></ul>
                    </div>
                </div>
            </div>


            <div class="card" id="divCommentsList" style="display:none;">
                <div class="card-header" id="Comments-heading">
                    <a class="card-title" data-lbl="adm_navComments" role="button" data-toggle="collapse" data-target="#Comments" aria-expanded="false" aria-controls="Comments">
                        Comments
                    </a>
                </div>

                <div id="Comments" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulItemCommentsList">
                            <li>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="customRadio21" name="customRadio2" class="custom-control-input">
                                    <label class="custom-control-label" for="customRadio21">Toggle this custom radio</label>
                                </div>
                            </li>
                            <li>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="customRadio22" name="customRadio2" class="custom-control-input">
                                    <label class="custom-control-label" for="customRadio22">Or toggle this other custom radio</label>
                                </div>
                            </li>
                            <li>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="customRadio23" name="customRadio2" class="custom-control-input">
                                    <label class="custom-control-label" for="customRadio23">Toggle this custom radio</label>
                                </div>
                            </li>
                            <li>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="customRadio24" name="customRadio2" class="custom-control-input">
                                    <label class="custom-control-label" for="customRadio24">Or toggle this other custom radio</label>
                                </div>
                            </li>
                            <li>
                                <a href="#" class="btn btn-icon btn-secondary  w-100 text-left"><img class="icon" src="~/Images/add-b.svg" alt=""> <span data-lbl="adm_btnAddExtraItems">Add Extra Items</span></a>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="card" id="divGroupModifierList" style="display:none;">
                <div class="card-header" id="Extra-heading">
                    <a class="card-title" data-lbl="adm_navGroupModifier" role="button" data-toggle="collapse" data-target="#GroupModifier" aria-expanded="false" aria-controls="GroupModifier">
                        Group Modifier
                    </a>
                </div>
                <div id="GroupModifier" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulGroupModifierList"></ul>
                    </div>
                </div>
            </div>
            <div class="card" id="divAllergensList" style="display:none;">
                <div class="card-header" id="Extra-heading">
                    <a class="card-title" data-lbl="adm_navAllergens" role="button" data-toggle="collapse" data-target="#Allergens" aria-expanded="false" aria-controls="Allergens">
                        Allergens
                    </a>
                </div>
                <div id="Allergens" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">
                        <ul id="ulAllergensList"></ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>


@*//-------------------------------------------Start Category Add Popup----------------------------------------*@
<div class="modal fade" id="WindowCategoryAdd" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="AddCategoryTitle" data-lbl="adm_titleAddCategory">Add Category</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <div class="toggle-switch-outer">
                            <label class="pb-0" data-lbl="adm_lblShowCategory">Show Category</label>
                            <div class="toggle-switch-block">
                                <label class="toggle-switch">
                                    <input id="chkShowCategory" type="checkbox">
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>

                        @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsSubCategory"]) == true)
                        {
                            <div class="toggle-switch-outer chkIsSubCate">
                                <label class="pb-0" data-lbl="adm_lblIsSubCategory">Is Sub Category</label>
                                <div class="toggle-switch-block">
                                    <label class="toggle-switch">
                                        <input id="chkIsSubCategory" type="checkbox" onclick="chkIsSubCategoryChange(this);">
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    @*@if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsSubCategory"]) == true)
                        {
                            <div class="form-group">
                                <div class="toggle-switch-outer">
                                    <label class="pb-0" data-lbl="adm_lblIsSubCategory">Is Sub Category</label>
                                    <div class="toggle-switch-block">
                                        <label class="toggle-switch">
                                            <input id="chkIsSubCategory" type="checkbox" onclick="chkIsSubCategoryChange(this);">
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }*@
                    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsSubCategory"]) == true)
                    {
                        <div id="divddrMainCategoryList" class="form-group" style="display:none">
                            <label data-lbl="adm_lblMainCategory">Main Category</label>
                            <select id="ddMainCategoryList" class="form-control" name="MainCategory[]" required></select>
                            <div class="invalid-feedback">
                                <span data-lbl="adm_valMainCategory">Please select a valid Main Category.</span>
                            </div>
                        </div>
                    }
                    <div class="form-group">
                        <label data-lbl="adm_lblSelectBrand">Select Brand</label>
                        <select id="ddBrand" class="form-control" name="ItemComments[]" required></select>
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valSelectBrand">Please select a valid brand.</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label data-lbl="adm_lblAssignBranch">Assign Branch</label>
                        <select id="ddBranch" class="form-control MultiSelect" name="Branchs[]" multiple="multiple" required></select>
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valAssignBranch">Please select a valid branch.</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label data-lbl="adm_lblCategoryName">Category Name</label>
                        @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                        {
                            <input id="txtCategoryName" type="text" class="form-control" required />

                        }
                        else
                        {
                            <input id="txtCategoryName" type="text" class="form-control" readonly="readonly" />
                        }
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valCategoryName">Please insert a valid category name.</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label data-lbl="adm_lblCategoryNameAr">Category Name(Arabic)</label>
                        @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                        {
                            <input id="txtCategoryNameArabic" type="text" class="form-control" required />

                        }
                        else
                        {
                            <input id="txtCategoryNameArabic" type="text" class="form-control" readonly="readonly" />
                        }

                        <div class="invalid-feedback">
                            <span data-lbl="adm_valCategoryName">Please insert a valid category name.</span>
                        </div>
                    </div>

                    @*-----------------------START Display None variables@*-----------------------*@
                    <div style="display: none;">
                        <b>Category Number:</b>
                        <input id="txtCategoryNumber" type="text" />
                    </div>
                    <div style="display: none;">
                        <b>Sequence Number:</b>
                        <input id="txtSeqNo" type="text" />
                    </div>
                    <div id="CatLanguage" style="display: none;">
                        <div>
                            <b>Category Name (Mandarian):</b>
                            <input id="txtCategoryNameMan" type="text" />
                        </div>

                        <div style="display: none;">
                            <b>Category Name (Russian):</b>
                            <input id="txtCategoryNameRus" type="text" />
                        </div>
                    </div>

                    <div class="row" style="display: none;">
                        <div class="col-lg-6">
                            <b>Is Sub Category </b>
                            <span style="margin-left: 20px">
                                Yes<input type="radio" name="isSubCategory" id="subCategory" class="image" value="false" onclick="ShowMainCategory()" />
                            </span>

                            <span style="margin-left: 20px">
                                No
                                <input type="radio" name="isSubCategory" id="mainCategory" class="image" checked value="true" onclick="hideMainCategory()" />
                            </span>
                        </div>
                        <div class="col-lg-6" id="mainCatDisplay" style="display: none;">
                            <b>Select Main Category </b>
                            <div style="margin-left: 10px">
                                <div id="ddMainCategory"></div>
                            </div>
                        </div>
                    </div>

                    @*-----------------------END Display None variables@*-----------------------*@
                </div>
                <div class="modal-footer">
                    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsPermenantDelete"]) == true)
                    {
                        if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                        {
                            <button id="CatDeleteButton" type="button" class="btn btn-primary" onclick="DeleteCategory();" style="display:none;" data-lbl="adm_btnDelete">Delete</button>
                        }
                    }

                    <button id="CatAddButton" type="button" class="btn btn-primary" onclick="SaveCategory();" data-lbl="adm_btnAdd">Add</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-lbl="adm_btnClose">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*//-------------------------------------------End Category Add Popup----------------------------------------*@

@*//-------------------------------------------Start Category Item Add Popup----------------------------------------*@
<div class="modal fade item-modal" id="WindowCategoryItemAdd" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-lg modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h2 class="modal-title" id="AddItemTitle" data-lbl="adm_titleAddItem">Add Item</h2>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../Images/ic-close.svg" alt=""></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="col-xl-7">
                        <div class="form-row">
                            <div class="col-lg-auto">
                                <div class="card p-sm-4 p-3 mb-2 align-items-center" style="min-height:102px;">
                                    <!-- Show Items toggle hidden per request - #chkShowItems kept in the DOM so
                                         existing JS that reads/sets it keeps working, just not shown to the user -->
                                    <div class="form-group mt-3" style="display:none;">
                                        <div class="toggle-switch-outer">
                                            <label class="pb-0" data-lbl="adm_lblShowItems">Show Items</label>
                                            <div class="toggle-switch-block">
                                                <label class="toggle-switch">
                                                    <input id="chkShowItems" type="checkbox" name="select">
                                                    <span class="slider"></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Price moved here from the col-xl-5 card below -->
                                    <div class="form-group w-100 mb-0">
                                        <label data-lbl="adm_lblPrice">Price</label>
                                        @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                                        {
                                            <input id="txtPrice" class="form-control numericOnly" type="text" name="" value="">
                                        }
                                        else
                                        {
                                            <input id="txtPrice" class="form-control numericOnly" type="text" name="" value="" readonly="readonly">
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg">
                                <div class="card pl-3 pr-3 pt-3 pb-1 mb-2">
                                    <div class="form-group">
                                        <label data-lbl="adm_lblCategory">Category</label>
                                        <bran id="ItemPopupCategoryName" class="form-control" readonly>Category</bran>
                                        <select id="ddItemCategory" class="form-control" name="ItemComments[]" style="width:100%;"></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <!-- Was the Price card - now the Select Allergen control, shown only when
                             the brand has ShowAllergen=1 (toggled in Category.js) -->
                        <div class="card pl-3 pr-3 pt-3 pb-1 mb-2" id="divItemAllergensSection" style="display:none;">
                            <div class="form-group">
                                <label data-lbl="adm_lblSelectAllergen">Select Allergen</label>
                                <select id="ddItemAllergens" class="form-control MultiSelect" name="ItemAllergens[]" multiple="multiple"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-xl-7 mb-2">
                        <div class="card pl-3 pr-3 pt-3 pb-2 h-100">
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label data-lbl="adm_lblItemNameEng">Item Name (English)</label>
                                    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                                    {
                                        <input id="txtItemNameEng" class="form-control" type="text" name="" value="">

                                    }
                                    else
                                    {
                                        <input id="txtItemNameEng" class="form-control" type="text" name="" value="" readonly="readonly">
                                    }
                                </div>
                                <div class="form-group col-md-6">
                                    <label data-lbl="adm_lblItemNameAra">Item Name (Arabic)</label>
                                    @if (@Convert.ToBoolean(System.Configuration.ConfigurationManager.AppSettings["IsEcommerce"]) == false)
                                    {
                                        <input id="txtItemNameAra" class="form-control" type="text" name="" value="">

                                    }
                                    else
                                    {
                                        <input id="txtItemNameAra" class="form-control" type="text" name="" value="" readonly="readonly">
                                    }

                                </div>
                                <div class="form-group col-md-6">
                                    <label data-lbl="adm_lblIngredientEng">Ingredient (English)</label>
                                    <textarea id="txtIngEng" class="form-control" rows="3"></textarea>
                                </div>
                                <div class="form-group col-md-6">
                                    <label data-lbl="adm_lblIngredientAra">Ingredient (Arabic)</label>
                                    <textarea id="txtIngAra" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5 mb-2">
                        <div class="card pl-3 pr-3 pt-3 pb-1 mb-2">
                            <div class="form-group">
                                <label data-lbl="adm_lblAssignBranch">Assign Branch</label>
                                <select id="ddItemBranch" class="form-control MultiSelect" name="ItemBranchs[]" multiple="multiple"></select>
                            </div>
                            <div id="divCreateItemChoiceList" class="form-group" style="display:none">
                                <label data-lbl="adm_lblAssignChoice">Assign Choice</label>
                                <select id="ddChoices" name="Choices[]" class="form-control MultiSelect" multiple="multiple"></select>
                            </div>
                            <div id="divCreateItemExtraItemsList" class="form-group" style="display:none">
                                <label data-lbl="adm_lblAssignExtras">Assign Extras</label>
                                <select id="ddExtraItems" name="ExtraItems[]" class="form-control MultiSelect" multiple="multiple"></select>
                            </div>
                            <div class="form-group">
                                <label data-lbl="adm_lblAssignComments">Assign Comments</label>
                                <select id="ddExtraComments" name="ExtraComments[]" class="form-control  MultiSelect" multiple="multiple"></select>
                            </div>
                            @*<div class="form-group">
                                <label>Assign ModifierGroup</label>
                                <select id="ddGroupModifier" name="ModifierGroup[]" class="form-control  MultiSelect" multiple="multiple"></select>
                            </div>*@
                        </div>
                    </div>
                </div>

                <div class="card pl-3 pr-3 pt-3 pb-1">
                    <div class="form-row">
                        <div class="col-md-6 upload-file-block mb-3">
                            <div class="form-group">
                                <input type="hidden" id="hdnImageFileName" value="" />
                                <label data-lbl="adm_lblSelectImage3MB">Select Image (max 3MB File Size)</label>
                                <div class="custom-file">
                                    <input id="imageFileUpload" type="file" name="ImageFileUpload" class="custom-file-input">
                                    <label id="lblImageuploadName" class="custom-file-label text-truncate" for="customFile" data-lbl="adm_lblChooseFile">Choose file</label>
                                </div>
                            </div>
