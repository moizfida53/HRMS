<div class="modal fade" id="WindowChangePassword" tabindex="-1" role="dialog" aria-labelledby="staticBackdrop" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header align-items-center">
                <h4 class="modal-title" id="ChangePasswordTitle" data-lbl="adm_titleChangePassword">Change Password</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><img src="../images/ic-close.svg" alt=""></span>
                </button>
            </div>
            @*<form class="needs-validation" novalidate>*@<form class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="form-group">
                        <input type="hidden" id="txtUserIDChangePassword" value="" />
                        <label data-lbl="adm_lblOldPassword">Old Password</label>
                        <input id="txtOldPassword" type="password" class="form-control" required />
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valPassword">Please insert a Password.</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label data-lbl="adm_lblNewPassword">New Password</label>
                        <input id="txtNewPassword" type="password" class="form-control" required />
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valPassword">Please insert a Password.</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label data-lbl="adm_lblRetypePassword">Retype Password</label>
                        <input id="txtReTypePassword" type="password" class="form-control" required />
                        <div class="invalid-feedback">
                            <span data-lbl="adm_valPassword">Please insert a Password.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="BtnChangePassword" type="button" class="btn btn-primary" onclick="ChangePassword();" data-lbl="adm_btnSave">Save</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-lbl="adm_btnClose">Close</button>
                </div>
                @*</form>*@
            </form>
        </div>
    </div>
</div>
