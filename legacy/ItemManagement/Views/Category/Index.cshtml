@using Jar.Helper   @* Asset.V() - css/js cache-buster, Helper\AssetVersion.cs *@
@{
    // One view, two homes. Served from /Category it is the classic admin page
    // and nothing about it changes. Served from /POS/Menu it renders inside the
    // POS chrome instead - same markup, same scripts, same endpoints, only the
    // shell around it differs. See Areas/POS/Controllers/MenuController.cs and
    // Areas/POS/Views/Shared/_LayoutPOSAdmin.cshtml.
    Layout = string.Equals(ViewContext.RouteData.DataTokens["area"] as string, "POS",
                           StringComparison.OrdinalIgnoreCase)
           ? "~/Areas/POS/Views/Shared/_LayoutPOSAdmin.cshtml"
           : "~/Views/Shared/_LayoutNew.cshtml";
}
<link href="@Asset.V("~/assets/plugins/custom/datatables/datatables.bundle.css?v=7.0.5")" rel="stylesheet" type="text/css" />
<link href="@Asset.V("~/Content/newfont-awesome.min.css")" rel="stylesheet" />
<style>
    .chkIsSubCate {
        float: right;
    }

    .branch_td1 {
        width: 25px !important;
        padding-right: 0px !important;
        /*padding-left: 0px !important;*/
    }

    .branch_td2 {
    }
    .branch_tdShort {
        width: 25px !important;
        padding:0px !important;
    }
    .branch_tdStatus {
        width: 25px !important;
        padding: 0px !important;
    }

    .branch_td3 {
        width: 25px !important;
        padding-right: 0px !important;
        padding-left: 0px !important;
    }

    .extraItem_td1 {
        width: 25px !important;
        padding-right: 0px !important;
        /*padding-left: 0px !important;*/
    }

    .extraItem_td2 {
    }

    .extraItem_td3 {
        width: 58px !important;
    }

    .extraItem_td4 {
        width: 25px !important;
        padding-right: 0px !important;
        padding-left: 0px !important;
    }

    .comment_td1 {
        width: 25px !important;
        padding-right: 0px !important;
        /*padding-left: 0px !important;*/
    }

    .comment_td2 {
    }

    .comment_td3 {
        width: 25px !important;
        padding-right: 0px !important;
        padding-left: 0px !important;
