+  margin-top: 0.4rem;
+  text-align: right;
+}
+
+.fs-st-signs {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.5rem;
+  margin-top: 2.5rem;
+  text-align: center;
+  font-size: 0.75rem;
+}
+@container content (max-width: 639.98px) {
+  .fs-st-signs {
+    grid-template-columns: 1fr;
+    gap: 2rem;
+  }
+}
+.fs-st-signs__line {
+  display: block;
+  height: 2.5rem;
+  border-bottom: 1px solid #98a2b3;
+  margin-bottom: 0.35rem;
+}
+.fs-st-signs .fs-st__en, .fs-st-signs .fs-st__ar {
+  margin: 0;
+}
+
+@media print {
