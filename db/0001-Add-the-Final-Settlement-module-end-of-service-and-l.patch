+  background: #ffffff;
+  border: 1px solid #e4e7ec;
+  border-radius: var(--hrms-radius-lg, 12px);
+  font-size: 0.82rem;
+  color: #1d2939;
+  overflow: hidden;
+}
+@container content (max-width: 639.98px) {
+  .fs-statement {
+    padding: 1rem;
+  }
+}
+.fs-statement__watermark {
+  position: absolute;
+  inset: 40% 0 auto;
+  transform: rotate(-18deg);
+  text-align: center;
+  font-size: 2.6rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  color: rgba(220, 38, 38, 0.1);
