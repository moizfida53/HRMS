+}
+.fs-statement__watermark .fs-st__ar {
+  font-size: 2rem;
+  color: inherit;
+}
+.fs-statement__head {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  gap: 1rem;
+  align-items: center;
+  padding-bottom: 1rem;
