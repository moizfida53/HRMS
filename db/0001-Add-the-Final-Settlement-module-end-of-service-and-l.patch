+  padding: 0.3rem 0.6rem;
+  border-bottom: 1px dashed #e4e7ec;
+  font-size: 0.76rem;
+}
+.fs-st-lines td.pr-money {
+  text-align: end;
+  width: 9rem;
+}
+.fs-st-lines tr.is-info td {
+  color: #667085;
+}
+
+.fs-st-paid {
+  font-weight: 600;
+  color: #0b7a3b;
+}
+
+.fs-st-declaration {
+  margin: 1rem 0;
+  padding: 0.75rem 1rem;
+  border: 1px solid #e4e7ec;
