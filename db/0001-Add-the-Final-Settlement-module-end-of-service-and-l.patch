diff --git a/src/HRMS.Web/Views/FinalSettlement/Statement.cshtml b/src/HRMS.Web/Views/FinalSettlement/Statement.cshtml
new file mode 100644
index 0000000..a18ecca
--- /dev/null
+++ b/src/HRMS.Web/Views/FinalSettlement/Statement.cshtml
@@ -0,0 +1,150 @@
+@using Microsoft.AspNetCore.Html
+@model SettlementStatementModel
+@{
+    // The settlement statement the employee signs: English and Arabic side by side,
+    // whatever the language of the screen (labels from Core.UiLabels in both languages).
+    var s = Model.Settlement;
+    ViewData["Title"] = "Settlement Statement";
+    ViewData["ActiveArea"] = "payroll";
+    ViewData["PayrollSection"] = "settlement";
+    ViewData["Subtitle"] = s.SettlementNo;
+    string D(DateTime? d) => d?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—";
+    string M(decimal v) => PayrollFormat.Money(v);
+    var typeKey = SettlementFormat.TypeKey(s.SettlementType);
+    var draft = s.IsDraft || s.IsPending;
+
+    IHtmlContent Pair(string key, params object?[] args)
+    {
+        var (en, ar) = Model.Both(key, args);
+        return new HtmlString($"<span class=\"fs-st__en\">{System.Net.WebUtility.HtmlEncode(en)}</span>"
+                              + $"<span class=\"fs-st__ar\" lang=\"ar\" dir=\"rtl\">{System.Net.WebUtility.HtmlEncode(ar)}</span>");
+    }
+    var service = SettlementFormat.Service(L, s.HireDate, s.LastWorkingDay);
+}
+<article class="fs-statement@(draft ? " is-draft" : "")" dir="ltr" aria-label="@L["fs.statement"]">
+    @if (draft)
+    {
+        <div class="fs-statement__watermark" aria-hidden="true">@Pair("fs.st_not_final")</div>
+    }
+    <header class="fs-statement__head">
+        <div class="fs-statement__co">
+            <strong>@s.CompanyName</strong>
+            <span>@s.CompanyCode</span>
+        </div>
+        <div class="fs-statement__title">
+            @Pair(s.IsExit ? "fs.st_title" : "fs.st_title_encashment")
+        </div>
+        <div class="fs-statement__co fs-statement__co--ar" lang="ar" dir="rtl">
+            <strong dir="auto">@(s.CompanyArabicName ?? s.CompanyName)</strong>
+            <span>@s.SettlementNo</span>
+        </div>
+    </header>
+
+    <table class="fs-st-info">
+        <tbody>
+            <tr>
+                <th>@Pair("fs.st_settlement_no")</th><td>@s.SettlementNo</td>
+                <th>@Pair("fs.st_date")</th><td>@D(s.ApprovedDate ?? s.CalculatedDate ?? s.CreatedDate)</td>
+            </tr>
+            <tr>
+                <th>@Pair("fs.st_employee")</th><td>@s.EmployeeName@(s.EmployeeArabicName is not null ? " / " : "")<span lang="ar">@s.EmployeeArabicName</span></td>
+                <th>@Pair("fs.st_employee_no")</th><td>@s.EmployeeNo</td>
+            </tr>
+            <tr>
+                <th>@Pair("fs.st_department")</th><td>@s.DepartmentName</td>
+                <th>@Pair("fs.st_designation")</th><td>@s.DesignationName</td>
+            </tr>
+            <tr>
+                <th>@Pair("fs.st_nationality")</th><td>@s.NationalityName</td>
+                <th>@Pair("fs.st_type")</th><td>@Pair(typeKey)</td>
+            </tr>
+            <tr>
+                <th>@Pair("fs.st_joined")</th><td>@D(s.HireDate)</td>
+                <th>@Pair(s.IsExit ? "fs.st_last_day" : "fs.st_balance_on")</th><td>@D(s.LastWorkingDay)</td>
+            </tr>
+            @if (s.IsExit)
+            {
+                <tr>
+                    <th>@Pair("fs.st_service")</th><td>@service (@SettlementFormat.Years(s.ServiceYears))</td>
+                    <th>@Pair("fs.st_monthly_salary")</th><td>KWD @M(s.MonthlySalary)</td>
+                </tr>
+                <tr>
+                    <th>@Pair("fs.st_indemnity_salary")</th><td>KWD @M(s.IndemnityBase)</td>
+                    <th>@Pair("fs.st_leave_salary")</th><td>KWD @M(s.LeaveBase)</td>
+                </tr>
+            }
+            else
+            {
+                <tr>
+                    <th>@Pair("fs.st_leave_salary")</th><td>KWD @M(s.LeaveBase)</td>
+                    <th>@Pair("fs.st_pay_month")</th><td>@(s.PayMonth?.ToString("MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))</td>
+                </tr>
+            }
+        </tbody>
+    </table>
+
+    <table class="fs-st-sum">
+        <thead>
+            <tr><th>@Pair("fs.st_entitlement")</th><th class="pr-money">@Pair("fs.st_amount_kwd")</th></tr>
+        </thead>
+        <tbody>
+            @if (s.IsExit)
+            {
+                <tr><td>@Pair("fs.pending_salary")<span class="fs-st__calc">@(s.SalaryFrom is { } f && f <= s.LastWorkingDay ? D(f) + " – " + D(s.LastWorkingDay) : "—")</span></td><td class="pr-money">@M(s.PendingSalaryAmount)</td></tr>
+                <tr><td>@Pair("fs.other_earnings")</td><td class="pr-money">@M(s.OtherEarningsAmount)</td></tr>
+            }
+            <tr><td>@Pair("fs.leave_encashment")<span class="fs-st__calc">@SettlementFormat.Num(s.EncashDays) × (@M(s.LeaveBase) ÷ @SettlementFormat.Num(s.DailyDivisor))</span></td><td class="pr-money">@M(s.LeaveAmount)</td></tr>
+            @if (s.IsExit)
+            {
+                <tr><td>@Pair("fs.indemnity")<span class="fs-st__calc">@M(s.IndemnityCapped) × @SettlementFormat.Pct(s.IndemnityPercent)@(s.RuleSetCode is not null ? " · " + s.RuleSetCode : "")</span></td><td class="pr-money">@M(s.IndemnityAmount)</td></tr>
+                <tr class="is-sub"><td>@Pair("fs.st_total_entitlements")</td><td class="pr-money">@M(s.GrossPayable)</td></tr>
+                <tr><td>@Pair("fs.recoveries")</td><td class="pr-money pr-neg">@M(s.RecoveryAmount)</td></tr>
+            }
+        </tbody>
+        <tfoot>
+            <tr><td>@Pair("fs.net_payable")</td><td class="pr-money">KWD @M(s.NetPayable)</td></tr>
+        </tfoot>
+    </table>
+
+    @if (Model.Lines.Any(l => !l.IsInfo && l.IsIncluded) && s.IsExit)
+    {
+        <table class="fs-st-lines">
+            <caption>@Pair("fs.st_details")</caption>
+            <tbody>
+                @foreach (var l in Model.Lines.Where(l => l.IsIncluded && l.Section != SettlementSection.Leave))
+                {
+                    <tr class="@(l.IsInfo ? "is-info" : null)">
+                        <td>@SettlementFormat.Title(L, l)<span class="fs-st__calc">@SettlementFormat.Detail(L, l, s.DailyDivisor)</span></td>
+                        <td class="pr-money@(l.Amount < 0 ? " pr-neg" : "")">@(l.IsInfo ? "(" + M(l.Amount) + ")" : M(l.Amount))</td>
+                    </tr>
+                }
+            </tbody>
+        </table>
+    }
+
+    @if (s.IsPaid)
+    {
+        <p class="fs-st-paid">@Pair("fs.st_paid_on", D(s.PaidDate), s.PaymentRef ?? "")</p>
+    }
+
+    <p class="fs-st-declaration">@Pair(s.IsExit ? "fs.st_declaration" : "fs.st_declaration_encashment", M(s.NetPayable))</p>
+
+    <div class="fs-st-signs">
+        <div><span class="fs-st-signs__line"></span>@Pair("fs.st_sign_employee")</div>
+        <div><span class="fs-st-signs__line"></span>@Pair("prv.hr_manager")</div>
+        <div><span class="fs-st-signs__line"></span>@Pair("prv.finance_manager")</div>
+    </div>
+
+    <footer class="fs-statement__foot">
+        <span>@Pair("fs.st_generated", D(DateTime.Today))</span>
+        <span>@s.SettlementNo</span>
+    </footer>
+</article>
+
+@section PageActions {
+    <a class="btn btn-outline-secondary" href="@Url.Action("Details", "FinalSettlement", new { id = s.FinalSettlementId })">@Html.Icon("chevron-left", 15)<span>@L["fs.back_to_settlement"]</span></a>
+    <button type="button" class="btn btn-primary" data-fs-print>@Html.Icon("printer", 15)<span>@L["fs.print"]</span></button>
+}
+@section Scripts {
+    <script src="~/js/settlement.js" asp-append-version="true"></script>
+}
diff --git a/src/HRMS.Web/Views/FinalSettlement/_AddLine.cshtml b/src/HRMS.Web/Views/FinalSettlement/_AddLine.cshtml
new file mode 100644
index 0000000..6cf1257
--- /dev/null
+++ b/src/HRMS.Web/Views/FinalSettlement/_AddLine.cshtml
@@ -0,0 +1,35 @@
+@model string
+@{
+    // Add a line by hand: an earning (air ticket, notice pay in lieu ...) or a recovery (asset not returned ...).
+    var recovery = Model == SettlementSection.Recovery;
+    var id = "fs-add-" + Model.ToLowerInvariant();
+}
+<details class="fs-add">
+    <summary>@Html.Icon("plus", 14)<span>@(recovery ? L["fs.add_recovery"] : L["fs.add_earning"])</span></summary>
+    <form class="fs-add__form" data-fs-add data-section="@Model" novalidate>
+        <div class="fs-add__desc">
+            <label class="form-label" for="@id-desc">@L["fs.description"] <span class="req" aria-hidden="true">*</span></label>
+            <input class="form-control" id="@id-desc" name="description" maxlength="300" required list="@id-list"
+                   placeholder="@(recovery ? L["fs.recovery_placeholder"] : L["fs.earning_placeholder"])" />
+            <datalist id="@id-list">
+                @if (recovery)
+                {
+                    <option value="@L["fs.sugg_asset"]"></option>
+                    <option value="@L["fs.sugg_notice_shortfall"]"></option>
+                    <option value="@L["fs.sugg_advance"]"></option>
+                }
+                else
+                {
+                    <option value="@L["fs.sugg_ticket"]"></option>
+                    <option value="@L["fs.sugg_notice_pay"]"></option>
+                    <option value="@L["fs.sugg_bonus"]"></option>
+                }
+            </datalist>
+        </div>
+        <div class="fs-add__amt">
+            <label class="form-label" for="@id-amt">@L["pr.amount_kwd"] <span class="req" aria-hidden="true">*</span></label>
+            <input class="form-control pr-input-num" id="@id-amt" name="amount" type="number" inputmode="decimal" min="0.001" step="0.001" required />
+        </div>
+        <button type="submit" class="btn btn-outline-primary fs-add__btn">@Html.Icon("plus", 15)<span>@L["fs.add"]</span></button>
+    </form>
+</details>
diff --git a/src/HRMS.Web/Views/FinalSettlement/_Form.cshtml b/src/HRMS.Web/Views/FinalSettlement/_Form.cshtml
new file mode 100644
index 0000000..e2a76a0
--- /dev/null
+++ b/src/HRMS.Web/Views/FinalSettlement/_Form.cshtml
@@ -0,0 +1,141 @@
+@model SettlementFormModel
+@{
+    // One form for a new settlement, a draft being changed and a leave encashment.
+    // Posted by settlement.js to /payroll/settlement/save; the procedure validates
+    // and recalculates. The employee panel is filled from /payroll/settlement/defaults.
+    var s = Model.Settlement;
+    string D(DateTime? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
+    var today = DateTime.Today;
+    var formId = Model.IsNew ? "fs-form-new" : "fs-form-" + s!.FinalSettlementId;
+}
+<form class="fs-form" id="@formId" data-fs-form novalidate autocomplete="off"
+      data-defaults-url="@Url.Action("Defaults", "FinalSettlement")"
+      data-mode="@(Model.IsEncashment ? "encashment" : "exit")">
+    <input type="hidden" name="FinalSettlementId" value="@(s?.FinalSettlementId ?? 0)" />
+    @if (Model.IsEncashment)
+    {
+        <input type="hidden" name="SettlementType" value="@SettlementType.Encashment" />
+    }
+
+    <fieldset class="hrms-fieldset">
+        <legend>@(Model.IsEncashment ? L["fs.leave_encashment"] : L["fs.separation"])</legend>
+        <div class="row g-3">
+            <div class="col-12 col-lg-6">
+                <label class="form-label" for="@formId-emp">@L["pr.employee"] <span class="req" aria-hidden="true">*</span></label>
+                @if (Model.IsNew)
+                {
+                    <select class="form-select" id="@formId-emp" name="EmployeeId" required data-fs-emp>
+                        <option value="">@L["fs.select_employee"]</option>
+                        @foreach (var e in Model.Employees)
+                        {
+                            var label = SettlementFormat.Name(L, e.EmployeeName, e.EmployeeArabicName) + " · " + e.EmployeeNo;
+                            if (!Model.IsEncashment && e.OpenSettlementNo is not null) label += " · " + e.OpenSettlementNo;
+                            <option value="@e.EmployeeId" selected="@(e.EmployeeId == Model.EmployeeId)"
+                                    disabled="@(!Model.IsEncashment && e.OpenSettlementNo is not null ? "disabled" : null)">@label</option>
+                        }
+                    </select>
+                }
+                else
+                {
+                    <input type="hidden" name="EmployeeId" value="@s!.EmployeeId" data-fs-emp />
+                    <input class="form-control" id="@formId-emp" value="@SettlementFormat.Name(L, s.EmployeeName, s.EmployeeArabicName) · @s.EmployeeNo" readonly />
+                }
+            </div>
+
+            @if (Model.IsEncashment)
+            {
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-lwd">@L["fs.balance_on"] <span class="req" aria-hidden="true">*</span></label>
+                    <input class="form-control" type="date" id="@formId-lwd" name="LastWorkingDay" value="@D(s?.LastWorkingDay ?? today)" required data-fs-lwd />
+                </div>
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-month">@L["fs.paid_in_payroll_of"] <span class="req" aria-hidden="true">*</span></label>
+                    <select class="form-select" id="@formId-month" name="PayMonth" required>
+                        @foreach (var m in Model.PayMonths)
+                        {
+                            <option value="@D(m)" selected="@(s?.PayMonth == m || (s is null && m == new DateTime(today.Year, today.Month, 1)))">@L.MonthYear(m)</option>
+                        }
+                    </select>
+                </div>
+            }
+            else
+            {
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-type">@L["fs.separation_type"] <span class="req" aria-hidden="true">*</span></label>
+                    <select class="form-select" id="@formId-type" name="SettlementType" required data-fs-type>
+                        @foreach (var t in SettlementType.Exit)
+                        {
+                            <option value="@t" selected="@(t == (s?.SettlementType ?? Model.Type))">@L[SettlementFormat.TypeKey(t)]</option>
+                        }
+                    </select>
+                </div>
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-lwd">@L["fs.last_working_day"] <span class="req" aria-hidden="true">*</span></label>
+                    <input class="form-control" type="date" id="@formId-lwd" name="LastWorkingDay" value="@D(s?.LastWorkingDay)" required data-fs-lwd />
+                </div>
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-notice">@L["fs.notice_date"]</label>
+                    <input class="form-control" type="date" id="@formId-notice" name="NoticeDate" value="@D(s?.NoticeDate)" />
+                </div>
+                <div class="col-6 col-lg-3">
+                    <label class="form-label" for="@formId-from">@L["fs.salary_unpaid_from"]</label>
+                    <input class="form-control" type="date" id="@formId-from" name="SalaryFrom" value="@D(s?.SalaryFrom)" data-fs-from />
+                    <div class="form-text" data-fs-from-hint></div>
+                </div>
+            }
+
+            <div class="col-6 col-lg-3">
+                <label class="form-label" for="@formId-bal">@L["fs.leave_balance_days"]@if (Model.IsEncashment) { <span class="req" aria-hidden="true"> *</span> }</label>
+                <input class="form-control pr-input-num" type="number" inputmode="decimal" min="0" max="999" step="0.5" id="@formId-bal" name="LeaveBalanceDays"
+                       value="@(s is null ? "" : SettlementFormat.Num(s.LeaveBalanceDays))" data-fs-balance />
+            </div>
+            <div class="col-6 col-lg-3">
+                <label class="form-label" for="@formId-enc">@L["fs.days_to_encash"]@if (Model.IsEncashment) { <span class="req" aria-hidden="true"> *</span> }</label>
+                <input class="form-control pr-input-num" type="number" inputmode="decimal" min="0" max="999" step="0.5" id="@formId-enc" name="EncashDays"
+                       value="@(s is null ? "" : SettlementFormat.Num(s.EncashDays))" data-fs-encash />
+                @if (!Model.IsEncashment)
+                {
+                    <div class="form-text">@L["fs.days_to_encash_hint"]</div>
+                }
+            </div>
+            <div class="col-12 @(Model.IsEncashment ? "col-lg-6" : "")">
+                <label class="form-label" for="@formId-reason">@(Model.IsEncashment ? L["pr.comment"] : L["fs.reason"])</label>
+                <textarea class="form-control" id="@formId-reason" name="Reason" rows="2" maxlength="500"
+                          placeholder="@(Model.IsEncashment ? L["fs.encashment_reason_placeholder"] : L["fs.reason_placeholder"])">@s?.Reason</textarea>
+            </div>
+        </div>
+    </fieldset>
+
+    @* filled by settlement.js once an employee (and last working day) is chosen *@
+    <div class="fs-info" data-fs-info hidden aria-live="polite">
+        <div class="pr-banner pr-banner--err" data-fs-open hidden>
+            @Html.Icon("alert", 18)
+            <div>@L["fs.employee_has_settlement"] <a data-fs-open-link href="#"></a></div>
+        </div>
+        <dl class="pr-dl">
+            <div><dt>@L["fs.joined"]</dt><dd data-fs-v="hire">—</dd></div>
+            <div><dt>@L["fs.service"]</dt><dd data-fs-v="service">—</dd></div>
+            <div><dt>@L["fs.monthly_salary"]</dt><dd data-fs-v="salary">—</dd></div>
+            @if (!Model.IsEncashment)
+            {
+                <div><dt>@L["fs.indemnity_salary"]</dt><dd data-fs-v="indemnity">—</dd></div>
+            }
+            <div><dt>@L["fs.leave_salary"]</dt><dd data-fs-v="leave">—</dd></div>
+            @if (!Model.IsEncashment)
+            {
+                <div><dt>@L["fs.salary_paid_through"]</dt><dd data-fs-v="paid">—</dd></div>
+                <div><dt>@L["fs.indemnity_rules"]</dt><dd data-fs-v="rules">—</dd></div>
+            }
+        </dl>
+    </div>
+
+    <div class="fs-form__actions">
+        @if (!Model.IsNew)
+        {
+            <button type="button" class="btn btn-outline-secondary" data-fs-form-cancel>@L["common.cancel"]</button>
+        }
+        <button type="submit" class="btn btn-primary" data-fs-save>
+            @Html.Icon("calculator", 15)<span>@(Model.IsNew ? L["fs.calculate_settlement"] : L["fs.save_and_recalculate"])</span>
+        </button>
+    </div>
+</form>
diff --git a/src/HRMS.Web/Views/FinalSettlement/_Grid.cshtml b/src/HRMS.Web/Views/FinalSettlement/_Grid.cshtml
new file mode 100644
index 0000000..86f9d17
--- /dev/null
+++ b/src/HRMS.Web/Views/FinalSettlement/_Grid.cshtml
@@ -0,0 +1,78 @@
+@using HRMS.Web.Models.Organization
+@model SettlementGridModel
+@{
+    var pg = Model.Page;
+}
+<div data-total="@pg.TotalCount" data-count-text="@(pg.TotalCount == 1 ? L["fs.1_settlement"] : L["fs.0_settlements", PayrollFormat.Count(pg.TotalCount)])">
+@if (pg.TotalCount == 0)
+{
+    <div class="hrms-empty">
+        <span class="hrms-empty__icon" aria-hidden="true">@Html.Icon(Model.IsFiltered ? "search" : "exit", 26)</span>
+        <p class="hrms-empty__title">@(Model.IsFiltered ? L["fs.no_settlements_match"] : L["fs.no_settlements_yet"])</p>
+        <p class="hrms-empty__text">@L["fs.no_settlements_text"]</p>
+    </div>
+}
+else
+{
+    <div class="hrms-table-wrap">
+        <table class="hrms-table fs-table">
+            <caption class="hrms-sr-only">@L["fs.settlements"]</caption>
+            <thead>
+                <tr>
+                    <th scope="col">@L["fs.settlement"]</th>
+                    <th scope="col">@L["pr.employee"]</th>
+                    <th scope="col">@L["fs.type"]</th>
+                    <th scope="col" class="col-p2">@L["fs.last_day"]</th>
+                    <th scope="col" class="col-p3">@L["fs.service"]</th>
+                    <th scope="col" class="pr-money">@L["fs.payable_kwd"]</th>
+                    <th scope="col">@L["common.status"]</th>
+                    <th scope="col"><span class="hrms-sr-only">@L["common.actions"]</span></th>
+                </tr>
+            </thead>
+            <tbody>
+                @foreach (var s in pg.Items)
+                {
+                    var emp = SettlementFormat.Name(L, s.EmployeeName, s.EmployeeArabicName);
+                    var url = Url.Action("Details", "FinalSettlement", new { id = s.FinalSettlementId });
+                    <tr class="@(s.Status == SettlementStatus.Cancelled ? "is-ended" : null)">
+                        <td data-label="@L["fs.settlement"]" class="hrms-nowrap"><a class="hrms-code-chip fs-no" href="@url">@s.SettlementNo</a></td>
+                        <td data-label="@L["pr.employee"]" class="hrms-nowrap">
+                            <span class="hrms-table__primary">@emp</span>
+                            <span class="pr-emp-sub">@s.EmployeeNo@(s.DepartmentName is not null ? " · " + s.DepartmentName : "")@(Model.ManyCompanies && s.CompanyName is not null ? " · " + s.CompanyName : "")</span>
+                        </td>
+                        <td data-label="@L["fs.type"]">
+                            @L[SettlementFormat.TypeKey(s.SettlementType)]
+                            @if (!s.IsExit)
+                            {
+                                <span class="pr-emp-sub">@L["fs.n_days", SettlementFormat.Num(s.EncashDays)]@(s.PayMonth is { } pm ? " · " + PayItemFormat.Month(L, pm) : "")</span>
+                            }
+                        </td>
+                        <td data-label="@L["fs.last_day"]" class="col-p2 col-date">@L.Date(s.LastWorkingDay)</td>
+                        <td data-label="@L["fs.service"]" class="col-p3">@(s.IsExit ? SettlementFormat.ServiceShort(L, s.ServiceYears) : "—")</td>
+                        <td data-label="@L["fs.payable_kwd"]" class="pr-money@(s.NetPayable < 0 ? " pr-neg" : "")">@PayrollFormat.Money(s.NetPayable)</td>
+                        <td data-label="@L["common.status"]">
+                            <span class="hrms-badge hrms-badge--@SettlementFormat.StatusBadge(s.Status)"><span class="hrms-badge__dot"></span>@SettlementFormat.StatusLabel(L, s.Status, s.ApprovalLevel)</span>
+                            @if (s.Status == SettlementStatus.Paid && s.PaidDate is { } pd)
+                            {
+                                <span class="pr-emp-sub">@L.Date(pd)</span>
+                            }
+                        </td>
+                        <td class="hrms-table__actions">
+                            <a class="btn-icon" href="@url" title="@L["fs.open"]" aria-label="@L["fs.open_0", s.SettlementNo]">@Html.Icon(s.Status == SettlementStatus.Draft && Model.Rights.CanProcess ? "edit" : "eye", 15)</a>
+                            @if (s.Status != SettlementStatus.Cancelled)
+                            {
+                                <a class="btn-icon" href="@Url.Action("Statement", "FinalSettlement", new { id = s.FinalSettlementId })" title="@L["fs.statement"]" aria-label="@L["fs.statement_0", s.SettlementNo]">@Html.Icon("printer", 15)</a>
+                            }
+                        </td>
+                    </tr>
+                }
+            </tbody>
+        </table>
+    </div>
+    @await Html.PartialAsync("~/Views/Organization/Partials/_Pagination.cshtml", new PaginationModel
+    {
+        PageNumber = pg.PageNumber, TotalPages = pg.TotalPages, TotalCount = pg.TotalCount,
+        FirstRow = pg.FirstRowOnPage, LastRow = pg.LastRowOnPage
+    })
+}
+</div>
