@@ -0,0 +1,499 @@
+// ============================================================================
+// Final Settlement (Payroll > Final Settlement, db/39-40)
+// ----------------------------------------------------------------------------
+// Settlement page: a main column of calculation cards and a sticky side column
+// (summary, actions, approval route, history). Layout follows the CONTENT
+// width (container "content", see _responsive.scss), so it stacks into one
+// column on tablets, phones and high zoom. The statement prints on A4 with the
+// app chrome hidden, English and Arabic side by side.
+// ============================================================================
+
+@use "tokens" as *;
+@use "mixins" as *;
+
+// ------------------------------------------------------------- layout ----
+.fs-page { display: flex; flex-direction: column; gap: 1rem; }
+
+.fs-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1rem;
+  align-items: start;
+
+  @include cq-up("lg") {
+    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
+  }
+}
+
+.fs-main { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
+
+.fs-side {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  min-width: 0;
+
+  @include cq-up("lg") {
+    position: sticky;
+    top: calc(var(--hrms-topbar-height, 64px) + 1rem);
+  }
+}
+
+// the summary comes first on narrow screens - it is what people look for
+@include cq-down("lg") {
+  .fs-layout > .fs-side { order: -1; }
+  .fs-new .fs-layout > .fs-side { order: 0; }
+}
+
+.fs-steps { margin-bottom: 0; }
+
+// ------------------------------------------------------- employee head ----
+.fs-head {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  grid-template-areas:
+    "avatar who"
+    "tags   tags"
+    "facts  facts"
+    "reason reason";
+  gap: .75rem 1rem;
+  align-items: center;
+  padding: 1rem 1.25rem;
+
+  @include cq-up("md") {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    grid-template-areas:
+      "avatar who   tags"
+      "facts  facts facts"
+      "reason reason reason";
+  }
+
+  &__avatar { grid-area: avatar; width: 48px; height: 48px; font-size: 1rem; }
+
+  &__who {
+    grid-area: who;
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+
+    strong { font-family: Lexend, "Public Sans", sans-serif; font-size: 1.05rem; color: $ink-900; overflow-wrap: anywhere; }
+    span { font-size: .8rem; color: $ink-500; }
+  }
+
+  &__tags { grid-area: tags; display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; justify-content: flex-start; }
+
+  @include cq-up("md") {
+    &__tags { justify-content: flex-end; }
+  }
+
+  &__facts {
+    grid-area: facts;
+    padding-top: .75rem;
+    border-top: 1px solid $line-100;
+    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  }
+
+  &__reason {
+    grid-area: reason;
+    display: flex;
+    gap: .4rem;
+    align-items: flex-start;
+    margin: 0;
+    padding: .5rem .75rem;
+    background: $surface-2;
+    border-radius: var(--hrms-radius);
+    font-size: .8rem;
+    color: $ink-700;
+
+    svg { flex: 0 0 auto; margin-top: 2px; color: $ink-400; }
+  }
+}
+
+// ------------------------------------------------------- section cards ----
+.fs-card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: .75rem;
+  padding: 1rem 1.25rem .75rem;
+
+  &__total {
+    font-family: Lexend, "Public Sans", sans-serif;
+    font-weight: 600;
+    font-variant-numeric: tabular-nums;
+    color: $ink-900;
+    white-space: nowrap;
+  }
+}
+
+.fs-num {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 1.5rem;
+  height: 1.5rem;
+  margin-inline-end: .5rem;
+  border-radius: 50%;
+  background: $blue-050;
+  color: $blue-600;
+  font-size: .75rem;
+  font-weight: 700;
+  vertical-align: 1px;
+}
+
+.fs-note { font-size: .8rem; color: $ink-600; margin: 0 0 .5rem; }
+
+.fs-calc td:first-child { padding-inline-end: 1rem; }
+
+// lines that can be waived or removed (other earnings, recoveries)
+.fs-lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.fs-line {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto auto;
+  gap: .25rem .75rem;
+  align-items: center;
+  padding: .5rem 0;
+  border-bottom: 1px dashed $line-200;
+  font-size: .85rem;
+
+  &__text { display: flex; flex-direction: column; min-width: 0; }
+  &__title { color: $ink-900; overflow-wrap: anywhere; }
+  &__sub { color: $ink-500; font-size: .75rem; overflow-wrap: anywhere; }
+  &__amt { font-weight: 600; }
+  &__act { display: inline-flex; gap: .15rem; }
+
+  &.is-waived {
+    .fs-line__title, .fs-line__sub { opacity: .6; }
+    .fs-line__amt { text-decoration: line-through; color: $ink-400; }
+  }
+
+  &.is-manual .fs-line__title::before {
+    content: "";
+    display: inline-block;
+    width: 6px;
+    height: 6px;
+    margin-inline-end: .4rem;
+    border-radius: 50%;
+    background: $amber-600;
+    vertical-align: middle;
+  }
+}
+
+// add a line by hand
+.fs-add {
+  margin-top: .75rem;
+
+  > summary {
+    display: inline-flex;
+    align-items: center;
+    gap: .35rem;
+    cursor: pointer;
+    list-style: none;
+    font-size: .8rem;
+    font-weight: 600;
+    color: $blue-600;
+
+    &::-webkit-details-marker { display: none; }
+    &:hover { text-decoration: underline; }
+  }
+
+  &__form {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: .5rem .75rem;
+    align-items: end;
+    margin-top: .6rem;
+    padding: .75rem;
+    background: $surface-2;
+    border: 1px solid $line-100;
+    border-radius: var(--hrms-radius);
+
+    @include cq-up("sm") {
+      grid-template-columns: minmax(0, 1fr) 140px auto;
+    }
+  }
+
+  &__btn { white-space: nowrap; }
+}
+
+// ------------------------------------------------------------- summary ----
+.fs-summary .pr-calc td { padding: .35rem 0; }
+
+.fs-net {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: .75rem;
+  margin-top: .85rem;
+  padding: .75rem 1rem;
+  border-radius: var(--hrms-radius);
+  background: $navy-900;
+  color: $white;
+  font-weight: 600;
+
+  strong { font-family: Lexend, "Public Sans", sans-serif; font-size: 1.2rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
+
+  &.is-negative { background: $red-700; }
+}
+
+.fs-calculated { margin: .4rem 0 0; font-size: .72rem; color: $ink-500; text-align: end; }
+
+.fs-actions {
+  display: flex;
+  flex-direction: column;
+  gap: .5rem;
+  margin-top: 1rem;
+
+  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; }
+
+  &__row {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: .5rem;
+  }
+}
+
+.fs-ack {
+  padding: .6rem .75rem .6rem 2.1rem;
+  border: 1px solid $amber-600;
+  border-radius: var(--hrms-radius);
+  background: $amber-050;
+  font-size: .78rem;
+  color: $amber-700;
+
+  [dir="rtl"] & { padding: .6rem 2.1rem .6rem .75rem; }
+
+  &.is-invalid { border-color: $red-600; box-shadow: 0 0 0 2px rgba($red-600, .15); }
+}
+
+.fs-hint { margin: 0; font-size: .75rem; color: $ink-500; }
+
+// history
+.fs-history {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  max-height: 22rem;
+  overflow-y: auto;
+
+  li { padding: .5rem 0; border-bottom: 1px solid $line-100; font-size: .8rem; }
+  li:last-child { border-bottom: 0; }
+
+  &__head { display: flex; justify-content: space-between; gap: .5rem; color: $ink-900; }
+  &__amt { font-variant-numeric: tabular-nums; color: $ink-600; white-space: nowrap; }
+  &__meta { color: $ink-500; font-size: .72rem; }
+}
+
+// --------------------------------------------------------------- form ----
+.fs-form {
+  .hrms-fieldset { margin-bottom: 0; }
+
+  &__actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: flex-end;
+    gap: .5rem;
+    margin-top: 1rem;
+
+    .btn { display: inline-flex; align-items: center; gap: .4rem; }
+  }
+}
+
+.fs-info {
+  margin-top: 1rem;
+  padding: .85rem 1rem;
+  border: 1px solid $blue-200;
+  border-radius: var(--hrms-radius);
+  background: $blue-050;
+
+  .pr-banner { margin-bottom: .75rem; }
+  .pr-dl { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
+}
+
+.fs-edit[open], .fs-edit { overflow: visible; }
+
+.fs-howto {
+  margin: 0 0 .75rem;
+  padding-inline-start: 1.1rem;
+  font-size: .8rem;
+  color: $ink-600;
+
+  li { margin-bottom: .5rem; }
+  strong { display: block; color: $ink-900; }
+}
+
+.fs-table .fs-no { text-decoration: none; }
+.fs-table .fs-no:hover { text-decoration: underline; }
+
+// ----------------------------------------------------------- statement ----
+.fs-statement {
+  position: relative;
+  max-width: 900px;
+  margin: 0 auto;
+  padding: 1.75rem;
+  background: $white;
+  border: 1px solid $line-200;
+  border-radius: var(--hrms-radius-lg, 12px);
+  font-size: .82rem;
+  color: $ink-800;
+  overflow: hidden;
+
+  @include cq-down("sm") { padding: 1rem; }
+
+  &__watermark {
+    position: absolute;
+    inset: 40% 0 auto;
+    transform: rotate(-18deg);
+    text-align: center;
+    font-size: 2.6rem;
+    font-weight: 800;
+    letter-spacing: .08em;
+    color: rgba($red-600, .1);
+    pointer-events: none;
+
+    .fs-st__ar { font-size: 2rem; color: inherit; }
+  }
+
+  &__head {
+    display: grid;
+    grid-template-columns: 1fr auto 1fr;
+    gap: 1rem;
+    align-items: center;
+    padding-bottom: 1rem;
+    margin-bottom: 1rem;
+    border-bottom: 2px solid $navy-900;
+
+    @include cq-down("sm") {
+      grid-template-columns: 1fr 1fr;
+      .fs-statement__title { grid-column: 1 / -1; order: 3; }
+    }
+  }
+
+  &__co {
+    display: flex;
+    flex-direction: column;
+
+    strong { font-family: Lexend, "Public Sans", sans-serif; color: $navy-900; font-size: 1rem; }
+    span { font-size: .72rem; color: $ink-500; }
+
+    &--ar { text-align: right; font-family: "Noto Kufi Arabic", "Noto Sans Arabic", sans-serif; }
+  }
+
+  &__title {
+    text-align: center;
+    font-weight: 700;
+    font-size: 1rem;
+    color: $navy-900;
+
+    .fs-st__en, .fs-st__ar { display: block; }
+  }
+
+  &__foot {
+    display: flex;
+    justify-content: space-between;
+    gap: 1rem;
+    margin-top: 1.25rem;
+    padding-top: .5rem;
+    border-top: 1px solid $line-200;
+    font-size: .7rem;
+    color: $ink-500;
+  }
+}
+
+// a label in both languages: English, the Arabic under it (bidi-safe, no inline mixing)
+.fs-st__en { display: block; }
+.fs-st__ar {
+  display: block;
+  font-family: "Noto Sans Arabic", sans-serif;
+  font-size: .92em;
+  color: $ink-600;
+}
+.fs-st__calc { display: block; font-size: .7rem; color: $ink-500; font-variant-numeric: tabular-nums; }
+
+.fs-st-info, .fs-st-sum, .fs-st-lines {
+  width: 100%;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+.fs-st-info {
+  th, td { padding: .35rem .5rem; border: 1px solid $line-200; vertical-align: top; }
+  th { width: 22%; background: $blue-050; font-weight: 600; color: $navy-900; font-size: .74rem; }
+  td { width: 28%; overflow-wrap: anywhere; }
+
+  // phones: one pair per row
+  @include cq-down("sm") {
+    tr { display: grid; grid-template-columns: 40% 60%; }
+    th, td { width: auto; }
+  }
+}
+
+.fs-st-sum {
+  th { background: $navy-900; color: $white; padding: .45rem .6rem; text-align: start; font-size: .75rem; }
+  th .fs-st__ar { color: $blue-200; }
+  th.pr-money .fs-st__ar { text-align: end; }
+  td { padding: .45rem .6rem; border-bottom: 1px solid $line-200; }
+  td.pr-money, th.pr-money { text-align: end; width: 9rem; }
+  tr.is-sub td { font-weight: 700; background: $surface-2; }
+  tfoot td { font-weight: 800; font-size: .95rem; border-top: 2px solid $navy-900; border-bottom: 2px solid $navy-900; background: $blue-050; color: $navy-900; }
+}
+
+.fs-st-lines {
+  caption { caption-side: top; padding: 0 0 .35rem; font-weight: 700; color: $navy-900; text-align: start; }
+  td { padding: .3rem .6rem; border-bottom: 1px dashed $line-200; font-size: .76rem; }
+  td.pr-money { text-align: end; width: 9rem; }
+  tr.is-info td { color: $ink-500; }
+}
+
+.fs-st-paid { font-weight: 600; color: $green-700; }
+
+.fs-st-declaration {
+  margin: 1rem 0;
+  padding: .75rem 1rem;
+  border: 1px solid $line-200;
+  border-radius: var(--hrms-radius);
+  background: $surface-2;
+  line-height: 1.6;
+
+  .fs-st__en, .fs-st__ar { display: block; margin: 0; }
+  .fs-st__ar { margin-top: .4rem; text-align: right; }
+}
+
+.fs-st-signs {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.5rem;
+  margin-top: 2.5rem;
+  text-align: center;
+  font-size: .75rem;
+
+  @include cq-down("sm") { grid-template-columns: 1fr; gap: 2rem; }
+
+  &__line { display: block; height: 2.5rem; border-bottom: 1px solid $ink-400; margin-bottom: .35rem; }
+  .fs-st__en, .fs-st__ar { margin: 0; }
+}
+
+@media print {
+  @page { size: A4; margin: 12mm; }
+
+  .hrms-wizard-steps,
+  .hrms-page-head,
+  .pr-tabs { display: none !important; }
+
+  .fs-statement {
+    max-width: none;
+    padding: 0;
+    border: 0;
+    border-radius: 0;
+    font-size: 9.5pt;
+    -webkit-print-color-adjust: exact;
+    print-color-adjust: exact;
+  }
+
+  .fs-st-signs { break-inside: avoid; }
+}
